{"type":"tool_call","subtype":"completed","call_id":"tool_36fcfc00-03a7-4093-9d94-d73985f0abb","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"use serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;"},"result":{"success":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","linesAdded":1,"linesRemoved":0,"diffString":"--- a//Users/user/work/delegate-12-budgets/tests/budgets.rs\n+++ b//Users/user/work/delegate-12-budgets/tests/budgets.rs\n@@ -2,6 +2,7 @@\n \n use serde_json::Value;\n use std::io::Write;\n+use std::sync::Mutex;\n use std::os::unix::fs::PermissionsExt;\n use std::path::PathBuf;\n use std::process::{Command, Output, Stdio};","beforeFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","afterFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","message":"The file /Users/user/work/delegate-12-budgets/tests/budgets.rs has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"tool_36fcfc00-03a7-4093-9d94-d73985f0abb","startedAtMs":"1790851757659","completedAtMs":"1790851758561"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851758483}
{"type":"tool_call","subtype":"started","call_id":"tool_5f295fe5-fdf8-404b-9579-5162fa04f69","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"const SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {"}},"hookAdditionalContexts":[],"toolCallId":"tool_5f295fe5-fdf8-404b-9579-5162fa04f69","startedAtMs":"1790851757671"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851758483}
{"type":"tool_call","subtype":"completed","call_id":"tool_5f295fe5-fdf8-404b-9579-5162fa04f69","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"const SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {"},"result":{"success":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","linesAdded":8,"linesRemoved":0,"diffString":"--- a//Users/user/work/delegate-12-budgets/tests/budgets.rs\n+++ b//Users/user/work/delegate-12-budgets/tests/budgets.rs\n@@ -62,6 +62,14 @@\n const MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\n const SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n \n+/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\n+static BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n+\n+fn serial_budgets(f: impl FnOnce()) {\n+    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n+    f();\n+}\n+\n struct Env {\n     dir: PathBuf,\n }","beforeFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","afterFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","message":"The file /Users/user/work/delegate-12-budgets/tests/budgets.rs has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"tool_5f295fe5-fdf8-404b-9579-5162fa04f69","startedAtMs":"1790851757671","completedAtMs":"1790851759378"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851759295}
{"type":"tool_call","subtype":"started","call_id":"tool_0361ebea-47c1-4676-ba28-3bba30a5e14","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");"}},"hookAdditionalContexts":[],"toolCallId":"tool_0361ebea-47c1-4676-ba28-3bba30a5e14","startedAtMs":"1790851758182"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851760119}
{"type":"tool_call","subtype":"completed","call_id":"tool_0361ebea-47c1-4676-ba28-3bba30a5e14","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");"},"result":{"success":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","linesAdded":1,"linesRemoved":0,"diffString":"--- a//Users/user/work/delegate-12-budgets/tests/budgets.rs\n+++ b//Users/user/work/delegate-12-budgets/tests/budgets.rs\n@@ -198,6 +198,7 @@\n \n #[test]\n fn run_exits_within_wall_clock_budget() {\n+    serial_budgets(|| {\n     let e = Env::new(\"run\");\n     let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n     assert!(","beforeFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","afterFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","message":"The file /Users/user/work/delegate-12-budgets/tests/budgets.rs has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"tool_0361ebea-47c1-4676-ba28-3bba30a5e14","startedAtMs":"1790851758182","completedAtMs":"1790851760930"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851760849}
{"type":"tool_call","subtype":"started","call_id":"tool_23d43fb5-0a1b-4f99-a715-ae6cb0cb821","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");"}},"hookAdditionalContexts":[],"toolCallId":"tool_23d43fb5-0a1b-4f99-a715-ae6cb0cb821","startedAtMs":"1790851760208"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851760849}
{"type":"tool_call","subtype":"completed","call_id":"tool_23d43fb5-0a1b-4f99-a715-ae6cb0cb821","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");"},"result":{"success":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","linesAdded":2,"linesRemoved":0,"diffString":"--- a//Users/user/work/delegate-12-budgets/tests/budgets.rs\n+++ b//Users/user/work/delegate-12-budgets/tests/budgets.rs\n@@ -215,10 +215,12 @@\n     );\n     e.release();\n     e.wait_terminal(&id);\n+    });\n }\n \n #[test]\n fn resume_exits_within_wall_clock_budget() {\n+    serial_budgets(|| {\n     let e = Env::new(\"resume\");\n     let a = e.run_id(\"quick\");\n     e.wait_terminal(&a);","beforeFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","afterFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","message":"The file /Users/user/work/delegate-12-budgets/tests/budgets.rs has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"tool_23d43fb5-0a1b-4f99-a715-ae6cb0cb821","startedAtMs":"1790851760208","completedAtMs":"1790851761733"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851761651}
{"type":"tool_call","subtype":"started","call_id":"tool_35fcfcce-16b2-4761-9c80-adf5d95b20b","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"    e.release();\n    e.wait_terminal(&b);\n    });\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"cancel\");"}},"hookAdditionalContexts":[],"toolCallId":"tool_35fcfcce-16b2-4761-9c80-adf5d95b20b","startedAtMs":"1790851760337"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851761651}
{"type":"tool_call","subtype":"completed","call_id":"tool_35fcfcce-16b2-4761-9c80-adf5d95b20b","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"    e.release();\n    e.wait_terminal(&b);\n    });\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"cancel\");"},"result":{"success":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","linesAdded":2,"linesRemoved":0,"diffString":"--- a//Users/user/work/delegate-12-budgets/tests/budgets.rs\n+++ b//Users/user/work/delegate-12-budgets/tests/budgets.rs\n@@ -239,10 +239,12 @@\n     );\n     e.release();\n     e.wait_terminal(&b);\n+    });\n }\n \n #[test]\n fn cancel_exits_within_wall_clock_budget() {\n+    serial_budgets(|| {\n     let e = Env::new(\"cancel\");\n     let id = e.run_id(\"CANCELME\");\n     e.until_agent_spawned();","beforeFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","afterFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n    });\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","message":"The file /Users/user/work/delegate-12-budgets/tests/budgets.rs has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"tool_35fcfcce-16b2-4761-9c80-adf5d95b20b","startedAtMs":"1790851760337","completedAtMs":"1790851762422"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851762340}
{"type":"tool_call","subtype":"started","call_id":"tool_69638de4-dadb-4279-a6fc-0c15d57e978","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"watch\");"}},"hookAdditionalContexts":[],"toolCallId":"tool_69638de4-dadb-4279-a6fc-0c15d57e978","startedAtMs":"1790851760460"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851762341}
{"type":"tool_call","subtype":"completed","call_id":"tool_69638de4-dadb-4279-a6fc-0c15d57e978","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"watch\");"},"result":{"success":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","linesAdded":2,"linesRemoved":0,"diffString":"--- a//Users/user/work/delegate-12-budgets/tests/budgets.rs\n+++ b//Users/user/work/delegate-12-budgets/tests/budgets.rs\n@@ -260,10 +260,12 @@\n         ms <= CANCEL_BUDGET_MS,\n         \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n     );\n+    });\n }\n \n #[test]\n fn watch_terminal_job_within_wall_clock_budget() {\n+    serial_budgets(|| {\n     let e = Env::new(\"watch\");\n     let id = e.run_id(\"quick\");\n     e.wait_terminal(&id);","beforeFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n    });\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","afterFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n    });\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","message":"The file /Users/user/work/delegate-12-budgets/tests/budgets.rs has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"tool_69638de4-dadb-4279-a6fc-0c15d57e978","startedAtMs":"1790851760460","completedAtMs":"1790851763136"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851763055}
{"type":"tool_call","subtype":"started","call_id":"tool_8fc63760-acb4-4656-8e2e-61549d16ad7","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"doctor\");"}},"hookAdditionalContexts":[],"toolCallId":"tool_8fc63760-acb4-4656-8e2e-61549d16ad7","startedAtMs":"1790851760519"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851763055}
{"type":"tool_call","subtype":"completed","call_id":"tool_8fc63760-acb4-4656-8e2e-61549d16ad7","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"doctor\");"},"result":{"success":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","linesAdded":2,"linesRemoved":0,"diffString":"--- a//Users/user/work/delegate-12-budgets/tests/budgets.rs\n+++ b//Users/user/work/delegate-12-budgets/tests/budgets.rs\n@@ -280,10 +280,12 @@\n         ms <= WATCH_BUDGET_MS,\n         \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n     );\n+    });\n }\n \n #[test]\n fn doctor_exits_within_wall_clock_budget() {\n+    serial_budgets(|| {\n     let e = Env::new_info(\"doctor\");\n     let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n     assert_eq!(","beforeFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n    });\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","afterFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n    });\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","message":"The file /Users/user/work/delegate-12-budgets/tests/budgets.rs has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"tool_8fc63760-acb4-4656-8e2e-61549d16ad7","startedAtMs":"1790851760519","completedAtMs":"1790851763853"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851763772}
{"type":"tool_call","subtype":"started","call_id":"tool_ac494f44-ba1c-4a91-af77-d37489dcdad","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"models\");"}},"hookAdditionalContexts":[],"toolCallId":"tool_ac494f44-ba1c-4a91-af77-d37489dcdad","startedAtMs":"1790851760750"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851763772}
{"type":"tool_call","subtype":"completed","call_id":"tool_ac494f44-ba1c-4a91-af77-d37489dcdad","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"models\");"},"result":{"success":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","linesAdded":2,"linesRemoved":0,"diffString":"--- a//Users/user/work/delegate-12-budgets/tests/budgets.rs\n+++ b//Users/user/work/delegate-12-budgets/tests/budgets.rs\n@@ -298,10 +298,12 @@\n         ms <= DOCTOR_BUDGET_MS,\n         \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n     );\n+    });\n }\n \n #[test]\n fn models_exits_within_wall_clock_budget() {\n+    serial_budgets(|| {\n     let e = Env::new_info(\"models\");\n     let (ms, out) = e.wall_ms(&[\"models\"], None);\n     assert!(","beforeFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n    });\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","afterFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n    });\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","message":"The file /Users/user/work/delegate-12-budgets/tests/budgets.rs has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"tool_ac494f44-ba1c-4a91-af77-d37489dcdad","startedAtMs":"1790851760750","completedAtMs":"1790851764571"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851764490}
{"type":"tool_call","subtype":"started","call_id":"tool_f7522a8b-89bc-4670-9eaa-c3354b0ebe3","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"rss\");"}},"hookAdditionalContexts":[],"toolCallId":"tool_f7522a8b-89bc-4670-9eaa-c3354b0ebe3","startedAtMs":"1790851761327"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851764491}
{"type":"tool_call","subtype":"completed","call_id":"tool_f7522a8b-89bc-4670-9eaa-c3354b0ebe3","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"rss\");"},"result":{"success":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","linesAdded":2,"linesRemoved":0,"diffString":"--- a//Users/user/work/delegate-12-budgets/tests/budgets.rs\n+++ b//Users/user/work/delegate-12-budgets/tests/budgets.rs\n@@ -315,10 +315,12 @@\n         ms <= MODELS_BUDGET_MS,\n         \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n     );\n+    });\n }\n \n #[test]\n fn supervisor_rss_while_running_within_budget() {\n+    serial_budgets(|| {\n     let e = Env::new(\"rss\");\n     let id = e.run_id(\"SLOW\");\n     until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");","beforeFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n    });\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","afterFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n    });\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","message":"The file /Users/user/work/delegate-12-budgets/tests/budgets.rs has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"tool_f7522a8b-89bc-4670-9eaa-c3354b0ebe3","startedAtMs":"1790851761327","completedAtMs":"1790851765577"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851765497}
{"type":"tool_call","subtype":"started","call_id":"tool_1819a3ac-d94e-4169-a8dd-6acb71f9dac","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"    e.release();\n    e.wait_terminal(&id);\n    });\n}\n"}},"hookAdditionalContexts":[],"toolCallId":"tool_1819a3ac-d94e-4169-a8dd-6acb71f9dac","startedAtMs":"1790851762043"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851765497}
{"type":"tool_call","subtype":"completed","call_id":"tool_1819a3ac-d94e-4169-a8dd-6acb71f9dac","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","streamContent":"    e.release();\n    e.wait_terminal(&id);\n    });\n}\n"},"result":{"success":{"path":"/Users/user/work/delegate-12-budgets/tests/budgets.rs","linesAdded":1,"linesRemoved":0,"diffString":"--- a//Users/user/work/delegate-12-budgets/tests/budgets.rs\n+++ b//Users/user/work/delegate-12-budgets/tests/budgets.rs\n@@ -332,4 +332,5 @@\n     );\n     e.release();\n     e.wait_terminal(&id);\n+    });\n }","beforeFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n    });\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n}\n","afterFullFileContent":"//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n\nuse serde_json::Value;\nuse std::io::Write;\nuse std::sync::Mutex;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::PathBuf;\nuse std::process::{Command, Output, Stdio};\nuse std::time::{Duration, Instant};\n\nconst FAKE_AGENT: &str = r#\"#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\nrel=\"$(dirname \"$0\")/go\"\ncase \"$*\" in\n  *CANCELME*)\n    sleep 300 &\n    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    exit 0\n    ;;\nesac\ncase \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n\"#;\n\nconst ABOUT: &str = \"\\\nAbout Cursor CLI\n\nCLI Version         2026.09.28-64d2043\nModel               Composer 2.5\nSubscription Tier   Pro\nUser Email          alice@example.com\";\n\nconst FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n\nfn info_agent_script() -> String {\n    format!(\n        r#\"#!/bin/sh\ncase \"$1\" in\n  --version) echo \"2026.09.28-64d2043\" ;;\n  about) printf '%s\\n' \"{ABOUT}\" ;;\n  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n  *) echo \"unexpected: $*\" >&2; exit 1 ;;\nesac\n\"#\n    )\n}\n\nconst RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\nconst RESUME_BUDGET_MS: u128 = 90; // measured: 30ms on M-series Mac, budget 3x\nconst CANCEL_BUDGET_MS: u128 = 177; // measured: 59ms on M-series Mac, budget 3x\nconst WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\nconst DOCTOR_BUDGET_MS: u128 = 522; // measured: 174ms on M-series Mac, budget 3x\nconst MODELS_BUDGET_MS: u128 = 12; // measured: 4ms on M-series Mac, budget 3x\nconst SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n\n/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\nstatic BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n\nfn serial_budgets(f: impl FnOnce()) {\n    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    f();\n}\n\nstruct Env {\n    dir: PathBuf,\n}\n\nimpl Env {\n    fn new(name: &str) -> Self {\n        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, FAKE_AGENT).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn new_info(name: &str) -> Self {\n        let dir =\n            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n        let _ = std::fs::remove_dir_all(&dir);\n        std::fs::create_dir_all(&dir).unwrap();\n        let agent = dir.join(\"agent.sh\");\n        std::fs::write(&agent, info_agent_script()).unwrap();\n        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n        Env { dir }\n    }\n\n    fn release(&self) {\n        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n    }\n\n    fn until_agent_spawned(&self) {\n        let t = Instant::now();\n        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n            assert!(\n                t.elapsed() < Duration::from_secs(10),\n                \"timed out waiting for CANCELME agent\"\n            );\n            std::thread::sleep(Duration::from_millis(20));\n        }\n    }\n\n    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n        cmd.args(args)\n            .current_dir(&self.dir)\n            .env(\"TMPDIR\", &self.dir)\n            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n            cmd.env(\n                \"CURSOR_DELEGATE_HOST_PROFILE\",\n                self.dir.join(\"nonexistent-profile.json\"),\n            );\n        }\n        let mut child = cmd\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .stderr(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let mut si = child.stdin.take().unwrap();\n        if let Some(s) = stdin {\n            let _ = si.write_all(s.as_bytes());\n        }\n        drop(si);\n        child.wait_with_output().unwrap()\n    }\n\n    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n        let start = Instant::now();\n        let out = self.delegate(args, stdin);\n        (start.elapsed().as_millis(), out)\n    }\n\n    fn run_id(&self, prompt: &str) -> String {\n        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n        assert!(\n            out.status.success(),\n            \"run failed in {ms}ms: stderr={} stdout={}\",\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n\n    fn record(&self, id: &str) -> Value {\n        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n    }\n\n    fn wait_terminal(&self, id: &str) {\n        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n        assert_eq!(out.status.code(), Some(0));\n    }\n}\n\nimpl Drop for Env {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.dir);\n    }\n}\n\nfn until(what: &str, mut f: impl FnMut() -> bool) {\n    let t = Instant::now();\n    while !f() {\n        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n        std::thread::sleep(Duration::from_millis(20));\n    }\n}\n\nfn supervisor_rss_kb(pid: i32) -> u64 {\n    let out = Command::new(\"ps\")\n        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n        .output()\n        .expect(\"ps\");\n    assert!(\n        out.status.success(),\n        \"ps failed: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .trim()\n        .parse()\n        .expect(\"rss parse\")\n}\n\n#[test]\nfn run_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"run\");\n    let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RUN_BUDGET_MS,\n        \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n    });\n}\n\n#[test]\nfn resume_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"resume\");\n    let a = e.run_id(\"quick\");\n    e.wait_terminal(&a);\n    let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n    assert!(\n        out.status.success(),\n        \"stderr={} stdout={}\",\n        String::from_utf8_lossy(&out.stderr),\n        String::from_utf8_lossy(&out.stdout)\n    );\n    let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n    assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n    assert!(\n        ms <= RESUME_BUDGET_MS,\n        \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n    );\n    e.release();\n    e.wait_terminal(&b);\n    });\n}\n\n#[test]\nfn cancel_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"cancel\");\n    let id = e.run_id(\"CANCELME\");\n    e.until_agent_spawned();\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= CANCEL_BUDGET_MS,\n        \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn watch_terminal_job_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"watch\");\n    let id = e.run_id(\"quick\");\n    e.wait_terminal(&id);\n    let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= WATCH_BUDGET_MS,\n        \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn doctor_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"doctor\");\n    let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n    assert_eq!(\n        out.status.code(),\n        Some(0),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= DOCTOR_BUDGET_MS,\n        \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn models_exits_within_wall_clock_budget() {\n    serial_budgets(|| {\n    let e = Env::new_info(\"models\");\n    let (ms, out) = e.wall_ms(&[\"models\"], None);\n    assert!(\n        out.status.success(),\n        \"stderr={}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        ms <= MODELS_BUDGET_MS,\n        \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n    );\n    });\n}\n\n#[test]\nfn supervisor_rss_while_running_within_budget() {\n    serial_budgets(|| {\n    let e = Env::new(\"rss\");\n    let id = e.run_id(\"SLOW\");\n    until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n    let rss = supervisor_rss_kb(pid);\n    assert!(\n        rss <= SUPERVISOR_RSS_BUDGET_KB,\n        \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n    );\n    e.release();\n    e.wait_terminal(&id);\n    });\n}\n","message":"The file /Users/user/work/delegate-12-budgets/tests/budgets.rs has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"tool_1819a3ac-d94e-4169-a8dd-6acb71f9dac","startedAtMs":"1790851762043","completedAtMs":"1790851766410"},"model_call_id":"03ff5b5c-012a-4c9e-8b5f-f8530a892bb5-16-z5j7","session_id":"23269ead-5209-4ac9-9976-6eab6d468682","timestamp_ms":1790851766349}
