,   \"backend\": \"pi\", \"price\": { \"input\": 2,   \"output\": 10,  \"cacheRead\": 0.1,  \"cacheWrite\": 2.5 } },\n    \"claude-opus-5-5\":   { \"label\": \"Claude Opus 5.5\",   \"backend\": \"claude\", \"price\": { \"input\": 4,  \"output\": 20, \"cacheRead\": 0.2,  \"cacheWrite\": 5 } },\n    \"claude-sonnet-5-5\": { \"label\": \"Claude Sonnet 5.5\", \"backend\": \"claude\", \"price\": { \"input\": 2,  \"output\": 10, \"cacheRead\": 0.2,  \"cacheWrite\": 2.5 } },\n    \"claude-fable-5-1\":  { \"label\": \"Claude Fable 5.1\",  \"backend\": \"claude\", \"price\": { \"input\": 10, \"output\": 50, \"cacheRead\": 0.25, \"cacheWrite\": 12.5 } }\n  }\n}\n    backend replaces family; default composer-2.5; pi/claude resolve to a\n    not-implemented error; delegate models prints an aligned table; delegate\n    doctor prints ok/warn/skip/fail lines with exit 1 on any fail.\n    \n    Co-Authored-By: Muse Spark 1.3 <noreply@opencode.ai>\n\n config/models.json    |  19 +-\n src/cli.rs            |  25 ++-\n src/cli_info.rs       | 209 +++++++++++++++++++\n src/config.rs         |  32 +--\n src/doctor.rs         | 198 ++----------------\n src/doctor_tests.rs   | 545 +++++++++++---------------------------------------\n src/index/tests.rs    |   2 +-\n src/lib.rs            |   1 +\n src/models.rs         |  97 ++++++---\n src/runner/tests.rs   |  24 +--\n src/tool_schemas.rs   |  12 +-\n src/types.rs          |   4 +-\n tests/cli_info_e2e.rs | 230 +++++++++++++++++++++\n 13 files changed, 717 insertions(+), 681 deletions(-)","is_error":false}]},"parent_tool_use_id":null,"session_id":"1dbb4698-1c43-4b15-b933-765f45723b7a","uuid":"b45dc50f-e822-43ee-92df-55255f3f5c0f","timestamp":"2026-10-01T09:22:16.973Z","tool_use_result":{"stdout":"config/models.json\nsrc/cli.rs\nsrc/cli_info.rs\nsrc/config.rs\nsrc/doctor.rs\nsrc/doctor_tests.rs\nsrc/index/tests.rs\nsrc/lib.rs\nsrc/models.rs\nsrc/runner/tests.rs\nsrc/tool_schemas.rs\nsrc/types.rs\ntests/cli_info_e2e.rs\n{\n  \"default\": \"