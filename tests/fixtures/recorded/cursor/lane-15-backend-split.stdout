ap_capability(Capability::Ask, false);","contentTruncated":false,"isContextLine":false},{"lineNumber":42,"content":"        let r = map_capability(Capability::WriteUnsandboxed, true);","contentTruncated":false,"isContextLine":false},{"lineNumber":49,"content":"        let r = map_capability(Capability::WriteUnsandboxed, false);","contentTruncated":false,"isContextLine":false}]},{"file":"./src/backends/types.rs","matches":[{"lineNumber":1,"content":"use crate::types::{JobSpec, RawCursorJson};","contentTruncated":false,"isContextLine":false},{"lineNumber":6,"content":"    pub raw: RawCursorJson,","contentTruncated":false,"isContextLine":false},{"lineNumber":40,"content":"pub trait Backend: Send + Sync {","contentTruncated":false,"isContextLine":false}]},{"file":"./src/backends/cursor.rs","matches":[{"lineNumber":6,"content":"use crate::types::{JobSpec, RawCursorJson};","contentTruncated":false,"isContextLine":false},{"lineNumber":18,"content":"pub fn make_cursor_adapter() -> CursorAdapter {","contentTruncated":false,"isContextLine":false},{"lineNumber":22,"content":"pub fn build_argv(","contentTruncated":false,"isContextLine":false},{"lineNumber":65,"content":"                        raw: RawCursorJson {","contentTruncated":false,"isContextLine":false},{"lineNumber":124,"content":"        let mut result: Option<RawCursorJson> = None;","contentTruncated":false,"isContextLine":false},{"lineNumber":154,"content":"    result: &mut Option<RawCursorJson>,","contentTruncated":false,"isContextLine":false}]}],"totalLines":48,"totalMatchedLines":48,"clientTruncated":false,"ripgrepTruncated":false}}}}}},"hookAdditionalContexts":[],"toolCallId":"call-2750523a-ede5-4209-bc05-83bd8f7a0b54-23\nfc_540e8da6-4e0f-951c-9b6b-7072c5d688aa_1","startedAtMs":"1790853465844","completedAtMs":"1790853466216"},"model_call_id":"a39a3dae-67ec-4300-bf85-501258a620a7-5-7r3j","session_id":"1d546125-183e-46a3-aaab-e9734f91ce3e","timestamp_ms":1790853466126}
{"type":"tool_call","subtype":"completed","call_id":"call-2750523a-ede5-4209-bc05-83bd8f7a0b54-24\nfc_540e8da6-4e0f-951c-9b6b-7072c5d688aa_2","tool_call":{"readToolCall":{"args":{"path":"/Users/user/work/delegate-15-backend-split/src/stream.rs","limit":150},"result":{"success":{"content":"use crate::types::RawCursorJson;\nuse serde_json::Value;\n\n#[derive(Debug, Clone, Default, PartialEq)]\npub struct StreamState {\n    pub last_tool: Option<String>,\n    pub tokens_so_far: f64,\n    pub last_assistant: Option<String>,\n    pub files_touched: Vec<String>,\n    pub phase: Option<String>,\n}\n\npub fn init_stream_state() -> StreamState {\n    StreamState::default()\n}\n\n#[derive(Debug, Clone, Default)]\npub struct ParsedLine {\n    pub result: Option<RawCursorJson>,\n    pub changed: bool,\n}\n\nconst PATH_ARG_KEYS: [&str; 5] = [\"path\", \"filePath\", \"file_path\", \"target\", \"destination\"];\n\nfn path_from_args(args: Option<&Value>) -> Option<String> {\n    let obj = args?.as_object()?;\n    for key in PATH_ARG_KEYS {\n        if let Some(v) = obj\n            .get(key)\n            .and_then(|x| x.as_str())\n            .filter(|s| !s.is_empty())\n        {\n            return Some(v.to_string());\n        }\n    }\n    None\n}\n\nfn extract_tool(tc: &Value) -> (Option<String>, Option<String>) {\n    if let Some(mcp) = tc.get(\"mcpToolCall\") {\n        let tool = mcp\n            .get(\"toolName\")\n            .and_then(|x| x.as_str())\n            .unwrap_or(\"mcp\")\n            .to_string();\n        return (Some(tool), None);\n    }\n    if let Some(obj) = tc.as_object() {\n        for (key, val) in obj {\n            if let Some(name) = key.strip_suffix(\"ToolCall\") {\n                let args = val.get(\"args\");\n                return (Some(name.to_string()), path_from_args(args));\n            }\n        }\n    }\n    (None, None)\n}\n\nfn extract_assistant_text(message: Option<&Value>) -> Option<String> {\n    let content = message?.get(\"content\")?.as_array()?;\n    let parts: Vec<&str> = content\n        .iter()\n        .filter(|b| b.get(\"type\").and_then(|t| t.as_str()) == Some(\"text\"))\n        .filter_map(|b| b.get(\"text\").and_then(|t| t.as_str()))\n        .collect();\n    if parts.is_empty() {\n        return None;\n    }\n    Some(parts.join(\"\"))\n}\n\npub fn parse_line(line: &str, state: &mut StreamState) -> ParsedLine {\n    let trimmed = line.trim();\n    if trimmed.is_empty() {\n        return ParsedLine {\n            changed: false,\n            result: None,\n        };\n    }\n    let ev: Value = match serde_json::from_str(trimmed) {\n        Ok(v) => v,\n        Err(_) => {\n            return ParsedLine {\n                changed: false,\n                result: None,\n            };\n        }\n    };\n    let ty = match ev.get(\"type\").and_then(|t| t.as_str()) {\n        Some(t) => t,\n        None => {\n            return ParsedLine {\n                changed: false,\n                result: None,\n            };\n        }\n    };\n\n    let mut changed = false;\n    if let Some(n) = ev\n        .pointer(\"/usage/outputTokens\")\n        .and_then(|x| x.as_f64())\n        .filter(|n| n.is_finite())\n    {\n        state.tokens_so_far = state.tokens_so_far.max(n);\n        changed = true;\n    }\n\n    match ty {\n        \"tool_call\" => {\n            if ev.get(\"subtype\").and_then(|s| s.as_str()) == Some(\"started\")\n                && ev.get(\"tool_call\").is_some()\n            {\n                state.phase = Some(\"running_tool\".into());\n                changed = true;\n                let (tool, path) = extract_tool(ev.get(\"tool_call\").unwrap());\n                if let Some(t) = tool {\n                    state.last_tool = Some(t);\n                }\n                if let Some(p) = path\n                    && !state.files_touched.contains(&p)\n                {\n                    state.files_touched.push(p);\n                }\n            }\n        }\n        \"assistant\" => {\n            if let Some(text) = extract_assistant_text(ev.get(\"message\")) {\n                let truncated: String = text.chars().take(200).collect();\n                state.last_assistant = Some(truncated);\n                state.phase = Some(\"responding\".into());\n                changed = true;\n            }\n        }\n        \"thinking\" => {\n            if ev.get(\"subtype\").and_then(|s| s.as_str()) == Some(\"delta\")\n                && ev.get(\"text\").and_then(|t| t.as_str()).is_some()\n            {\n                state.phase = Some(\"thinking\".into());\n                changed = true;\n            }\n        }\n        \"result\" => {\n            let raw: RawCursorJson = serde_json::from_value(ev).unwrap_or_default();\n            return ParsedLine {\n                result: Some(raw),\n                changed: true,\n            };\n        }\n        _ => {}","isEmpty":false,"exceededLimit":false,"totalLines":359,"fileSize":10486,"path":"/Users/user/work/delegate-15-backend-split/src/stream.rs","readRange":{"startLine":1,"endLine":150},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-2750523a-ede5-4209-bc05-83bd8f7a0b54-24\nfc_540e8da6-4e0f-951c-9b6b-7072c5d688aa_2","startedAtMs":"1790853466160","completedAtMs":"1790853466516"},"model_call_id":"a39a3dae-67ec-4300-bf85-501258a620a7-5-7r3j","session_id":"1d546125-183e-46a3-aaab-e9734f91ce3e","timestamp_ms":1790853466425}
{"type":"tool_call","subtype":"started","call_id":"call-2750523a-ede5-4209-bc05-83bd8f7a0b54-25\nfc_540e8da6-4e0f-951c-9b6b-7072c5d688aa_3","tool_call":{"readToolCall":{"args":{"path":"/Users/user/work/delegate-15-backend-split/src/models.rs","limit":200}},"hookAdditionalContexts":[],"toolCallId":"call-2750523a-ede5-4209-bc05-83bd8f7a0b54-25\nfc_540e8da6-4e0f-951c-9b6b-7072c5d688aa_3","startedAtMs":"1790853466525"},"model_call_id":"a39a3dae-67ec-4300-bf85-501258a620a7-5-7r3j","session_id":"1d546125-183e-46a3-aaab-e9734f91ce3e","timestamp_ms":1790853466433}
{"type":"tool_call","subtype":"completed","call_id":"call-2750523a-ede5-4209-bc05-83bd8f7a0b54-25\nfc_540e8da6-4e0f-951c-9b6b-7072c5d688aa_3","tool_call":{"readToolCall":{"args":{"path":"/Users/user/work/delegate-15-backend-split/src/models.rs","limit":200},"result":{"success":{"content":"use crate::types::{Config, ResolvedModel};\n\n#[derive(Debug)]\npub struct ModelNotAllowedError {\n    pub message: String,\n}\n\nimpl std::fmt::Display for ModelNotAllowedError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(&self.message)\n    }\n}\nimpl std::error::Error for ModelNotAllowedError {}\n\npub fn resolve_model(\n    model: Option<&str>,\n    config: &impl ConfigLike,\n) -> Result<ResolvedModel, Box<dyn std::error::Error + Send + Sync>> {\n    let model = model\n        .map(|s| s.to_string())\n        .unwrap_or_else(|| config.default_model().to_string());\n    let entry = config.models().get(&model).ok_or_else(|| {\n        Box::new(ModelNotAllowedError {\n            message: format!(\"model \\\"{model}\\\" is not in the allow-list\"),\n        }) as Box<dyn std::error::Error + Send + Sync>\n    })?;\n    if entry.backend != \"cursor\" {\n        return Err(format!(\n            \"model \\\"{model}\\\" uses backend \\\"{}\\\", which is not implemented yet\",\n            entry.backend\n        )\n        .into());\n    }\n    Ok(ResolvedModel {\n        model,\n        backend: entry.backend.clone(),\n        price: entry.price,\n    })\n}\n\npub trait ConfigLike {\n    fn default_model(&self) -> &str;\n    fn models(&self) -> &std::collections::HashMap<String, crate::types::ModelEntry>;\n}\n\nimpl ConfigLike for Config {\n    fn default_model(&self) -> &str {\n        &self.default\n    }\n    fn models(&self) -> &std::collections::HashMap<String, crate::types::ModelEntry> {\n        &self.models\n    }\n}\n\nimpl ConfigLike\n    for (\n        &str,\n        &std::collections::HashMap<String, crate::types::ModelEntry>,\n    )\n{\n    fn default_model(&self) -> &str {\n        self.0\n    }\n    fn models(&self) -> &std::collections::HashMap<String, crate::types::ModelEntry> {\n        self.1\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::types::{ModelEntry, Price};\n    use std::collections::HashMap;\n\n    fn price(input: f64, output: f64, cache_read: f64, cache_write: f64) -> Price {\n        Price {\n            input,\n            output,\n            cache_read,\n            cache_write,\n        }\n    }\n\n    fn base() -> (String, HashMap<String, ModelEntry>) {\n        let mut models = HashMap::new();\n        models.insert(\n            \"composer-2.5\".into(),\n            ModelEntry {\n                label: \"Composer 2.5\".into(),\n                backend: \"cursor\".into(),\n                price: price(0.5, 2.5, 0.2, 0.0),\n            },\n        );\n        models.insert(\n            \"grok-4.7-high\".into(),\n            ModelEntry {\n                label: \"Grok 4.7 High\".into(),\n                backend: \"cursor\".into(),\n                price: price(2.0, 6.0, 0.5, 0.0),\n            },\n        );\n        models.insert(\n            \"openai-codex/gpt-6-luna\".into(),\n            ModelEntry {\n                label: \"GPT-6 Luna\".into(),\n                backend: \"pi\".into(),\n                price: price(0.1, 0.5, 0.01, 0.125),\n            },\n        );\n        models.insert(\n            \"claude-sonnet-5-5\".into(),\n            ModelEntry {\n                label: \"Claude Sonnet 5.5\".into(),\n                backend: \"claude\".into(),\n                price: price(2.0, 10.0, 0.2, 2.5),\n            },\n        );\n        (\"composer-2.5\".into(), models)\n    }\n\n    #[test]\n    fn omitted_model_resolves_to_default() {\n        let (d, m) = base();\n        let r = resolve_model(None, &(d.as_str(), &m)).unwrap();\n        assert_eq!(r.model, \"composer-2.5\");\n        assert_eq!(r.backend, \"cursor\");\n        assert_eq!(r.price, m[\"composer-2.5\"].price);\n    }\n\n    #[test]\n    fn allowed_id_resolves_with_backend_and_price() {\n        let (d, m) = base();\n        let r = resolve_model(Some(\"grok-4.7-high\"), &(d.as_str(), &m)).unwrap();\n        assert_eq!(r.model, \"grok-4.7-high\");\n        assert_eq!(r.backend, \"cursor\");\n        assert_eq!(r.price, m[\"grok-4.7-high\"].price);\n    }\n\n    #[test]\n    fn unknown_id_throws_model_not_allowed() {\n        let (d, m) = base();\n        let e = resolve_model(Some(\"not-listed\"), &(d.as_str(), &m)).unwrap_err();\n        assert!(e.downcast_ref::<ModelNotAllowedError>().is_some());\n    }\n\n    #[test]\n    fn claude_backend_is_not_implemented() {\n        let (d, m) = base();\n        let e = resolve_model(Some(\"claude-sonnet-5-5\"), &(d.as_str(), &m)).unwrap_err();\n        assert_eq!(\n            e.to_string(),\n            \"model \\\"claude-sonnet-5-5\\\" uses backend \\\"claude\\\", which is not implemented yet\"\n        );\n    }\n\n    #[test]\n    fn pi_backend_is_not_implemented() {\n        let (d, m) = base();\n        let e = resolve_model(Some(\"openai-codex/gpt-6-luna\"), &(d.as_str(), &m)).unwrap_err();\n        assert_eq!(\n            e.to_string(),\n            \"model \\\"openai-codex/gpt-6-luna\\\" uses backend \\\"pi\\\", which is not implemented yet\"\n        );\n    }\n}\n","isEmpty":false,"exceededLimit":false,"totalLines":166,"fileSize":4849,"path":"/Users/user/work/delegate-15-backend-split/src/models.rs","readRange":{"startLine":1,"endLine":166},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-2750523a-ede5-4209-bc05-83bd8f7a0b54-25\nfc_540e8da6-4e0f-951c-9b6b-7072c5d688aa_3","startedAtMs":"1790853466525","completedAtMs":"1790853466894"},"model_call_id":"a39a3dae-67ec-4300-bf85-501258a620a7-5-7r3j","session_id":"1d546125-183e-46a3-aaab-e9734f91ce3e","timestamp_ms":1790853466820}
