{"type":"message_update","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"assistantMessageEvent":{"type":"toolcall_delta","contentIndex":2,"delta":"{\"content\":\"//! The pi backend: binary, argv, spawn, and stream-json parsing.\\n//!\\n//! `pi -p --mode json` prints one JSON object per line. The `session` header\\n//! carries the id, `agent_end.messages` holds the final turn, and usage/cost\\n//! accumulate over assistant `message_end` events. pi exits 0 even on errors,\\n//! so success comes from the last assistant message's `stopReason`, never the\\n//! exit code.\\n\\npub(crate) mod doctor;\\n\\nuse super::types::{BackendResult, Event, EventFn, ProgressSnapshotRaw, Spawned};\\nuse crate::types::{Capability, JobSpec, Usage};\\nuse std::sync::atomic::Ordering;\\n\\nconst NO_RESULT: &str = \\\"no result line\\\";\\n\\npub(crate) fn resolve_bin(r#override: Option<&str>) -> String {\\n    if let Some(o) = r#override.filter(|s| !s.is_empty()) {\\n        return o.to_string();\\n    }\\n    if let Ok(env) = std::env::var(\\\"PI_BIN\\\")\\n        && !env.is_empty()\\n    {\\n        return env;\\n    }\\n    if let Ok(out) = std::process::Command::new(\\\"which\\\").arg(\\\"pi\\\").output()\\n        && out.status.success()\\n    {\\n        let found = String::from_utf8_lossy(&out.stdout).trim().to_string();\\n        if !found.is_empty() {\\n            return found;\\n        }\\n    }\\n    crate::util::homedir()\\n        .join(\\\".local/bin/pi\\\")\\n        .to_string_lossy()\\n        .into_owned()\\n}\\n\\npub(crate) fn argv(\\n    model: &str,\\n    _capability: Capability,\\n    session: Option<&str>,\\n    prompt: &str,\\n) -> (Vec<String>, bool) {\\n    // pi has no read-only mode, so the capability maps to no flag; `run` and\\n    // `resume` reject read-only pi jobs before launch. The session id is chosen\\n    // before launch: resume passes the stored id, a fresh run mints one (pi\\n    // creates the session if absent, continues it if present).\\n    let session = session\\n        .map(str::to_string)\\n        .unwrap_or_else(crate::util::random_uuid);\\n    let args = vec![\\n        \\\"-p\\\".into(),\\n        \\\"--mode\\\".into(),\\n        \\\"json\\\".into(),\\n        \\\"--model\\\".into(),\\n        model.to_string(),\\n        \\\"--session-id\\\".into(),\\n        session,\\n        \\\"--\\\".into(),\\n        prompt.to_string(),\\n    ];\\n    (args, true)\\n}\\n\\npub(crate) fn spawn(spec: &JobSpec) -> Spawned {\\n    let started = match super::start_child(spec) {\\n        Ok(s) => s,\\n        Err(msg) => return super::spawn_failed(&msg),\\n    };\\n    let pid = started.pid;\\n    let reaped = started.reaped;\\n    let reaped_k = std::sync::Arc::clone(&reaped);\\n    let stdout = started.stdout;\\n    let stderr = started.stderr;\\n    let mut child = started.child;\\n    Spawned {\\n        kill: super::killer(pid, reaped_k),\\n        drive: Box::new(move |on| {\\n            let mut state = PiState::default();\\n            let pumped = super::pump(\\n                stdout,\\n                stderr,\\n                on,\\n                move || {\\n                    let clean = child.wait().map(|s| s.success()).unwrap_or(false);\\n                    reaped.store(true, Ordering::SeqCst);\\n                    clean\\n                },\\n                |line| {\\n                    if handle_line(line, &mut state) {\\n                        on(Event::Progress(ProgressSnapshotRaw {\\n                            last_tool: state.last_tool.clone(),\\n                            tokens_so_far: 0.0,\\n                            last_assistant: state.last_assistant.clone(),\\n                            files_touched: Vec::new(),\\n                            phase: state.phase.clone(),\\n                        }));\\n                    }\\n                },\\n            );\\n            finish(state, pumped.clean_exit, &pumped.stderr)\\n        }),\\n    }\\n}\\n\\n/// Pure parse of a finished `pi -p --mode json` stdout. The spawn driver uses\\n/// [`finish`] too.\\npub fn parse_stdout(stdout: &str, clean_exit: bool, stderr: &str) -> BackendResult {\\n    let mut state = PiState::default();\\n    for line in stdout.split_inclusive('\\\\n') {\\n        handle_line(line.as_bytes(), &mut state);\\n    }\\n    finish(state, clean_exit, stderr)\\n}\\n\\n#[derive(Debug, Default)]\\nstruct PiState {\\n    session_id: Option<String>,\\n    agent_end: Option<serde_json::Value>,\\n    last_assistant_end: Option<serde_json::Value>,\\n    input: f64,\\n    output: f64,\\n    cache_read: f64,\\n    cache_write: f64,\\n    cost: f64,\\n    saw_assistant_end: bool,\\n    last_tool: Option<String>,\\n    last_assistant: Option<String>,\\n    phase: Option<String>,\\n}\\n\\n/// Fold one stdout line into the state. Unparseable lines are ignored.\\n/// Returns whether a progress event should fire.\\nfn handle_line(line: &[u8], state: &mut PiState) -> bool {\\n    let trimmed = String::from_utf8_lossy(line).trim().to_string();\\n    if trimmed.is_empty() {\\n        return false;\\n    }\\n    let ev: serde_json::Value = match serde_json::from_str(&trimmed) {\\n        Ok(v) => v,\\n        Err(_) => return false,\\n    };\\n    if ev.get(\\\"type\\\").and_then(|t| t.as_str()).is_none() {\\n        return false;\\n    }\\n    match ev.get(\\\"type\\\").and_then(|t| t.as_str()) {\\n        Some(\\\"session\\\") => {\\n            if let Some(id) = ev.get(\\\"id\\\").and_then(|i| i.as_str()) {\\n                state.session_id = Some(id.to_string());\\n            }\\n            false\\n        }\\n        Some(\\\"tool_execution_start\\\") => {\\n            if let Some(tool) = ev.get(\\\"toolName\\\").and_then(|t| t.as_str()) {\\n                state.last_tool = Some(tool.to_string());\\n            }\\n            state.phase = Some(\\\"running_tool\\\".into());\\n            true\\n        }\\n        Some(\\\"message_update\\\") => {\\n            let end = ev\\n                .get(\\\"assistantMessageEvent\\\")\\n                .filter(|e| e.get(\\\"type\\\").and_then(|t| t.as_str()) == Some(\\\"text_end\\\"))\\n                .and_then(|e| e.get(\\\"content\\\"))\\n                .and_then(|c| c.as_str());\\n            if let Some(text) = end {\\n                let truncated: String = text.chars().take(200).collect();\\n                state.last_assistant = Some(truncated);\\n                state.phase = Some(\\\"responding\\\".into());\\n                return true;\\n            }\\n            false\\n        }\\n        Some(\\\"message_end\\\") => {\\n            let message = match ev.get(\\\"message\\\") {\\n                Some(m) if m.get(\\\"role\\\").and_then(|r| r.as_str()) == Some(\\\"assistant\\\") => m,\\n                _ => return false,\\n            };\\n            let usage = message.get(\\\"usage\\\");\\n            state.input += usage\\n                .and_then(|u| u.get(\\\"input\\\"))\\n                .and_then(|n| n.as_f64())\\n                .filter(|n| n.is_finite())\\n                .unwrap_or(0.0);\\n            state.output += usage\\n                .and_then(|u| u.get(\\\"output\\\"))\\n                .and_then(|n| n.as_f64())\\n                .filter(|n| n.is_finite())\\n                .unwrap_or(0.0);\\n            state.cache_read += usage\\n                .and_then(|u| u.get(\\\"cacheRead\\\"))\\n                .and_then(|n| n.as_f64())\\n                .filter(|n| n.is_finite())\\n                .unwrap_or(0.0);\\n            state.cache_write += usage\\n                .and_then(|u| u.get(\\\"cacheWrite\\\"))\\n                .and_then(|n| n.as_f64())\\n                .filter(|n| n.is_finite())\\n                .unwrap_or(0.0);\\n            state.cost += usage\\n                .and_then(|u| u.get(\\\"cost\\\"))\\n                .and_then(|c| c.get(\\\"total\\\"))\\n                .and_then(|n| n.as_f64())\\n                .filter(|n| n.is_finite())\\n                .unwrap_or(0.0);\\n            state.saw_assistant_end = true;\\n            state.last_assistant_end = Some(message.clone());\\n            true\\n        }\\n        Some(\\\"agent_end\\\") => {\\n            state.agent_end = Some(ev);\\n            false\\n        }\\n        _ => false,\\n    }\\n}\\n\\n/// Concatenated `text` parts of one assistant message.\\nfn assistant_text(message: &serde_json::Value) -> String {\\n    message\\n        .get(\\\"content\\\")\\n        .and_then(|c| c.as_array())\\n        .map(|parts| {\\n            parts\\n                .iter()\\n                .filter(|p| p.get(\\\"type\\\").and_then(|t| t.as_str()) == Some(\\\"text\\\"))\\n                .filter_map(|p| p.get(\\\"text\\\").and_then(|t| t.as_str()))\\n                .collect::<Vec<_>>()\\n                .join(\\\"\\\")\\n        })\\n        .unwrap_or_default()\\n}\\n\\n/// Turn the terminal `agent_end` (or the lack of one) into the normalized result.\\n/// The exit code never decides success: pi exits 0 on errors. CANCELLED is the\\n/// supervisor's status, never ours.\\nfn finish(state: PiState, clean_exit: bool, stderr: &str) -> BackendResult {\\n    let Some(end) = state.agent_end else {\\n        return BackendResult {\\n            text: NO_RESULT.to_string(),\\n            is_error: Some(true),\\n            clean_exit,\\n            stderr: stderr.to_string(),\\n            ..Default::default()\\n        };\\n    };\\n    let assistant = end\\n        .get(\\\"messages\\\")\\n        .and_then(|m| m.as_array())\\n        .and_then(|msgs| {\\n            msgs.iter()\\n                .rev()\\n                .find(|m| m.get(\\\"role\\\").and_then(|r| r.as_str()) == Some(\\\"assistant\\\"))\\n        });\\n    let (text, is_error) = match assistant {\\n        Some(m)\\n            if m.get(\\\"stopReason\\\").and_then(|s| s.as_str()) == Some(\\\"error\\\") =>\\n        {\\n            (\\n                m.get(\\\"errorMessage\\\")\\n                    .and_then(|e| e.as_str())\\n                    .unwrap_or_default()\\n                    .to_string(),\\n                Some(true),\\n            )\\n        }\\n        Some(m) => (assistant_text(m), Some(false)),\\n        // No assistant turn in the transcript; fall back to its last message.\\n        None => (\\n            state\\n                .last_assistant_end\\n                .as_ref()\\n                .map(assistant_text)\\n                .unwrap_or_default(),\\n            Some(false),\\n        ),\\n    };\\n    BackendResult {\\n        text,\\n        session_id: state.session_id,\\n        usage: state.saw_assistant_end.then(|| Usage {\\n            input_tokens: state.input,\\n            output_tokens: state.output,\\n            cache_read_tokens: state.cache_read,\\n            cache_write_tokens: state.cache_write,\\n        }),\\n        cost_usd: state.saw_assistant_end.then_some(state.cost),\\n        is_error,\\n        duration_ms: None,\\n        clean_exit,\\n        stderr: stderr.to_string(),\\n    }\\n}\\n\\n#[cfg(test)]\\nmod tests {\\n    use super::*;\\n\\n    #[test]\\n    fn fresh_run_mints_a_session_id_and_resume_reuses_it() {\\n        let (fresh, is_write) = argv(\\\"openai-codex/gpt-6-luna\\\", Capability::Ask, None, \\\"hi\\\");\\n        assert!(is_write);\\n        assert_eq!(\\n            &fresh[..6],\\n            [\\n                \\\"-p\\\",\\n                \\\"--mode\\\",\\n                \\\"json\\\",\\n                \\\"--model\\\",\\n                \\\"openai-codex/gpt-6-luna\\\",\\n                \\\"--session-id\\\",\\n            ]\\n        );\\n        let minted = &fresh[6];\\n        assert_eq!(minted.len(), 36, \\\"{fresh:?}\\\");\\n        assert!(\\n            minted.chars().all(|c| c.is_ascii_lowercase()\\n                || c.is_ascii_digit()\\n                || c == '-'),\\n            \\\"{fresh:?}\\\"\\n        );\\n        assert_eq!(&fresh[7..], [\\\"--\\\", \\\"hi\\\"]);\\n        // A second fresh run mints a different id.\\n        let (other, _) = argv(\\\"openai-codex/gpt-6-luna\\\", Capability::Ask, None, \\\"hi\\\");\\n        assert_ne!(fresh[6], other[6]);\\n\\n        let (resume, resume_write) = argv(\\n            \\\"openai-codex/gpt-6-luna\\\",\\n            Capability::WriteUnsandboxed,\\n            Some(\\\"afcd8926-430b-4d9a-a552-d7c6d1b900ba\\\"),\\n            \\\"go\\\",\\n        );\\n        assert!(resume_write);\\n        assert_eq!(resume[6], \\\"afcd8926-430b-4d9a-a552-d7c6d1b900ba\\\");\\n        assert_eq!(&resume[7..], [\\\"--\\\", \\\"go\\\"]);\\n    }\\n\\n    #[test]\\n    fn explicit_override_wins() {\\n        assert_eq!(resolve_bin(Some(\\\"/custom/pi\\\")), \\\"/custom/pi\\\");\\n    }\\n\\n    #[test]\\n    fn env_used_when_no_override() {\\n        let prev = std::env::var(\\\"PI_BIN\\\").ok();\\n        unsafe { std::env::set_var(\\\"PI_BIN\\\", \\\"/env/pi\\\") };\\n        assert_eq!(resolve_bin(None), \\\"/env/pi\\\");\\n        match prev {\\n            Some(v) => unsafe { std::env::set_var(\\\"PI_BIN\\\", v) },\\n            None => unsafe { std::env::remove_var(\\\"PI_BIN\\\") },\\n        }\\n    }\\n\\n    #[test]\\n    fn tool_start_and_text_end_emit_progress() {\\n        let on = |_: Event| {};\\n        let mut state = PiState::default();\\n        assert!(handle_line(\\n            br#\\\"{\\\"type\\\":\\\"tool_execution_start\\\",\\\"toolCallId\\\":\\\"c1\\\",\\\"toolName\\\":\\\"bash\\\",\\\"args\\\":{\\\"command\\\":\\\"ls\\\"}}\\\"#,\\n            &mut state,\\n        ));\\n        assert_eq!(state.last_tool.as_deref(), Some(\\\"bash\\\"));\\n        assert_eq!(state.phase.as_deref(), Some(\\\"running_tool\\\"));\\n        assert!(handle_line(\\n            br#\\\"{\\\"type\\\":\\\"message_update\\\",\\\"assistantMessageEvent\\\":{\\\"type\\\":\\\"text_end\\\",\\\"contentIndex\\\":0,\\\"content\\\":\\\"hello\\\"}}\\\"#,\\n            &mut state,\\n        ));\\n        assert_eq!(state.last_assistant.as_deref(), Some(\\\"hello\\\"));\\n        assert_eq!(state.phase.as_deref(), Some(\\\"responding\\\"));\\n        assert!(!handle_line(b\\\"not json\\\", &mut state));\\n        assert!(!handle_line(b\\\"\\\", &mut state));\\n        // Deltas and non-assistant message_ends carry no progress of their own.\\n        assert!(!handle_line(\\n            br#\\\"{\\\"type\\\":\\\"message_update\\\",\\\"assistantMessageEvent\\\":{\\\"type\\\":\\\"text_delta\\\",\\\"contentIndex\\\":0,\\\"delta\\\":\\\"hi\\\"}}\\\"#,\\n            &mut state,\\n        ));\\n        assert!(!handle_line(\\n            br#\\\"{\\\"type\\\":\\\"message_end\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[]}}\\\"#,\\n            &mut state,\\n        ));\\n        let _ = on;\\n    }\\n\\n    #[test]\\n    fn spawn_failure_is_an_error_result() {\\n        let spec = crate::job::tests::spec_of(|s| s.bin = \\\"/nonexistent/pi\\\".into());\\n        let spawned = spawn(&spec);\\n        (spawned.kill)();\\n        let res = (spawned.drive)(&|_| {});\\n        assert!(!res.clean_exit);\\n        assert_eq!(res.is_error, Some(true));\\n        assert!(!res.text.is_empty());\\n    }\\n\\n    #[test]\\n    fn real_child_runs_and_sigterm_kills_it() {\\n        let spec = crate::job::tests::spec_of(|s| {\\n            s.bin = \\\"/bin/sh\\\".into();\\n            s.argv = vec![\\\"-c\\\".into(), \\\"exec sleep 30\\\".into()];\\n        });\\n        let spawned = spawn(&spec);\\n        let kill = spawned.kill;\\n        let t = std::thread::spawn(move || (spawned.drive)(&|_| {}));\\n        std::thread::sleep(std::time::Duration::from_millis(100));\\n        kill();\\n        let res = t.join().unwrap();\\n        assert!(!res.clean_exit);\\n    }\\n\\n    /// Exit status is not stored in the fixtures. Only `cancelled` stops\\n    /// mid-stream (SIGTERM exits 143); every other fixture ran to `agent_end`.\\n    fn clean_exit_for(stem: &str) -> bool {\\n        !matches!(stem, \\\"cancelled\\\")\\n    }\\n\\n    fn approx(a: f64, b: f64) -> bool {\\n        (a - b).abs() < 1e-12\\n    }\\n\\n    #[test]\\n    fn fixtures_parse_to_a_normalized_result() {\\n        let dir =\\n            std::path::PathBuf::from(env!(\\\"CARGO_MANIFEST_DIR\\\")).join(\\\"tests/fixtures/pi\\\");\\n        let mut files: Vec<_> = std::fs::read_dir(&dir)\\n            .unwrap_or_else(|e| panic!(\\\"{}: {e}\\\", dir.display()))\\n            .map(|e| e.unwrap().path())\\n            .filter(|p| p.extension().and_then(|s| s.to_str()) == Some(\\\"stdout\\\"))\\n            .collect();\\n        files.sort();\\n        assert!(!files.is_empty(), \\\"no pi stdout fixtures\\\");\\n\\n        for path in files {\\n            let stem = path.file_stem().unwrap().to_str().unwrap().to_string();\\n            let stdout = std::fs::read_to_string(&path)\\n                .unwrap_or_else(|e| panic!(\\\"{}: {e}\\\", path.display()));\\n            let stderr_path = path.with_extension(\\\"stderr\\\");\\n            let stderr = std::fs::read_to_string(&stderr_path).unwrap_or_default();\\n            let clean = clean_exit_for(&stem);\\n            let res = parse_stdout(&stdout, clean, &stderr);\\n\\n            assert_eq!(res.clean_exit, clean, \\\"{stem}\\\");\\n            assert_eq!(res.stderr, stderr, \\\"{stem}\\\");\\n            assert_eq!(res.duration_ms, None, \\\"{stem}\\\");\\n            assert!(!res.text.contains(\\\"CANCELLED\\\"), \\\"{stem}\\\");\\n            // The exit code never decides success: error-bad-model exits 0.\\n            if stem == \\\"cancelled\\\" {\\n                assert_eq!(res.is_error, Some(true), \\\"{stem}\\\");\\n                assert_eq!(res.text, NO_RESULT, \\\"{stem}\\\");\\n                assert!(res.session_id.is_none() && res.usage.is_none(), \\\"{stem}\\\");\\n                assert_eq!(res.cost_usd, None, \\\"{stem}\\\");\\n                continue;\\n            }\\n            assert!(res.session_id.is_some() && res.usage.is_some(), \\\"{stem}\\\");\\n            assert_eq!(res.cost_usd.is_some(), true, \\\"{stem}\\\");\\n\\n            match stem.as_str() {\\n                \\\"plain-answer\\\" => assert_eq!(\\n                    res,\\n                    BackendResult {\\n                        text: \\\"391\\\\nSTATUS: DONE\\\".into(),\\n                        session_id: Some(\\\"afcd8926-430b-4d9a-a552-d7c6d1b900ba\\\".into()),\\n                        usage: Some(Usage {\\n                            input_tokens: 5320.0,\\n                            output_tokens: 9.0,\\n                            cache_read_tokens: 0.0,\\n                            cache_write_tokens: 0.0,\\n                        }),\\n                        cost_usd: Some(0.0005365),\\n                        is_error: Some(false),\\n                        duration_ms: None,\\n                        clean_exit: true,\\n                        stderr,\\n                    },\\n                    \\\"{stem}\\\"\\n                ),\\n                \\\"tool-calls-fix\\\" => {\\n                    assert_eq!(\\n                        res.text,\\n                        \\\"Fixed `add` in `calc.py` to add its arguments. \\\\\\n                         `python3 test_calc.py` passes.\\\\n\\\\nSTATUS: DONE\\\",\\n                        \\\"{stem}\\\"\\n                    );\\n                    assert_eq!(\\n                        res.session_id.as_deref(),\\n                        Some(\\\"e04e84ae-41c0-4ed8-b9e5-de410d2f3bdf\\\"),\\n                        \\\"{stem}\\\"\\n                    );\\n                    let usage = res.usage.as_ref().expect(\\\"usage\\\");\\n                    assert_eq!(usage.input_tokens, 8940.0, \\\"{stem}\\\");\\n                    assert_eq!(usage.output_tokens, 214.0, \\\"{stem}\\\");\\n                    assert_eq!(usage.cache_read_tokens, 18432.0, \\\"{stem}\\\");\\n                    assert_eq!(usage.cache_write_tokens, 0.0, \\\"{stem}\\\");\\n                    assert!(approx(res.cost_usd.unwrap(), 0.00118532), \\\"{stem}\\\");\\n                    assert_eq!(res.is_error, Some(false), \\\"{stem}\\\");\\n                }\\n                \\\"resume-answer\\\" => {\\n                    assert_eq!(res.text, \\\"392\\\\nSTATUS: DONE\\\", \\\"{stem}\\\");\\n                    assert_eq!(\\n                        res.session_id.as_deref(),\\n                        Some(\\\"afcd8926-430b-4d9a-a552-d7c6d1b900ba\\\"),\\n                        \\\"{stem}\\\"\\n                    );\\n                    let usage = res.usage.as_ref().expect(\\\"usage\\\");\\n                    assert_eq!(usage.input_tokens, 814.0, \\\"{stem}\\\");\\n                    assert_eq!(usage.output_tokens, 33.0, \\\"{stem}\\\");\\n                    assert_eq!(usage.cache_read_tokens, 4608.0, \\\"{stem}\\\");\\n                    assert_eq!(usage.cache_write_tokens, 0.0, \\\"{stem}\\\");\\n                    assert!(approx(res.cost_usd.unwrap(), 0.00014398), \\\"{stem}\\\");\\n                    assert_eq!(res.is_error, Some(false), \\\"{stem}\\\");\\n                }\\n                \\\"error-bad-model\\\" => {\\n                    assert_eq!(\\n                        res.text,\\n                        \\\"Codex error: The 'no-such-model' model is not supported \\\\\\n                         when using Codex with a ChatGPT account.\\\",\\n                        \\\"{stem}\\\"\\n                    );\\n                    assert_eq!(\\n                        res.session_id.as_deref(),\\n                        Some(\\\"a86b4f04-f9fe-4fe2-88f2-9c07c39dda68\\\"),\\n                        \\\"{stem}\\\"\\n                    );\\n                    assert_eq!(res.is_error, Some(true), \\\"{stem}\\\");\\n                    assert_eq!(res.cost_usd, Some(0.0), \\\"{stem}\\\");\\n                }\\n                \\\"needs-context\\\" => {\\n                    assert_eq!(\\n                        res.text,\\n                        \\\"What would you like the function in `calc.py` to be called?\\\\\\n                         \\\\n\\\\nSTATUS: NEEDS_CONTEXT\\\",\\n                        \\\"{stem}\\\"\\n                    );\\n                    assert_eq!(\\n                        res.session_id.as_deref(),\\n                        Some(\\\"b7a8e40b-c58f-4468-b202-0ea1ff35dbac\\\"),\\n                        \\\"{stem}\\\"\\n                    );\\n                    let usage = res.usage.as_ref().expect(\\\"usage\\\");\\n                    assert_eq!(usage.input_tokens, 7912.0, \\\"{stem}\\\");\\n                    assert_eq!(usage.output_tokens, 174.0, \\\"{stem}\\\");\\n                    assert_eq!(usage.cache_read_tokens, 13824.0, \\\"{stem}\\\");\\n                    assert_eq!(usage.cache_write_tokens, 0.0, \\\"{stem}\\\");\\n                    assert!(approx(res.cost_usd.unwrap(), 0.00101644), \\\"{stem}\\\");\\n                    assert_eq!(res.is_error, Some(false), \\\"{stem}\\\");\\n                }\\n                other => panic!(\\\"unexpected pi fixture: {other}\\\"),\\n            }\\n        }\\n    }\\n\\n    #[test]\\n    fn every_pi_fixture_has_progress() {\\n        // tool_execution_start sets last_tool; assistant text sets last_assistant.\\n        let dir =\\n            std::path::PathBuf::from(env!(\\\"CARGO_MANIFEST_DIR\\\")).join(\\\"tests/fixtures/pi\\\");\\n        for stem in [\\\"plain-answer\\\", \\\"tool-calls-fix\\\", \\\"needs-context\\\", \\\"resume-answer\\\"] {\\n            let stdout = std::fs::read_to_string(dir.join(format!(\\\"{stem}.stdout\\\"))).unwrap();\\n            let mut state = PiState::default();\\n            for line in stdout.split_inclusive('\\\\n') {\\n                handle_line(line.as_bytes(), &mut state);\\n            }\\n            assert!(\\n                state.last_assistant.is_some(),\\n                \\\"{stem} progress saw no assistant text\\\"\\n            );\\n            if stem == \\\"tool-calls-fix\\\" || stem == \\\"needs-context\\\" {\\n                assert!(state.last_tool.is_some(), \\\"{stem} progress saw no tool call\\\");\\n            }\\n        }\\n    }\\n}\\n\""}}
{"type":"message_update","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"assistantMessageEvent":{"type":"toolcall_delta","contentIndex":2,"delta":",\"path\":\"src/backends/pi/mod.rs\"}"}}
{"type":"message_update","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":2,"toolCall":{"type":"toolCall","id":"call_01a0f753a760751884fb2945e8d5a839|fc_01a0f753a760751884fb2945e8d5a839","name":"write","arguments":{"content":"//! The pi backend: binary, argv, spawn, and stream-json parsing.\n//!\n//! `pi -p --mode json` prints one JSON object per line. The `session` header\n//! carries the id, `agent_end.messages` holds the final turn, and usage/cost\n//! accumulate over assistant `message_end` events. pi exits 0 even on errors,\n//! so success comes from the last assistant message's `stopReason`, never the\n//! exit code.\n\npub(crate) mod doctor;\n\nuse super::types::{BackendResult, Event, EventFn, ProgressSnapshotRaw, Spawned};\nuse crate::types::{Capability, JobSpec, Usage};\nuse std::sync::atomic::Ordering;\n\nconst NO_RESULT: &str = \"no result line\";\n\npub(crate) fn resolve_bin(r#override: Option<&str>) -> String {\n    if let Some(o) = r#override.filter(|s| !s.is_empty()) {\n        return o.to_string();\n    }\n    if let Ok(env) = std::env::var(\"PI_BIN\")\n        && !env.is_empty()\n    {\n        return env;\n    }\n    if let Ok(out) = std::process::Command::new(\"which\").arg(\"pi\").output()\n        && out.status.success()\n    {\n        let found = String::from_utf8_lossy(&out.stdout).trim().to_string();\n        if !found.is_empty() {\n            return found;\n        }\n    }\n    crate::util::homedir()\n        .join(\".local/bin/pi\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub(crate) fn argv(\n    model: &str,\n    _capability: Capability,\n    session: Option<&str>,\n    prompt: &str,\n) -> (Vec<String>, bool) {\n    // pi has no read-only mode, so the capability maps to no flag; `run` and\n    // `resume` reject read-only pi jobs before launch. The session id is chosen\n    // before launch: resume passes the stored id, a fresh run mints one (pi\n    // creates the session if absent, continues it if present).\n    let session = session\n        .map(str::to_string)\n        .unwrap_or_else(crate::util::random_uuid);\n    let args = vec![\n        \"-p\".into(),\n        \"--mode\".into(),\n        \"json\".into(),\n        \"--model\".into(),\n        model.to_string(),\n        \"--session-id\".into(),\n        session,\n        \"--\".into(),\n        prompt.to_string(),\n    ];\n    (args, true)\n}\n\npub(crate) fn spawn(spec: &JobSpec) -> Spawned {\n    let started = match super::start_child(spec) {\n        Ok(s) => s,\n        Err(msg) => return super::spawn_failed(&msg),\n    };\n    let pid = started.pid;\n    let reaped = started.reaped;\n    let reaped_k = std::sync::Arc::clone(&reaped);\n    let stdout = started.stdout;\n    let stderr = started.stderr;\n    let mut child = started.child;\n    Spawned {\n        kill: super::killer(pid, reaped_k),\n        drive: Box::new(move |on| {\n            let mut state = PiState::default();\n            let pumped = super::pump(\n                stdout,\n                stderr,\n                on,\n                move || {\n                    let clean = child.wait().map(|s| s.success()).unwrap_or(false);\n                    reaped.store(true, Ordering::SeqCst);\n                    clean\n                },\n                |line| {\n                    if handle_line(line, &mut state) {\n                        on(Event::Progress(ProgressSnapshotRaw {\n                            last_tool: state.last_tool.clone(),\n                            tokens_so_far: 0.0,\n                            last_assistant: state.last_assistant.clone(),\n                            files_touched: Vec::new(),\n                            phase: state.phase.clone(),\n                        }));\n                    }\n                },\n            );\n            finish(state, pumped.clean_exit, &pumped.stderr)\n        }),\n    }\n}\n\n/// Pure parse of a finished `pi -p --mode json` stdout. The spawn driver uses\n/// [`finish`] too.\npub fn parse_stdout(stdout: &str, clean_exit: bool, stderr: &str) -> BackendResult {\n    let mut state = PiState::default();\n    for line in stdout.split_inclusive('\\n') {\n        handle_line(line.as_bytes(), &mut state);\n    }\n    finish(state, clean_exit, stderr)\n}\n\n#[derive(Debug, Default)]\nstruct PiState {\n    session_id: Option<String>,\n    agent_end: Option<serde_json::Value>,\n    last_assistant_end: Option<serde_json::Value>,\n    input: f64,\n    output: f64,\n    cache_read: f64,\n    cache_write: f64,\n    cost: f64,\n    saw_assistant_end: bool,\n    last_tool: Option<String>,\n    last_assistant: Option<String>,\n    phase: Option<String>,\n}\n\n/// Fold one stdout line into the state. Unparseable lines are ignored.\n/// Returns whether a progress event should fire.\nfn handle_line(line: &[u8], state: &mut PiState) -> bool {\n    let trimmed = String::from_utf8_lossy(line).trim().to_string();\n    if trimmed.is_empty() {\n        return false;\n    }\n    let ev: serde_json::Value = match serde_json::from_str(&trimmed) {\n        Ok(v) => v,\n        Err(_) => return false,\n    };\n    if ev.get(\"type\").and_then(|t| t.as_str()).is_none() {\n        return false;\n    }\n    match ev.get(\"type\").and_then(|t| t.as_str()) {\n        Some(\"session\") => {\n            if let Some(id) = ev.get(\"id\").and_then(|i| i.as_str()) {\n                state.session_id = Some(id.to_string());\n            }\n            false\n        }\n        Some(\"tool_execution_start\") => {\n            if let Some(tool) = ev.get(\"toolName\").and_then(|t| t.as_str()) {\n                state.last_tool = Some(tool.to_string());\n            }\n            state.phase = Some(\"running_tool\".into());\n            true\n        }\n        Some(\"message_update\") => {\n            let end = ev\n                .get(\"assistantMessageEvent\")\n                .filter(|e| e.get(\"type\").and_then(|t| t.as_str()) == Some(\"text_end\"))\n                .and_then(|e| e.get(\"content\"))\n                .and_then(|c| c.as_str());\n            if let Some(text) = end {\n                let truncated: String = text.chars().take(200).collect();\n                state.last_assistant = Some(truncated);\n                state.phase = Some(\"responding\".into());\n                return true;\n            }\n            false\n        }\n        Some(\"message_end\") => {\n            let message = match ev.get(\"message\") {\n                Some(m) if m.get(\"role\").and_then(|r| r.as_str()) == Some(\"assistant\") => m,\n                _ => return false,\n            };\n            let usage = message.get(\"usage\");\n            state.input += usage\n                .and_then(|u| u.get(\"input\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.output += usage\n                .and_then(|u| u.get(\"output\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.cache_read += usage\n                .and_then(|u| u.get(\"cacheRead\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.cache_write += usage\n                .and_then(|u| u.get(\"cacheWrite\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.cost += usage\n                .and_then(|u| u.get(\"cost\"))\n                .and_then(|c| c.get(\"total\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.saw_assistant_end = true;\n            state.last_assistant_end = Some(message.clone());\n            true\n        }\n        Some(\"agent_end\") => {\n            state.agent_end = Some(ev);\n            false\n        }\n        _ => false,\n    }\n}\n\n/// Concatenated `text` parts of one assistant message.\nfn assistant_text(message: &serde_json::Value) -> String {\n    message\n        .get(\"content\")\n        .and_then(|c| c.as_array())\n        .map(|parts| {\n            parts\n                .iter()\n                .filter(|p| p.get(\"type\").and_then(|t| t.as_str()) == Some(\"text\"))\n                .filter_map(|p| p.get(\"text\").and_then(|t| t.as_str()))\n                .collect::<Vec<_>>()\n                .join(\"\")\n        })\n        .unwrap_or_default()\n}\n\n/// Turn the terminal `agent_end` (or the lack of one) into the normalized result.\n/// The exit code never decides success: pi exits 0 on errors. CANCELLED is the\n/// supervisor's status, never ours.\nfn finish(state: PiState, clean_exit: bool, stderr: &str) -> BackendResult {\n    let Some(end) = state.agent_end else {\n        return BackendResult {\n            text: NO_RESULT.to_string(),\n            is_error: Some(true),\n            clean_exit,\n            stderr: stderr.to_string(),\n            ..Default::default()\n        };\n    };\n    let assistant = end\n        .get(\"messages\")\n        .and_then(|m| m.as_array())\n        .and_then(|msgs| {\n            msgs.iter()\n                .rev()\n                .find(|m| m.get(\"role\").and_then(|r| r.as_str()) == Some(\"assistant\"))\n        });\n    let (text, is_error) = match assistant {\n        Some(m)\n            if m.get(\"stopReason\").and_then(|s| s.as_str()) == Some(\"error\") =>\n        {\n            (\n                m.get(\"errorMessage\")\n                    .and_then(|e| e.as_str())\n                    .unwrap_or_default()\n                    .to_string(),\n                Some(true),\n            )\n        }\n        Some(m) => (assistant_text(m), Some(false)),\n        // No assistant turn in the transcript; fall back to its last message.\n        None => (\n            state\n                .last_assistant_end\n                .as_ref()\n                .map(assistant_text)\n                .unwrap_or_default(),\n            Some(false),\n        ),\n    };\n    BackendResult {\n        text,\n        session_id: state.session_id,\n        usage: state.saw_assistant_end.then(|| Usage {\n            input_tokens: state.input,\n            output_tokens: state.output,\n            cache_read_tokens: state.cache_read,\n            cache_write_tokens: state.cache_write,\n        }),\n        cost_usd: state.saw_assistant_end.then_some(state.cost),\n        is_error,\n        duration_ms: None,\n        clean_exit,\n        stderr: stderr.to_string(),\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn fresh_run_mints_a_session_id_and_resume_reuses_it() {\n        let (fresh, is_write) = argv(\"openai-codex/gpt-6-luna\", Capability::Ask, None, \"hi\");\n        assert!(is_write);\n        assert_eq!(\n            &fresh[..6],\n            [\n                \"-p\",\n                \"--mode\",\n                \"json\",\n                \"--model\",\n                \"openai-codex/gpt-6-luna\",\n                \"--session-id\",\n            ]\n        );\n        let minted = &fresh[6];\n        assert_eq!(minted.len(), 36, \"{fresh:?}\");\n        assert!(\n            minted.chars().all(|c| c.is_ascii_lowercase()\n                || c.is_ascii_digit()\n                || c == '-'),\n            \"{fresh:?}\"\n        );\n        assert_eq!(&fresh[7..], [\"--\", \"hi\"]);\n        // A second fresh run mints a different id.\n        let (other, _) = argv(\"openai-codex/gpt-6-luna\", Capability::Ask, None, \"hi\");\n        assert_ne!(fresh[6], other[6]);\n\n        let (resume, resume_write) = argv(\n            \"openai-codex/gpt-6-luna\",\n            Capability::WriteUnsandboxed,\n            Some(\"afcd8926-430b-4d9a-a552-d7c6d1b900ba\"),\n            \"go\",\n        );\n        assert!(resume_write);\n        assert_eq!(resume[6], \"afcd8926-430b-4d9a-a552-d7c6d1b900ba\");\n        assert_eq!(&resume[7..], [\"--\", \"go\"]);\n    }\n\n    #[test]\n    fn explicit_override_wins() {\n        assert_eq!(resolve_bin(Some(\"/custom/pi\")), \"/custom/pi\");\n    }\n\n    #[test]\n    fn env_used_when_no_override() {\n        let prev = std::env::var(\"PI_BIN\").ok();\n        unsafe { std::env::set_var(\"PI_BIN\", \"/env/pi\") };\n        assert_eq!(resolve_bin(None), \"/env/pi\");\n        match prev {\n            Some(v) => unsafe { std::env::set_var(\"PI_BIN\", v) },\n            None => unsafe { std::env::remove_var(\"PI_BIN\") },\n        }\n    }\n\n    #[test]\n    fn tool_start_and_text_end_emit_progress() {\n        let on = |_: Event| {};\n        let mut state = PiState::default();\n        assert!(handle_line(\n            br#\"{\"type\":\"tool_execution_start\",\"toolCallId\":\"c1\",\"toolName\":\"bash\",\"args\":{\"command\":\"ls\"}}\"#,\n            &mut state,\n        ));\n        assert_eq!(state.last_tool.as_deref(), Some(\"bash\"));\n        assert_eq!(state.phase.as_deref(), Some(\"running_tool\"));\n        assert!(handle_line(\n            br#\"{\"type\":\"message_update\",\"assistantMessageEvent\":{\"type\":\"text_end\",\"contentIndex\":0,\"content\":\"hello\"}}\"#,\n            &mut state,\n        ));\n        assert_eq!(state.last_assistant.as_deref(), Some(\"hello\"));\n        assert_eq!(state.phase.as_deref(), Some(\"responding\"));\n        assert!(!handle_line(b\"not json\", &mut state));\n        assert!(!handle_line(b\"\", &mut state));\n        // Deltas and non-assistant message_ends carry no progress of their own.\n        assert!(!handle_line(\n            br#\"{\"type\":\"message_update\",\"assistantMessageEvent\":{\"type\":\"text_delta\",\"contentIndex\":0,\"delta\":\"hi\"}}\"#,\n            &mut state,\n        ));\n        assert!(!handle_line(\n            br#\"{\"type\":\"message_end\",\"message\":{\"role\":\"user\",\"content\":[]}}\"#,\n            &mut state,\n        ));\n        let _ = on;\n    }\n\n    #[test]\n    fn spawn_failure_is_an_error_result() {\n        let spec = crate::job::tests::spec_of(|s| s.bin = \"/nonexistent/pi\".into());\n        let spawned = spawn(&spec);\n        (spawned.kill)();\n        let res = (spawned.drive)(&|_| {});\n        assert!(!res.clean_exit);\n        assert_eq!(res.is_error, Some(true));\n        assert!(!res.text.is_empty());\n    }\n\n    #[test]\n    fn real_child_runs_and_sigterm_kills_it() {\n        let spec = crate::job::tests::spec_of(|s| {\n            s.bin = \"/bin/sh\".into();\n            s.argv = vec![\"-c\".into(), \"exec sleep 30\".into()];\n        });\n        let spawned = spawn(&spec);\n        let kill = spawned.kill;\n        let t = std::thread::spawn(move || (spawned.drive)(&|_| {}));\n        std::thread::sleep(std::time::Duration::from_millis(100));\n        kill();\n        let res = t.join().unwrap();\n        assert!(!res.clean_exit);\n    }\n\n    /// Exit status is not stored in the fixtures. Only `cancelled` stops\n    /// mid-stream (SIGTERM exits 143); every other fixture ran to `agent_end`.\n    fn clean_exit_for(stem: &str) -> bool {\n        !matches!(stem, \"cancelled\")\n    }\n\n    fn approx(a: f64, b: f64) -> bool {\n        (a - b).abs() < 1e-12\n    }\n\n    #[test]\n    fn fixtures_parse_to_a_normalized_result() {\n        let dir =\n            std::path::PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"tests/fixtures/pi\");\n        let mut files: Vec<_> = std::fs::read_dir(&dir)\n            .unwrap_or_else(|e| panic!(\"{}: {e}\", dir.display()))\n            .map(|e| e.unwrap().path())\n            .filter(|p| p.extension().and_then(|s| s.to_str()) == Some(\"stdout\"))\n            .collect();\n        files.sort();\n        assert!(!files.is_empty(), \"no pi stdout fixtures\");\n\n        for path in files {\n            let stem = path.file_stem().unwrap().to_str().unwrap().to_string();\n            let stdout = std::fs::read_to_string(&path)\n                .unwrap_or_else(|e| panic!(\"{}: {e}\", path.display()));\n            let stderr_path = path.with_extension(\"stderr\");\n            let stderr = std::fs::read_to_string(&stderr_path).unwrap_or_default();\n            let clean = clean_exit_for(&stem);\n            let res = parse_stdout(&stdout, clean, &stderr);\n\n            assert_eq!(res.clean_exit, clean, \"{stem}\");\n            assert_eq!(res.stderr, stderr, \"{stem}\");\n            assert_eq!(res.duration_ms, None, \"{stem}\");\n            assert!(!res.text.contains(\"CANCELLED\"), \"{stem}\");\n            // The exit code never decides success: error-bad-model exits 0.\n            if stem == \"cancelled\" {\n                assert_eq!(res.is_error, Some(true), \"{stem}\");\n                assert_eq!(res.text, NO_RESULT, \"{stem}\");\n                assert!(res.session_id.is_none() && res.usage.is_none(), \"{stem}\");\n                assert_eq!(res.cost_usd, None, \"{stem}\");\n                continue;\n            }\n            assert!(res.session_id.is_some() && res.usage.is_some(), \"{stem}\");\n            assert_eq!(res.cost_usd.is_some(), true, \"{stem}\");\n\n            match stem.as_str() {\n                \"plain-answer\" => assert_eq!(\n                    res,\n                    BackendResult {\n                        text: \"391\\nSTATUS: DONE\".into(),\n                        session_id: Some(\"afcd8926-430b-4d9a-a552-d7c6d1b900ba\".into()),\n                        usage: Some(Usage {\n                            input_tokens: 5320.0,\n                            output_tokens: 9.0,\n                            cache_read_tokens: 0.0,\n                            cache_write_tokens: 0.0,\n                        }),\n                        cost_usd: Some(0.0005365),\n                        is_error: Some(false),\n                        duration_ms: None,\n                        clean_exit: true,\n                        stderr,\n                    },\n                    \"{stem}\"\n                ),\n                \"tool-calls-fix\" => {\n                    assert_eq!(\n                        res.text,\n                        \"Fixed `add` in `calc.py` to add its arguments. \\\n                         `python3 test_calc.py` passes.\\n\\nSTATUS: DONE\",\n                        \"{stem}\"\n                    );\n                    assert_eq!(\n                        res.session_id.as_deref(),\n                        Some(\"e04e84ae-41c0-4ed8-b9e5-de410d2f3bdf\"),\n                        \"{stem}\"\n                    );\n                    let usage = res.usage.as_ref().expect(\"usage\");\n                    assert_eq!(usage.input_tokens, 8940.0, \"{stem}\");\n                    assert_eq!(usage.output_tokens, 214.0, \"{stem}\");\n                    assert_eq!(usage.cache_read_tokens, 18432.0, \"{stem}\");\n                    assert_eq!(usage.cache_write_tokens, 0.0, \"{stem}\");\n                    assert!(approx(res.cost_usd.unwrap(), 0.00118532), \"{stem}\");\n                    assert_eq!(res.is_error, Some(false), \"{stem}\");\n                }\n                \"resume-answer\" => {\n                    assert_eq!(res.text, \"392\\nSTATUS: DONE\", \"{stem}\");\n                    assert_eq!(\n                        res.session_id.as_deref(),\n                        Some(\"afcd8926-430b-4d9a-a552-d7c6d1b900ba\"),\n                        \"{stem}\"\n                    );\n                    let usage = res.usage.as_ref().expect(\"usage\");\n                    assert_eq!(usage.input_tokens, 814.0, \"{stem}\");\n                    assert_eq!(usage.output_tokens, 33.0, \"{stem}\");\n                    assert_eq!(usage.cache_read_tokens, 4608.0, \"{stem}\");\n                    assert_eq!(usage.cache_write_tokens, 0.0, \"{stem}\");\n                    assert!(approx(res.cost_usd.unwrap(), 0.00014398), \"{stem}\");\n                    assert_eq!(res.is_error, Some(false), \"{stem}\");\n                }\n                \"error-bad-model\" => {\n                    assert_eq!(\n                        res.text,\n                        \"Codex error: The 'no-such-model' model is not supported \\\n                         when using Codex with a ChatGPT account.\",\n                        \"{stem}\"\n                    );\n                    assert_eq!(\n                        res.session_id.as_deref(),\n                        Some(\"a86b4f04-f9fe-4fe2-88f2-9c07c39dda68\"),\n                        \"{stem}\"\n                    );\n                    assert_eq!(res.is_error, Some(true), \"{stem}\");\n                    assert_eq!(res.cost_usd, Some(0.0), \"{stem}\");\n                }\n                \"needs-context\" => {\n                    assert_eq!(\n                        res.text,\n                        \"What would you like the function in `calc.py` to be called?\\\n                         \\n\\nSTATUS: NEEDS_CONTEXT\",\n                        \"{stem}\"\n                    );\n                    assert_eq!(\n                        res.session_id.as_deref(),\n                        Some(\"b7a8e40b-c58f-4468-b202-0ea1ff35dbac\"),\n                        \"{stem}\"\n                    );\n                    let usage = res.usage.as_ref().expect(\"usage\");\n                    assert_eq!(usage.input_tokens, 7912.0, \"{stem}\");\n                    assert_eq!(usage.output_tokens, 174.0, \"{stem}\");\n                    assert_eq!(usage.cache_read_tokens, 13824.0, \"{stem}\");\n                    assert_eq!(usage.cache_write_tokens, 0.0, \"{stem}\");\n                    assert!(approx(res.cost_usd.unwrap(), 0.00101644), \"{stem}\");\n                    assert_eq!(res.is_error, Some(false), \"{stem}\");\n                }\n                other => panic!(\"unexpected pi fixture: {other}\"),\n            }\n        }\n    }\n\n    #[test]\n    fn every_pi_fixture_has_progress() {\n        // tool_execution_start sets last_tool; assistant text sets last_assistant.\n        let dir =\n            std::path::PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"tests/fixtures/pi\");\n        for stem in [\"plain-answer\", \"tool-calls-fix\", \"needs-context\", \"resume-answer\"] {\n            let stdout = std::fs::read_to_string(dir.join(format!(\"{stem}.stdout\"))).unwrap();\n            let mut state = PiState::default();\n            for line in stdout.split_inclusive('\\n') {\n                handle_line(line.as_bytes(), &mut state);\n            }\n            assert!(\n                state.last_assistant.is_some(),\n                \"{stem} progress saw no assistant text\"\n            );\n            if stem == \"tool-calls-fix\" || stem == \"needs-context\" {\n                assert!(state.last_tool.is_some(), \"{stem} progress saw no tool call\");\n            }\n        }\n    }\n}\n","path":"src/backends/pi/mod.rs"}}}}
{"type":"message_end","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"rs_6abe4aa98e8a2884cc0a48cb:rs_01a0f753a65175bf8ee1dec1b008318d\",\"type\":\"reasoning\",\"status\":\"completed\",\"encrypted_content\":\"Q-PaDgFd9ERqaNPzZAu9LOWmBZV8_gEG9ZqbWgghKS1-yhdzWbGrQ3CaJ5QU7NyPPRJGheLq2bto_y4tzkopFeb_wkMLvxAj2bqbdoXtNPBNGxJKxvoczmaetu7Nqs8LV_mxqGAhBHy-TZNAe5HP_ZTXgkR0gjWnm5Upmmi-N4kLEGoZyyY1RRDyJQ66bE4MUUf1fU_Mg3M9WODxppXyar2XfdhVT6NycxbmrwIl21yaOiWrGoYOmxEedvhs77AQQa-VAo-Hiz_zJh-wf2-HsefwH8qhFvIcKg8HY-I5AYgbvRsX33mm8Z5ddyy3qFDCaIJ5UsWZ66QjCaABnFzfCipMA_7UHGKdoel8z7ETbcbqPsW-G7ojPrS_Y2o8jO-ABr2ljOuq0q-zT1Y2tXnkdIuL0Bwsu_l2MOa6VqoGFckLDNHZJZ2FheVBuUplFSelnLoL3C7Q0Jx2fUKi-gt94soKbjaV2GIoaroT3YKsuqFbi3CLt5DRQVbgp9Fu18KTlKdUZPnpriaJLvCmFRL0iZR3qFoWHRAyWjUQS8Dd1572aMpGpz9HLAEk7D1WqhCanZXpKeNqMBEJL6eX9skOVIITH51b4onrE-fDfhS_JoVpjE0QbEGA-ebkmMGkTOzhiVG_k62YeYl4ukI0-MKewILqO1AKcj58YOdwojLVFwKqE4IlGgJB-lRz4fRyQ36sNOLm95r6kS9xrVvOhvqvhzmDyL545DVcMRX_kKgc1EFyw8iIBhqcYsRgnqUHmBGICDBzea6s1ZYEp4NavXbVRDccHwOBKX6IDht4ZPJ364rt8H6k3KBHn50UzeF50DxVHmZswvaRRBGc87RroYwrcqaL9WRiS8SIqjDmTaUDMvcZPP-F_fOWPyKAMPZHt1_RqPdqRgutgQtQM0OpEqs4Xqn4nq4w-t2F8ClPxgdXxZkwO0RaBZivpDY6O3vFdWjAn-vGr6L_55eMdwWl6uQY6mK5lV3F9L3hJG7t3dGtsUI1RM0LzFntFvJRS6r7TCpsGpk1ZfHp5wpzGSw_2ak-H5mr8vAd_n0c5gX2ZMuxE4ZuhqbTTWV8FbupAf6MPirAFg2ld4WLn-oY1QQ2jyHdZ3W37UFZydoCjXoRHtUF8N7fV9gE40YtRYvXf5I21qqSYj06i2_UfenDnBWwLKyYV5TW1SxtxNdRVRDHyy4nTxvly-Ge1BfBVBAB0eEN7zkUVKSQ6dEpOqBcNMy9rPuApF-QF_kFkMIdyW9TW_vd-PaRUzhIwSSfogxlyGTCEjRkTCqhqJdibQqpmBuHGlyOHBLWdWIVv_2_TOxw09_NiSXjTeU-OvuoU2auMW157yu1PCVA0J82bzsGmx6iRSXzr60Vho_KRkdngn34dyXWtDb2vAzxjKAB-B-AKblyO6IxYP3Qt77kKVFeh2CK7A\",\"summary\":[]}"},{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"rs_6abe4aa98e8a2884cc0a48cb:rs_01a0f753a706771d91e453dda525d7e3\",\"type\":\"reasoning\",\"status\":\"completed\",\"encrypted_content\":\"Q-PaDgGDZPq6ArKOit2X6DyaScc0HuYg6fS1zGZXHHOC5P6rC1WZyoFRUegcIJTh3nHbdDDGyCgDFrsQxCwE49cuAh1M4RCGQLcLPMcu_TxOLRuzJUsdNwsab4Dh6cl3n4iXmpn1RLHjdxYzsH5qDNCJ-cgRbZegK-6RE4ZDoiWK5CAnp3isQlCMIdc79Mnvfa3cCcblVLOCWlhymNr2VZoubkzFF9IFKyrnfe8s3WSi_TNWyD6JdkYAQdA_rnSvOcPeRbEWx6_cEomlMxibgJ63cxnMbKMpzDXAQWniaTNvOuQ66exUTlwV_1TC192ftw57Ov9VU7kuzQgVRQFARMC6s9ZvWyLWAnQgjAojVG6Q0LCmA5qQWycVe7EUs8n-6WYckFbmA5RYpQo2obH7n5hSZRt39k6TcnO4MmTUjNIM01hWCElCQRl2cOeINYF29TYqLqUd8WKB9jxTiVOKCMUCIusDIpXzYNl2jParhNfD4CCUWGoG1NDb9UL8oV6sCDi2NMk6uRy6eGBSnN3EWuM0T_g-j98st4jZ1Zcnojs9dVTNhiEN_dFRMB0M1XMY55kMGXVFO3-qiTrtqkV3iJ6ZFanb4UAcVdORJmU1ukD6kuFz_55V5JPOzNAkfxVvB2H296Gp8kD5cgzpmGjFSzRLk_bEapJfvdDKsaDcgUO87yCAIoiUQDBMVueEMTXO3ev1ki1kYhDLj9A8Q58Mi_aLzeZsfDieJIn65q0lq-N0AZ7iKqrOQBFpp9FNacaef77j-KvbEE2nZcaODVpn5gVXLdm3I_eRUrWvU8RXiVhBAUU4bxcqLH0s3IotWmKKF1GgV0hBrj9qUuI5YHmVjHpuh_cs-UVCovzeZhwE2m3PllcVZBYkHDGVzMmDWEJHxVgjDMHzmxvViNGROTfqDpd-DLLfY1j8bFFBiiPaQioMoLpl20onCHJu8XTpZ19rHOCtM4OzTF3yEpo7ShqpzWYtIjSvt3locj0Q_NEL51Dm49vH27M9HkQS2Ff0tOe-GOPVdT6Z4BE7z7IYG-9urMr5TKa1JrVVnqZ587xOrxztKFthpUhPv0AA5dg-qM95x87oDCSGx_hPOgulhOm64-y2WyC3_G2csktETLC2F3COY9jNiOvIphMvi-X-fxxiBvkcswpq2lSRVyViFCJtqBLiO0OEdlsDIBA8hmOIOJ8kOXNfDxqLXB-B-zjcoCZiDkKUgcOAl0a-xqcZmQTCBTsARQRg6LHgw09X9CxDXYeXAJbM6VtAzDgmVVEsX29oUHik7RNBwyDkzb87zea0FeyKKoje0KXyfFrboQGB06LGNIaGI9SBsUDLMFbd7LzpivWtrEzIrr6YjsCUb-bpWLyG4MqIJieHaR_U6mYq6peVS3mMMNNAwkLXqgMM0SLFt8n5J06rwXi_Tdd4Ew\",\"summary\":[]}"},{"type":"toolCall","id":"call_01a0f753a760751884fb2945e8d5a839|fc_01a0f753a760751884fb2945e8d5a839","name":"write","arguments":{"content":"//! The pi backend: binary, argv, spawn, and stream-json parsing.\n//!\n//! `pi -p --mode json` prints one JSON object per line. The `session` header\n//! carries the id, `agent_end.messages` holds the final turn, and usage/cost\n//! accumulate over assistant `message_end` events. pi exits 0 even on errors,\n//! so success comes from the last assistant message's `stopReason`, never the\n//! exit code.\n\npub(crate) mod doctor;\n\nuse super::types::{BackendResult, Event, EventFn, ProgressSnapshotRaw, Spawned};\nuse crate::types::{Capability, JobSpec, Usage};\nuse std::sync::atomic::Ordering;\n\nconst NO_RESULT: &str = \"no result line\";\n\npub(crate) fn resolve_bin(r#override: Option<&str>) -> String {\n    if let Some(o) = r#override.filter(|s| !s.is_empty()) {\n        return o.to_string();\n    }\n    if let Ok(env) = std::env::var(\"PI_BIN\")\n        && !env.is_empty()\n    {\n        return env;\n    }\n    if let Ok(out) = std::process::Command::new(\"which\").arg(\"pi\").output()\n        && out.status.success()\n    {\n        let found = String::from_utf8_lossy(&out.stdout).trim().to_string();\n        if !found.is_empty() {\n            return found;\n        }\n    }\n    crate::util::homedir()\n        .join(\".local/bin/pi\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub(crate) fn argv(\n    model: &str,\n    _capability: Capability,\n    session: Option<&str>,\n    prompt: &str,\n) -> (Vec<String>, bool) {\n    // pi has no read-only mode, so the capability maps to no flag; `run` and\n    // `resume` reject read-only pi jobs before launch. The session id is chosen\n    // before launch: resume passes the stored id, a fresh run mints one (pi\n    // creates the session if absent, continues it if present).\n    let session = session\n        .map(str::to_string)\n        .unwrap_or_else(crate::util::random_uuid);\n    let args = vec![\n        \"-p\".into(),\n        \"--mode\".into(),\n        \"json\".into(),\n        \"--model\".into(),\n        model.to_string(),\n        \"--session-id\".into(),\n        session,\n        \"--\".into(),\n        prompt.to_string(),\n    ];\n    (args, true)\n}\n\npub(crate) fn spawn(spec: &JobSpec) -> Spawned {\n    let started = match super::start_child(spec) {\n        Ok(s) => s,\n        Err(msg) => return super::spawn_failed(&msg),\n    };\n    let pid = started.pid;\n    let reaped = started.reaped;\n    let reaped_k = std::sync::Arc::clone(&reaped);\n    let stdout = started.stdout;\n    let stderr = started.stderr;\n    let mut child = started.child;\n    Spawned {\n        kill: super::killer(pid, reaped_k),\n        drive: Box::new(move |on| {\n            let mut state = PiState::default();\n            let pumped = super::pump(\n                stdout,\n                stderr,\n                on,\n                move || {\n                    let clean = child.wait().map(|s| s.success()).unwrap_or(false);\n                    reaped.store(true, Ordering::SeqCst);\n                    clean\n                },\n                |line| {\n                    if handle_line(line, &mut state) {\n                        on(Event::Progress(ProgressSnapshotRaw {\n                            last_tool: state.last_tool.clone(),\n                            tokens_so_far: 0.0,\n                            last_assistant: state.last_assistant.clone(),\n                            files_touched: Vec::new(),\n                            phase: state.phase.clone(),\n                        }));\n                    }\n                },\n            );\n            finish(state, pumped.clean_exit, &pumped.stderr)\n        }),\n    }\n}\n\n/// Pure parse of a finished `pi -p --mode json` stdout. The spawn driver uses\n/// [`finish`] too.\npub fn parse_stdout(stdout: &str, clean_exit: bool, stderr: &str) -> BackendResult {\n    let mut state = PiState::default();\n    for line in stdout.split_inclusive('\\n') {\n        handle_line(line.as_bytes(), &mut state);\n    }\n    finish(state, clean_exit, stderr)\n}\n\n#[derive(Debug, Default)]\nstruct PiState {\n    session_id: Option<String>,\n    agent_end: Option<serde_json::Value>,\n    last_assistant_end: Option<serde_json::Value>,\n    input: f64,\n    output: f64,\n    cache_read: f64,\n    cache_write: f64,\n    cost: f64,\n    saw_assistant_end: bool,\n    last_tool: Option<String>,\n    last_assistant: Option<String>,\n    phase: Option<String>,\n}\n\n/// Fold one stdout line into the state. Unparseable lines are ignored.\n/// Returns whether a progress event should fire.\nfn handle_line(line: &[u8], state: &mut PiState) -> bool {\n    let trimmed = String::from_utf8_lossy(line).trim().to_string();\n    if trimmed.is_empty() {\n        return false;\n    }\n    let ev: serde_json::Value = match serde_json::from_str(&trimmed) {\n        Ok(v) => v,\n        Err(_) => return false,\n    };\n    if ev.get(\"type\").and_then(|t| t.as_str()).is_none() {\n        return false;\n    }\n    match ev.get(\"type\").and_then(|t| t.as_str()) {\n        Some(\"session\") => {\n            if let Some(id) = ev.get(\"id\").and_then(|i| i.as_str()) {\n                state.session_id = Some(id.to_string());\n            }\n            false\n        }\n        Some(\"tool_execution_start\") => {\n            if let Some(tool) = ev.get(\"toolName\").and_then(|t| t.as_str()) {\n                state.last_tool = Some(tool.to_string());\n            }\n            state.phase = Some(\"running_tool\".into());\n            true\n        }\n        Some(\"message_update\") => {\n            let end = ev\n                .get(\"assistantMessageEvent\")\n                .filter(|e| e.get(\"type\").and_then(|t| t.as_str()) == Some(\"text_end\"))\n                .and_then(|e| e.get(\"content\"))\n                .and_then(|c| c.as_str());\n            if let Some(text) = end {\n                let truncated: String = text.chars().take(200).collect();\n                state.last_assistant = Some(truncated);\n                state.phase = Some(\"responding\".into());\n                return true;\n            }\n            false\n        }\n        Some(\"message_end\") => {\n            let message = match ev.get(\"message\") {\n                Some(m) if m.get(\"role\").and_then(|r| r.as_str()) == Some(\"assistant\") => m,\n                _ => return false,\n            };\n            let usage = message.get(\"usage\");\n            state.input += usage\n                .and_then(|u| u.get(\"input\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.output += usage\n                .and_then(|u| u.get(\"output\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.cache_read += usage\n                .and_then(|u| u.get(\"cacheRead\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.cache_write += usage\n                .and_then(|u| u.get(\"cacheWrite\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.cost += usage\n                .and_then(|u| u.get(\"cost\"))\n                .and_then(|c| c.get(\"total\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.saw_assistant_end = true;\n            state.last_assistant_end = Some(message.clone());\n            true\n        }\n        Some(\"agent_end\") => {\n            state.agent_end = Some(ev);\n            false\n        }\n        _ => false,\n    }\n}\n\n/// Concatenated `text` parts of one assistant message.\nfn assistant_text(message: &serde_json::Value) -> String {\n    message\n        .get(\"content\")\n        .and_then(|c| c.as_array())\n        .map(|parts| {\n            parts\n                .iter()\n                .filter(|p| p.get(\"type\").and_then(|t| t.as_str()) == Some(\"text\"))\n                .filter_map(|p| p.get(\"text\").and_then(|t| t.as_str()))\n                .collect::<Vec<_>>()\n                .join(\"\")\n        })\n        .unwrap_or_default()\n}\n\n/// Turn the terminal `agent_end` (or the lack of one) into the normalized result.\n/// The exit code never decides success: pi exits 0 on errors. CANCELLED is the\n/// supervisor's status, never ours.\nfn finish(state: PiState, clean_exit: bool, stderr: &str) -> BackendResult {\n    let Some(end) = state.agent_end else {\n        return BackendResult {\n            text: NO_RESULT.to_string(),\n            is_error: Some(true),\n            clean_exit,\n            stderr: stderr.to_string(),\n            ..Default::default()\n        };\n    };\n    let assistant = end\n        .get(\"messages\")\n        .and_then(|m| m.as_array())\n        .and_then(|msgs| {\n            msgs.iter()\n                .rev()\n                .find(|m| m.get(\"role\").and_then(|r| r.as_str()) == Some(\"assistant\"))\n        });\n    let (text, is_error) = match assistant {\n        Some(m)\n            if m.get(\"stopReason\").and_then(|s| s.as_str()) == Some(\"error\") =>\n        {\n            (\n                m.get(\"errorMessage\")\n                    .and_then(|e| e.as_str())\n                    .unwrap_or_default()\n                    .to_string(),\n                Some(true),\n            )\n        }\n        Some(m) => (assistant_text(m), Some(false)),\n        // No assistant turn in the transcript; fall back to its last message.\n        None => (\n            state\n                .last_assistant_end\n                .as_ref()\n                .map(assistant_text)\n                .unwrap_or_default(),\n            Some(false),\n        ),\n    };\n    BackendResult {\n        text,\n        session_id: state.session_id,\n        usage: state.saw_assistant_end.then(|| Usage {\n            input_tokens: state.input,\n            output_tokens: state.output,\n            cache_read_tokens: state.cache_read,\n            cache_write_tokens: state.cache_write,\n        }),\n        cost_usd: state.saw_assistant_end.then_some(state.cost),\n        is_error,\n        duration_ms: None,\n        clean_exit,\n        stderr: stderr.to_string(),\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn fresh_run_mints_a_session_id_and_resume_reuses_it() {\n        let (fresh, is_write) = argv(\"openai-codex/gpt-6-luna\", Capability::Ask, None, \"hi\");\n        assert!(is_write);\n        assert_eq!(\n            &fresh[..6],\n            [\n                \"-p\",\n                \"--mode\",\n                \"json\",\n                \"--model\",\n                \"openai-codex/gpt-6-luna\",\n                \"--session-id\",\n            ]\n        );\n        let minted = &fresh[6];\n        assert_eq!(minted.len(), 36, \"{fresh:?}\");\n        assert!(\n            minted.chars().all(|c| c.is_ascii_lowercase()\n                || c.is_ascii_digit()\n                || c == '-'),\n            \"{fresh:?}\"\n        );\n        assert_eq!(&fresh[7..], [\"--\", \"hi\"]);\n        // A second fresh run mints a different id.\n        let (other, _) = argv(\"openai-codex/gpt-6-luna\", Capability::Ask, None, \"hi\");\n        assert_ne!(fresh[6], other[6]);\n\n        let (resume, resume_write) = argv(\n            \"openai-codex/gpt-6-luna\",\n            Capability::WriteUnsandboxed,\n            Some(\"afcd8926-430b-4d9a-a552-d7c6d1b900ba\"),\n            \"go\",\n        );\n        assert!(resume_write);\n        assert_eq!(resume[6], \"afcd8926-430b-4d9a-a552-d7c6d1b900ba\");\n        assert_eq!(&resume[7..], [\"--\", \"go\"]);\n    }\n\n    #[test]\n    fn explicit_override_wins() {\n        assert_eq!(resolve_bin(Some(\"/custom/pi\")), \"/custom/pi\");\n    }\n\n    #[test]\n    fn env_used_when_no_override() {\n        let prev = std::env::var(\"PI_BIN\").ok();\n        unsafe { std::env::set_var(\"PI_BIN\", \"/env/pi\") };\n        assert_eq!(resolve_bin(None), \"/env/pi\");\n        match prev {\n            Some(v) => unsafe { std::env::set_var(\"PI_BIN\", v) },\n            None => unsafe { std::env::remove_var(\"PI_BIN\") },\n        }\n    }\n\n    #[test]\n    fn tool_start_and_text_end_emit_progress() {\n        let on = |_: Event| {};\n        let mut state = PiState::default();\n        assert!(handle_line(\n            br#\"{\"type\":\"tool_execution_start\",\"toolCallId\":\"c1\",\"toolName\":\"bash\",\"args\":{\"command\":\"ls\"}}\"#,\n            &mut state,\n        ));\n        assert_eq!(state.last_tool.as_deref(), Some(\"bash\"));\n        assert_eq!(state.phase.as_deref(), Some(\"running_tool\"));\n        assert!(handle_line(\n            br#\"{\"type\":\"message_update\",\"assistantMessageEvent\":{\"type\":\"text_end\",\"contentIndex\":0,\"content\":\"hello\"}}\"#,\n            &mut state,\n        ));\n        assert_eq!(state.last_assistant.as_deref(), Some(\"hello\"));\n        assert_eq!(state.phase.as_deref(), Some(\"responding\"));\n        assert!(!handle_line(b\"not json\", &mut state));\n        assert!(!handle_line(b\"\", &mut state));\n        // Deltas and non-assistant message_ends carry no progress of their own.\n        assert!(!handle_line(\n            br#\"{\"type\":\"message_update\",\"assistantMessageEvent\":{\"type\":\"text_delta\",\"contentIndex\":0,\"delta\":\"hi\"}}\"#,\n            &mut state,\n        ));\n        assert!(!handle_line(\n            br#\"{\"type\":\"message_end\",\"message\":{\"role\":\"user\",\"content\":[]}}\"#,\n            &mut state,\n        ));\n        let _ = on;\n    }\n\n    #[test]\n    fn spawn_failure_is_an_error_result() {\n        let spec = crate::job::tests::spec_of(|s| s.bin = \"/nonexistent/pi\".into());\n        let spawned = spawn(&spec);\n        (spawned.kill)();\n        let res = (spawned.drive)(&|_| {});\n        assert!(!res.clean_exit);\n        assert_eq!(res.is_error, Some(true));\n        assert!(!res.text.is_empty());\n    }\n\n    #[test]\n    fn real_child_runs_and_sigterm_kills_it() {\n        let spec = crate::job::tests::spec_of(|s| {\n            s.bin = \"/bin/sh\".into();\n            s.argv = vec![\"-c\".into(), \"exec sleep 30\".into()];\n        });\n        let spawned = spawn(&spec);\n        let kill = spawned.kill;\n        let t = std::thread::spawn(move || (spawned.drive)(&|_| {}));\n        std::thread::sleep(std::time::Duration::from_millis(100));\n        kill();\n        let res = t.join().unwrap();\n        assert!(!res.clean_exit);\n    }\n\n    /// Exit status is not stored in the fixtures. Only `cancelled` stops\n    /// mid-stream (SIGTERM exits 143); every other fixture ran to `agent_end`.\n    fn clean_exit_for(stem: &str) -> bool {\n        !matches!(stem, \"cancelled\")\n    }\n\n    fn approx(a: f64, b: f64) -> bool {\n        (a - b).abs() < 1e-12\n    }\n\n    #[test]\n    fn fixtures_parse_to_a_normalized_result() {\n        let dir =\n            std::path::PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"tests/fixtures/pi\");\n        let mut files: Vec<_> = std::fs::read_dir(&dir)\n            .unwrap_or_else(|e| panic!(\"{}: {e}\", dir.display()))\n            .map(|e| e.unwrap().path())\n            .filter(|p| p.extension().and_then(|s| s.to_str()) == Some(\"stdout\"))\n            .collect();\n        files.sort();\n        assert!(!files.is_empty(), \"no pi stdout fixtures\");\n\n        for path in files {\n            let stem = path.file_stem().unwrap().to_str().unwrap().to_string();\n            let stdout = std::fs::read_to_string(&path)\n                .unwrap_or_else(|e| panic!(\"{}: {e}\", path.display()));\n            let stderr_path = path.with_extension(\"stderr\");\n            let stderr = std::fs::read_to_string(&stderr_path).unwrap_or_default();\n            let clean = clean_exit_for(&stem);\n            let res = parse_stdout(&stdout, clean, &stderr);\n\n            assert_eq!(res.clean_exit, clean, \"{stem}\");\n            assert_eq!(res.stderr, stderr, \"{stem}\");\n            assert_eq!(res.duration_ms, None, \"{stem}\");\n            assert!(!res.text.contains(\"CANCELLED\"), \"{stem}\");\n            // The exit code never decides success: error-bad-model exits 0.\n            if stem == \"cancelled\" {\n                assert_eq!(res.is_error, Some(true), \"{stem}\");\n                assert_eq!(res.text, NO_RESULT, \"{stem}\");\n                assert!(res.session_id.is_none() && res.usage.is_none(), \"{stem}\");\n                assert_eq!(res.cost_usd, None, \"{stem}\");\n                continue;\n            }\n            assert!(res.session_id.is_some() && res.usage.is_some(), \"{stem}\");\n            assert_eq!(res.cost_usd.is_some(), true, \"{stem}\");\n\n            match stem.as_str() {\n                \"plain-answer\" => assert_eq!(\n                    res,\n                    BackendResult {\n                        text: \"391\\nSTATUS: DONE\".into(),\n                        session_id: Some(\"afcd8926-430b-4d9a-a552-d7c6d1b900ba\".into()),\n                        usage: Some(Usage {\n                            input_tokens: 5320.0,\n                            output_tokens: 9.0,\n                            cache_read_tokens: 0.0,\n                            cache_write_tokens: 0.0,\n                        }),\n                        cost_usd: Some(0.0005365),\n                        is_error: Some(false),\n                        duration_ms: None,\n                        clean_exit: true,\n                        stderr,\n                    },\n                    \"{stem}\"\n                ),\n                \"tool-calls-fix\" => {\n                    assert_eq!(\n                        res.text,\n                        \"Fixed `add` in `calc.py` to add its arguments. \\\n                         `python3 test_calc.py` passes.\\n\\nSTATUS: DONE\",\n                        \"{stem}\"\n                    );\n                    assert_eq!(\n                        res.session_id.as_deref(),\n                        Some(\"e04e84ae-41c0-4ed8-b9e5-de410d2f3bdf\"),\n                        \"{stem}\"\n                    );\n                    let usage = res.usage.as_ref().expect(\"usage\");\n                    assert_eq!(usage.input_tokens, 8940.0, \"{stem}\");\n                    assert_eq!(usage.output_tokens, 214.0, \"{stem}\");\n                    assert_eq!(usage.cache_read_tokens, 18432.0, \"{stem}\");\n                    assert_eq!(usage.cache_write_tokens, 0.0, \"{stem}\");\n                    assert!(approx(res.cost_usd.unwrap(), 0.00118532), \"{stem}\");\n                    assert_eq!(res.is_error, Some(false), \"{stem}\");\n                }\n                \"resume-answer\" => {\n                    assert_eq!(res.text, \"392\\nSTATUS: DONE\", \"{stem}\");\n                    assert_eq!(\n                        res.session_id.as_deref(),\n                        Some(\"afcd8926-430b-4d9a-a552-d7c6d1b900ba\"),\n                        \"{stem}\"\n                    );\n                    let usage = res.usage.as_ref().expect(\"usage\");\n                    assert_eq!(usage.input_tokens, 814.0, \"{stem}\");\n                    assert_eq!(usage.output_tokens, 33.0, \"{stem}\");\n                    assert_eq!(usage.cache_read_tokens, 4608.0, \"{stem}\");\n                    assert_eq!(usage.cache_write_tokens, 0.0, \"{stem}\");\n                    assert!(approx(res.cost_usd.unwrap(), 0.00014398), \"{stem}\");\n                    assert_eq!(res.is_error, Some(false), \"{stem}\");\n                }\n                \"error-bad-model\" => {\n                    assert_eq!(\n                        res.text,\n                        \"Codex error: The 'no-such-model' model is not supported \\\n                         when using Codex with a ChatGPT account.\",\n                        \"{stem}\"\n                    );\n                    assert_eq!(\n                        res.session_id.as_deref(),\n                        Some(\"a86b4f04-f9fe-4fe2-88f2-9c07c39dda68\"),\n                        \"{stem}\"\n                    );\n                    assert_eq!(res.is_error, Some(true), \"{stem}\");\n                    assert_eq!(res.cost_usd, Some(0.0), \"{stem}\");\n                }\n                \"needs-context\" => {\n                    assert_eq!(\n                        res.text,\n                        \"What would you like the function in `calc.py` to be called?\\\n                         \\n\\nSTATUS: NEEDS_CONTEXT\",\n                        \"{stem}\"\n                    );\n                    assert_eq!(\n                        res.session_id.as_deref(),\n                        Some(\"b7a8e40b-c58f-4468-b202-0ea1ff35dbac\"),\n                        \"{stem}\"\n                    );\n                    let usage = res.usage.as_ref().expect(\"usage\");\n                    assert_eq!(usage.input_tokens, 7912.0, \"{stem}\");\n                    assert_eq!(usage.output_tokens, 174.0, \"{stem}\");\n                    assert_eq!(usage.cache_read_tokens, 13824.0, \"{stem}\");\n                    assert_eq!(usage.cache_write_tokens, 0.0, \"{stem}\");\n                    assert!(approx(res.cost_usd.unwrap(), 0.00101644), \"{stem}\");\n                    assert_eq!(res.is_error, Some(false), \"{stem}\");\n                }\n                other => panic!(\"unexpected pi fixture: {other}\"),\n            }\n        }\n    }\n\n    #[test]\n    fn every_pi_fixture_has_progress() {\n        // tool_execution_start sets last_tool; assistant text sets last_assistant.\n        let dir =\n            std::path::PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"tests/fixtures/pi\");\n        for stem in [\"plain-answer\", \"tool-calls-fix\", \"needs-context\", \"resume-answer\"] {\n            let stdout = std::fs::read_to_string(dir.join(format!(\"{stem}.stdout\"))).unwrap();\n            let mut state = PiState::default();\n            for line in stdout.split_inclusive('\\n') {\n                handle_line(line.as_bytes(), &mut state);\n            }\n            assert!(\n                state.last_assistant.is_some(),\n                \"{stem} progress saw no assistant text\"\n            );\n            if stem == \"tool-calls-fix\" || stem == \"needs-context\" {\n                assert!(state.last_tool.is_some(), \"{stem} progress saw no tool call\");\n            }\n        }\n    }\n}\n","path":"src/backends/pi/mod.rs"}}],"api":"openai-responses","provider":"opencode-go","model":"muse-spark-1.3-contributor","usage":{"input":1037,"output":5171,"cacheRead":102385,"cacheWrite":0,"reasoning":12,"totalTokens":108593,"cost":{"input":0.00010370000000000001,"output":0.0010342,"cacheRead":0.00020477,"cacheWrite":0,"total":0.00134267}},"stopReason":"toolUse","timestamp":1790855848054,"responseId":"resp_6abe4aa98e8a2884cc0a48cb","rawStopReason":"completed","thinkingLevel":"high"}}
{"type":"tool_execution_start","toolCallId":"call_01a0f753a760751884fb2945e8d5a839|fc_01a0f753a760751884fb2945e8d5a839","toolName":"write","args":{"content":"//! The pi backend: binary, argv, spawn, and stream-json parsing.\n//!\n//! `pi -p --mode json` prints one JSON object per line. The `session` header\n//! carries the id, `agent_end.messages` holds the final turn, and usage/cost\n//! accumulate over assistant `message_end` events. pi exits 0 even on errors,\n//! so success comes from the last assistant message's `stopReason`, never the\n//! exit code.\n\npub(crate) mod doctor;\n\nuse super::types::{BackendResult, Event, EventFn, ProgressSnapshotRaw, Spawned};\nuse crate::types::{Capability, JobSpec, Usage};\nuse std::sync::atomic::Ordering;\n\nconst NO_RESULT: &str = \"no result line\";\n\npub(crate) fn resolve_bin(r#override: Option<&str>) -> String {\n    if let Some(o) = r#override.filter(|s| !s.is_empty()) {\n        return o.to_string();\n    }\n    if let Ok(env) = std::env::var(\"PI_BIN\")\n        && !env.is_empty()\n    {\n        return env;\n    }\n    if let Ok(out) = std::process::Command::new(\"which\").arg(\"pi\").output()\n        && out.status.success()\n    {\n        let found = String::from_utf8_lossy(&out.stdout).trim().to_string();\n        if !found.is_empty() {\n            return found;\n        }\n    }\n    crate::util::homedir()\n        .join(\".local/bin/pi\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub(crate) fn argv(\n    model: &str,\n    _capability: Capability,\n    session: Option<&str>,\n    prompt: &str,\n) -> (Vec<String>, bool) {\n    // pi has no read-only mode, so the capability maps to no flag; `run` and\n    // `resume` reject read-only pi jobs before launch. The session id is chosen\n    // before launch: resume passes the stored id, a fresh run mints one (pi\n    // creates the session if absent, continues it if present).\n    let session = session\n        .map(str::to_string)\n        .unwrap_or_else(crate::util::random_uuid);\n    let args = vec![\n        \"-p\".into(),\n        \"--mode\".into(),\n        \"json\".into(),\n        \"--model\".into(),\n        model.to_string(),\n        \"--session-id\".into(),\n        session,\n        \"--\".into(),\n        prompt.to_string(),\n    ];\n    (args, true)\n}\n\npub(crate) fn spawn(spec: &JobSpec) -> Spawned {\n    let started = match super::start_child(spec) {\n        Ok(s) => s,\n        Err(msg) => return super::spawn_failed(&msg),\n    };\n    let pid = started.pid;\n    let reaped = started.reaped;\n    let reaped_k = std::sync::Arc::clone(&reaped);\n    let stdout = started.stdout;\n    let stderr = started.stderr;\n    let mut child = started.child;\n    Spawned {\n        kill: super::killer(pid, reaped_k),\n        drive: Box::new(move |on| {\n            let mut state = PiState::default();\n            let pumped = super::pump(\n                stdout,\n                stderr,\n                on,\n                move || {\n                    let clean = child.wait().map(|s| s.success()).unwrap_or(false);\n                    reaped.store(true, Ordering::SeqCst);\n                    clean\n                },\n                |line| {\n                    if handle_line(line, &mut state) {\n                        on(Event::Progress(ProgressSnapshotRaw {\n                            last_tool: state.last_tool.clone(),\n                            tokens_so_far: 0.0,\n                            last_assistant: state.last_assistant.clone(),\n                            files_touched: Vec::new(),\n                            phase: state.phase.clone(),\n                        }));\n                    }\n                },\n            );\n            finish(state, pumped.clean_exit, &pumped.stderr)\n        }),\n    }\n}\n\n/// Pure parse of a finished `pi -p --mode json` stdout. The spawn driver uses\n/// [`finish`] too.\npub fn parse_stdout(stdout: &str, clean_exit: bool, stderr: &str) -> BackendResult {\n    let mut state = PiState::default();\n    for line in stdout.split_inclusive('\\n') {\n        handle_line(line.as_bytes(), &mut state);\n    }\n    finish(state, clean_exit, stderr)\n}\n\n#[derive(Debug, Default)]\nstruct PiState {\n    session_id: Option<String>,\n    agent_end: Option<serde_json::Value>,\n    last_assistant_end: Option<serde_json::Value>,\n    input: f64,\n    output: f64,\n    cache_read: f64,\n    cache_write: f64,\n    cost: f64,\n    saw_assistant_end: bool,\n    last_tool: Option<String>,\n    last_assistant: Option<String>,\n    phase: Option<String>,\n}\n\n/// Fold one stdout line into the state. Unparseable lines are ignored.\n/// Returns whether a progress event should fire.\nfn handle_line(line: &[u8], state: &mut PiState) -> bool {\n    let trimmed = String::from_utf8_lossy(line).trim().to_string();\n    if trimmed.is_empty() {\n        return false;\n    }\n    let ev: serde_json::Value = match serde_json::from_str(&trimmed) {\n        Ok(v) => v,\n        Err(_) => return false,\n    };\n    if ev.get(\"type\").and_then(|t| t.as_str()).is_none() {\n        return false;\n    }\n    match ev.get(\"type\").and_then(|t| t.as_str()) {\n        Some(\"session\") => {\n            if let Some(id) = ev.get(\"id\").and_then(|i| i.as_str()) {\n                state.session_id = Some(id.to_string());\n            }\n            false\n        }\n        Some(\"tool_execution_start\") => {\n            if let Some(tool) = ev.get(\"toolName\").and_then(|t| t.as_str()) {\n                state.last_tool = Some(tool.to_string());\n            }\n            state.phase = Some(\"running_tool\".into());\n            true\n        }\n        Some(\"message_update\") => {\n            let end = ev\n                .get(\"assistantMessageEvent\")\n                .filter(|e| e.get(\"type\").and_then(|t| t.as_str()) == Some(\"text_end\"))\n                .and_then(|e| e.get(\"content\"))\n                .and_then(|c| c.as_str());\n            if let Some(text) = end {\n                let truncated: String = text.chars().take(200).collect();\n                state.last_assistant = Some(truncated);\n                state.phase = Some(\"responding\".into());\n                return true;\n            }\n            false\n        }\n        Some(\"message_end\") => {\n            let message = match ev.get(\"message\") {\n                Some(m) if m.get(\"role\").and_then(|r| r.as_str()) == Some(\"assistant\") => m,\n                _ => return false,\n            };\n            let usage = message.get(\"usage\");\n            state.input += usage\n                .and_then(|u| u.get(\"input\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.output += usage\n                .and_then(|u| u.get(\"output\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.cache_read += usage\n                .and_then(|u| u.get(\"cacheRead\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.cache_write += usage\n                .and_then(|u| u.get(\"cacheWrite\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.cost += usage\n                .and_then(|u| u.get(\"cost\"))\n                .and_then(|c| c.get(\"total\"))\n                .and_then(|n| n.as_f64())\n                .filter(|n| n.is_finite())\n                .unwrap_or(0.0);\n            state.saw_assistant_end = true;\n            state.last_assistant_end = Some(message.clone());\n            true\n        }\n        Some(\"agent_end\") => {\n            state.agent_end = Some(ev);\n            false\n        }\n        _ => false,\n    }\n}\n\n/// Concatenated `text` parts of one assistant message.\nfn assistant_text(message: &serde_json::Value) -> String {\n    message\n        .get(\"content\")\n        .and_then(|c| c.as_array())\n        .map(|parts| {\n            parts\n                .iter()\n                .filter(|p| p.get(\"type\").and_then(|t| t.as_str()) == Some(\"text\"))\n                .filter_map(|p| p.get(\"text\").and_then(|t| t.as_str()))\n                .collect::<Vec<_>>()\n                .join(\"\")\n        })\n        .unwrap_or_default()\n}\n\n/// Turn the terminal `agent_end` (or the lack of one) into the normalized result.\n/// The exit code never decides success: pi exits 0 on errors. CANCELLED is the\n/// supervisor's status, never ours.\nfn finish(state: PiState, clean_exit: bool, stderr: &str) -> BackendResult {\n    let Some(end) = state.agent_end else {\n        return BackendResult {\n            text: NO_RESULT.to_string(),\n            is_error: Some(true),\n            clean_exit,\n            stderr: stderr.to_string(),\n            ..Default::default()\n        };\n    };\n    let assistant = end\n        .get(\"messages\")\n        .and_then(|m| m.as_array())\n        .and_then(|msgs| {\n            msgs.iter()\n                .rev()\n                .find(|m| m.get(\"role\").and_then(|r| r.as_str()) == Some(\"assistant\"))\n        });\n    let (text, is_error) = match assistant {\n        Some(m)\n            if m.get(\"stopReason\").and_then(|s| s.as_str()) == Some(\"error\") =>\n        {\n            (\n                m.get(\"errorMessage\")\n                    .and_then(|e| e.as_str())\n                    .unwrap_or_default()\n                    .to_string(),\n                Some(true),\n            )\n        }\n        Some(m) => (assistant_text(m), Some(false)),\n        // No assistant turn in the transcript; fall back to its last message.\n        None => (\n            state\n                .last_assistant_end\n                .as_ref()\n                .map(assistant_text)\n                .unwrap_or_default(),\n            Some(false),\n        ),\n    };\n    BackendResult {\n        text,\n        session_id: state.session_id,\n        usage: state.saw_assistant_end.then(|| Usage {\n            input_tokens: state.input,\n            output_tokens: state.output,\n            cache_read_tokens: state.cache_read,\n            cache_write_tokens: state.cache_write,\n        }),\n        cost_usd: state.saw_assistant_end.then_some(state.cost),\n        is_error,\n        duration_ms: None,\n        clean_exit,\n        stderr: stderr.to_string(),\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn fresh_run_mints_a_session_id_and_resume_reuses_it() {\n        let (fresh, is_write) = argv(\"openai-codex/gpt-6-luna\", Capability::Ask, None, \"hi\");\n        assert!(is_write);\n        assert_eq!(\n            &fresh[..6],\n            [\n                \"-p\",\n                \"--mode\",\n                \"json\",\n                \"--model\",\n                \"openai-codex/gpt-6-luna\",\n                \"--session-id\",\n            ]\n        );\n        let minted = &fresh[6];\n        assert_eq!(minted.len(), 36, \"{fresh:?}\");\n        assert!(\n            minted.chars().all(|c| c.is_ascii_lowercase()\n                || c.is_ascii_digit()\n                || c == '-'),\n            \"{fresh:?}\"\n        );\n        assert_eq!(&fresh[7..], [\"--\", \"hi\"]);\n        // A second fresh run mints a different id.\n        let (other, _) = argv(\"openai-codex/gpt-6-luna\", Capability::Ask, None, \"hi\");\n        assert_ne!(fresh[6], other[6]);\n\n        let (resume, resume_write) = argv(\n            \"openai-codex/gpt-6-luna\",\n            Capability::WriteUnsandboxed,\n            Some(\"afcd8926-430b-4d9a-a552-d7c6d1b900ba\"),\n            \"go\",\n        );\n        assert!(resume_write);\n        assert_eq!(resume[6], \"afcd8926-430b-4d9a-a552-d7c6d1b900ba\");\n        assert_eq!(&resume[7..], [\"--\", \"go\"]);\n    }\n\n    #[test]\n    fn explicit_override_wins() {\n        assert_eq!(resolve_bin(Some(\"/custom/pi\")), \"/custom/pi\");\n    }\n\n    #[test]\n    fn env_used_when_no_override() {\n        let prev = std::env::var(\"PI_BIN\").ok();\n        unsafe { std::env::set_var(\"PI_BIN\", \"/env/pi\") };\n        assert_eq!(resolve_bin(None), \"/env/pi\");\n        match prev {\n            Some(v) => unsafe { std::env::set_var(\"PI_BIN\", v) },\n            None => unsafe { std::env::remove_var(\"PI_BIN\") },\n        }\n    }\n\n    #[test]\n    fn tool_start_and_text_end_emit_progress() {\n        let on = |_: Event| {};\n        let mut state = PiState::default();\n        assert!(handle_line(\n            br#\"{\"type\":\"tool_execution_start\",\"toolCallId\":\"c1\",\"toolName\":\"bash\",\"args\":{\"command\":\"ls\"}}\"#,\n            &mut state,\n        ));\n        assert_eq!(state.last_tool.as_deref(), Some(\"bash\"));\n        assert_eq!(state.phase.as_deref(), Some(\"running_tool\"));\n        assert!(handle_line(\n            br#\"{\"type\":\"message_update\",\"assistantMessageEvent\":{\"type\":\"text_end\",\"contentIndex\":0,\"content\":\"hello\"}}\"#,\n            &mut state,\n        ));\n        assert_eq!(state.last_assistant.as_deref(), Some(\"hello\"));\n        assert_eq!(state.phase.as_deref(), Some(\"responding\"));\n        assert!(!handle_line(b\"not json\", &mut state));\n        assert!(!handle_line(b\"\", &mut state));\n        // Deltas and non-assistant message_ends carry no progress of their own.\n        assert!(!handle_line(\n            br#\"{\"type\":\"message_update\",\"assistantMessageEvent\":{\"type\":\"text_delta\",\"contentIndex\":0,\"delta\":\"hi\"}}\"#,\n            &mut state,\n        ));\n        assert!(!handle_line(\n            br#\"{\"type\":\"message_end\",\"message\":{\"role\":\"user\",\"content\":[]}}\"#,\n            &mut state,\n        ));\n        let _ = on;\n    }\n\n    #[test]\n    fn spawn_failure_is_an_error_result() {\n        let spec = crate::job::tests::spec_of(|s| s.bin = \"/nonexistent/pi\".into());\n        let spawned = spawn(&spec);\n        (spawned.kill)();\n        let res = (spawned.drive)(&|_| {});\n        assert!(!res.clean_exit);\n        assert_eq!(res.is_error, Some(true));\n        assert!(!res.text.is_empty());\n    }\n\n    #[test]\n    fn real_child_runs_and_sigterm_kills_it() {\n        let spec = crate::job::tests::spec_of(|s| {\n            s.bin = \"/bin/sh\".into();\n            s.argv = vec![\"-c\".into(), \"exec sleep 30\".into()];\n        });\n        let spawned = spawn(&spec);\n        let kill = spawned.kill;\n        let t = std::thread::spawn(move || (spawned.drive)(&|_| {}));\n        std::thread::sleep(std::time::Duration::from_millis(100));\n        kill();\n        let res = t.join().unwrap();\n        assert!(!res.clean_exit);\n    }\n\n    /// Exit status is not stored in the fixtures. Only `cancelled` stops\n    /// mid-stream (SIGTERM exits 143); every other fixture ran to `agent_end`.\n    fn clean_exit_for(stem: &str) -> bool {\n        !matches!(stem, \"cancelled\")\n    }\n\n    fn approx(a: f64, b: f64) -> bool {\n        (a - b).abs() < 1e-12\n    }\n\n    #[test]\n    fn fixtures_parse_to_a_normalized_result() {\n        let dir =\n            std::path::PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"tests/fixtures/pi\");\n        let mut files: Vec<_> = std::fs::read_dir(&dir)\n            .unwrap_or_else(|e| panic!(\"{}: {e}\", dir.display()))\n            .map(|e| e.unwrap().path())\n            .filter(|p| p.extension().and_then(|s| s.to_str()) == Some(\"stdout\"))\n            .collect();\n        files.sort();\n        assert!(!files.is_empty(), \"no pi stdout fixtures\");\n\n        for path in files {\n            let stem = path.file_stem().unwrap().to_str().unwrap().to_string();\n            let stdout = std::fs::read_to_string(&path)\n                .unwrap_or_else(|e| panic!(\"{}: {e}\", path.display()));\n            let stderr_path = path.with_extension(\"stderr\");\n            let stderr = std::fs::read_to_string(&stderr_path).unwrap_or_default();\n            let clean = clean_exit_for(&stem);\n            let res = parse_stdout(&stdout, clean, &stderr);\n\n            assert_eq!(res.clean_exit, clean, \"{stem}\");\n            assert_eq!(res.stderr, stderr, \"{stem}\");\n            assert_eq!(res.duration_ms, None, \"{stem}\");\n            assert!(!res.text.contains(\"CANCELLED\"), \"{stem}\");\n            // The exit code never decides success: error-bad-model exits 0.\n            if stem == \"cancelled\" {\n                assert_eq!(res.is_error, Some(true), \"{stem}\");\n                assert_eq!(res.text, NO_RESULT, \"{stem}\");\n                assert!(res.session_id.is_none() && res.usage.is_none(), \"{stem}\");\n                assert_eq!(res.cost_usd, None, \"{stem}\");\n                continue;\n            }\n            assert!(res.session_id.is_some() && res.usage.is_some(), \"{stem}\");\n            assert_eq!(res.cost_usd.is_some(), true, \"{stem}\");\n\n            match stem.as_str() {\n                \"plain-answer\" => assert_eq!(\n                    res,\n                    BackendResult {\n                        text: \"391\\nSTATUS: DONE\".into(),\n                        session_id: Some(\"afcd8926-430b-4d9a-a552-d7c6d1b900ba\".into()),\n                        usage: Some(Usage {\n                            input_tokens: 5320.0,\n                            output_tokens: 9.0,\n                            cache_read_tokens: 0.0,\n                            cache_write_tokens: 0.0,\n                        }),\n                        cost_usd: Some(0.0005365),\n                        is_error: Some(false),\n                        duration_ms: None,\n                        clean_exit: true,\n                        stderr,\n                    },\n                    \"{stem}\"\n                ),\n                \"tool-calls-fix\" => {\n                    assert_eq!(\n                        res.text,\n                        \"Fixed `add` in `calc.py` to add its arguments. \\\n                         `python3 test_calc.py` passes.\\n\\nSTATUS: DONE\",\n                        \"{stem}\"\n                    );\n                    assert_eq!(\n                        res.session_id.as_deref(),\n                        Some(\"e04e84ae-41c0-4ed8-b9e5-de410d2f3bdf\"),\n                        \"{stem}\"\n                    );\n                    let usage = res.usage.as_ref().expect(\"usage\");\n                    assert_eq!(usage.input_tokens, 8940.0, \"{stem}\");\n                    assert_eq!(usage.output_tokens, 214.0, \"{stem}\");\n                    assert_eq!(usage.cache_read_tokens, 18432.0, \"{stem}\");\n                    assert_eq!(usage.cache_write_tokens, 0.0, \"{stem}\");\n                    assert!(approx(res.cost_usd.unwrap(), 0.00118532), \"{stem}\");\n                    assert_eq!(res.is_error, Some(false), \"{stem}\");\n                }\n                \"resume-answer\" => {\n                    assert_eq!(res.text, \"392\\nSTATUS: DONE\", \"{stem}\");\n                    assert_eq!(\n                        res.session_id.as_deref(),\n                        Some(\"afcd8926-430b-4d9a-a552-d7c6d1b900ba\"),\n                        \"{stem}\"\n                    );\n                    let usage = res.usage.as_ref().expect(\"usage\");\n                    assert_eq!(usage.input_tokens, 814.0, \"{stem}\");\n                    assert_eq!(usage.output_tokens, 33.0, \"{stem}\");\n                    assert_eq!(usage.cache_read_tokens, 4608.0, \"{stem}\");\n                    assert_eq!(usage.cache_write_tokens, 0.0, \"{stem}\");\n                    assert!(approx(res.cost_usd.unwrap(), 0.00014398), \"{stem}\");\n                    assert_eq!(res.is_error, Some(false), \"{stem}\");\n                }\n                \"error-bad-model\" => {\n                    assert_eq!(\n                        res.text,\n                        \"Codex error: The 'no-such-model' model is not supported \\\n                         when using Codex with a ChatGPT account.\",\n                        \"{stem}\"\n                    );\n                    assert_eq!(\n                        res.session_id.as_deref(),\n                        Some(\"a86b4f04-f9fe-4fe2-88f2-9c07c39dda68\"),\n                        \"{stem}\"\n                    );\n                    assert_eq!(res.is_error, Some(true), \"{stem}\");\n                    assert_eq!(res.cost_usd, Some(0.0), \"{stem}\");\n                }\n                \"needs-context\" => {\n                    assert_eq!(\n                        res.text,\n                        \"What would you like the function in `calc.py` to be called?\\\n                         \\n\\nSTATUS: NEEDS_CONTEXT\",\n                        \"{stem}\"\n                    );\n                    assert_eq!(\n                        res.session_id.as_deref(),\n                        Some(\"b7a8e40b-c58f-4468-b202-0ea1ff35dbac\"),\n                        \"{stem}\"\n                    );\n                    let usage = res.usage.as_ref().expect(\"usage\");\n                    assert_eq!(usage.input_tokens, 7912.0, \"{stem}\");\n                    assert_eq!(usage.output_tokens, 174.0, \"{stem}\");\n                    assert_eq!(usage.cache_read_tokens, 13824.0, \"{stem}\");\n                    assert_eq!(usage.cache_write_tokens, 0.0, \"{stem}\");\n                    assert!(approx(res.cost_usd.unwrap(), 0.00101644), \"{stem}\");\n                    assert_eq!(res.is_error, Some(false), \"{stem}\");\n                }\n                other => panic!(\"unexpected pi fixture: {other}\"),\n            }\n        }\n    }\n\n    #[test]\n    fn every_pi_fixture_has_progress() {\n        // tool_execution_start sets last_tool; assistant text sets last_assistant.\n        let dir =\n            std::path::PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"tests/fixtures/pi\");\n        for stem in [\"plain-answer\", \"tool-calls-fix\", \"needs-context\", \"resume-answer\"] {\n            let stdout = std::fs::read_to_string(dir.join(format!(\"{stem}.stdout\"))).unwrap();\n            let mut state = PiState::default();\n            for line in stdout.split_inclusive('\\n') {\n                handle_line(line.as_bytes(), &mut state);\n            }\n            assert!(\n                state.last_assistant.is_some(),\n                \"{stem} progress saw no assistant text\"\n            );\n            if stem == \"tool-calls-fix\" || stem == \"needs-context\" {\n                assert!(state.last_tool.is_some(), \"{stem} progress saw no tool call\");\n            }\n        }\n    }\n}\n","path":"src/backends/pi/mod.rs"}}
