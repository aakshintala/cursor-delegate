{"type":"tool_call","subtype":"completed","call_id":"call-b5199ffe-7f18-4116-96ca-508f3a0337d0-87\nfc_816badf8-aca6-99e1-aa50-1a59e8f7ebb2_0","tool_call":{"readToolCall":{"args":{"path":"/Users/user/work/delegate-17-claude/src/backends/cursor/doctor_tests.rs","offset":250,"limit":80},"result":{"success":{"content":"\n#[test]\nfn probe_model_menu_warns() {\n    let mut t = HashMap::new();\n    t.insert(\"models\".into(), ok_cmd(&format!(\"{MODELS_FIXTURE}\\n\")));\n    let run = stub_run(t);\n    let r = probe_model_menu(\n        \"/fake/cursor-agent\",\n        &[\n            \"composer-2.5\".into(),\n            \"stale-id\".into(),\n            \"grok-4.7-high\".into(),\n        ],\n        &run,\n    );\n    assert_eq!(\n        r.account_ids.as_ref().unwrap(),\n        &[\n            \"composer-2.5\".to_string(),\n            \"grok-4.7-high\".into(),\n            \"grok-4.7-xhigh\".into()\n        ]\n    );\n    assert_eq!(r.missing_from_account, [\"stale-id\"]);\n    assert!(!r.prices_checkable);\n    assert!(r.note.to_lowercase().contains(\"not checkable\"));\n    assert!(r.error.is_none());\n}\n\n#[test]\nfn probe_model_menu_fallback() {\n    let mut t = HashMap::new();\n    t.insert(\"models\".into(), fail_cmd(\"exit 1\"));\n    t.insert(\"--list-models\".into(), ok_cmd(\"composer-2.5\\ngrok-4.7-high\\n\"));\n    let run = stub_run(t);\n    let r = probe_model_menu(\n        \"/fake/cursor-agent\",\n        &[\"composer-2.5\".into(), \"missing-one\".into()],\n        &run,\n    );\n    assert_eq!(\n        r.account_ids.as_ref().unwrap(),\n        &[\"composer-2.5\".to_string(), \"grok-4.7-high\".into()]\n    );\n    assert_eq!(r.missing_from_account, [\"missing-one\"]);\n}\n\n#[test]\nfn probe_model_menu_both_fail() {\n    let mut t = HashMap::new();\n    t.insert(\"models\".into(), fail_cmd(\"exit 1\"));\n    t.insert(\"--list-models\".into(), fail_cmd(\"exit 2\"));\n    let run = stub_run(t);\n    let r = probe_model_menu(\"/fake/cursor-agent\", &[\"composer-2.5\".into()], &run);\n    assert!(r.account_ids.is_none());\n    assert!(r.missing_from_account.is_empty());\n    assert!(r.error.is_some());\n}\n\nfn composer_only() -> Config {\n    let mut c = models_config();\n    c.models.retain(|k, _| k == \"composer-2.5\");\n    c\n}\n\n#[test]\nfn run_doctor_happy_path() {\n    let mut t = HashMap::new();\n    t.insert(\"--version\".into(), ok_cmd(\"2026.06.01-abc\\n\"));\n    t.insert(\"about\".into(), ok_cmd(&format!(\"{ABOUT_FIXTURE}\\n\")));\n    t.insert(\"models\".into(), ok_cmd(&format!(\"{MODELS_FIXTURE}\\n\")));\n    t.insert(\n        \"auth check --model openai-codex/gpt-6-luna\".into(),\n        ok_cmd(\"authenticated\\n\"),\n    );\n    let run = stub_run(t);\n    let cfg = models_config();\n    let report = run_doctor(RunDoctorOpts {\n        config: &cfg,\n        resolve_bin: Some(&|_| \"/fake/cursor-agent\".into()),","isEmpty":false,"exceededLimit":false,"totalLines":479,"fileSize":14722,"path":"/Users/user/work/delegate-17-claude/src/backends/cursor/doctor_tests.rs","readRange":{"startLine":250,"endLine":329},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-b5199ffe-7f18-4116-96ca-508f3a0337d0-87\nfc_816badf8-aca6-99e1-aa50-1a59e8f7ebb2_0","startedAtMs":"1790859215929","completedAtMs":"1790859216338"},"model_call_id":"a8be2a3c-1fd3-45e2-a488-7ff9d6bfc46e-13-8s16","session_id":"a6874d86-60bb-4e84-8f2b-a3973591ec9a","timestamp_ms":1790859216251}
