{"type":"tool_call","subtype":"started","call_id":"tool_6e3e54aa-c3c0-45be-aa22-cf3ed6ad9ba","tool_call":{"shellToolCall":{"args":{"command":"gh pr view 28 --repo user/delegate --json files,title,body","workingDirectory":"","timeout":30000,"toolCallId":"tool_6e3e54aa-c3c0-45be-aa22-cf3ed6ad9ba","simpleCommands":["gh"],"hasInputRedirect":false,"hasOutputRedirect":false,"parsingResult":{"parsingFailed":false,"executableCommands":[{"name":"gh","args":[{"type":"word","value":"pr"},{"type":"word","value":"view"},{"type":"number","value":"28"},{"type":"word","value":"--repo"},{"type":"word","value":"user/delegate"},{"type":"word","value":"--json"},{"type":"word","value":"files,title,body"}],"fullText":"gh pr view 28 --repo user/delegate --json files,title,body"}],"hasRedirects":false,"hasCommandSubstitution":false,"redirects":[]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"List PR #28 changed files","closeStdin":true,"conversationId":"7741c2bb-bcd7-41f4-9bcb-95b590a9605c","adminCommandDenylist":[],"requestId":"a1e1f338-6f70-4231-84f0-9f978cd0626d"},"description":"List PR #28 changed files"},"hookAdditionalContexts":[],"toolCallId":"tool_6e3e54aa-c3c0-45be-aa22-cf3ed6ad9ba","startedAtMs":"1790853483133"},"model_call_id":"a1e1f338-6f70-4231-84f0-9f978cd0626d-1-wdi0","session_id":"7741c2bb-bcd7-41f4-9bcb-95b590a9605c","timestamp_ms":1790853483065}
