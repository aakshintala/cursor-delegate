":\"word\",\"value\":\"view\"},{\"type\":\"number\",\"value\":\"4\"}],\"fullText\":\"gh issue view 4\"},{\"name\":\"gh\",\"args\":[{\"type\":\"word\",\"valu [... omitted end of long line]","contentTruncated":false,"isContextLine":false}]},{"file":"./tests/fixtures/cursor/preflight-10.stdout","matches":[{"lineNumber":48,"content":"{\"type\":\"tool_call\",\"subtype\":\"completed\",\"call_id\":\"tool_0b7931c5-5d08-425f-8fa0-f7145e67562\",\"tool_call\":{\"shellToolCall\":{\"args\":{\"command\":\"gh issue view 4 --comments\",\"workingDirectory\":\"\",\"timeout\":30000,\"toolCallId\":\"tool_0b7931c5-5d08-425f-8fa0-f7145e67562\",\"simpleCommands\":[\"gh\"],\"hasInputRedirect\":false,\"hasOutputRedirect\":false,\"parsingResult\":{\"parsingFailed\":false,\"executableCommands\":[{\"name\":\"gh\",\"args\":[{\"type\":\"word\",\"value\":\"issue\"},{\"type\":\"word\",\"value\":\"view\"},{\"type\":\"number\",\"value\":\"4\"},{\"type\":\"word\",\"value\":\"--comments\"}],\"fullText\":\"gh issue view 4 --comments\"}],\"hasRedirects\":false,\"hasCommandSubstitution\":false,\"redirects\":[]},\"fileOutputThresholdBytes\":\"40000\",\"isBackground\":false,\"skipApproval\":false,\"timeoutBehavior\":\"TIMEOUT_BEHAVIOR_BACKGROUND\",\"hardTimeout\":86400000,\"description\":\"View spec issue #4 with comments\",\"closeStdin\":true,\"conversationId\":\"9fe30b80-d334-4ff0-ad00-19ff619b32c9\",\"adminCommandDenylist\":[],\"requestId\":\"46fec545-9cff-4ca8-a876-d8 [... omitted end of long line]","contentTruncated":false,"isContextLine":false}]},{"file":"./tests/fixtures/cursor/preflight-7.stdout","matches":[{"lineNumber":43,"content":"{\"type\":\"tool_call\",\"subtype\":\"completed\",\"call_id\":\"tool_eb875959-7d27-439a-8b4e-682d339e1b6\",\"tool_call\":{\"shellToolCall\":{\"args\":{\"command\":\"cd /Users/user/work/delegate-7-tracer && gh issue view 4 --comments\",\"workingDirectory\":\"\",\"timeout\":30000,\"toolCallId\":\"tool_eb875959-7d27-439a-8b4e-682d339e1b6\",\"simpleCommands\":[\"cd\",\"gh\"],\"hasInputRedirect\":false,\"hasOutputRedirect\":false,\"parsingResult\":{\"parsingFailed\":false,\"executableCommands\":[{\"name\":\"cd\",\"args\":[{\"type\":\"word\",\"value\":\"/Users/user/work/delegate-7-tracer\"}],\"fullText\":\"cd /Users/user/work/delegate-7-tracer\"},{\"name\":\"gh\",\"args\":[{\"type\":\"word\",\"value\":\"issue\"},{\"type\":\"word\",\"value\":\"view\"},{\"type\":\"number\",\"value\":\"4\"},{\"type\":\"word\",\"value\":\"--comments\"}],\"fullText\":\"gh issue view 4 --comments\"}],\"hasRedirects\":false,\"hasCommandSubstitution\":false,\"redirects\":[]},\"fileOutputThresholdBytes\":\"40000\",\"isBackground\":false,\"skipApproval\":false,\"timeoutBehavior\":\"TIMEOUT_BEHAVIOR_BACKGROUND\",\"hardTimeout\":86400000,\"descri [... omitted end of long line]","contentTruncated":false,"isContextLine":false}]},{"file":"./tests/fixtures/claude/review-18.stdout","matches":[{"lineNumber":15,"content":"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HGCobLa7Nx9QjMUKTdjMFz\",\"type\":\"tool_result\",\"content\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, r [... omitted end of long line]","contentTruncated":false,"isContextLine":false},{"lineNumber":20,"content":"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01FKZWbvxr8HjdhvcCbZixe8\",\"type\":\"tool_result\",\"content\":\"     1\\t#!/usr/bin/env bash\\n     2\\t# Run one prompt through a backend's raw headless CLI and save stdout/stderr as a parser fixture.\\n     3\\t#\\n     4\\t#   scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt\\n     5\\t#\\n     6\\t# BACKEND: cursor | pi | claude. CAPABILITY: read-only | read-write (pi rejects read-only).\\n     7\\t# SESSION resumes that backend session; pi and claude get a fresh id when it is omitted.\\n     8\\t# CANCEL_AFTER=N sends the CLI SIGTERM after N seconds.\\n     9\\t# Writes tests/fixtures/BACKEND/NAME.{stdout,stderr,argv}; prints the session id (if chosen) and exit code.\\n    10\\tset -uo pipefail\\n    11\\t\\n    12\\t[ $# -ge 4 ] || { sed -n 2,9p \\\"$0\\\"; exit 2; }\\n    13\\tbackend=$1 model=$2 cap=$3 name=$4 cwd=${5:-$PWD} session=${6:-}\\n    14\\there=\\\"$(cd \\\"$(dirname \\\"$0\\\")\\\" && pwd)\\\"\\n    15\\tout=\\\"$here/../t [... omitted end of long line]","contentTruncated":false,"isContextLine":false}]}],"totalLines":31,"totalMatchedLines":31,"clientTruncated":false,"ripgrepTruncated":false}}}}}},"hookAdditionalContexts":[],"toolCallId":"tool_1a6c0ee1-a776-4a5d-bb8e-c1ce201165d","startedAtMs":"1790845579690","completedAtMs":"1790845580100"},"model_call_id":"386feff0-e8c0-4a47-a111-127accad2785-1-z3ki","session_id":"24a298ed-5281-4d0f-b4ee-9f5363059aa8","timestamp_ms":1790845580077}
{"type":"tool_call","subtype":"completed","call_id":"tool_659472b9-7afb-4ca6-b674-e80d48a6712","tool_call":{"shellToolCall":{"args":{"command":"cd /Users/user/work/delegate-fixtures && gh issue view 16 --comments 2>&1; echo '===='; gh issue view 4 2>&1","workingDirectory":"","timeout":30000,"toolCallId":"tool_659472b9-7afb-4ca6-b674-e80d48a6712","simpleCommands":["cd","gh","echo","gh"],"hasInputRedirect":false,"hasOutputRedirect":true,"parsingResult":{"parsingFailed":false,"executableCommands":[{"name":"cd","args":[{"type":"word","value":"/Users/user/work/delegate-fixtures"}],"fullText":"cd /Users/user/work/delegate-fixtures"},{"name":"gh","args":[{"type":"word","value":"issue"},{"type":"word","value":"view"},{"type":"number","value":"16"},{"type":"word","value":"--comments"}],"fullText":"gh issue view 16 --comments"},{"name":"echo","args":[{"type":"raw_string","value":"'===='"}],"fullText":"echo '===='"},{"name":"gh","args":[{"type":"word","value":"issue"},{"type":"word","value":"view"},{"type":"number","value":"4"}],"fullText":"gh issue view 4"}],"hasRedirects":true,"hasCommandSubstitution":false,"allRedirectsAreDevNull":true,"redirects":[{"operator":">&","destinationFds":[2],"targetNodeType":"number","targetText":"1"},{"operator":">&","destinationFds":[2],"targetNodeType":"number","targetText":"1"}]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Fetch issue #16 and #4 bodies","closeStdin":true,"conversationId":"24a298ed-5281-4d0f-b4ee-9f5363059aa8","adminCommandDenylist":[],"requestId":"386feff0-e8c0-4a47-a111-127accad2785"},"result":{"success":{"command":"cd /Users/user/work/delegate-fixtures && gh issue view 16 --comments 2>&1; echo '===='; gh issue view 4 2>&1","workingDirectory":"","exitCode":0,"signal":"","stdout":"====\ntitle:\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\nstate:\tOPEN\nauthor:\tuser (Amogh Akshintala)\nlabels:\tready-for-agent\ncomments:\t1\nassignees:\t\nprojects:\t\nmilestone:\t\nissue-type:\t\nparent:\t\nsub-issues:\t\nsub-issues-completed:\t\nblocked-by:\t\nblocking:\t\nnumber:\t4\n--\n## Problem Statement\n\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\n\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\n\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\n\n## Solution\n\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\n\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\n\n## User Stories\n\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\n49. As a user, I want the skill to show briefs that say \"do not delegate further\", so that a delegated Claude does not loop back through delegate.\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\n\n## Implementation Decisions\n\n**Surface.** The MCP server is removed. The CLI is:\n\n```\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\ndelegate cancel <jobId>\ndelegate watch  <jobId>... [--timeout S]\ndelegate doctor\ndelegate models\n```\n\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\n\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\n\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\n\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\n\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\n\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\n\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\n\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\n\n- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\n- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\n- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\n\n**Model table.** Bundled JSON: `default` plus, per id, `{label, backend, price}`. Prices are kept for every model for display; only cursor uses them to compute cost. Pi model ids use pi's `provider/model` form. Default is `composer-2.5`. Grok 4.7 ids are `grok-4.7-high` / `grok-4.7-xhigh` (no `cursor-` prefix), priced as Grok 4.6.\n\n**Prompt composition.** The tool adds only the STATUS-line instruction to the caller's prompt; the result status is parsed from that line.\n\n**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\n\n**Rename.** Binary `delegate`; config at `~/.config/delegate/` with `DELEGATE_HOST_PROFILE` override; setup moves the old profile file. The Claude plugin ships the skill only. The Codex plugin manifest is dropped since nothing needs registering. The GitHub repo and local directory were renamed on 2026-10-01. The user's global agent instructions and agent memory are updated to the new names.\n\n**Skill.** Rewritten for the CLI: model picks and catalog over the new ids, read-only/read-write, cwd, gates, resume with overrides, the background `delegate watch` as the only documented waiting path, and a \"do not delegate further\" line for briefs. The plan-writer brief points at resume.\n\n**Delivery order.** (1) CLI conversion with all trims and the rename, cursor only, plus CI; (2) backend split behind the interface; (3) pi backend; (4) claude backend.\n\n## Testing Decisions\n\nA good test drives the `delegate` binary as a real process and asserts on what a caller sees: command output, exit status, and status-file contents. It does not reach into internal modules.\n\n- **Primary seam: the CLI against fake agent binaries.** Extends the existing end-to-end tests, which already run the real binary with a shell-script fake cursor-agent selected by an environment variable. Each backend gets a fake that replays a recorded stream. Covers run/detach, BUSY across processes, watchdog kill, gate pass/fail, change-set, NEEDS_CONTEXT, resume with and without overrides, cross-backend override rejection, resume after the original process is gone, cancel killing the process group, watch timeout, doctor, models.\n- **Parser seam: one per backend, on recorded headless output.** Prior art: the cursor adapter's stream tests. Fixtures are raw stdout captured from real headless runs, not stored session files (pi session files, Claude transcripts and Cursor chat stores are different formats). Use past sessions to choose realistic tasks to record: long tool output, many tool calls, resume, errors.\n- **Live tests, opt-in.** One real round trip per backend, ignored by default, like the existing live test. They save raw stdout as fresh fixtures. They also settle two open behaviours: whether headless plan mode in Claude answers rather than proposing a plan, and how often auto mode refuses calls.\n- **Latency budgets.** Every command is timed against fake agents. `run` returning its job id matters most. Budgets are set at about 3x the local measurement so CI noise does not trip them.\n- **Memory budget.** The supervisor's resident memory is measured while a fake agent runs. Replaces the old idle-server memory gate.\n- **CI.** GitHub Actions on Linux: format check, clippy with warnings as errors, tests. Live tests excluded. macOS runs locally. The suite currently takes about 5 seconds warm, 5 seconds clean build.\n\n## Out of Scope\n\n- A separate Codex backend; Codex models are reached through pi's openai-codex provider.\n- Fiber as a backend (waits for `fiber ask`).\n- Sandboxing any backend, or a seatbelt wrapper for pi.\n- Read-only mode for pi.\n- Server-created worktrees; callers create their own and pass `--cwd`.\n- Cleanup of old status records.\n- Reading pi's model catalog at runtime for prices.\n- Tiered (long-context) pricing in the model table.\n- Keeping MCP as a second interface.\n\n## Further Notes\n\n- Usage numbers come from 413 deduplicated `cursor_run` calls in local Claude transcripts.\n- Headless Claude auto mode cannot prompt, so calls its classifier will not auto-approve are refused. If that proves frequent, revisit.\n- If headless plan mode misbehaves, fall back to blocking the edit tools for read-only Claude runs.\n- A delegated Claude or pi loads this skill and the user's global instructions, so briefs must say \"do not delegate further\" to stop loops.\n- Superseded design notes: the multi-backend idea doc, which this spec replaces.\n\n\n","stderr":"","executionTime":2359,"interleavedOutput":"====\ntitle:\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\nstate:\tOPEN\nauthor:\tuser (Amogh Akshintala)\nlabels:\tready-for-agent\ncomments:\t1\nassignees:\t\nprojects:\t\nmilestone:\t\nissue-type:\t\nparent:\t\nsub-issues:\t\nsub-issues-completed:\t\nblocked-by:\t\nblocking:\t\nnumber:\t4\n--\n## Problem Statement\n\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\n\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\n\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\n\n## Solution\n\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\n\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\n\n## User Stories\n\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\n49. As a user, I want the skill to show briefs that say \"do not delegate further\", so that a delegated Claude does not loop back through delegate.\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\n\n## Implementation Decisions\n\n**Surface.** The MCP server is removed. The CLI is:\n\n```\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\ndelegate cancel <jobId>\ndelegate watch  <jobId>... [--timeout S]\ndelegate doctor\ndelegate models\n```\n\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\n\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\n\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\n\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\n\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\n\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\n\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\n\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\n\n- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\n- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\n- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\n\n**Model table.** Bundled JSON: `default` plus, per id, `{label, backend, price}`. Prices are kept for every model for display; only cursor uses them to compute cost. Pi model ids use pi's `provider/model` form. Default is `composer-2.5`. Grok 4.7 ids are `grok-4.7-high` / `grok-4.7-xhigh` (no `cursor-` prefix), priced as Grok 4.6.\n\n**Prompt composition.** The tool adds only the STATUS-line instruction to the caller's prompt; the result status is parsed from that line.\n\n**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\n\n**Rename.** Binary `delegate`; config at `~/.config/delegate/` with `DELEGATE_HOST_PROFILE` override; setup moves the old profile file. The Claude plugin ships the skill only. The Codex plugin manifest is dropped since nothing needs registering. The GitHub repo and local directory were renamed on 2026-10-01. The user's global agent instructions and agent memory are updated to the new names.\n\n**Skill.** Rewritten for the CLI: model picks and catalog over the new ids, read-only/read-write, cwd, gates, resume with overrides, the background `delegate watch` as the only documented waiting path, and a \"do not delegate further\" line for briefs. The plan-writer brief points at resume.\n\n**Delivery order.** (1) CLI conversion with all trims and the rename, cursor only, plus CI; (2) backend split behind the interface; (3) pi backend; (4) claude backend.\n\n## Testing Decisions\n\nA good test drives the `delegate` binary as a real process and asserts on what a caller sees: command output, exit status, and status-file contents. It does not reach into internal modules.\n\n- **Primary seam: the CLI against fake agent binaries.** Extends the existing end-to-end tests, which already run the real binary with a shell-script fake cursor-agent selected by an environment variable. Each backend gets a fake that replays a recorded stream. Covers run/detach, BUSY across processes, watchdog kill, gate pass/fail, change-set, NEEDS_CONTEXT, resume with and without overrides, cross-backend override rejection, resume after the original process is gone, cancel killing the process group, watch timeout, doctor, models.\n- **Parser seam: one per backend, on recorded headless output.** Prior art: the cursor adapter's stream tests. Fixtures are raw stdout captured from real headless runs, not stored session files (pi session files, Claude transcripts and Cursor chat stores are different formats). Use past sessions to choose realistic tasks to record: long tool output, many tool calls, resume, errors.\n- **Live tests, opt-in.** One real round trip per backend, ignored by default, like the existing live test. They save raw stdout as fresh fixtures. They also settle two open behaviours: whether headless plan mode in Claude answers rather than proposing a plan, and how often auto mode refuses calls.\n- **Latency budgets.** Every command is timed against fake agents. `run` returning its job id matters most. Budgets are set at about 3x the local measurement so CI noise does not trip them.\n- **Memory budget.** The supervisor's resident memory is measured while a fake agent runs. Replaces the old idle-server memory gate.\n- **CI.** GitHub Actions on Linux: format check, clippy with warnings as errors, tests. Live tests excluded. macOS runs locally. The suite currently takes about 5 seconds warm, 5 seconds clean build.\n\n## Out of Scope\n\n- A separate Codex backend; Codex models are reached through pi's openai-codex provider.\n- Fiber as a backend (waits for `fiber ask`).\n- Sandboxing any backend, or a seatbelt wrapper for pi.\n- Read-only mode for pi.\n- Server-created worktrees; callers create their own and pass `--cwd`.\n- Cleanup of old status records.\n- Reading pi's model catalog at runtime for prices.\n- Tiered (long-context) pricing in the model table.\n- Keeping MCP as a second interface.\n\n## Further Notes\n\n- Usage numbers come from 413 deduplicated `cursor_run` calls in local Claude transcripts.\n- Headless Claude auto mode cannot prompt, so calls its classifier will not auto-approve are refused. If that proves frequent, revisit.\n- If headless plan mode misbehaves, fall back to blocking the edit tools for read-only Claude runs.\n- A delegated Claude or pi loads this skill and the user's global instructions, so briefs must say \"do not delegate further\" to stop loops.\n- Superseded design notes: the multi-backend idea doc, which this spec replaces.\n\n\n","localExecutionTimeMs":2131},"isBackground":false},"description":"Fetch issue #16 and #4 bodies"},"hookAdditionalContexts":[],"toolCallId":"tool_659472b9-7afb-4ca6-b674-e80d48a6712","startedAtMs":"1790845579689","completedAtMs":"1790845582244"},"model_call_id":"386feff0-e8c0-4a47-a111-127accad2785-1-z3ki","session_id":"24a298ed-5281-4d0f-b4ee-9f5363059aa8","timestamp_ms":1790845582231}
