 = e.delegate(&[\"cancel\", &slow], None);\n    assert_eq!(cancelled.status.code(), Some(0));\n    assert_eq!(e.record(&slow)[\"status\"], \"CANCELLED\");\n    let out = e.resume(&slow, &[], Some(\"follow\"));\n    assert_eq!(out.status.code(), Some(2));\n    assert!(\n        String::from_utf8_lossy(&out.stderr).contains(\"session\"),\n        \"{}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n}","oldText":"    // A record with no session id (supervisor died before any result) is not resumable.\n    let slow = e.run(\"SLOW\");\n    let pid = e.record(&slow)[\"supervisorPid\"].as_i64().unwrap();\n    unsafe { libc::kill(pid as i32, libc::SIGKILL) };\n    let dead = e.wait_terminal(&slow);\n    assert_eq!(dead[\"status\"], \"ERROR\");\n    let out = e.resume(&slow, &[], Some(\"follow\"));\n    assert_eq!(out.status.code(), Some(2));\n    assert!(\n        String::from_utf8_lossy(&out.stderr).contains(\"session\"),\n        \"{}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    e.release();\n}"}],"path":"/Users/user/work/delegate-10-resume-cancel/tests/cli_e2e.rs"}}],"api":"openai-responses","provider":"opencode-go","model":"muse-spark-1.3-contributor","usage":{"input":797,"output":1347,"cacheRead":121713,"cacheWrite":0,"reasoning":851,"totalTokens":123857,"cost":{"input":0.00007970000000000001,"output":0.00026940000000000004,"cacheRead":0.000243426,"cacheWrite":0,"total":0.0005925260000000001}},"stopReason":"toolUse","timestamp":1790850622279,"responseId":"resp_6abe363f3a989a38d9f04ea2","rawStopReason":"completed","thinkingLevel":"high"}}
