     ])\n+        .current_dir(&dir)\n+        .env(\"TMPDIR\", &dir)\n+        .env(\"CLAUDE_BIN\", &wrapper)\n+        .stdin(Stdio::piped())\n+        .stdout(Stdio::piped())\n+        .spawn()\n+        .unwrap();\n+    run.stdin\n+        .take()\n+        .unwrap()\n+        .write_all(b\"What is 17 * 23?\")\n+        .unwrap();\n+    let id = String::from_utf8_lossy(&run.wait_with_output().unwrap().stdout)\n+        .trim()\n+        .to_string();\n+    let watch = Command::new(bin)\n+        .args([\"watch\", &id, \"--timeout\", \"300\"])\n+        .current_dir(&dir)\n+        .env(\"TMPDIR\", &dir)\n+        .env(\"CLAUDE_BIN\", &wrapper)\n+        .output()\n+        .unwrap();\n+    let out = String::from_utf8_lossy(&watch.stdout);\n+    let rec: serde_json::Value = serde_json::from_str(out.trim()).unwrap();\n+    assert_eq!(rec[\"status\"], \"DONE\");\n+    assert!(rec[\"result\"][\"text\"].as_str().unwrap().contains(\"391\"));\n+\n+    let fixture = repo.join(\"tests/fixtures/claude/live-plain-answer.stdout\");\n+    let jq = Command::new(\"jq\")\n+        .current_dir(&repo)\n+        .args([\n+            \"-rR\",\n+            \"-L\",\n+            \"scripts\",\n+            r#\"include \"redact\"; (fromjson? | redact | tojson) // .\"#,\n+        ])\n+        .stdin(Stdio::from(std::fs::File::open(&raw).unwrap()))\n+        .stdout(Stdio::from(std::fs::File::create(&fixture).unwrap()))\n+        .status()\n+        .unwrap();\n+    assert!(jq.success(), \"jq redact failed\");\n+    assert!(fixture.metadata().unwrap().len() > 0);\n+}\n+\n+fn real_claude() -> std::path::PathBuf {\n+    if let Ok(p) = std::env::var(\"CLAUDE_BIN\")\n+        && !p.is_empty()\n+    {\n+        return std::path::PathBuf::from(p);\n+    }\n+    if let Ok(out) = Command::new(\"which\").arg(\"claude\").output()\n+        && out.status.success()\n+    {\n+        let found = String::from_utf8_lossy(&out.stdout).trim().to_string();\n+        if !found.is_empty() {\n+            return std::path::PathBuf::from(found);\n+        }\n+    }\n+    std::env::var_os(\"HOME\")\n+        .map(std::path::PathBuf::from)\n+        .unwrap_or_else(|| std::path::PathBuf::from(\"/tmp\"))\n+        .join(\".local/bin/claude\")\n+}\nauto-fix.argv\nauto-fix.stderr\nauto-fix.stdout\nauto-refusal-exfil.argv\nauto-refusal-exfil.stderr\nauto-refusal-exfil.stdout\nauto-refusal.argv\nauto-refusal.stderr\nauto-refusal.stdout\ncancelled.argv\ncancelled.stderr\ncancelled.stdout\nerror-bad-model.argv\nerror-bad-model.stderr\nerror-bad-model.stdout\nlane-14-repair-1.argv\nlane-14-repair-1.stderr\nlane-14-repair-1.stdout\nlane-7-repair-1.argv\nlane-7-repair-1.stderr\nlane-7-repair-1.stdout\nlane-7-tracer.argv\nlane-7-tracer.stderr\nlane-7-tracer.stdout\nneeds-context.argv\nneeds-context.stderr\nneeds-context.stdout\nplan-edit-request.argv\nplan-edit-request.stderr\nplan-edit-request.stdout\nplan-plain-answer.argv\nplan-plain-answer.stderr\nplan-plain-answer.stdout\nplan-review.argv\nplan-review.stderr\nplan-review.stdout\nresume-answer.argv\nresume-answer.stderr\nresume-answer.stdout\nreview-18.argv\nreview-18.stderr\nreview-18.stdout\nreview-19.argv\nreview-19.stderr\nreview-19.stdout\nreview-20.argv\nreview-20.stderr\nreview-20.stdout\nreview-21.argv\nreview-21.stderr\nreview-21.stdout\nreview-23.argv\nreview-23.stderr\nreview-23.stdout\nreview-24.argv\nreview-24.stderr\nreview-24.stdout\nreview-26.argv\nreview-26.stderr\nreview-26.stdout\nreview-27.argv\nreview-27.stderr\nreview-27.stdout\nreview-29.argv\nreview-29.stderr\nreview-29.stdout\nShell cwd was reset to /Users/user/work/delegate-17-claude","is_error":false}]},"parent_tool_use_id":null,"session_id":"4eeac212-2355-47f7-94b7-850a7e176ccd","uuid":"3d896a0c-dc84-4e4e-a056-a4b03c5bc226","timestamp":"2026-10-01T12:20:44.919Z","tool_use_result":{"stdout":"diff --git a/src/backends/mod.rs b/src/backends/mod.rs\nindex 8a8a2ae..435eb73 100644\n--- a/src/backends/mod.rs\n+++ b/src/backends/mod.rs\n@@ -1,3 +1,4 @@\n+p