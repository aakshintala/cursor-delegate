       Err(e) => {\n            eprintln!(\"{e}\");\n            std::process::exit(1);\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests;\n","isEmpty":false,"exceededLimit":false,"totalLines":467,"fileSize":15294,"path":"/Users/user/work/delegate-13-contract/src/index.rs","readRange":{"startLine":400,"endLine":467},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"tool_b3b11a20-95bd-42a5-8bea-cb41167a343","startedAtMs":"1790852416109","completedAtMs":"1790852416521"},"model_call_id":"23978e36-7eb7-44ac-8d86-987b657a4703-4-pn7v","session_id":"e2d994f1-ef61-48a1-b218-cde928b7cc82","timestamp_ms":1790852416456}
