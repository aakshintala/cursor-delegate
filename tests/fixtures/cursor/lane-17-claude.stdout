          .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n+            .env(\"CLAUDE_BIN\", self.dir.join(\"claude.sh\"))\n             .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n         if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n             cmd.env(\ndiff --git a/tests/cli_info_e2e.rs b/tests/cli_info_e2e.rs\nindex ef8e3bb..9d1a580 100644\n--- a/tests/cli_info_e2e.rs\n+++ b/tests/cli_info_e2e.rs\n@@ -29,6 +29,21 @@ esac\n const FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n const MISSING_XHIGH: &str = \"composer-2.5 grok-4.7-high\";\n \n+const CLAUDE_FAKE: &str = r#\"#!/bin/sh\n+case \"$1\" in\n+  --version) echo \"2.0.0-test\" ;;\n+  auth)\n+    if [ \"$2\" = status ]; then\n+      printf '%s\\n' '{\"loggedIn\":true}'\n+    else\n+      echo \"unexpected auth $*\" >&2\n+      exit 1\n+    fi\n+    ;;\n+  *) echo \"unexpected: $*\" >&2; exit 1 ;;\n+esac\n+\"#;\n+\n struct Env {\n     dir: PathBuf,\n }\n@@ -41,6 +56,9 @@ impl Env {\n         let agent = dir.join(\"agent.sh\");\n         std::fs::write(&agent, script).unwrap();\n         std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n+        let claude = dir.join(\"claude.sh\");\n+        std::fs::write(&claude, CLAUDE_FAKE).unwrap();\n+        std::fs::set_permissions(&claude, std::fs::Permissions::from_mode(0o755)).unwrap();\n         Env { dir }\n     }\n \n@@ -54,6 +72,7 @@ impl Env {\n             .current_dir(&self.dir)\n             .env(\"TMPDIR\", &self.dir)\n             .env(\"CURSOR_AGENT_BIN\", bin)\n+            .env(\"CLAUDE_BIN\", self.dir.join(\"claude.sh\"))\n             // Isolate from the developer machine's real host profile: exact\n             // table assertions need the bundled models only.\n             .env(\n@@ -168,9 +187,11 @@ fn doctor_passes_against_full_fake() {\n         \"{stdout}\"\n     );\n     assert!(\n-        stdout.contains(\"skip  claude: backend not implemented (3 models)\"),\n+        stdout.contains(\"ok    claude: claude 2.0.0-test (\"),\n         \"{stdout}\"\n     );\n+    assert!(stdout.contains(\"ok    claude: logged in\"), \"{stdout}\");\n+    assert!(!stdout.contains(\"skip  claude\"), \"{stdout}\");\n     assert!(!stdout.contains(\"warn\"), \"{stdout}\");\n     assert!(!stdout.contains(\"fail\"), \"{stdout}\");\n }\n@@ -209,15 +230,6 @@ fn doctor_fails_when_binary_missing() {\n #[test]\n fn run_rejects_unimplemented_backend_with_exit_2() {\n     let e = Env::new(\"run-gate\", &agent_script(FULL_LIST));\n-    let out = e.delegate(&[\"run\", \"--model\", \"claude-sonnet-5-5\"], Some(\"hi\"));\n-    assert_eq!(out.status.code(), Some(2));\n-    let err = String::from_utf8_lossy(&out.stderr);\n-    assert!(\n-        err.contains(\n-            r#\"model \"claude-sonnet-5-5\" uses backend \"claude\", which is not implemented yet\"#\n-        ),\n-        \"{err}\"\n-    );\n     let out = e.delegate(&[\"run\", \"--model\", \"openai-codex/gpt-6-luna\"], Some(\"hi\"));\n     assert_eq!(out.status.code(), Some(2));\n     let err = String::from_utf8_lossy(&out.stderr);\ndiff --git a/tests/live.rs b/tests/live.rs\nindex 52c93d2..b95b28b 100644\n--- a/tests/live.rs\n+++ b/tests/live.rs\n@@ -1,6 +1,7 @@\n //! Opt-in: real cursor-agent. Run with: cargo test --test live -- --ignored\n \n use std::io::Write;\n+use std::os::unix::fs::PermissionsExt;\n use std::process::{Command, Stdio};\n \n #[test]\n@@ -47,3 +48,100 @@ fn ask_multiplies_on_real_agent() {\n             .is_some_and(|s| !s.is_empty())\n     );\n }\n+\n+/// Opt-in: real `claude`. Run with: cargo test --test live -- --ignored\n+/// Writes the redacted stream to tests/fixtures/claude/live-plain-answer.stdout.\n+#[test]\n+#[ignore = \"needs a logged-in claude; spends a Claude request\"]\n+fn ask_multiplies_on_real_claude() {\n+    let repo = std::path::PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n+    let dir = std::env::temp_dir().join(format!(\"delegate-live-claude-{}\", std::process::id()));\n+    let _ = std::fs::remove_dir_all(&dir);\n+    std::fs::create_dir_all(&dir).unwrap();\n+    let raw = dir.join(\"raw.stdout\");\n+    let real = real_claude();\n+    let wrapper = dir.join(\"claude-tee.sh\");\n+    std::fs::write(\n+        &wrapper,\n+        format!(\n+            \"#!/bin/sh\\n'{}' \\\"$@\\\" > '{}'\\nstatus=$?\\ncat '{}'\\nexit $status\\n\",\n+            real.display(),\n+            raw.display(),\n+            raw.display(),\n+        ),\n+    )\n+    .unwrap();\n+    std::fs::set_permissions(&wrapper, std::fs::Permissions::from_mode(0o755)).unwrap();\n+\n+    let bin = env!(\"CARGO_BIN_EXE_delegate\");\n+    let mut run = Command::new(bin)\n+        .args([\n+            \"run\",\n+            \"--model\",\n+            \"claude-sonnet-5-5\",\n+            \"--capability\",\n+            \"read-only\",\n+        ])\n+        .current_dir(&dir)\n+        .env(\"TMPDIR\", &dir)\n+        .env(\"CLAUDE_BIN\", &wrapper)\n+        .stdin(Stdio::piped())\n+        .stdout(Stdio::piped())\n+        .spawn()\n+        .unwrap();\n+    run.stdin\n+        .take()\n+        .unwrap()\n+        .write_all(b\"What is 17 * 23?\")\n+        .unwrap();\n+    let id = String::from_utf8_lossy(&run.wait_with_output().unwrap().stdout)\n+        .trim()\n+        .to_string();\n+    let watch = Command::new(bin)\n+        .args([\"watch\", &id, \"--timeout\", \"300\"])\n+        .current_dir(&dir)\n+        .env(\"TMPDIR\", &dir)\n+        .env(\"CLAUDE_BIN\", &wrapper)\n+        .output()\n+        .unwrap();\n+    let out = String::from_utf8_lossy(&watch.stdout);\n+    let rec: serde_json::Value = serde_json::from_str(out.trim()).unwrap();\n+    assert_eq!(rec[\"status\"], \"DONE\");\n+    assert!(rec[\"result\"][\"text\"].as_str().unwrap().contains(\"391\"));\n+\n+    let fixture = repo.join(\"tests/fixtures/claude/live-plain-answer.stdout\");\n+    let jq = Command::new(\"jq\")\n+        .current_dir(&repo)\n+        .args([\n+            \"-rR\",\n+            \"-L\",\n+            \"scripts\",\n+            r#\"include \"redact\"; (fromjson? | redact | tojson) // .\"#,\n+        ])\n+        .stdin(Stdio::from(std::fs::File::open(&raw).unwrap()))\n+        .stdout(Stdio::from(std::fs::File::create(&fixture).unwrap()))\n+        .status()\n+        .unwrap();\n+    assert!(jq.success(), \"jq redact failed\");\n+    assert!(fixture.metadata().unwrap().len() > 0);\n+}\n+\n+fn real_claude() -> std::path::PathBuf {\n+    if let Ok(p) = std::env::var(\"CLAUDE_BIN\")\n+        && !p.is_empty()\n+    {\n+        return std::path::PathBuf::from(p);\n+    }\n+    if let Ok(out) = Command::new(\"which\").arg(\"claude\").output()\n+        && out.status.success()\n+    {\n+        let found = String::from_utf8_lossy(&out.stdout).trim().to_string();\n+        if !found.is_empty() {\n+            return std::path::PathBuf::from(found);\n+        }\n+    }\n+    std::env::var_os(\"HOME\")\n+        .map(std::path::PathBuf::from)\n+        .unwrap_or_else(|| std::path::PathBuf::from(\"/tmp\"))\n+        .join(\".local/bin/claude\")\n+}\n","localExecutionTimeMs":308},"isBackground":false},"description":"Show full diff for commit review"},"hookAdditionalContexts":[],"toolCallId":"call-2d737f48-e27c-478e-b902-59148c0eeb63-170\nfc_de9f6edc-327c-9580-989b-d4ddf8d1e680_1","startedAtMs":"1790857028670","completedAtMs":"1790857029432"},"model_call_id":"a6d3412c-3430-4550-9d20-13547e35e0bc-66-y0pi","session_id":"a6874d86-60bb-4e84-8f2b-a3973591ec9a","timestamp_ms":1790857029426}
