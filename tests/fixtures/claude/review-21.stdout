edError {\n+    pub message: String,\n+}\n+\n+impl std::fmt::Display for BackendNotImplementedError {\n+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n+        f.write_str(&self.message)\n+    }\n+}\n+impl std::error::Error for BackendNotImplementedError {}\n+\n pub fn resolve_model(\n     model: Option<&str>,\n     require_non_claude: bool,\n@@ -37,14 +49,24 @@ pub fn resolve_model(\n             message: format!(\"model \\\"{model}\\\" is not in the allow-list\"),\n         }) as Box<dyn std::error::Error + Send + Sync>\n     })?;\n-    if require_non_claude && entry.family == \"claude\" {\n+    if require_non_claude && entry.backend == \"claude\" {\n         return Err(Box::new(NonClaudeViolationError {\n-            message: format!(\"requireNonClaude is set but model \\\"{model}\\\" has family \\\"claude\\\"\"),\n+            message: format!(\n+                \"requireNonClaude is set but model \\\"{model}\\\" has backend \\\"claude\\\"\"\n+            ),\n+        }));\n+    }\n+    if entry.backend != \"cursor\" {\n+        return Err(Box::new(BackendNotImplementedError {\n+            message: format!(\n+                \"model \\\"{model}\\\" uses backend \\\"{}\\\", which is not implemented yet\",\n+                entry.backend\n+            ),\n         }));\n     }\n     Ok(ResolvedModel {\n         model,\n-        family: entry.family.clone(),\n+        backend: entry.backend.clone(),\n         price: entry.price,\n     })\n }\n@@ -98,24 +120,32 @@ mod tests {\n             \"composer-2.5\".into(),\n             ModelEntry {\n                 label: \"Composer 2.5\".into(),\n-                family: \"composer\".into(),\n+                backend: \"cursor\".into(),\n                 price: price(0.5, 2.5, 0.2, 0.0),\n             },\n         );\n         models.insert(\n-            \"grok-4.5-xhigh\".into(),\n+            \"grok-4.7-high\".into(),\n             ModelEntry {\n-                label: \"Grok 4.5\".into(),\n-                family: \"grok\".into(),\n+                label: \"Grok 4.7 High\".into(),\n+                backend: \"cursor\".into(),\n                 price: price(2.0, 6.0, 0.5, 0.0),\n             },\n         );\n         models.insert(\n-            \"claude-sonnet-4\".into(),\n+            \"openai-codex/gpt-6-luna\".into(),\n             ModelEntry {\n-                label: \"Claude Sonnet 4\".into(),\n-                family: \"claude\".into(),\n-                price: price(3.0, 15.0, 0.3, 0.0),\n+                label: \"GPT-6 Luna\".into(),\n+                backend: \"pi\".into(),\n+                price: price(0.1, 0.5, 0.01, 0.125),\n+            },\n+        );\n+        models.insert(\n+            \"claude-sonnet-5-5\".into(),\n+            ModelEntry {\n+                label: \"Claude Sonnet 5.5\".into(),\n+                backend: \"claude\".into(),\n+                price: price(2.0, 10.0, 0.2, 2.5),\n             },\n         );\n         (\"composer-2.5\".into(), models)\n@@ -126,17 +156,17 @@ mod tests {\n         let (d, m) = base();\n         let r = resolve_model(None, false, &(d.as_str(), &m)).unwrap();\n         assert_eq!(r.model, \"composer-2.5\");\n-        assert_eq!(r.family, \"composer\");\n+        assert_eq!(r.backend, \"cursor\");\n         assert_eq!(r.price, m[\"composer-2.5\"].price);\n     }\n \n     #[test]\n-    fn allowed_id_resolves_with_family_and_price() {\n+    fn allowed_id_resolves_with_backend_and_price() {\n         let (d, m) = base();\n-        let r = resolve_model(Some(\"grok-4.5-xhigh\"), false, &(d.as_str(), &m)).unwrap();\n-        assert_eq!(r.model, \"grok-4.5-xhigh\");\n-        assert_eq!(r.family, \"grok\");\n-        assert_eq!(r.price, m[\"grok-4.5-xhigh\"].price);\n+        let r = resolve_model(Some(\"grok-4.7-high\"), false, &(d.as_str(), &m)).unwrap();\n+        assert_eq!(r.model, \"grok-4.7-high\");\n+        assert_eq!(r.backend, \"cursor\");\n+        assert_eq!(r.price, m[\"grok-4.7-high\"].price);\n     }\n \n     #[test]\n@@ -149,30 +179,45 @@ mod tests {\n     #[test]\n     fn require_non_claude_rejects_explicit_claude() {\n         let (d, m) = base();\n-        let e = resolve_model(Some(\"claude-sonnet-4\"), true, &(d.as_str(), &m)).unwrap_err();\n+        let e = resolve_model(Some(\"claude-sonnet-5-5\"), true, &(d.as_str(), &m)).unwrap_err();\n         assert!(e.downcast_ref::<NonClaudeViolationError>().is_some());\n     }\n \n     #[test]\n     fn require_non_claude_rejects_claude_default() {\n         let (_, m) = base();\n-        let e = resolve_model(None, true, &(\"claude-sonnet-4\", &m)).unwrap_err();\n+        let e = resolve_model(None, true, &(\"claude-sonnet-5-5\", &m)).unwrap_err();\n         assert!(e.downcast_ref::<NonClaudeViolationError>().is_some());\n     }\n \n     #[test]\n     fn require_non_claude_passes_non_claude() {\n         let (d, m) = base();\n-        let r = resolve_model(Some(\"grok-4.5-xhigh\"), true, &(d.as_str(), &m)).unwrap();\n-        assert_eq!(r.model, \"grok-4.5-xhigh\");\n-        assert_eq!(r.family, \"grok\");\n+        let r = resolve_model(Some(\"grok-4.7-high\"), true, &(d.as_str(), &m)).unwrap();\n+        assert_eq!(r.model, \"grok-4.7-high\");\n+        assert_eq!(r.backend, \"cursor\");\n+    }\n+\n+    #[test]\n+    fn claude_backend_is_not_implemented() {\n+        let (d, m) = base();\n+        let e = resolve_model(Some(\"claude-sonnet-5-5\"), false, &(d.as_str(), &m)).unwrap_err();\n+        let be = e.downcast_ref::<BackendNotImplementedError>().unwrap();\n+        assert_eq!(\n+            be.message,\n+            \"model \\\"claude-sonnet-5-5\\\" uses backend \\\"claude\\\", which is not implemented yet\"\n+        );\n     }\n \n     #[test]\n-    fn require_non_claude_false_allows_claude() {\n+    fn pi_backend_is_not_implemented() {\n         let (d, m) = base();\n-        let r = resolve_model(Some(\"claude-sonnet-4\"), false, &(d.as_str(), &m)).unwrap();\n-        assert_eq!(r.model, \"claude-sonnet-4\");\n-        assert_eq!(r.family, \"claude\");\n+        let e =\n+            resolve_model(Some(\"openai-codex/gpt-6-luna\"), false, &(d.as_str(), &m)).unwrap_err();\n+        let be = e.downcast_ref::<BackendNotImplementedError>().unwrap();\n+        assert_eq!(\n+            be.message,\n+            \"model \\\"openai-codex/gpt-6-luna\\\" uses backend \\\"pi\\\", which is not implemented yet\"\n+        );\n     }\n }\ndiff --git a/src/types.rs b/src/types.rs\nindex d938352..e8c5d54 100644\n--- a/src/types.rs\n+++ b/src/types.rs\n@@ -251,14 +251,14 @@ pub type PriceMap = std::collections::HashMap<String, Price>;\n #[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n pub struct ModelEntry {\n     pub label: String,\n-    pub family: String,\n+    pub backend: String,\n     pub price: Price,\n }\n \n #[derive(Debug, Clone, PartialEq)]\n pub struct ResolvedModel {\n     pub model: String,\n-    pub family: String,\n+    pub backend: String,\n     pub price: Price,\n }\n \n16:fn agent_script(listed: &str) -> String {\n37:    fn new(name: &str, script: &str) -> Self {\n47:    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n51:    fn delegate_with_bin(&self, args: &[&str], stdin: Option<&str>, bin: &str) -> Output {\n78:    fn drop(&mut self) {\n113:#[test]\n114:fn models_lists_all_twelve_with_default_marked() {\n149:#[test]\n150:fn doctor_passes_against_full_fake() {\n178:#[test]\n179:fn doctor_warns_on_missing_model_and_still_exits_0() {\n197:#[test]\n198:fn doctor_fails_when_binary_missing() {\n209:#[test]\n210:fn run_rejects_unimplemented_backend_with_exit_2() {","is_error":false}]},"parent_tool_use_id":null,"session_id":"1dbb4698-1c43-4b15-b933-765f45723b7a","uuid":"bbb0ef2d-3131-4ba3-99cb-6d60eb668ba6","timestamp":"2026-10-01T09:22:19.330Z","tool_use_result":{"stdout":"     1\t//! Human-readable `delegate models` and `delegate doctor` output.\n     2\t\n     3\tuse crate::doctor::{RunDoctorOpts, run_doctor};\n     4\tuse crate::index::build_deps;\n     5\tuse crate::types::Config;\n     6\t\n     7\t/// `delegate models`: an aligned table of id, label, backend and $/1M prices.\n     8\tpub fn models() -> Result<i32, String> {\n     9\t    let deps = build_deps().map_err(|e| e.to_string())?;\n    10\t    print!(\"{}\", models_table(&deps.config));\n    11\t    Ok(0)\n    12\t}\n    13\t\n    14\t/// `delegate doctor`: one ok/warn/skip/fail line per check. Exit 1 on any fail.\n    15\tpub fn doctor() -> Result<i32, String> {\n    16\t    let deps = build_deps().map_err(|e| e.to_string())?;\n    17\t    let (text, code) = doctor_text(&deps.config);\n    18\t    print!(\"{text}\");\n    19\t    Ok(code)\n    20\t}\n    21\t\n    22\tfn status_line(status: &str, msg: &str) -> String {\n    23\t    format!(\"{status:<5} {msg}\\n\")\n    24\t}\n    25\t\n    26\t/// Rows sort by backend, then by id. A `*` marks the default model.\n    27\tpub fn models_table(config: &Config) -> String {\n    28\t    let mut rows: Vec<(&String, &crate::types::ModelEntry)> = config.models.iter().collect();\n    29\t    rows.sort_by(|a, b| (&a.1.backend, a.0).cmp(&(&b.1.backend, b.0)));\n    30\t    let ins: Vec<String> = rows\n    31\t        .iter()\n    32\t        .map(|(_, e)| format!(\"{:.2}\", e.price.input))\n    33\t        .collect();\n    34\t    let outs: Vec<String> = rows\n    35\t        .iter()\n    36\t        .map(|(_, e)| format!(\"{:.2}\", e.price.output))\n    37\t        .collect();\n    38\t    let id_w = rows\n    39\t        .iter()\n    40\t        .map(|(id, _)| id.len())\n    41\t        .max()\n    42\t        .unwrap_or(0)\n    43\t        .max(\"ID\".len());\n    44\t    let label_w = rows\n    45\t        .iter()\n    46\t        .map(|(_, e)| e.label.len())\n    47\t        .max()\n    48\t        .unwrap_or(0)\n    49\t        .max(\"LABEL\".len());\n    50\t    let backend_w = rows\n    51\t        .iter()\n    52\t        .map(|(_, e)| e.backend.len())\n    53\t        .max()\n    54\t        .unwrap_or(0)\n    55\t        .max(\"BACKEND\".len());\n    56\t    let in_w = ins\n    57\t        .iter()\n    58\t        .map(|s| s.len())\n    59\t        .max()\n    60\t        .unwrap_or(0)\n    61\t        .max(\"$IN/1M\".len());\n    62\t    let out_w = outs\n    63\t        .iter()\n    64\t        .map(|s| s.len())\n    65\t        .max()\n    66\t        .unwrap_or(0)\n    67\t        .max(\"$OUT/1M\".len());\n    68\t\n    69\t    let mut out = format!(\n    70\t        \"  {0:<id_w$}  {1:<label_w$}  {2:<backend_w$}  {3:>in_w$}  {4:>out_w$}\\n\",\n    71\t        \"ID\", \"LABEL\", \"BACKEND\", \"$IN/1M\", \"$OUT/1M\"\n    72\t    );\n    73\t    for (i, (id, entry)) in rows.iter().enumerate() {\n    74\t        let mark = if *id == &config.default { \"*\" } else { \" \" };\n    75\t        out += &format!(\n    76\t            \"{mark} {0:<id_w$}  {1:<label_w$}  {2:<backend_w$}  {3:>in_w$}  {4:>out_w$}\\n\",\n    77\t            id, entry.label, entry.backend, ins[i], outs[i]\n    78\t        );\n    79\t    }\n    80\t    out\n    81\t}\n    82\t\n    83\tpub fn doctor_text(config: &Config) -> (String, i32) {\n    84\t    let report = run_doctor(RunDoctorOpts {\n    85\t        config,\n    86\t        resolve_bin: None,\n    87\t        bin_exists: None,\n    88\t        run_command: None,\n    89\t        read_package_version: None,\n    90\t        check_plugin_registration: None,\n    91\t    });\n    92\t    let mut text = String::new();\n    93\t    let mut failed = false;\n    94\t\n    95\t    if report.plugin.version == \"unknown\" {\n    96\t        text += &status_line(\"fail\", \"delegate: version unknown\");\n    97\t        failed = true;\n    98\t    } else {\n    99\t        text += &status_line(\"ok\", &format!(\"delegate {}\", report.plugin.version));\n   100\t    }\n   101\t\n   102\t    if !report.agent.found {\n   103\t        text += &status_line(\"fail\", \"cursor: cursor-agent not found\");\n   104\t        failed = true;\n   105\t    } else {\n   106\t        let path = report.agent.path.as_deref().unwrap_or(\"?\");\n   107\t        match report.agent.version.as_deref() {\n   108\t            Some(v) => {\n   109\t                text += &status_line(\"ok\", &format!(\"cursor: cursor-agent {v} ({path})\"));\n   110\t            }\n   111\t            None => {\n   112\t                let e = report.agent.error.as_deref().unwrap_or(\"unknown error\");\n   113\t                text += &status_line(\n   114\t                    \"fail\",\n   115\t                    &format!(\"cursor: cursor-agent --version failed: {e}\"),\n   116\t                );\n   117\t                failed = true;\n   118\t            }\n   119\t        }\n   120\t        if report.account.logged_in {\n   121\t            text += &status_line(\"ok\", \"cursor: logged in\");\n   122\t        } else {\n   123\t            let e = report\n   124\t                .account\n   125\t                .error\n   126\t                .as_deref()\n   127\t                .unwrap_or(\"no email in about output\");\n   128\t            text += &status_line(\"fail\", &format!(\"cursor: not logged in: {e}\"));\n   129\t            failed = true;\n   130\t        }\n   131\t        if let Some(e) = report.model_menu.error.as_deref() {\n   132\t            text += &status_line(\"warn\", &format!(\"cursor: model list check failed: {e}\"));\n   133\t        }\n   134\t        for id in &report.model_menu.missing_from_account {\n   135\t            text += &status_line(\n   136\t                \"warn\",\n   137\t                &format!(\"cursor: model {id} missing from cursor-agent --list-models\"),\n   138\t            );\n   139\t        }\n   140\t    }\n   141\t\n   142\t    for backend in [\"pi\", \"claude\"] {\n   143\t        let n = config\n   144\t            .models\n   145\t            .values()\n   146\t            .filter(|e| e.backend == backend)\n   147\t            .count();\n   148\t        if n > 0 {\n   149\t            let word = if n == 1 { \"model\" } else { \"models\" };\n   150\t            text += &status_line(\n   151\t                \"skip\",\n   152\t                &format!(\"{backend}: backend not implemented ({n} {word})\"),\n   153\t            );\n   154\t        }\n   155\t    }\n   156\t\n   157\t    (text, i32::from(failed))\n   158\t}\n   159\t\n   160\t#[cfg(test)]\n   161\tmod tests {\n   162\t    use super::*;\n   163\t    use crate::types::{ModelEntry, Price};\n   164\t    use std::collections::HashMap;\n   165\t\n   166\t    fn config() -> Config {\n   167\t        let mut models: HashMap<String, ModelEntry> = HashMap::new();\n   168\t        for (id, label, backend) in [\n   169\t            (\"b-2\", \"B Two\", \"pi\"),\n   170\t            (\"a-1\", \"A One\", \"claude\"),\n   171\t            (\"composer-2.5\", \"Composer 2.5\", \"cursor\"),\n   172\t        ] {\n   173\t            models.insert(\n   174\t                id.into(),\n   175\t                ModelEntry {\n   176\t                    label: label.into(),\n   177\t                    backend: backend.into(),\n   178\t                    price: Price {\n   179\t                        input: 1.0,\n   180\t                        output: 2.0,\n   181\t                        cache_read: 0.0,\n   182\t                        cache_write: 0.0,\n   183\t                    },\n   184\t                },\n   185\t            );\n   186\t        }\n   187\t        Config {\n   188\t            default: \"composer-2.5\".into(),\n   189\t            price_map: models.iter().map(|(k, v)| (k.clone(), v.price)).collect(),\n   190\t            models,\n   191\t            profile: crate::types::HostProfile::default(),\n   192\t        }\n   193\t    }\n   194\t\n   195\t    #[test]\n   196\t    fn table_sorts_and_marks_default() {\n   197\t        let t = models_table(&config());\n   198\t        let lines: Vec<&str> = t.lines().collect();\n   199\t        assert_eq!(lines.len(), 4);\n   200\t        assert!(lines[0].starts_with(\"  ID\"));\n   201\t        let ids: Vec<&str> = lines[1..]\n   202\t            .iter()\n   203\t            .map(|l| l[2..].split_whitespace().next().unwrap())\n   204\t            .collect();\n   205\t        assert_eq!(ids, [\"a-1\", \"composer-2.5\", \"b-2\"]);\n   206\t        assert!(lines[2].starts_with('*'));\n   207\t        assert!(!lines[1].starts_with('*') && !lines[3].starts_with('*'));\n   208\t    }\n   209\t}\ncommit 0a720d224d4de61fc77ded4e4a5a48b2460dfd83\nAuthor: Amogh Akshintala <amoghakshintala@gmail.com>\nDate:   Thu Oct 1 02:21:15 2026 -0700\n\n    feat: delegate models, trimmed doctor, and the new model table (#11)\n    \n    backend replaces family; default composer-2.5; pi/claude resolve to a\n    not-implemented error; delegate models prints an aligned table; delegate\n    doctor prints ok/warn/skip/fail lines with exit 1 on any fail.\n    \n    Co-Authored-By: Muse Spark 1.3 <noreply@opencode.ai>\n\ndiff --git a/src/cli.rs b/src/cli.rs\nindex 14391c1..2e7d537 100644\n--- a/src/cli.rs\n+++ b/src/cli.rs\n@@ -19,7 +19,7 @@ use std::process::{Command, Stdio};\n use std::sync::Arc;\n use std::time::{Duration, Instant};\n \n-const USAGE: &str = \"usage: delegate run --model M [--capability read-only|read-write] [--cwd D] [--prompt-file F]\\n       delegate watch <jobId>... [--timeout S]\";\n+const USAGE: &str = \"usage: delegate run --model M [--capability read-only|read-write] [--cwd D] [--prompt-file F]\\n       delegate watch <jobId>... [--timeout S]\\n       delegate models\\n       delegate doctor\";\n \n /// Bad input: reason on stderr, exit 2.\n struct Usage(String);\n@@ -33,6 +33,8 @@ pub fn main() -> i32 {\n     let res = match args.first().map(String::as_str) {\n         Some(\"run\") => run(&args[1..]),\n         Some(\"watch\") => watch(&args[1..]),\n+        Some(\"models\") => crate::cli_info::models().map_err(Usage),\n+        Some(\"doctor\") => crate::cli_info::doctor().map_err(Usage),\n         Some(\"__supervise\") => return supervise(&args[1..]),\n         _ => usage(USAGE),\n     };\n@@ -93,13 +95,20 @@ fn run(args: &[String]) -> Result<i32, Usage> {\n             return Ok(1);\n         }\n     };\n-    if resolve_model(Some(model), false, &deps.config).is_err() {\n-        let mut ids: Vec<_> = deps.config.models.keys().cloned().collect();\n-        ids.sort();\n-        return usage(format!(\n-            \"unknown model {model}; valid models: {}\",\n-            ids.join(\", \")\n-        ));\n+    if let Err(e) = resolve_model(Some(model), false, &deps.config) {\n+        // An unknown id lists the valid ids; any other failure (e.g. a model on\n+        // a backend that is not implemented yet) prints the actual error.\n+        if e.downcast_ref::<crate::models::ModelNotAllowedError>()\n+            .is_some()\n+        {\n+            let mut ids: Vec<_> = deps.config.models.keys().cloned().collect();\n+            ids.sort();\n+            return usage(format!(\n+                \"unknown model {model}; valid models: {}\",\n+                ids.join(\", \")\n+            ));\n+        }\n+        return usage(format!(\"{e}\"));\n     }\n     let mut prompt = String::new();\n     match flag(&kv, \"--prompt-file\") {\ndiff --git a/src/config.rs b/src/config.rs\nindex 5b7c2fb..8e26b00 100644\n--- a/src/config.rs\n+++ b/src/config.rs\n@@ -166,7 +166,7 @@ fn decode_model_entry(raw: &Value, id: &str, where_: &str) -> Result<ModelEntry,\n     let loc = format!(\"{where_}[\\\"{id}\\\"]\");\n     Ok(ModelEntry {\n         label: str_field(obj, \"label\", &loc)?,\n-        family: str_field(obj, \"family\", &loc)?,\n+        backend: str_field(obj, \"backend\", &loc)?,\n         price: decode_price(obj.get(\"price\").unwrap_or(&Value::Null), &loc)?,\n     })\n }\n@@ -346,12 +346,12 @@ mod tests {\n   \"models\": {\n     \"composer-2.5\": {\n       \"label\": \"Composer 2.5\",\n-      \"family\": \"composer\",\n+      \"backend\": \"cursor\",\n       \"price\": { \"input\": 0.5, \"output\": 2.5, \"cacheRead\": 0.2, \"cacheWrite\": 0 }\n     },\n-    \"grok-4.5-xhigh\": {\n-      \"label\": \"Grok 4.5\",\n-      \"family\": \"grok\",\n+    \"grok-4.7-high\": {\n+      \"label\": \"Grok 4.7 High\",\n+      \"backend\": \"cursor\",\n       \"price\": { \"input\": 2, \"output\": 6, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n     }\n   }\n@@ -378,7 +378,7 @@ mod tests {\n         })\n         .unwrap();\n         assert_eq!(cfg.default, \"composer-2.5\");\n-        assert_eq!(cfg.models[\"composer-2.5\"].family, \"composer\");\n+        assert_eq!(cfg.models[\"composer-2.5\"].backend, \"cursor\");\n         assert_eq!(cfg.price_map[\"composer-2.5\"].input, 0.5);\n         assert_eq!(cfg.profile, HostProfile::default());\n     }\n@@ -390,11 +390,11 @@ mod tests {\n         files.insert(\n             \"/profile.json\".into(),\n             serde_json::json!({\n-                \"default\": \"grok-4.5-xhigh\",\n+                \"default\": \"grok-4.7-high\",\n                 \"models\": {\n-                    \"gpt-5.5-high\": {\n-                        \"label\": \"GPT-5.5 1M High\",\n-                        \"family\": \"gpt\",\n+                    \"openai-codex/gpt-6-luna\": {\n+                        \"label\": \"GPT-6 Luna\",\n+                        \"backend\": \"pi\",\n                         \"price\": { \"input\": 5, \"output\": 30, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n                     }\n                 },\n@@ -409,11 +409,11 @@ mod tests {\n             read_file: Some(reader(files)),\n         })\n         .unwrap();\n-        assert_eq!(cfg.default, \"grok-4.5-xhigh\");\n+        assert_eq!(cfg.default, \"grok-4.7-high\");\n         assert!(cfg.models.contains_key(\"composer-2.5\"));\n-        assert!(cfg.models.contains_key(\"gpt-5.5-high\"));\n-        assert_eq!(cfg.models[\"gpt-5.5-high\"].family, \"gpt\");\n-        assert_eq!(cfg.price_map[\"gpt-5.5-high\"].output, 30.0);\n+        assert!(cfg.models.contains_key(\"openai-codex/gpt-6-luna\"));\n+        assert_eq!(cfg.models[\"openai-codex/gpt-6-luna\"].backend, \"pi\");\n+        assert_eq!(cfg.price_map[\"openai-codex/gpt-6-luna\"].output, 30.0);\n         assert_eq!(\n             cfg.profile.required_deny.as_ref().unwrap(),\n             &[\"rm -rf /\".to_string()]\n@@ -457,7 +457,7 @@ mod tests {\n     fn rejects_non_finite_price() {\n         let bad = serde_json::json!({\n             \"default\":\"m\",\n-            \"models\":{\"m\":{\"label\":\"M\",\"family\":\"f\",\"price\":{\"input\":null,\"output\":1,\"cacheRead\":0,\"cacheWrite\":0}}}\n+            \"models\":{\"m\":{\"label\":\"M\",\"backend\":\"cursor\",\"price\":{\"input\":null,\"output\":1,\"cacheRead\":0,\"cacheWrite\":0}}}\n         })\n         .to_string();\n         // NaN is not valid JSON; use a missing-like invalid (string) which fails the number check.\n@@ -477,7 +477,7 @@ mod tests {\n     fn rejects_missing_price_field() {\n         let bad = serde_json::json!({\n             \"default\":\"m\",\n-            \"models\":{\"m\":{\"label\":\"M\",\"family\":\"f\",\"price\":{\"input\":1,\"output\":1,\"cacheRead\":0}}}\n+            \"models\":{\"m\":{\"label\":\"M\",\"backend\":\"cursor\",\"price\":{\"input\":1,\"output\":1,\"cacheRead\":0}}}\n         })\n         .to_string();\n         let mut files = HashMap::new();\ndiff --git a/src/models.rs b/src/models.rs\nindex df77e40..08d314d 100644\n--- a/src/models.rs\n+++ b/src/models.rs\n@@ -24,6 +24,18 @@ impl std::fmt::Display for NonClaudeViolationError {\n }\n impl std::error::Error for NonClaudeViolationError {}\n \n+#[derive(Debug)]\n+pub struct BackendNotImplementedError {\n+    pub message: String,\n+}\n+\n+impl std::fmt::Display for BackendNotImplementedError {\n+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n+        f.write_str(&self.message)\n+    }\n+}\n+impl std::error::Error for BackendNotImplementedError {}\n+\n pub fn resolve_model(\n     model: Option<&str>,\n     require_non_claude: bool,\n@@ -37,14 +49,24 @@ pub fn resolve_model(\n             message: format!(\"model \\\"{model}\\\" is not in the allow-list\"),\n         }) as Box<dyn std::error::Error + Send + Sync>\n     })?;\n-    if require_non_claude && entry.family == \"claude\" {\n+    if require_non_claude && entry.backend == \"claude\" {\n         return Err(Box::new(NonClaudeViolationError {\n-            message: format!(\"requireNonClaude is set but model \\\"{model}\\\" has family \\\"claude\\\"\"),\n+            message: format!(\n+                \"requireNonClaude is set but model \\\"{model}\\\" has backend \\\"claude\\\"\"\n+            ),\n+        }));\n+    }\n+    if entry.backend != \"cursor\" {\n+        return Err(Box::new(BackendNotImplementedError {\n+            message: format!(\n+                \"model \\\"{model}\\\" uses backend \\\"{}\\\", which is not implemented yet\",\n+                entry.backend\n+            ),\n         }));\n     }\n     Ok(ResolvedModel {\n         model,\n-        family: entry.family.clone(),\n+        backend: entry.backend.clone(),\n         price: entry.price,\n     })\n }\n@@ -98,24 +120,32 @@ mod tests {\n             \"composer-2.5\".into(),\n             ModelEntry {\n                 label: \"Composer 2.5\".into(),\n-                family: \"composer\".into(),\n+                backend: \"cursor\".into(),\n                 price: price(0.5, 2.5, 0.2, 0.0),\n             },\n         );\n         models.insert(\n-            \"grok-4.5-xhigh\".into(),\n+            \"grok-4.7-high\".into(),\n             ModelEntry {\n-                label: \"Grok 4.5\".into(),\n-                family: \"grok\".into(),\n+                label: \"Grok 4.7 High\".into(),\n+                backend: \"cursor\".into(),\n                 price: price(2.0, 6.0, 0.5, 0.0),\n             },\n         );\n         models.insert(\n-            \"claude-sonnet-4\".into(),\n+            \"openai-codex/gpt-6-luna\".into(),\n             ModelEntry {\n-                label: \"Claude Sonnet 4\".into(),\n-                family: \"claude\".into(),\n-                price: price(3.0, 15.0, 0.3, 0.0),\n+                label: \"GPT-6 Luna\".into(),\n+                backend: \"pi\".into(),\n+                price: price(0.1, 0.5, 0.01, 0.125),\n+            },\n+        );\n+        models.insert(\n+            \"claude-sonnet-5-5\".into(),\n+            ModelEntry {\n+                label: \"Claude Sonnet 5.5\".into(),\n+                backend: \"claude\".into(),\n+                price: price(2.0, 10.0, 0.2, 2.5),\n             },\n         );\n         (\"composer-2.5\".into(), models)\n@@ -126,17 +156,17 @@ mod tests {\n         let (d, m) = base();\n         let r = resolve_model(None, false, &(d.as_str(), &m)).unwrap();\n         assert_eq!(r.model, \"composer-2.5\");\n-        assert_eq!(r.family, \"composer\");\n+        assert_eq!(r.backend, \"cursor\");\n         assert_eq!(r.price, m[\"composer-2.5\"].price);\n     }\n \n     #[test]\n-    fn allowed_id_resolves_with_family_and_price() {\n+    fn allowed_id_resolves_with_backend_and_price() {\n         let (d, m) = base();\n-        let r = resolve_model(Some(\"grok-4.5-xhigh\"), false, &(d.as_str(), &m)).unwrap();\n-        assert_eq!(r.model, \"grok-4.5-xhigh\");\n-        assert_eq!(r.family, \"grok\");\n-        assert_eq!(r.price, m[\"grok-4.5-xhigh\"].price);\n+        let r = resolve_model(Some(\"grok-4.7-high\"), false, &(d.as_str(), &m)).unwrap();\n+        assert_eq!(r.model, \"grok-4.7-high\");\n+        assert_eq!(r.backend, \"cursor\");\n+        assert_eq!(r.price, m[\"grok-4.7-high\"].price);\n     }\n \n     #[test]\n@@ -149,30 +179,45 @@ mod tests {\n     #[test]\n     fn require_non_claude_rejects_explicit_claude() {\n         let (d, m) = base();\n-        let e = resolve_model(Some(\"claude-sonnet-4\"), true, &(d.as_str(), &m)).unwrap_err();\n+        let e = resolve_model(Some(\"claude-sonnet-5-5\"), true, &(d.as_str(), &m)).unwrap_err();\n         assert!(e.downcast_ref::<NonClaudeViolationError>().is_some());\n     }\n \n     #[test]\n     fn require_non_claude_rejects_claude_default() {\n         let (_, m) = base();\n-        let e = resolve_model(None, true, &(\"claude-sonnet-4\", &m)).unwrap_err();\n+        let e = resolve_model(None, true, &(\"claude-sonnet-5-5\", &m)).unwrap_err();\n         assert!(e.downcast_ref::<NonClaudeViolationError>().is_some());\n     }\n \n     #[test]\n     fn require_non_claude_passes_non_claude() {\n         let (d, m) = base();\n-        let r = resolve_model(Some(\"grok-4.5-xhigh\"), true, &(d.as_str(), &m)).unwrap();\n-        assert_eq!(r.model, \"grok-4.5-xhigh\");\n-        assert_eq!(r.family, \"grok\");\n+        let r = resolve_model(Some(\"grok-4.7-high\"), true, &(d.as_str(), &m)).unwrap();\n+        assert_eq!(r.model, \"grok-4.7-high\");\n+        assert_eq!(r.backend, \"cursor\");\n+    }\n+\n+    #[test]\n+    fn claude_backend_is_not_implemented() {\n+        let (d, m) = base();\n+        let e = resolve_model(Some(\"claude-sonnet-5-5\"), false, &(d.as_str(), &m)).unwrap_err();\n+        let be = e.downcast_ref::<BackendNotImplementedError>().unwrap();\n+        assert_eq!(\n+            be.message,\n+            \"model \\\"claude-sonnet-5-5\\\" uses backend \\\"claude\\\", which is not implemented yet\"\n+        );\n     }\n \n     #[test]\n-    fn require_non_claude_false_allows_claude() {\n+    fn pi_backend_is_not_implemented() {\n         let (d, m) = base();\n-        let r = resolve_model(Some(\"claude-sonnet-4\"), false, &(d.as_str(), &m)).unwrap();\n-        assert_eq!(r.model, \"claude-sonnet-4\");\n-        assert_eq!(r.family, \"claude\");\n+        let e =\n+            resolve_model(Some(\"openai-codex/gpt-6-luna\"), false, &(d.as_str(), &m)).unwrap_err();\n+        let be = e.downcast_ref::<BackendNotImplementedError>().unwrap();\n+        assert_eq!(\n+            be.message,\n+            \"model \\\"openai-codex/gpt-6-luna\\\" uses backend \\\"pi\\\", which is not implemented yet\"\n+        );\n     }\n }\ndiff --git a/src/types.rs b/src/types.rs\nindex d938352..e8c5d54 100644\n--- a/src/types.rs\n+++ b/src/types.rs\n@@ -251,14 +251,14 @@ pub type PriceMap = std::collections::HashMap<String, Price>;\n #[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n pub struct ModelEntry {\n     pub label: String,\n-    pub family: String,\n+    pub backend: String,\n     pub price: Price,\n }\n \n #[derive(Debug, Clone, PartialEq)]\n pub struct ResolvedModel {\n     pub model: String,\n-    pub family: String,\n+    pub backend: String,\n     pub price: Price,\n }\n \n16:fn agent_script(listed: &str) -> String {\n37:    fn new(name: &str, script: &str) -> Self {\n47:    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n51:    fn delegate_with_bin(&self, args: &[&str], stdin: Option<&str>, bin: &str) -> Output {\n78:    fn drop(&mut self) {\n113:#[test]\n114:fn models_lists_all_twelve_with_default_marked() {\n149:#[test]\n150:fn doctor_passes_against_full_fake() {\n178:#[test]\n179:fn doctor_warns_on_missing_model_and_still_exits_0() {\n197:#[test]\n198:fn doctor_fails_when_binary_missing() {\n209:#[test]\n210:fn run_rejects_unimplemented_backend_with_exit_2() {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
