prompt_file.display()));\n85\t     }\n86\t \n87\t+    let mut supervise_args = vec![\n88\t+        \"__supervise\".to_string(),\n89\t+        id.clone(),\n90\t+        model.to_string(),\n91\t+        cap_name.to_string(),\n92\t+        cwd.clone(),\n93\t+    ];\n94\t+    if !gate.is_empty() {\n95\t+        supervise_args.push(\"--gate\".into());\n96\t+        supervise_args.push(gate);\n97\t+    }\n98\t+    if let Some(ms) = tool_idle_ms {\n99\t+        supervise_args.push(\"--tool-idle-ms\".into());\n100\t+        // Shortest round-trip so the supervisor parses the same number back.\n101\t+        supervise_args.push(ms.to_string());\n102\t+    }\n103\t+    if let Some(lock) = &held {\n104\t+        supervise_args.push(\"--lock-fd\".into());\n105\t+        supervise_args.push(lock.fd().to_string());\n106\t+    }\n107\t     // Own session and process group, stdio closed: the supervisor outlives this process.\n108\t+    // `held` stays open across the spawn so the inherited fd remains locked.\n109\t     let mut child = unsafe {\n110\t         Command::new(std::env::current_exe().map_err(|e| Usage(e.to_string()))?)\n111\t-            .args([\"__supervise\", &id, model, cap_name, &cwd])\n112\t+            .args(&supervise_args)\n113\t             .stdin(Stdio::null())\n114\t             .stdout(Stdio::null())\n115\t             .stderr(Stdio::null())\n116\t@@ -170,13 +227,36 @@ fn run(args: &[String]) -> Result<i32, Usage> {\n117\t \n118\t /// The detached half of `run`: drives one job, keeping its record fresh until it ends.\n119\t fn supervise(args: &[String]) -> i32 {\n120\t-    let [id, model, cap_name, cwd] = args else {\n121\t-        return 2;\n122\t-    };\n123\t     let fail = |m: String| {\n124\t         eprintln!(\"{m}\");\n125\t         1\n126\t     };\n127\t+    let (kv, pos) = match parse(args, &[\"--gate\", \"--tool-idle-ms\", \"--lock-fd\"]) {\n128\t+        Ok(v) => v,\n129\t+        Err(Usage(m)) => return fail(m),\n130\t+    };\n131\t+    let [id, m