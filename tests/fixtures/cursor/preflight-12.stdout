ber":15,"content":"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HGCobLa7Nx9QjMUKTdjMFz\",\"type\":\"tool_result\",\"content\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, r [... omitted end of long line]","contentTruncated":false,"isContextLine":false},{"lineNumber":20,"content":"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01FKZWbvxr8HjdhvcCbZixe8\",\"type\":\"tool_result\",\"content\":\"     1\\t#!/usr/bin/env bash\\n     2\\t# Run one prompt through a backend's raw headless CLI and save stdout/stderr as a parser fixture.\\n     3\\t#\\n     4\\t#   scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt\\n     5\\t#\\n     6\\t# BACKEND: cursor | pi | claude. CAPABILITY: read-only | read-write (pi rejects read-only).\\n     7\\t# SESSION resumes that backend session; pi and claude get a fresh id when it is omitted.\\n     8\\t# CANCEL_AFTER=N sends the CLI SIGTERM after N seconds.\\n     9\\t# Writes tests/fixtures/BACKEND/NAME.{stdout,stderr,argv}; prints the session id (if chosen) and exit code.\\n    10\\tset -uo pipefail\\n    11\\t\\n    12\\t[ $# -ge 4 ] || { sed -n 2,9p \\\"$0\\\"; exit 2; }\\n    13\\tbackend=$1 model=$2 cap=$3 name=$4 cwd=${5:-$PWD} session=${6:-}\\n    14\\there=\\\"$(cd \\\"$(dirname \\\"$0\\\")\\\" && pwd)\\\"\\n    15\\tout=\\\"$here/../t [... omitted end of long line]","contentTruncated":false,"isContextLine":false},{"lineNumber":61,"content":"{\"duration_api_ms\":40452,\"stop_reason\":\"end_turn\",\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"total_cost_usd\":0.24653500000000003,\"usage\":{\"input_tokens\":20,\"cache_creation_input_tokens\":33045,\"cache_read_input_tokens\":379575,\"output_tokens\":3840,\"output_tokens_details\":{\"thinking_tokens\":1844},\"server_tool_use\":{\"web_search_requests\":0,\"web_fetch_requests\":0},\"service_tier\":\"standard\",\"cache_creation\":{\"ephemeral_1h_input_tokens\":33045,\"ephemeral_5m_input_tokens\":0},\"inference_geo\":\"not_available\",\"iterations\":[{\"input_tokens\":2,\"output_tokens\":1120,\"cache_read_input_tokens\":44611,\"cache_creation_input_tokens\":365,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":365},\"type\":\"message\"}],\"speed\":\"standard\",\"fallback_credit\":null},\"modelUsage\":{\"claude-sonnet-5-5\":{\"inputTokens\":20,\"outputTokens\":3840,\"cacheReadInputTokens\":379575,\"cacheCreationInputTokens\":33045,\"webSearchRequests\":0,\"costUSD\":0.24653500000000003,\"contextWindow\":1000000,\"maxOutputToke [... omitted end of long line]","contentTruncated":false,"isContextLine":false}]},{"file":"tests/fixtures/claude/resume-answer.stdout","matches":[{"lineNumber":9,"content":"{\"type\":\"system\",\"subtype\":\"init\",\"cwd\":\"/private/tmp/claude-501/-Users-user-work-delegate/b6c92b35-d0b3-4033-aeb8-cccd1ebc9f27/scratchpad/w-claude\",\"session_id\":\"25dddfc3-4271-4019-9de0-6795bd6483fa\",\"tools\":[\"Task\",\"Bash\",\"CronCreate\",\"CronDelete\",\"CronList\",\"DesignSync\",\"Edit\",\"EnterWorktree\",\"ExitWorktree\",\"ListAgents\",\"Monitor\"