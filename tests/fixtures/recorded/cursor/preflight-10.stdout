{"type":"tool_call","subtype":"completed","call_id":"tool_0cc43245-f2f9-4ccd-8e02-6ebb5d084d6","tool_call":{"grepToolCall":{"args":{"pattern":"resume|cancel|PollResult|ResumeContext|supervisor","glob":"**/*.{rs,md}","caseInsensitive":false,"headLimit":80,"multiline":false,"toolCallId":"tool_0cc43245-f2f9-4ccd-8e02-6ebb5d084d6","offset":0},"result":{"success":{"pattern":"resume|cancel|PollResult|ResumeContext|supervisor","path":"","outputMode":"content","workspaceResults":{"/Users/user/work/delegate-fixtures":{"content":{"matches":[{"file":"./tests/e2e.rs","matches":[{"lineNumber":91,"content":"fn run_completes_and_cancel_kills_a_hung_agent() {","contentTruncated":false,"isContextLine":false},{"lineNumber":92,"content":"    let dir = scratch(\"cancel\");","contentTruncated":false,"isContextLine":false},{"lineNumber":106,"content":"    let cancelled = s.tool(3, \"cursor_cancel\", json!({\"jobId\": job}));","contentTruncated":false,"isContextLine":false},{"lineNumber":107,"content":"    assert_eq!(cancelled[\"status\"], \"CANCELLED\");","contentTruncated":false,"isContextLine":false},{"lineNumber":110,"content":"        \"cancel took {:?}\",","contentTruncated":false,"isContextLine":false},{"lineNumber":120,"content":"fn cancelled_request_gets_no_reply() {","contentTruncated":false,"isContextLine":false},{"lineNumber":121,"content":"    let dir = scratch(\"cancel-reply\");","contentTruncated":false,"isContextLine":false},{"lineNumber":137,"content":"        json!({\"jsonrpc\":\"2.0\",\"method\":\"notifications/cancelled\",","contentTruncated":false,"isContextLine":false},{"lineNumber":154,"content":"        assert_ne!(v[\"id\"], 2, \"reply sent for a cancelled request: {v}\");","contentTruncated":false,"isContextLine":false},{"lineNumber":159,"content":"    s.tool(4, \"cursor_cancel\", json!({\"jobId\": job}));","contentTruncated":false,"isContextLine":false}]},{"file":"./src/types.rs","matches":[{"lineNumber":348,"content":"pub struct ResumeContext {","contentTruncate