is not implemented yet) prints the actual error.\n        if e.downcast_ref::<crate::models::ModelNotAllowedError>()\n            .is_some()\n        {\n            return usage(unknown_model(&deps.config, model));\n        }\n        return usage(format!(\"{e}\"));\n    }\n    let mut prompt = String::new();\n    match flag(&kv, \"--prompt-file\") {\n        Some(f) => prompt = std::fs::read_to_string(f).map_err(|e| Usage(format!(\"{f}: {e}\")))?,\n        None => {\n            let _ = std::io::stdin().read_to_string(&mut prompt);\n        }\n    }\n    if prompt.trim().is_empty() {\n        return usage(\"prompt is empty\");\n    }\n    let cwd = match flag(&kv, \"--cwd\") {\n        Some(d) => resolve_path(d),\n        None => std::env::current_dir()\n            .map(|p| p.to_string_lossy().into_owned())\n            .map_err(|e| Usage(e.to_string()))?,\n    };\n    if !std::path::Path::new(&cwd).is_dir() {\n        return usage(format!(\"cwd {cwd} is not a directory\"));\n    }\n\n    match launch(LaunchParams {\n        prompt: &prompt,\n        model,\n        cap_name,\n        cwd: &cwd,\n        gate: &gate,\n        tool_idle_ms,\n        session: None,\n        resumed_from: None,\n    }) {\n        Ok(id) => {\n            println!(\"{id}\");\n            Ok(0)\n        }\n        Err(LaunchErr::Usage(m)) => Err(Usage(m)),\n        Err(LaunchErr::Done(c)) => Ok(c),\n    }\n}\n\nfn resume(args: &[String]) -> Result<i32, Usage> {\n    let (kv, pos) = parse(\n        args,\n        &[\"--model\", \"--capability\", \"--gate\", \"--prompt-file\"],\n\n[514 more lines in file. Use offset=300 to continue.]"}],"isError":false,"timestamp":1790855541898},{"role":"toolResult","toolCallId":"call_01a0f74eeff973c98da621e539c25fe0|fc_01a0f74eeff973c98da621e539c25fe0","toolName":"bash","content":[{"type":"text","text":"budgets.rs\ncli_e2e.rs\ncli_info_e2e.rs\nfixtures\nlive.rs\n13:# Stays RUNNING behind a grandchild: `sleep` inherits the agent's process group, so\n17: 