{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RTmsx6AoytRpJFZYnMCVSr","type":"tool_result","content":"     1\tdiff --git a/tests/budgets.rs b/tests/budgets.rs\n     2\tnew file mode 100644\n     3\tindex 0000000..5ae8eba\n     4\t--- /dev/null\n     5\t+++ b/tests/budgets.rs\n     6\t@@ -0,0 +1,338 @@\n     7\t+//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n     8\t+\n     9\t+use serde_json::Value;\n    10\t+use std::io::Write;\n    11\t+use std::os::unix::fs::PermissionsExt;\n    12\t+use std::path::PathBuf;\n    13\t+use std::process::{Command, Output, Stdio};\n    14\t+use std::sync::Mutex;\n    15\t+use std::time::{Duration, Instant};\n    16\t+\n    17\t+const FAKE_AGENT: &str = r#\"#!/bin/sh\n    18\t+printf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\n    19\t+rel=\"$(dirname \"$0\")/go\"\n    20\t+case \"$*\" in\n    21\t+  *CANCELME*)\n    22\t+    sleep 300 &\n    23\t+    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    24\t+    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    25\t+    i=0\n    26\t+    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    27\t+    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    28\t+    exit 0\n    29\t+    ;;\n    30\t+esac\n    31\t+case \"$*\" in\n    32\t+  *SLOW*)\n    33\t+    i=0\n    34\t+    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    35\t+    ;;\n    36\t+esac\n    37\t+printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n    38\t+\"#;\n    39\t+\n    40\t+const ABOUT: &str = \"\\\n    41\t+About Cursor CLI\n    42\t+\n    43\t+CLI Version         2026.09.28-64d2043\n    44\t+Model               Composer 2.5\n    45\t+Subscription Tier   Pro\n    46\t+User Email          alice@example.com\";\n    47\t+\n    48\t+const FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n    49\t+\n    50\t+fn info_agent_script() -> String {\n    51\t+    format!(\n    52\t+        r#\"#!/bin/sh\n    53\t+case \"$1\" in\n    54\t+  --version) echo \"2026.09.28-64d2043\" ;;\n    55\t+  about) printf '%s\\n' \"{ABOUT}\" ;;\n    56\t+  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n    57\t+  *) echo \"unexpected: $*\" >&2; exit 1 ;;\n    58\t+esac\n    59\t+\"#\n    60\t+    )\n    61\t+}\n    62\t+\n    63\t+const RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\n    64\t+const RESUME_BUDGET_MS: u128 = 93; // measured: 31ms on M-series Mac, budget 3x\n    65\t+const CANCEL_BUDGET_MS: u128 = 192; // measured: 64ms on M-series Mac, budget 3x\n    66\t+const WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\n    67\t+const DOCTOR_BUDGET_MS: u128 = 567; // measured: 189ms on M-series Mac, budget 3x\n    68\t+const MODELS_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\n    69\t+const SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n    70\t+\n    71\t+/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\n    72\t+static BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n    73\t+\n    74\t+fn serial_budgets(f: impl FnOnce()) {\n    75\t+    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    76\t+    f();\n    77\t+}\n    78\t+\n    79\t+struct Env {\n    80\t+    dir: PathBuf,\n    81\t+}\n    82\t+\n    83\t+impl Env {\n    84\t+    fn new(name: &str) -> Self {\n    85\t+        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n    86\t+        let _ = std::fs::remove_dir_all(&dir);\n    87\t+        std::fs::create_dir_all(&dir).unwrap();\n    88\t+        let agent = dir.join(\"agent.sh\");\n    89\t+        std::fs::write(&agent, FAKE_AGENT).unwrap();\n    90\t+        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n    91\t+        Env { dir }\n    92\t+    }\n    93\t+\n    94\t+    fn new_info(name: &str) -> Self {\n    95\t+        let dir =\n    96\t+            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n    97\t+        let _ = std::fs::remove_dir_all(&dir);\n    98\t+        std::fs::create_dir_all(&dir).unwrap();\n    99\t+        let agent = dir.join(\"agent.sh\");\n   100\t+        std::fs::write(&agent, info_agent_script()).unwrap();\n   101\t+        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n   102\t+        Env { dir }\n   103\t+    }\n   104\t+\n   105\t+    fn release(&self) {\n   106\t+        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n   107\t+    }\n   108\t+\n   109\t+    fn until_agent_spawned(&self) {\n   110\t+        let t = Instant::now();\n   111\t+        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n   112\t+            assert!(\n   113\t+                t.elapsed() < Duration::from_secs(10),\n   114\t+                \"timed out waiting for CANCELME agent\"\n   115\t+            );\n   116\t+            std::thread::sleep(Duration::from_millis(20));\n   117\t+        }\n   118\t+    }\n   119\t+\n   120\t+    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n   121\t+        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n   122\t+        cmd.args(args)\n   123\t+            .current_dir(&self.dir)\n   124\t+            .env(\"TMPDIR\", &self.dir)\n   125\t+            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n   126\t+            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n   127\t+        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n   128\t+            cmd.env(\n   129\t+                \"CURSOR_DELEGATE_HOST_PROFILE\",\n   130\t+                self.dir.join(\"nonexistent-profile.json\"),\n   131\t+            );\n   132\t+        }\n   133\t+        let mut child = cmd\n   134\t+            .stdin(Stdio::piped())\n   135\t+            .stdout(Stdio::piped())\n   136\t+            .stderr(Stdio::piped())\n   137\t+            .spawn()\n   138\t+            .unwrap();\n   139\t+        let mut si = child.stdin.take().unwrap();\n   140\t+        if let Some(s) = stdin {\n   141\t+            let _ = si.write_all(s.as_bytes());\n   142\t+        }\n   143\t+        drop(si);\n   144\t+        child.wait_with_output().unwrap()\n   145\t+    }\n   146\t+\n   147\t+    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n   148\t+        // One throwaway spawn so the timed sample is not paying a cold binary load.\n   149\t+        let _ = self.delegate(&[\"watch\", \"nope\"], None);\n   150\t+        let start = Instant::now();\n   151\t+        let out = self.delegate(args, stdin);\n   152\t+        (start.elapsed().as_millis(), out)\n   153\t+    }\n   154\t+\n   155\t+    fn run_id(&self, prompt: &str) -> String {\n   156\t+        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n   157\t+        assert!(\n   158\t+            out.status.success(),\n   159\t+            \"run failed in {ms}ms: stderr={} stdout={}\",\n   160\t+            String::from_utf8_lossy(&out.stderr),\n   161\t+            String::from_utf8_lossy(&out.stdout)\n   162\t+        );\n   163\t+        String::from_utf8(out.stdout).unwrap().trim().to_string()\n   164\t+    }\n   165\t+\n   166\t+    fn record(&self, id: &str) -> Value {\n   167\t+        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n   168\t+        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n   169\t+    }\n   170\t+\n   171\t+    fn wait_terminal(&self, id: &str) {\n   172\t+        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n   173\t+        assert_eq!(out.status.code(), Some(0));\n   174\t+    }\n   175\t+}\n   176\t+\n   177\t+impl Drop for Env {\n   178\t+    fn drop(&mut self) {\n   179\t+        let _ = std::fs::remove_dir_all(&self.dir);\n   180\t+    }\n   181\t+}\n   182\t+\n   183\t+fn until(what: &str, mut f: impl FnMut() -> bool) {\n   184\t+    let t = Instant::now();\n   185\t+    while !f() {\n   186\t+        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n   187\t+        std::thread::sleep(Duration::from_millis(20));\n   188\t+    }\n   189\t+}\n   190\t+\n   191\t+fn supervisor_rss_kb(pid: i32) -> u64 {\n   192\t+    let out = Command::new(\"ps\")\n   193\t+        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n   194\t+        .output()\n   195\t+        .expect(\"ps\");\n   196\t+    assert!(\n   197\t+        out.status.success(),\n   198\t+        \"ps failed: {}\",\n   199\t+        String::from_utf8_lossy(&out.stderr)\n   200\t+    );\n   201\t+    String::from_utf8_lossy(&out.stdout)\n   202\t+        .trim()\n   203\t+        .parse()\n   204\t+        .expect(\"rss parse\")\n   205\t+}\n   206\t+\n   207\t+#[test]\n   208\t+fn run_exits_within_wall_clock_budget() {\n   209\t+    serial_budgets(|| {\n   210\t+        let e = Env::new(\"run\");\n   211\t+        let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n   212\t+        assert!(\n   213\t+            out.status.success(),\n   214\t+            \"stderr={} stdout={}\",\n   215\t+            String::from_utf8_lossy(&out.stderr),\n   216\t+            String::from_utf8_lossy(&out.stdout)\n   217\t+        );\n   218\t+        let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n   219\t+        assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n   220\t+        assert!(\n   221\t+            ms <= RUN_BUDGET_MS,\n   222\t+            \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n   223\t+        );\n   224\t+        e.release();\n   225\t+        e.wait_terminal(&id);\n   226\t+    });\n   227\t+}\n   228\t+\n   229\t+#[test]\n   230\t+fn resume_exits_within_wall_clock_budget() {\n   231\t+    serial_budgets(|| {\n   232\t+        let e = Env::new(\"resume\");\n   233\t+        let a = e.run_id(\"quick\");\n   234\t+        e.wait_terminal(&a);\n   235\t+        let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n   236\t+        assert!(\n   237\t+            out.status.success(),\n   238\t+            \"stderr={} stdout={}\",\n   239\t+            String::from_utf8_lossy(&out.stderr),\n   240\t+            String::from_utf8_lossy(&out.stdout)\n   241\t+        );\n   242\t+        let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n   243\t+        assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n   244\t+        assert!(\n   245\t+            ms <= RESUME_BUDGET_MS,\n   246\t+            \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n   247\t+        );\n   248\t+        e.release();\n   249\t+        e.wait_terminal(&b);\n   250\t+    });\n   251\t+}\n   252\t+\n   253\t+#[test]\n   254\t+fn cancel_exits_within_wall_clock_budget() {\n   255\t+    serial_budgets(|| {\n   256\t+        let e = Env::new(\"cancel\");\n   257\t+        let id = e.run_id(\"CANCELME\");\n   258\t+        e.until_agent_spawned();\n   259\t+        assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n   260\t+        let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n   261\t+        assert_eq!(\n   262\t+            out.status.code(),\n   263\t+            Some(0),\n   264\t+            \"stderr={}\",\n   265\t+            String::from_utf8_lossy(&out.stderr)\n   266\t+        );\n   267\t+        assert!(\n   268\t+            ms <= CANCEL_BUDGET_MS,\n   269\t+            \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n   270\t+        );\n   271\t+    });\n   272\t+}\n   273\t+\n   274\t+#[test]\n   275\t+fn watch_terminal_job_within_wall_clock_budget() {\n   276\t+    serial_budgets(|| {\n   277\t+        let e = Env::new(\"watch\");\n   278\t+        let id = e.run_id(\"quick\");\n   279\t+        e.wait_terminal(&id);\n   280\t+        let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n   281\t+        assert_eq!(\n   282\t+            out.status.code(),\n   283\t+            Some(0),\n   284\t+            \"stderr={}\",\n   285\t+            String::from_utf8_lossy(&out.stderr)\n   286\t+        );\n   287\t+        assert!(\n   288\t+            ms <= WATCH_BUDGET_MS,\n   289\t+            \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n   290\t+        );\n   291\t+    });\n   292\t+}\n   293\t+\n   294\t+#[test]\n   295\t+fn doctor_exits_within_wall_clock_budget() {\n   296\t+    serial_budgets(|| {\n   297\t+        let e = Env::new_info(\"doctor\");\n   298\t+        let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n   299\t+        assert_eq!(\n   300\t+            out.status.code(),\n   301\t+            Some(0),\n   302\t+            \"stderr={}\",\n   303\t+            String::from_utf8_lossy(&out.stderr)\n   304\t+        );\n   305\t+        assert!(\n   306\t+            ms <= DOCTOR_BUDGET_MS,\n   307\t+            \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n   308\t+        );\n   309\t+    });\n   310\t+}\n   311\t+\n   312\t+#[test]\n   313\t+fn models_exits_within_wall_clock_budget() {\n   314\t+    serial_budgets(|| {\n   315\t+        let e = Env::new_info(\"models\");\n   316\t+        let (ms, out) = e.wall_ms(&[\"models\"], None);\n   317\t+        assert!(\n   318\t+            out.status.success(),\n   319\t+            \"stderr={}\",\n   320\t+            String::from_utf8_lossy(&out.stderr)\n   321\t+        );\n   322\t+        assert!(\n   323\t+            ms <= MODELS_BUDGET_MS,\n   324\t+            \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n   325\t+        );\n   326\t+    });\n   327\t+}\n   328\t+\n   329\t+#[test]\n   330\t+fn supervisor_rss_while_running_within_budget() {\n   331\t+    serial_budgets(|| {\n   332\t+        let e = Env::new(\"rss\");\n   333\t+        let id = e.run_id(\"SLOW\");\n   334\t+        until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n   335\t+        let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n   336\t+        let rss = supervisor_rss_kb(pid);\n   337\t+        assert!(\n   338\t+            rss <= SUPERVISOR_RSS_BUDGET_KB,\n   339\t+            \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n   340\t+        );\n   341\t+        e.release();\n   342\t+        e.wait_terminal(&id);\n   343\t+    });\n   344\t+}\nauthor:\tuser\nassociation:\towner\nedited:\tfalse\nstatus:\tnone\n--\n## Preflight rulings: orchestrator ruling (owner asleep; reversible)\n\n1. **Slow-run negative control:** no test-only delay hook in production code. The lane records the negative control in the PR instead: it adds a local sleep before `run` prints its id, shows the test failing, then removes the sleep.\n2. **Supervisor memory:** sample `ps -o rss= -p <supervisorPid>` (the pid comes from the status record) while the fake agent holds RUNNING. The same command works on macOS and Linux, so the test needs no per-OS code.\n3. **Latency endpoint:** wall clock until the process exits. `run` and `resume` exit right after printing the id.\n4. **Cases timed:** `watch` on an already-terminal job, with no timeout path. `cancel` on a RUNNING job whose fake agent exits on SIGTERM. `doctor` against fakes that exit 0.\n5. **Budget constants:** about 3x the local measurement, with the measured baseline in a comment beside each. No retries: if CI is noisy, raise the margin.\n6. **Fake agents** wait on release files, never on sleeps (the lesson from #7).\n--\nbudgets.rs\ncli_e2e.rs\ncli_info_e2e.rs\ne2e.rs\nfixtures\nlive.rs","is_error":false}]},"parent_tool_use_id":null,"session_id":"bc26522a-3803-4d63-8d60-9a2a2108782c","uuid":"85171926-cd07-4565-8471-230aeda5c1f3","timestamp":"2026-10-01T10:54:10.911Z","tool_use_result":{"stdout":"     1\tdiff --git a/tests/budgets.rs b/tests/budgets.rs\n     2\tnew file mode 100644\n     3\tindex 0000000..5ae8eba\n     4\t--- /dev/null\n     5\t+++ b/tests/budgets.rs\n     6\t@@ -0,0 +1,338 @@\n     7\t+//! Wall-clock and supervisor RSS budgets for the `delegate` CLI (debug test build).\n     8\t+\n     9\t+use serde_json::Value;\n    10\t+use std::io::Write;\n    11\t+use std::os::unix::fs::PermissionsExt;\n    12\t+use std::path::PathBuf;\n    13\t+use std::process::{Command, Output, Stdio};\n    14\t+use std::sync::Mutex;\n    15\t+use std::time::{Duration, Instant};\n    16\t+\n    17\t+const FAKE_AGENT: &str = r#\"#!/bin/sh\n    18\t+printf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\n    19\t+rel=\"$(dirname \"$0\")/go\"\n    20\t+case \"$*\" in\n    21\t+  *CANCELME*)\n    22\t+    sleep 300 &\n    23\t+    echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n    24\t+    echo $$ > \"$(dirname \"$0\")/agent.pid\"\n    25\t+    i=0\n    26\t+    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    27\t+    printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n    28\t+    exit 0\n    29\t+    ;;\n    30\t+esac\n    31\t+case \"$*\" in\n    32\t+  *SLOW*)\n    33\t+    i=0\n    34\t+    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    35\t+    ;;\n    36\t+esac\n    37\t+printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"391\\nSTATUS: DONE\",\"session_id\":\"s-1\"}'\n    38\t+\"#;\n    39\t+\n    40\t+const ABOUT: &str = \"\\\n    41\t+About Cursor CLI\n    42\t+\n    43\t+CLI Version         2026.09.28-64d2043\n    44\t+Model               Composer 2.5\n    45\t+Subscription Tier   Pro\n    46\t+User Email          alice@example.com\";\n    47\t+\n    48\t+const FULL_LIST: &str = \"composer-2.5 grok-4.7-high grok-4.7-xhigh\";\n    49\t+\n    50\t+fn info_agent_script() -> String {\n    51\t+    format!(\n    52\t+        r#\"#!/bin/sh\n    53\t+case \"$1\" in\n    54\t+  --version) echo \"2026.09.28-64d2043\" ;;\n    55\t+  about) printf '%s\\n' \"{ABOUT}\" ;;\n    56\t+  models|--list-models) printf '%s\\n' {FULL_LIST} ;;\n    57\t+  *) echo \"unexpected: $*\" >&2; exit 1 ;;\n    58\t+esac\n    59\t+\"#\n    60\t+    )\n    61\t+}\n    62\t+\n    63\t+const RUN_BUDGET_MS: u128 = 102; // measured: 34ms on M-series Mac, budget 3x\n    64\t+const RESUME_BUDGET_MS: u128 = 93; // measured: 31ms on M-series Mac, budget 3x\n    65\t+const CANCEL_BUDGET_MS: u128 = 192; // measured: 64ms on M-series Mac, budget 3x\n    66\t+const WATCH_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\n    67\t+const DOCTOR_BUDGET_MS: u128 = 567; // measured: 189ms on M-series Mac, budget 3x\n    68\t+const MODELS_BUDGET_MS: u128 = 6; // measured: 2ms on M-series Mac, budget 3x\n    69\t+const SUPERVISOR_RSS_BUDGET_KB: u64 = 8736; // measured: 2912KB on M-series Mac, budget 3x\n    70\t+\n    71\t+/// Wall-clock and RSS samples are not meaningful when these tests run in parallel.\n    72\t+static BUDGET_SERIAL: Mutex<()> = Mutex::new(());\n    73\t+\n    74\t+fn serial_budgets(f: impl FnOnce()) {\n    75\t+    let _guard = BUDGET_SERIAL.lock().unwrap_or_else(|e| e.into_inner());\n    76\t+    f();\n    77\t+}\n    78\t+\n    79\t+struct Env {\n    80\t+    dir: PathBuf,\n    81\t+}\n    82\t+\n    83\t+impl Env {\n    84\t+    fn new(name: &str) -> Self {\n    85\t+        let dir = std::env::temp_dir().join(format!(\"cdm-budget-{name}-{}\", std::process::id()));\n    86\t+        let _ = std::fs::remove_dir_all(&dir);\n    87\t+        std::fs::create_dir_all(&dir).unwrap();\n    88\t+        let agent = dir.join(\"agent.sh\");\n    89\t+        std::fs::write(&agent, FAKE_AGENT).unwrap();\n    90\t+        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n    91\t+        Env { dir }\n    92\t+    }\n    93\t+\n    94\t+    fn new_info(name: &str) -> Self {\n    95\t+        let dir =\n    96\t+            std::env::temp_dir().join(format!(\"cdm-budget-info-{name}-{}\", std::process::id()));\n    97\t+        let _ = std::fs::remove_dir_all(&dir);\n    98\t+        std::fs::create_dir_all(&dir).unwrap();\n    99\t+        let agent = dir.join(\"agent.sh\");\n   100\t+        std::fs::write(&agent, info_agent_script()).unwrap();\n   101\t+        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).unwrap();\n   102\t+        Env { dir }\n   103\t+    }\n   104\t+\n   105\t+    fn release(&self) {\n   106\t+        std::fs::write(self.dir.join(\"go\"), \"\").unwrap();\n   107\t+    }\n   108\t+\n   109\t+    fn until_agent_spawned(&self) {\n   110\t+        let t = Instant::now();\n   111\t+        while !(self.dir.join(\"agent.pid\").exists() && self.dir.join(\"grandchild.pid\").exists()) {\n   112\t+            assert!(\n   113\t+                t.elapsed() < Duration::from_secs(10),\n   114\t+                \"timed out waiting for CANCELME agent\"\n   115\t+            );\n   116\t+            std::thread::sleep(Duration::from_millis(20));\n   117\t+        }\n   118\t+    }\n   119\t+\n   120\t+    fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n   121\t+        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n   122\t+        cmd.args(args)\n   123\t+            .current_dir(&self.dir)\n   124\t+            .env(\"TMPDIR\", &self.dir)\n   125\t+            .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n   126\t+            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n   127\t+        if args.first() == Some(&\"models\") || args.first() == Some(&\"doctor\") {\n   128\t+            cmd.env(\n   129\t+                \"CURSOR_DELEGATE_HOST_PROFILE\",\n   130\t+                self.dir.join(\"nonexistent-profile.json\"),\n   131\t+            );\n   132\t+        }\n   133\t+        let mut child = cmd\n   134\t+            .stdin(Stdio::piped())\n   135\t+            .stdout(Stdio::piped())\n   136\t+            .stderr(Stdio::piped())\n   137\t+            .spawn()\n   138\t+            .unwrap();\n   139\t+        let mut si = child.stdin.take().unwrap();\n   140\t+        if let Some(s) = stdin {\n   141\t+            let _ = si.write_all(s.as_bytes());\n   142\t+        }\n   143\t+        drop(si);\n   144\t+        child.wait_with_output().unwrap()\n   145\t+    }\n   146\t+\n   147\t+    fn wall_ms(&self, args: &[&str], stdin: Option<&str>) -> (u128, Output) {\n   148\t+        // One throwaway spawn so the timed sample is not paying a cold binary load.\n   149\t+        let _ = self.delegate(&[\"watch\", \"nope\"], None);\n   150\t+        let start = Instant::now();\n   151\t+        let out = self.delegate(args, stdin);\n   152\t+        (start.elapsed().as_millis(), out)\n   153\t+    }\n   154\t+\n   155\t+    fn run_id(&self, prompt: &str) -> String {\n   156\t+        let (ms, out) = self.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(prompt));\n   157\t+        assert!(\n   158\t+            out.status.success(),\n   159\t+            \"run failed in {ms}ms: stderr={} stdout={}\",\n   160\t+            String::from_utf8_lossy(&out.stderr),\n   161\t+            String::from_utf8_lossy(&out.stdout)\n   162\t+        );\n   163\t+        String::from_utf8(out.stdout).unwrap().trim().to_string()\n   164\t+    }\n   165\t+\n   166\t+    fn record(&self, id: &str) -> Value {\n   167\t+        let p = self.dir.join(\"delegate-jobs\").join(format!(\"{id}.json\"));\n   168\t+        serde_json::from_str(&std::fs::read_to_string(p).unwrap()).unwrap()\n   169\t+    }\n   170\t+\n   171\t+    fn wait_terminal(&self, id: &str) {\n   172\t+        let out = self.delegate(&[\"watch\", id, \"--timeout\", \"15\"], None);\n   173\t+        assert_eq!(out.status.code(), Some(0));\n   174\t+    }\n   175\t+}\n   176\t+\n   177\t+impl Drop for Env {\n   178\t+    fn drop(&mut self) {\n   179\t+        let _ = std::fs::remove_dir_all(&self.dir);\n   180\t+    }\n   181\t+}\n   182\t+\n   183\t+fn until(what: &str, mut f: impl FnMut() -> bool) {\n   184\t+    let t = Instant::now();\n   185\t+    while !f() {\n   186\t+        assert!(t.elapsed() < Duration::from_secs(10), \"timed out: {what}\");\n   187\t+        std::thread::sleep(Duration::from_millis(20));\n   188\t+    }\n   189\t+}\n   190\t+\n   191\t+fn supervisor_rss_kb(pid: i32) -> u64 {\n   192\t+    let out = Command::new(\"ps\")\n   193\t+        .args([\"-o\", \"rss=\", \"-p\", &pid.to_string()])\n   194\t+        .output()\n   195\t+        .expect(\"ps\");\n   196\t+    assert!(\n   197\t+        out.status.success(),\n   198\t+        \"ps failed: {}\",\n   199\t+        String::from_utf8_lossy(&out.stderr)\n   200\t+    );\n   201\t+    String::from_utf8_lossy(&out.stdout)\n   202\t+        .trim()\n   203\t+        .parse()\n   204\t+        .expect(\"rss parse\")\n   205\t+}\n   206\t+\n   207\t+#[test]\n   208\t+fn run_exits_within_wall_clock_budget() {\n   209\t+    serial_budgets(|| {\n   210\t+        let e = Env::new(\"run\");\n   211\t+        let (ms, out) = e.wall_ms(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"SLOW brief\"));\n   212\t+        assert!(\n   213\t+            out.status.success(),\n   214\t+            \"stderr={} stdout={}\",\n   215\t+            String::from_utf8_lossy(&out.stderr),\n   216\t+            String::from_utf8_lossy(&out.stdout)\n   217\t+        );\n   218\t+        let id = String::from_utf8(out.stdout).unwrap().trim().to_string();\n   219\t+        assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n   220\t+        assert!(\n   221\t+            ms <= RUN_BUDGET_MS,\n   222\t+            \"run took {ms}ms, budget {RUN_BUDGET_MS}ms\"\n   223\t+        );\n   224\t+        e.release();\n   225\t+        e.wait_terminal(&id);\n   226\t+    });\n   227\t+}\n   228\t+\n   229\t+#[test]\n   230\t+fn resume_exits_within_wall_clock_budget() {\n   231\t+    serial_budgets(|| {\n   232\t+        let e = Env::new(\"resume\");\n   233\t+        let a = e.run_id(\"quick\");\n   234\t+        e.wait_terminal(&a);\n   235\t+        let (ms, out) = e.wall_ms(&[\"resume\", &a], Some(\"SLOW follow\"));\n   236\t+        assert!(\n   237\t+            out.status.success(),\n   238\t+            \"stderr={} stdout={}\",\n   239\t+            String::from_utf8_lossy(&out.stderr),\n   240\t+            String::from_utf8_lossy(&out.stdout)\n   241\t+        );\n   242\t+        let b = String::from_utf8(out.stdout).unwrap().trim().to_string();\n   243\t+        assert_eq!(e.record(&b)[\"status\"], \"RUNNING\");\n   244\t+        assert!(\n   245\t+            ms <= RESUME_BUDGET_MS,\n   246\t+            \"resume took {ms}ms, budget {RESUME_BUDGET_MS}ms\"\n   247\t+        );\n   248\t+        e.release();\n   249\t+        e.wait_terminal(&b);\n   250\t+    });\n   251\t+}\n   252\t+\n   253\t+#[test]\n   254\t+fn cancel_exits_within_wall_clock_budget() {\n   255\t+    serial_budgets(|| {\n   256\t+        let e = Env::new(\"cancel\");\n   257\t+        let id = e.run_id(\"CANCELME\");\n   258\t+        e.until_agent_spawned();\n   259\t+        assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n   260\t+        let (ms, out) = e.wall_ms(&[\"cancel\", &id], None);\n   261\t+        assert_eq!(\n   262\t+            out.status.code(),\n   263\t+            Some(0),\n   264\t+            \"stderr={}\",\n   265\t+            String::from_utf8_lossy(&out.stderr)\n   266\t+        );\n   267\t+        assert!(\n   268\t+            ms <= CANCEL_BUDGET_MS,\n   269\t+            \"cancel took {ms}ms, budget {CANCEL_BUDGET_MS}ms\"\n   270\t+        );\n   271\t+    });\n   272\t+}\n   273\t+\n   274\t+#[test]\n   275\t+fn watch_terminal_job_within_wall_clock_budget() {\n   276\t+    serial_budgets(|| {\n   277\t+        let e = Env::new(\"watch\");\n   278\t+        let id = e.run_id(\"quick\");\n   279\t+        e.wait_terminal(&id);\n   280\t+        let (ms, out) = e.wall_ms(&[\"watch\", &id], None);\n   281\t+        assert_eq!(\n   282\t+            out.status.code(),\n   283\t+            Some(0),\n   284\t+            \"stderr={}\",\n   285\t+            String::from_utf8_lossy(&out.stderr)\n   286\t+        );\n   287\t+        assert!(\n   288\t+            ms <= WATCH_BUDGET_MS,\n   289\t+            \"watch took {ms}ms, budget {WATCH_BUDGET_MS}ms\"\n   290\t+        );\n   291\t+    });\n   292\t+}\n   293\t+\n   294\t+#[test]\n   295\t+fn doctor_exits_within_wall_clock_budget() {\n   296\t+    serial_budgets(|| {\n   297\t+        let e = Env::new_info(\"doctor\");\n   298\t+        let (ms, out) = e.wall_ms(&[\"doctor\"], None);\n   299\t+        assert_eq!(\n   300\t+            out.status.code(),\n   301\t+            Some(0),\n   302\t+            \"stderr={}\",\n   303\t+            String::from_utf8_lossy(&out.stderr)\n   304\t+        );\n   305\t+        assert!(\n   306\t+            ms <= DOCTOR_BUDGET_MS,\n   307\t+            \"doctor took {ms}ms, budget {DOCTOR_BUDGET_MS}ms\"\n   308\t+        );\n   309\t+    });\n   310\t+}\n   311\t+\n   312\t+#[test]\n   313\t+fn models_exits_within_wall_clock_budget() {\n   314\t+    serial_budgets(|| {\n   315\t+        let e = Env::new_info(\"models\");\n   316\t+        let (ms, out) = e.wall_ms(&[\"models\"], None);\n   317\t+        assert!(\n   318\t+            out.status.success(),\n   319\t+            \"stderr={}\",\n   320\t+            String::from_utf8_lossy(&out.stderr)\n   321\t+        );\n   322\t+        assert!(\n   323\t+            ms <= MODELS_BUDGET_MS,\n   324\t+            \"models took {ms}ms, budget {MODELS_BUDGET_MS}ms\"\n   325\t+        );\n   326\t+    });\n   327\t+}\n   328\t+\n   329\t+#[test]\n   330\t+fn supervisor_rss_while_running_within_budget() {\n   331\t+    serial_budgets(|| {\n   332\t+        let e = Env::new(\"rss\");\n   333\t+        let id = e.run_id(\"SLOW\");\n   334\t+        until(\"RUNNING\", || e.record(&id)[\"status\"] == \"RUNNING\");\n   335\t+        let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap() as i32;\n   336\t+        let rss = supervisor_rss_kb(pid);\n   337\t+        assert!(\n   338\t+            rss <= SUPERVISOR_RSS_BUDGET_KB,\n   339\t+            \"supervisor rss {rss}KB, budget {SUPERVISOR_RSS_BUDGET_KB}KB\"\n   340\t+        );\n   341\t+        e.release();\n   342\t+        e.wait_terminal(&id);\n   343\t+    });\n   344\t+}\nauthor:\tuser\nassociation:\towner\nedited:\tfalse\nstatus:\tnone\n--\n## Preflight rulings: orchestrator ruling (owner asleep; reversible)\n\n1. **Slow-run negative control:** no test-only delay hook in production code. The lane records the negative control in the PR instead: it adds a local sleep before `run` prints its id, shows the test failing, then removes the sleep.\n2. **Supervisor memory:** sample `ps -o rss= -p <supervisorPid>` (the pid comes from the status record) while the fake agent holds RUNNING. The same command works on macOS and Linux, so the test needs no per-OS code.\n3. **Latency endpoint:** wall clock until the process exits. `run` and `resume` exit right after printing the id.\n4. **Cases timed:** `watch` on an already-terminal job, with no timeout path. `cancel` on a RUNNING job whose fake agent exits on SIGTERM. `doctor` against fakes that exit 0.\n5. **Budget constants:** about 3x the local measurement, with the measured baseline in a comment beside each. No retries: if CI is noisy, raise the margin.\n6. **Fake agents** wait on release files, never on sleeps (the lesson from #7).\n--\nbudgets.rs\ncli_e2e.rs\ncli_info_e2e.rs\ne2e.rs\nfixtures\nlive.rs","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
