n.\",\n  \"author\": {\n    \"name\": \"Amogh Akshintala\",\n    \"email\": \"amogh.akshintala@databricks.com\"\n  },\n  \"skills\": [\n    \"./skills/delegate\"\n  ],\n  \"mcpServers\": {\n    \"cursor-delegate\": {\n      \"type\": \"stdio\",\n      \"command\": \"${CLAUDE_PLUGIN_ROOT}/bin/cursor-delegate-mcp\",\n      \"timeout\": 600000\n    }\n  }\n}\n","afterFullFileContent":"{\n  \"name\": \"delegate\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Routes tasks to cursor-agent, pi, or Claude Code models through the delegate CLI.\",\n  \"author\": {\n    \"name\": \"Amogh Akshintala\",\n    \"email\": \"amogh.akshintala@databricks.com\"\n  },\n  \"skills\": [\n    \"./skills/delegate\"\n  ]\n}\n","message":"Wrote contents to /Users/user/work/delegate-13-contract/.claude-plugin/plugin.json"}}},"hookAdditionalContexts":[],"toolCallId":"tool_2aad3cd2-964d-42a3-b91b-bafb7701fc8","startedAtMs":"1790852810554","completedAtMs":"1790852811901"},"model_call_id":"8f7a3157-f7ea-43a2-87c7-1f6f92882945-7-thdh","session_id":"e2d994f1-ef61-48a1-b218-cde928b7cc82","timestamp_ms":1790852811833}
