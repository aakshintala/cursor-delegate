Users/user/work/delegate-fixtures && gh issue view 13\",\"workingDirectory\":\"\",\"timeout\":30000,\"toolCallId\":\"tool_3e4c77d5-c7e2-445e-ad31-e9f2d78c561\",\"simpleCommands\":[\"cd\",\"gh\"],\"hasInputRedirect\":false,\"hasOutputRedirect\":false,\"parsingResult\":{\"parsingFailed\":false,\"executableCommands\":[{\"name\":\"cd\",\"args\":[{\"type\":\"word\",\"value\":\"/Users/user/work/delegate-fixtures\"}],\"fullText\":\"cd /Users/user/work/delegate-fixtures\"},{\"name\":\"gh\",\"args\":[{\"type\":\"word\",\"value\":\"issue\"},{\"type\":\"word\",\"value\":\"view\"},{\"type\":\"number\",\"value\":\"13\"}],\"fullText\":\"gh issue view 13\"}],\"hasRedirects\":false,\"hasCommandSubstitution\":false,\"redirects\":[]},\"fileOutputThresholdBytes\":\"40000\",\"isBackground\":false,\"skipApproval\":false,\"timeoutBehavior\":\"TIMEOUT_BEHAVIOR_BACKGROUND\",\"hardTimeout\":86400000,\"description\":\"View GitHub issue #13\",\"clo [... omitted end of long line]","contentTruncated":false,"isContextLine":false}]},{"file":"./tests/fixtures/cursor/preflight-12.stdout","matches":[{"lineNumber":2,"content":"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Read-only doc preflight. Do not edit anything. Do not delegate further.\\n\\nRead GitHub issue #12 (`gh issue view 12`), spec #4 (`gh issue view 4` and its comments), and the owner rulings already posted on #7, #9, #10, #11 (`gh issue view N --comments`). Assume #7–#11 land as ruled. Then read the code on origin/main that #12 touches (src/cli.rs, tests/cli_e2e.rs, and whatever the ticket names).\\n\\nList, max 250 words total, one line each:\\n1. Contradictions between #12, #4, the rulings and the code.\\n2. Defaults or formats #12 leaves unstated that the lane must pick.\\n3. Failure cases with no stated behaviour.\\n4. Acceptance criteria that fight the spec or the code.\\nFor each give your recommended ruling in a few words, preferring the smallest change. End with a STATUS line.\\n\\nEnd your final message with a single trailing line that is exactly one of: STATUS: DONE, STATUS: DONE_WITH_CONCERNS, STATUS: BLOCKED, STAT [... omitted end of long line]","contentTruncated":false,"isContextLine":false},{"lineNumber":5,"content":"{\"type\":\"thinking\",\"subtype\":\"delta\",\"text\":\"\\n\\nFetching issue #12,\",\"session_id\":\"d0cbbbf5-5deb-40e3-a6cf-fb1778573e0a\",\"timestamp_ms\":1790845451547}","contentTruncated":false,"isContextLine":false},{"lineNumber":19,"content":"{\"type\":\"tool_call\",\"subtype\":\"started\",\"call_id\":\"tool_37da337c-5fa0-4723-ba1c-fa9f2fcb531\",\"tool_call\":{\"shellToolCall\":{\"args\":{\"command\":\"cd /Users/user/work/delegate-fixtures && gh issue view 12\",\"workingDirectory\":\"\",\"timeout\":30000,\"toolCallId\":\"tool_37da337c-5fa0-4723-ba1c-fa9f2fcb531\",\"simpleCommands\":[\"cd\",\"gh\"],\"hasInputRedirect\":false,\"hasOutputRedirect\":false,\"parsingResult\":{\"parsingFailed\":false,\"executableCommands\":[{\"name\":\"cd\",\"args\":[{\"type\":\"word\",\"value\":\"/Users/user/work/delegate-fixtures\"}],\"fullText\":\"cd /Users/user/work/delegate-fixtures\"},{\"name\":\"gh\",\"args\":[{\"type\":\"word\",\"value\":\"issue\"},{\"type\":\"word\",\"value\":\"view\"},{\"type\":\"number\",\"value\":\"12\"}],\"fullText\":\"gh issue view 12\"}],\"hasRedirects\":false,\"hasCommandSubstitution\":false,\"redirects\":[]},\"fileOutputThresholdBytes\":\"40000\",\"isBackground\":false,\"skipApproval\":false,\"timeoutBehavior\":\"TIMEOUT_BEHAVIOR_BACKGROUND\",\"hardTimeout\":86400000,\"description\":\"View GitHub issue #12\",\"close [... omitted end of long line]","contentTruncated":false,"isContextLine":false},{"lineNumber":23,"content":"{\"type\":\"tool_call\",\"subtype\":\"completed\",\"call_id\":\"tool_37da337c-5fa0-4723-ba1c-fa9f2fcb531\",\"tool_call\":{\"shellToolCall\":{\"args\":{\"command\":\"cd /Users/user/work/delegate-fixtures && gh issue view 12\",\"workingDirectory\":\"\",\"timeout\":30000,\"toolCallId\":\"tool