{"type":"tool_call","subtype":"started","call_id":"tool_c81e2b96-2aca-402b-9837-d2dc92332bf","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-13-contract/src/config.rs","streamContent":"                \"idleMs\": 1000\n            })\n            .to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"grok-4.7-high\");\n        assert!(cfg.models.contains_key(\"composer-2.5\"));\n        assert!(cfg.models.contains_key(\"openai-codex/gpt-6-luna\"));\n        assert_eq!(cfg.models[\"openai-codex/gpt-6-luna\"].backend, \"pi\");\n        assert_eq!(cfg.price_map[\"openai-codex/gpt-6-luna\"].output, 30.0);\n        assert_eq!(cfg.profile.idle_ms, Some(Some(1000.0)));\n    }"}},"hookAdditionalContexts":[],"toolCallId":"tool_c81e2b96-2aca-402b-9837-d2dc92332bf","startedAtMs":"1790852588141"},"model_call_id":"23978e36-7eb7-44ac-8d86-987b657a4703-23-t8u7","session_id":"e2d994f1-ef61-48a1-b218-cde928b7cc82","timestamp_ms":1790852590307}
{"type":"tool_call","subtype":"completed","call_id":"tool_c81e2b96-2aca-402b-9837-d2dc92332bf","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-13-contract/src/config.rs","streamContent":"                \"idleMs\": 1000\n            })\n            .to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"grok-4.7-high\");\n        assert!(cfg.models.contains_key(\"composer-2.5\"));\n        assert!(cfg.models.contains_key(\"openai-codex/gpt-6-luna\"));\n        assert_eq!(cfg.models[\"openai-codex/gpt-6-luna\"].backend, \"pi\");\n        assert_eq!(cfg.price_map[\"openai-codex/gpt-6-luna\"].output, 30.0);\n        assert_eq!(cfg.profile.idle_ms, Some(Some(1000.0)));\n    }"},"result":{"success":{"path":"/Users/user/work/delegate-13-contract/src/config.rs","linesAdded":2,"linesRemoved":7,"diffString":"--- a//Users/user/work/delegate-13-contract/src/config.rs\n+++ b//Users/user/work/delegate-13-contract/src/config.rs\n@@ -377,8 +377,7 @@\n                         \"price\": { \"input\": 5, \"output\": 30, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n                     }\n                 },\n-                \"requiredDeny\": [\"rm -rf /\"],\n-                \"deadlineMs\": 5000\n+                \"idleMs\": 1000\n             })\n             .to_string(),\n         );\n@@ -393,11 +392,7 @@\n         assert!(cfg.models.contains_key(\"openai-codex/gpt-6-luna\"));\n         assert_eq!(cfg.models[\"openai-codex/gpt-6-luna\"].backend, \"pi\");\n         assert_eq!(cfg.price_map[\"openai-codex/gpt-6-luna\"].output, 30.0);\n-        assert_eq!(\n-            cfg.profile.required_deny.as_ref().unwrap(),\n-            &[\"rm -rf /\".to_string()]\n-        );\n-        assert_eq!(cfg.profile.deadline_ms, Some(5000.0));\n+        assert_eq!(cfg.profile.idle_ms, Some(Some(1000.0)));\n     }\n \n     #[test]","beforeFullFileContent":"use crate::types::{Config, HostProfile, ModelEntry, Price, PriceMap};\nuse serde_json::Value;\nuse std::collections::HashMap;\n\npub const BUNDLED_MODELS_JSON: &str = include_str!(\"../config/models.json\");\n\npub type ReadFileFn = Box<dyn Fn(&str) -> Result<String, IoErr> + Send + Sync>;\n\n#[derive(Debug)]\npub struct IoErr {\n    pub code: Option<String>,\n    pub message: String,\n}\n\nimpl std::fmt::Display for IoErr {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(&self.message)\n    }\n}\nimpl std::error::Error for IoErr {}\n\nfn default_read_file(path: &str) -> Result<String, IoErr> {\n    match std::fs::read_to_string(path) {\n        Ok(s) => Ok(s),\n        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Err(IoErr {\n            code: Some(\"ENOENT\".into()),\n            message: e.to_string(),\n        }),\n        Err(e) => Err(IoErr {\n            code: None,\n            message: e.to_string(),\n        }),\n    }\n}\n\nfn read_json(\n    read_file: &dyn Fn(&str) -> Result<String, IoErr>,\n    path: &str,\n) -> Result<Option<Value>, Box<dyn std::error::Error + Send + Sync>> {\n    match read_file(path) {\n        Ok(s) => Ok(Some(serde_json::from_str(&s)?)),\n        Err(e) if e.code.as_deref() == Some(\"ENOENT\") => Ok(None),\n        Err(e) => Err(Box::new(e)),\n    }\n}\n\nfn is_record(v: &Value) -> bool {\n    v.is_object()\n}\n\nfn str_field(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<String, String> {\n    obj.get(field)\n        .and_then(|v| v.as_str())\n        .map(|s| s.to_string())\n        .ok_or_else(|| format!(\"invalid config: {where_}.{field} must be a string\"))\n}\n\nfn opt_str(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<String>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => v\n            .as_str()\n            .map(|s| Some(s.to_string()))\n            .ok_or_else(|| format!(\"invalid config: {where_}.{field} must be a string\")),\n    }\n}\n\nfn opt_str_array(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<Vec<String>>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => {\n            let arr = v.as_array().ok_or_else(|| {\n                format!(\"invalid config: {where_}.{field} must be an array of strings\")\n            })?;\n            if arr.iter().any(|x| !x.is_string()) {\n                return Err(format!(\n                    \"invalid config: {where_}.{field} must be an array of strings\"\n                ));\n            }\n            Ok(Some(\n                arr.iter()\n                    .filter_map(|x| x.as_str().map(|s| s.to_string()))\n                    .collect(),\n            ))\n        }\n    }\n}\n\nfn opt_finite(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<f64>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => {\n            let n = v\n                .as_f64()\n                .filter(|n| n.is_finite() && *n > 0.0)\n                .ok_or_else(|| {\n                    format!(\"invalid config: {where_}.{field} must be a positive finite number\")\n                })?;\n            Ok(Some(n))\n        }\n    }\n}\n\nfn opt_finite_or_null(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<Option<f64>>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) if v.is_null() => Ok(Some(None)),\n        Some(_) => Ok(Some(opt_finite(obj, field, where_)?)),\n    }\n}\n\nfn decode_price(raw: &Value, where_: &str) -> Result<Price, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_}.price must be an object\"))?;\n    let mut out = Price {\n        input: 0.0,\n        output: 0.0,\n        cache_read: 0.0,\n        cache_write: 0.0,\n    };\n    for (k, slot) in [\n        (\"input\", &mut out.input),\n        (\"output\", &mut out.output),\n        (\"cacheRead\", &mut out.cache_read),\n        (\"cacheWrite\", &mut out.cache_write),\n    ] {\n        let v = obj.get(k).and_then(|x| x.as_f64());\n        match v {\n            Some(n) if n.is_finite() && n >= 0.0 => *slot = n,\n            _ => {\n                return Err(format!(\n                    \"invalid config: {where_}.price.{k} must be a non-negative finite number\"\n                ));\n            }\n        }\n    }\n    Ok(out)\n}\n\nfn decode_model_entry(raw: &Value, id: &str, where_: &str) -> Result<ModelEntry, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_}[\\\"{id}\\\"] must be an object\"))?;\n    let loc = format!(\"{where_}[\\\"{id}\\\"]\");\n    Ok(ModelEntry {\n        label: str_field(obj, \"label\", &loc)?,\n        backend: str_field(obj, \"backend\", &loc)?,\n        price: decode_price(obj.get(\"price\").unwrap_or(&Value::Null), &loc)?,\n    })\n}\n\nfn decode_models(raw: &Value, where_: &str) -> Result<HashMap<String, ModelEntry>, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_} must be an object\"))?;\n    let mut out = HashMap::new();\n    for (id, entry) in obj {\n        out.insert(id.clone(), decode_model_entry(entry, id, where_)?);\n    }\n    Ok(out)\n}\n\nfn decode_host_profile(raw: Option<&Value>) -> Result<HostProfile, String> {\n    let Some(raw) = raw else {\n        return Ok(HostProfile::default());\n    };\n    if raw.is_null() {\n        return Ok(HostProfile::default());\n    }\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| \"invalid config: host profile must be an object\".to_string())?;\n    let mut profile = HostProfile::default();\n    if let Some(d) = opt_str(obj, \"default\", \"host-profile\")? {\n        profile.default = Some(d);\n    }\n    if let Some(models) = obj.get(\"models\") {\n        profile.models = Some(decode_models(models, \"host-profile.models\")?);\n    }\n    if let Some(g) = opt_str(obj, \"gate\", \"host-profile\")? {\n        profile.gate = Some(g);\n    }\n    if let Some(i) = opt_finite_or_null(obj, \"idleMs\", \"host-profile\")? {\n        profile.idle_ms = Some(i);\n    }\n    if let Some(i) = opt_finite_or_null(obj, \"toolIdleMs\", \"host-profile\")? {\n        profile.tool_idle_ms = Some(i);\n    }\n    Ok(profile)\n}\n\npub fn default_host_profile_path() -> String {\n    crate::util::homedir()\n        .join(\".config/cursor-delegate/host-profile.json\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub fn default_cli_config_path() -> String {\n    crate::util::homedir()\n        .join(\".cursor/cli-config.json\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub struct LoadConfigOpts {\n    pub models_path: String,\n    pub host_profile_path: Option<String>,\n    pub read_file: Option<ReadFileFn>,\n}\n\nfn to_price_map(models: &HashMap<String, ModelEntry>) -> PriceMap {\n    models.iter().map(|(id, e)| (id.clone(), e.price)).collect()\n}\n\npub fn load_config(\n    opts: LoadConfigOpts,\n) -> Result<Config, Box<dyn std::error::Error + Send + Sync>> {\n    let read_owned = opts.read_file;\n    let read_fn = |path: &str| -> Result<String, IoErr> {\n        if let Some(rf) = &read_owned {\n            rf(path)\n        } else {\n            default_read_file(path)\n        }\n    };\n    let profile_path = opts.host_profile_path.clone().unwrap_or_else(|| {\n        std::env::var(\"CURSOR_DELEGATE_HOST_PROFILE\")\n            .unwrap_or_else(|_| default_host_profile_path())\n    });\n\n    let file_raw = read_json(&read_fn, &opts.models_path)?;\n    let profile_raw = read_json(&read_fn, &profile_path)?;\n\n    let file_raw =\n        file_raw.ok_or_else(|| format!(\"invalid or missing models file: {}\", opts.models_path))?;\n    if !is_record(&file_raw) || !file_raw.get(\"default\").and_then(|d| d.as_str()).is_some() {\n        return Err(format!(\"invalid or missing models file: {}\", opts.models_path).into());\n    }\n    let file_models = decode_models(\n        file_raw.get(\"models\").unwrap_or(&Value::Null),\n        \"models.json.models\",\n    )?;\n    let profile = decode_host_profile(profile_raw.as_ref())?;\n\n    let mut models = file_models;\n    if let Some(pm) = &profile.models {\n        for (k, v) in pm {\n            models.insert(k.clone(), v.clone());\n        }\n    }\n    let default_model = profile\n        .default\n        .clone()\n        .unwrap_or_else(|| file_raw[\"default\"].as_str().unwrap().to_string());\n    if !models.contains_key(&default_model) {\n        return Err(\n            format!(\"default model \\\"{default_model}\\\" is not present in the models map\").into(),\n        );\n    }\n    Ok(Config {\n        price_map: to_price_map(&models),\n        default: default_model,\n        models,\n        profile,\n    })\n}\n\npub struct CliDeps {\n    pub config: Config,\n}\n\npub fn build_deps() -> Result<CliDeps, Box<dyn std::error::Error + Send + Sync>> {\n    let bundled = BUNDLED_MODELS_JSON.to_string();\n    let config = load_config(LoadConfigOpts {\n        models_path: \"<bundled>/models.json\".into(),\n        host_profile_path: None,\n        read_file: Some(Box::new(move |path: &str| {\n            if path == \"<bundled>/models.json\" {\n                Ok(bundled.clone())\n            } else {\n                std::fs::read_to_string(path).map_err(|e| IoErr {\n                    code: if e.kind() == std::io::ErrorKind::NotFound {\n                        Some(\"ENOENT\".into())\n                    } else {\n                        None\n                    },\n                    message: e.to_string(),\n                })\n            }\n        })),\n    })?;\n    Ok(CliDeps { config })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use std::collections::HashMap;\n    use std::sync::Arc;\n\n    const MODELS_DEFAULT: &str = r#\"{\n  \"default\": \"composer-2.5\",\n  \"models\": {\n    \"composer-2.5\": {\n      \"label\": \"Composer 2.5\",\n      \"backend\": \"cursor\",\n      \"price\": { \"input\": 0.5, \"output\": 2.5, \"cacheRead\": 0.2, \"cacheWrite\": 0 }\n    },\n    \"grok-4.7-high\": {\n      \"label\": \"Grok 4.7 High\",\n      \"backend\": \"cursor\",\n      \"price\": { \"input\": 2, \"output\": 6, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n    }\n  }\n}\"#;\n\n    fn reader(files: HashMap<String, String>) -> ReadFileFn {\n        let files = Arc::new(files);\n        Box::new(move |path: &str| {\n            files.get(path).cloned().ok_or_else(|| IoErr {\n                code: Some(\"ENOENT\".into()),\n                message: \"ENOENT\".into(),\n            })\n        })\n    }\n\n    #[test]\n    fn loads_models_and_derives_price_map() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/does-not-exist.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"composer-2.5\");\n        assert_eq!(cfg.models[\"composer-2.5\"].backend, \"cursor\");\n        assert_eq!(cfg.price_map[\"composer-2.5\"].input, 0.5);\n        assert_eq!(cfg.profile, HostProfile::default());\n    }\n\n    #[test]\n    fn merges_host_profile() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/profile.json\".into(),\n            serde_json::json!({\n                \"default\": \"grok-4.7-high\",\n                \"models\": {\n                    \"openai-codex/gpt-6-luna\": {\n                        \"label\": \"GPT-6 Luna\",\n                        \"backend\": \"pi\",\n                        \"price\": { \"input\": 5, \"output\": 30, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n                    }\n                },\n                \"requiredDeny\": [\"rm -rf /\"],\n                \"deadlineMs\": 5000\n            })\n            .to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"grok-4.7-high\");\n        assert!(cfg.models.contains_key(\"composer-2.5\"));\n        assert!(cfg.models.contains_key(\"openai-codex/gpt-6-luna\"));\n        assert_eq!(cfg.models[\"openai-codex/gpt-6-luna\"].backend, \"pi\");\n        assert_eq!(cfg.price_map[\"openai-codex/gpt-6-luna\"].output, 30.0);\n        assert_eq!(\n            cfg.profile.required_deny.as_ref().unwrap(),\n            &[\"rm -rf /\".to_string()]\n        );\n        assert_eq!(cfg.profile.deadline_ms, Some(5000.0));\n    }\n\n    #[test]\n    fn missing_host_profile_is_empty() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/does-not-exist.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.profile, HostProfile::default());\n        assert_eq!(cfg.default, \"composer-2.5\");\n        assert!(cfg.price_map.contains_key(\"composer-2.5\"));\n    }\n\n    #[test]\n    fn throws_when_default_absent() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/profile.json\".into(),\n            serde_json::json!({\"default\":\"not-a-real-model\"}).to_string(),\n        );\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"default\"));\n    }\n\n    #[test]\n    fn rejects_non_finite_price() {\n        let bad = serde_json::json!({\n            \"default\":\"m\",\n            \"models\":{\"m\":{\"label\":\"M\",\"backend\":\"cursor\",\"price\":{\"input\":null,\"output\":1,\"cacheRead\":0,\"cacheWrite\":0}}}\n        })\n        .to_string();\n        // NaN is not valid JSON; use a missing-like invalid (string) which fails the number check.\n        let bad = bad.replace(\"null\", \"\\\"nan\\\"\");\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), bad);\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/x.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"price.input\"));\n    }\n\n    #[test]\n    fn rejects_missing_price_field() {\n        let bad = serde_json::json!({\n            \"default\":\"m\",\n            \"models\":{\"m\":{\"label\":\"M\",\"backend\":\"cursor\",\"price\":{\"input\":1,\"output\":1,\"cacheRead\":0}}}\n        })\n        .to_string();\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), bad);\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/x.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"price.cacheWrite\"));\n    }\n\n    #[test]\n    fn rejects_bad_deadline() {\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/p.json\".into(),\n            serde_json::json!({\"deadlineMs\":\"soon\"}).to_string(),\n        );\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/p.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"deadlineMs\"));\n    }\n\n    #[test]\n    fn rejects_bad_required_deny() {\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/p.json\".into(),\n            serde_json::json!({\"requiredDeny\":[1,2]}).to_string(),\n        );\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/p.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"requiredDeny\"));\n    }\n\n    #[test]\n    fn accepts_null_idle() {\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/p.json\".into(),\n            serde_json::json!({\"idleMs\":null,\"toolIdleMs\":null,\"deadlineMs\":1000}).to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/p.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.profile.idle_ms, Some(None));\n        assert_eq!(cfg.profile.tool_idle_ms, Some(None));\n    }\n}\n","afterFullFileContent":"use crate::types::{Config, HostProfile, ModelEntry, Price, PriceMap};\nuse serde_json::Value;\nuse std::collections::HashMap;\n\npub const BUNDLED_MODELS_JSON: &str = include_str!(\"../config/models.json\");\n\npub type ReadFileFn = Box<dyn Fn(&str) -> Result<String, IoErr> + Send + Sync>;\n\n#[derive(Debug)]\npub struct IoErr {\n    pub code: Option<String>,\n    pub message: String,\n}\n\nimpl std::fmt::Display for IoErr {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(&self.message)\n    }\n}\nimpl std::error::Error for IoErr {}\n\nfn default_read_file(path: &str) -> Result<String, IoErr> {\n    match std::fs::read_to_string(path) {\n        Ok(s) => Ok(s),\n        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Err(IoErr {\n            code: Some(\"ENOENT\".into()),\n            message: e.to_string(),\n        }),\n        Err(e) => Err(IoErr {\n            code: None,\n            message: e.to_string(),\n        }),\n    }\n}\n\nfn read_json(\n    read_file: &dyn Fn(&str) -> Result<String, IoErr>,\n    path: &str,\n) -> Result<Option<Value>, Box<dyn std::error::Error + Send + Sync>> {\n    match read_file(path) {\n        Ok(s) => Ok(Some(serde_json::from_str(&s)?)),\n        Err(e) if e.code.as_deref() == Some(\"ENOENT\") => Ok(None),\n        Err(e) => Err(Box::new(e)),\n    }\n}\n\nfn is_record(v: &Value) -> bool {\n    v.is_object()\n}\n\nfn str_field(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<String, String> {\n    obj.get(field)\n        .and_then(|v| v.as_str())\n        .map(|s| s.to_string())\n        .ok_or_else(|| format!(\"invalid config: {where_}.{field} must be a string\"))\n}\n\nfn opt_str(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<String>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => v\n            .as_str()\n            .map(|s| Some(s.to_string()))\n            .ok_or_else(|| format!(\"invalid config: {where_}.{field} must be a string\")),\n    }\n}\n\nfn opt_str_array(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<Vec<String>>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => {\n            let arr = v.as_array().ok_or_else(|| {\n                format!(\"invalid config: {where_}.{field} must be an array of strings\")\n            })?;\n            if arr.iter().any(|x| !x.is_string()) {\n                return Err(format!(\n                    \"invalid config: {where_}.{field} must be an array of strings\"\n                ));\n            }\n            Ok(Some(\n                arr.iter()\n                    .filter_map(|x| x.as_str().map(|s| s.to_string()))\n                    .collect(),\n            ))\n        }\n    }\n}\n\nfn opt_finite(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<f64>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => {\n            let n = v\n                .as_f64()\n                .filter(|n| n.is_finite() && *n > 0.0)\n                .ok_or_else(|| {\n                    format!(\"invalid config: {where_}.{field} must be a positive finite number\")\n                })?;\n            Ok(Some(n))\n        }\n    }\n}\n\nfn opt_finite_or_null(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<Option<f64>>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) if v.is_null() => Ok(Some(None)),\n        Some(_) => Ok(Some(opt_finite(obj, field, where_)?)),\n    }\n}\n\nfn decode_price(raw: &Value, where_: &str) -> Result<Price, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_}.price must be an object\"))?;\n    let mut out = Price {\n        input: 0.0,\n        output: 0.0,\n        cache_read: 0.0,\n        cache_write: 0.0,\n    };\n    for (k, slot) in [\n        (\"input\", &mut out.input),\n        (\"output\", &mut out.output),\n        (\"cacheRead\", &mut out.cache_read),\n        (\"cacheWrite\", &mut out.cache_write),\n    ] {\n        let v = obj.get(k).and_then(|x| x.as_f64());\n        match v {\n            Some(n) if n.is_finite() && n >= 0.0 => *slot = n,\n            _ => {\n                return Err(format!(\n                    \"invalid config: {where_}.price.{k} must be a non-negative finite number\"\n                ));\n            }\n        }\n    }\n    Ok(out)\n}\n\nfn decode_model_entry(raw: &Value, id: &str, where_: &str) -> Result<ModelEntry, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_}[\\\"{id}\\\"] must be an object\"))?;\n    let loc = format!(\"{where_}[\\\"{id}\\\"]\");\n    Ok(ModelEntry {\n        label: str_field(obj, \"label\", &loc)?,\n        backend: str_field(obj, \"backend\", &loc)?,\n        price: decode_price(obj.get(\"price\").unwrap_or(&Value::Null), &loc)?,\n    })\n}\n\nfn decode_models(raw: &Value, where_: &str) -> Result<HashMap<String, ModelEntry>, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_} must be an object\"))?;\n    let mut out = HashMap::new();\n    for (id, entry) in obj {\n        out.insert(id.clone(), decode_model_entry(entry, id, where_)?);\n    }\n    Ok(out)\n}\n\nfn decode_host_profile(raw: Option<&Value>) -> Result<HostProfile, String> {\n    let Some(raw) = raw else {\n        return Ok(HostProfile::default());\n    };\n    if raw.is_null() {\n        return Ok(HostProfile::default());\n    }\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| \"invalid config: host profile must be an object\".to_string())?;\n    let mut profile = HostProfile::default();\n    if let Some(d) = opt_str(obj, \"default\", \"host-profile\")? {\n        profile.default = Some(d);\n    }\n    if let Some(models) = obj.get(\"models\") {\n        profile.models = Some(decode_models(models, \"host-profile.models\")?);\n    }\n    if let Some(g) = opt_str(obj, \"gate\", \"host-profile\")? {\n        profile.gate = Some(g);\n    }\n    if let Some(i) = opt_finite_or_null(obj, \"idleMs\", \"host-profile\")? {\n        profile.idle_ms = Some(i);\n    }\n    if let Some(i) = opt_finite_or_null(obj, \"toolIdleMs\", \"host-profile\")? {\n        profile.tool_idle_ms = Some(i);\n    }\n    Ok(profile)\n}\n\npub fn default_host_profile_path() -> String {\n    crate::util::homedir()\n        .join(\".config/cursor-delegate/host-profile.json\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub fn default_cli_config_path() -> String {\n    crate::util::homedir()\n        .join(\".cursor/cli-config.json\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub struct LoadConfigOpts {\n    pub models_path: String,\n    pub host_profile_path: Option<String>,\n    pub read_file: Option<ReadFileFn>,\n}\n\nfn to_price_map(models: &HashMap<String, ModelEntry>) -> PriceMap {\n    models.iter().map(|(id, e)| (id.clone(), e.price)).collect()\n}\n\npub fn load_config(\n    opts: LoadConfigOpts,\n) -> Result<Config, Box<dyn std::error::Error + Send + Sync>> {\n    let read_owned = opts.read_file;\n    let read_fn = |path: &str| -> Result<String, IoErr> {\n        if let Some(rf) = &read_owned {\n            rf(path)\n        } else {\n            default_read_file(path)\n        }\n    };\n    let profile_path = opts.host_profile_path.clone().unwrap_or_else(|| {\n        std::env::var(\"CURSOR_DELEGATE_HOST_PROFILE\")\n            .unwrap_or_else(|_| default_host_profile_path())\n    });\n\n    let file_raw = read_json(&read_fn, &opts.models_path)?;\n    let profile_raw = read_json(&read_fn, &profile_path)?;\n\n    let file_raw =\n        file_raw.ok_or_else(|| format!(\"invalid or missing models file: {}\", opts.models_path))?;\n    if !is_record(&file_raw) || !file_raw.get(\"default\").and_then(|d| d.as_str()).is_some() {\n        return Err(format!(\"invalid or missing models file: {}\", opts.models_path).into());\n    }\n    let file_models = decode_models(\n        file_raw.get(\"models\").unwrap_or(&Value::Null),\n        \"models.json.models\",\n    )?;\n    let profile = decode_host_profile(profile_raw.as_ref())?;\n\n    let mut models = file_models;\n    if let Some(pm) = &profile.models {\n        for (k, v) in pm {\n            models.insert(k.clone(), v.clone());\n        }\n    }\n    let default_model = profile\n        .default\n        .clone()\n        .unwrap_or_else(|| file_raw[\"default\"].as_str().unwrap().to_string());\n    if !models.contains_key(&default_model) {\n        return Err(\n            format!(\"default model \\\"{default_model}\\\" is not present in the models map\").into(),\n        );\n    }\n    Ok(Config {\n        price_map: to_price_map(&models),\n        default: default_model,\n        models,\n        profile,\n    })\n}\n\npub struct CliDeps {\n    pub config: Config,\n}\n\npub fn build_deps() -> Result<CliDeps, Box<dyn std::error::Error + Send + Sync>> {\n    let bundled = BUNDLED_MODELS_JSON.to_string();\n    let config = load_config(LoadConfigOpts {\n        models_path: \"<bundled>/models.json\".into(),\n        host_profile_path: None,\n        read_file: Some(Box::new(move |path: &str| {\n            if path == \"<bundled>/models.json\" {\n                Ok(bundled.clone())\n            } else {\n                std::fs::read_to_string(path).map_err(|e| IoErr {\n                    code: if e.kind() == std::io::ErrorKind::NotFound {\n                        Some(\"ENOENT\".into())\n                    } else {\n                        None\n                    },\n                    message: e.to_string(),\n                })\n            }\n        })),\n    })?;\n    Ok(CliDeps { config })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use std::collections::HashMap;\n    use std::sync::Arc;\n\n    const MODELS_DEFAULT: &str = r#\"{\n  \"default\": \"composer-2.5\",\n  \"models\": {\n    \"composer-2.5\": {\n      \"label\": \"Composer 2.5\",\n      \"backend\": \"cursor\",\n      \"price\": { \"input\": 0.5, \"output\": 2.5, \"cacheRead\": 0.2, \"cacheWrite\": 0 }\n    },\n    \"grok-4.7-high\": {\n      \"label\": \"Grok 4.7 High\",\n      \"backend\": \"cursor\",\n      \"price\": { \"input\": 2, \"output\": 6, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n    }\n  }\n}\"#;\n\n    fn reader(files: HashMap<String, String>) -> ReadFileFn {\n        let files = Arc::new(files);\n        Box::new(move |path: &str| {\n            files.get(path).cloned().ok_or_else(|| IoErr {\n                code: Some(\"ENOENT\".into()),\n                message: \"ENOENT\".into(),\n            })\n        })\n    }\n\n    #[test]\n    fn loads_models_and_derives_price_map() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/does-not-exist.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"composer-2.5\");\n        assert_eq!(cfg.models[\"composer-2.5\"].backend, \"cursor\");\n        assert_eq!(cfg.price_map[\"composer-2.5\"].input, 0.5);\n        assert_eq!(cfg.profile, HostProfile::default());\n    }\n\n    #[test]\n    fn merges_host_profile() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/profile.json\".into(),\n            serde_json::json!({\n                \"default\": \"grok-4.7-high\",\n                \"models\": {\n                    \"openai-codex/gpt-6-luna\": {\n                        \"label\": \"GPT-6 Luna\",\n                        \"backend\": \"pi\",\n                        \"price\": { \"input\": 5, \"output\": 30, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n                    }\n                },\n                \"idleMs\": 1000\n            })\n            .to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"grok-4.7-high\");\n        assert!(cfg.models.contains_key(\"composer-2.5\"));\n        assert!(cfg.models.contains_key(\"openai-codex/gpt-6-luna\"));\n        assert_eq!(cfg.models[\"openai-codex/gpt-6-luna\"].backend, \"pi\");\n        assert_eq!(cfg.price_map[\"openai-codex/gpt-6-luna\"].output, 30.0);\n        assert_eq!(cfg.profile.idle_ms, Some(Some(1000.0)));\n    }\n\n    #[test]\n    fn missing_host_profile_is_empty() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/does-not-exist.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.profile, HostProfile::default());\n        assert_eq!(cfg.default, \"composer-2.5\");\n        assert!(cfg.price_map.contains_key(\"composer-2.5\"));\n    }\n\n    #[test]\n    fn throws_when_default_absent() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/profile.json\".into(),\n            serde_json::json!({\"default\":\"not-a-real-model\"}).to_string(),\n        );\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"default\"));\n    }\n\n    #[test]\n    fn rejects_non_finite_price() {\n        let bad = serde_json::json!({\n            \"default\":\"m\",\n            \"models\":{\"m\":{\"label\":\"M\",\"backend\":\"cursor\",\"price\":{\"input\":null,\"output\":1,\"cacheRead\":0,\"cacheWrite\":0}}}\n        })\n        .to_string();\n        // NaN is not valid JSON; use a missing-like invalid (string) which fails the number check.\n        let bad = bad.replace(\"null\", \"\\\"nan\\\"\");\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), bad);\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/x.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"price.input\"));\n    }\n\n    #[test]\n    fn rejects_missing_price_field() {\n        let bad = serde_json::json!({\n            \"default\":\"m\",\n            \"models\":{\"m\":{\"label\":\"M\",\"backend\":\"cursor\",\"price\":{\"input\":1,\"output\":1,\"cacheRead\":0}}}\n        })\n        .to_string();\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), bad);\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/x.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"price.cacheWrite\"));\n    }\n\n    #[test]\n    fn rejects_bad_deadline() {\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/p.json\".into(),\n            serde_json::json!({\"deadlineMs\":\"soon\"}).to_string(),\n        );\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/p.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"deadlineMs\"));\n    }\n\n    #[test]\n    fn rejects_bad_required_deny() {\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/p.json\".into(),\n            serde_json::json!({\"requiredDeny\":[1,2]}).to_string(),\n        );\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/p.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"requiredDeny\"));\n    }\n\n    #[test]\n    fn accepts_null_idle() {\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/p.json\".into(),\n            serde_json::json!({\"idleMs\":null,\"toolIdleMs\":null,\"deadlineMs\":1000}).to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/p.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.profile.idle_ms, Some(None));\n        assert_eq!(cfg.profile.tool_idle_ms, Some(None));\n    }\n}\n","message":"The file /Users/user/work/delegate-13-contract/src/config.rs has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"tool_c81e2b96-2aca-402b-9837-d2dc92332bf","startedAtMs":"1790852588141","completedAtMs":"1790852591509"},"model_call_id":"23978e36-7eb7-44ac-8d86-987b657a4703-23-t8u7","session_id":"e2d994f1-ef61-48a1-b218-cde928b7cc82","timestamp_ms":1790852591444}
{"type":"tool_call","subtype":"started","call_id":"tool_972e47b8-3ffc-41eb-af0a-ba7a8e04511","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-13-contract/src/config.rs","streamContent":"    #[test]\n    fn accepts_null_idle() {"}},"hookAdditionalContexts":[],"toolCallId":"tool_972e47b8-3ffc-41eb-af0a-ba7a8e04511","startedAtMs":"1790852590404"},"model_call_id":"23978e36-7eb7-44ac-8d86-987b657a4703-23-t8u7","session_id":"e2d994f1-ef61-48a1-b218-cde928b7cc82","timestamp_ms":1790852591974}
{"type":"tool_call","subtype":"completed","call_id":"tool_972e47b8-3ffc-41eb-af0a-ba7a8e04511","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-13-contract/src/config.rs","streamContent":"    #[test]\n    fn accepts_null_idle() {"},"result":{"success":{"path":"/Users/user/work/delegate-13-contract/src/config.rs","linesAdded":0,"linesRemoved":34,"diffString":"--- a//Users/user/work/delegate-13-contract/src/config.rs\n+++ b//Users/user/work/delegate-13-contract/src/config.rs\n@@ -466,40 +466,6 @@\n     }\n \n     #[test]\n-    fn rejects_bad_deadline() {\n-        let mut files = HashMap::new();\n-        files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n-        files.insert(\n-            \"/p.json\".into(),\n-            serde_json::json!({\"deadlineMs\":\"soon\"}).to_string(),\n-        );\n-        let e = load_config(LoadConfigOpts {\n-            models_path: \"/m.json\".into(),\n-            host_profile_path: Some(\"/p.json\".into()),\n-            read_file: Some(reader(files)),\n-        })\n-        .unwrap_err();\n-        assert!(e.to_string().contains(\"deadlineMs\"));\n-    }\n-\n-    #[test]\n-    fn rejects_bad_required_deny() {\n-        let mut files = HashMap::new();\n-        files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n-        files.insert(\n-            \"/p.json\".into(),\n-            serde_json::json!({\"requiredDeny\":[1,2]}).to_string(),\n-        );\n-        let e = load_config(LoadConfigOpts {\n-            models_path: \"/m.json\".into(),\n-            host_profile_path: Some(\"/p.json\".into()),\n-            read_file: Some(reader(files)),\n-        })\n-        .unwrap_err();\n-        assert!(e.to_string().contains(\"requiredDeny\"));\n-    }\n-\n-    #[test]\n     fn accepts_null_idle() {\n         let mut files = HashMap::new();\n         files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());","beforeFullFileContent":"use crate::types::{Config, HostProfile, ModelEntry, Price, PriceMap};\nuse serde_json::Value;\nuse std::collections::HashMap;\n\npub const BUNDLED_MODELS_JSON: &str = include_str!(\"../config/models.json\");\n\npub type ReadFileFn = Box<dyn Fn(&str) -> Result<String, IoErr> + Send + Sync>;\n\n#[derive(Debug)]\npub struct IoErr {\n    pub code: Option<String>,\n    pub message: String,\n}\n\nimpl std::fmt::Display for IoErr {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(&self.message)\n    }\n}\nimpl std::error::Error for IoErr {}\n\nfn default_read_file(path: &str) -> Result<String, IoErr> {\n    match std::fs::read_to_string(path) {\n        Ok(s) => Ok(s),\n        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Err(IoErr {\n            code: Some(\"ENOENT\".into()),\n            message: e.to_string(),\n        }),\n        Err(e) => Err(IoErr {\n            code: None,\n            message: e.to_string(),\n        }),\n    }\n}\n\nfn read_json(\n    read_file: &dyn Fn(&str) -> Result<String, IoErr>,\n    path: &str,\n) -> Result<Option<Value>, Box<dyn std::error::Error + Send + Sync>> {\n    match read_file(path) {\n        Ok(s) => Ok(Some(serde_json::from_str(&s)?)),\n        Err(e) if e.code.as_deref() == Some(\"ENOENT\") => Ok(None),\n        Err(e) => Err(Box::new(e)),\n    }\n}\n\nfn is_record(v: &Value) -> bool {\n    v.is_object()\n}\n\nfn str_field(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<String, String> {\n    obj.get(field)\n        .and_then(|v| v.as_str())\n        .map(|s| s.to_string())\n        .ok_or_else(|| format!(\"invalid config: {where_}.{field} must be a string\"))\n}\n\nfn opt_str(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<String>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => v\n            .as_str()\n            .map(|s| Some(s.to_string()))\n            .ok_or_else(|| format!(\"invalid config: {where_}.{field} must be a string\")),\n    }\n}\n\nfn opt_str_array(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<Vec<String>>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => {\n            let arr = v.as_array().ok_or_else(|| {\n                format!(\"invalid config: {where_}.{field} must be an array of strings\")\n            })?;\n            if arr.iter().any(|x| !x.is_string()) {\n                return Err(format!(\n                    \"invalid config: {where_}.{field} must be an array of strings\"\n                ));\n            }\n            Ok(Some(\n                arr.iter()\n                    .filter_map(|x| x.as_str().map(|s| s.to_string()))\n                    .collect(),\n            ))\n        }\n    }\n}\n\nfn opt_finite(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<f64>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => {\n            let n = v\n                .as_f64()\n                .filter(|n| n.is_finite() && *n > 0.0)\n                .ok_or_else(|| {\n                    format!(\"invalid config: {where_}.{field} must be a positive finite number\")\n                })?;\n            Ok(Some(n))\n        }\n    }\n}\n\nfn opt_finite_or_null(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<Option<f64>>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) if v.is_null() => Ok(Some(None)),\n        Some(_) => Ok(Some(opt_finite(obj, field, where_)?)),\n    }\n}\n\nfn decode_price(raw: &Value, where_: &str) -> Result<Price, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_}.price must be an object\"))?;\n    let mut out = Price {\n        input: 0.0,\n        output: 0.0,\n        cache_read: 0.0,\n        cache_write: 0.0,\n    };\n    for (k, slot) in [\n        (\"input\", &mut out.input),\n        (\"output\", &mut out.output),\n        (\"cacheRead\", &mut out.cache_read),\n        (\"cacheWrite\", &mut out.cache_write),\n    ] {\n        let v = obj.get(k).and_then(|x| x.as_f64());\n        match v {\n            Some(n) if n.is_finite() && n >= 0.0 => *slot = n,\n            _ => {\n                return Err(format!(\n                    \"invalid config: {where_}.price.{k} must be a non-negative finite number\"\n                ));\n            }\n        }\n    }\n    Ok(out)\n}\n\nfn decode_model_entry(raw: &Value, id: &str, where_: &str) -> Result<ModelEntry, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_}[\\\"{id}\\\"] must be an object\"))?;\n    let loc = format!(\"{where_}[\\\"{id}\\\"]\");\n    Ok(ModelEntry {\n        label: str_field(obj, \"label\", &loc)?,\n        backend: str_field(obj, \"backend\", &loc)?,\n        price: decode_price(obj.get(\"price\").unwrap_or(&Value::Null), &loc)?,\n    })\n}\n\nfn decode_models(raw: &Value, where_: &str) -> Result<HashMap<String, ModelEntry>, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_} must be an object\"))?;\n    let mut out = HashMap::new();\n    for (id, entry) in obj {\n        out.insert(id.clone(), decode_model_entry(entry, id, where_)?);\n    }\n    Ok(out)\n}\n\nfn decode_host_profile(raw: Option<&Value>) -> Result<HostProfile, String> {\n    let Some(raw) = raw else {\n        return Ok(HostProfile::default());\n    };\n    if raw.is_null() {\n        return Ok(HostProfile::default());\n    }\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| \"invalid config: host profile must be an object\".to_string())?;\n    let mut profile = HostProfile::default();\n    if let Some(d) = opt_str(obj, \"default\", \"host-profile\")? {\n        profile.default = Some(d);\n    }\n    if let Some(models) = obj.get(\"models\") {\n        profile.models = Some(decode_models(models, \"host-profile.models\")?);\n    }\n    if let Some(g) = opt_str(obj, \"gate\", \"host-profile\")? {\n        profile.gate = Some(g);\n    }\n    if let Some(i) = opt_finite_or_null(obj, \"idleMs\", \"host-profile\")? {\n        profile.idle_ms = Some(i);\n    }\n    if let Some(i) = opt_finite_or_null(obj, \"toolIdleMs\", \"host-profile\")? {\n        profile.tool_idle_ms = Some(i);\n    }\n    Ok(profile)\n}\n\npub fn default_host_profile_path() -> String {\n    crate::util::homedir()\n        .join(\".config/cursor-delegate/host-profile.json\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub fn default_cli_config_path() -> String {\n    crate::util::homedir()\n        .join(\".cursor/cli-config.json\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub struct LoadConfigOpts {\n    pub models_path: String,\n    pub host_profile_path: Option<String>,\n    pub read_file: Option<ReadFileFn>,\n}\n\nfn to_price_map(models: &HashMap<String, ModelEntry>) -> PriceMap {\n    models.iter().map(|(id, e)| (id.clone(), e.price)).collect()\n}\n\npub fn load_config(\n    opts: LoadConfigOpts,\n) -> Result<Config, Box<dyn std::error::Error + Send + Sync>> {\n    let read_owned = opts.read_file;\n    let read_fn = |path: &str| -> Result<String, IoErr> {\n        if let Some(rf) = &read_owned {\n            rf(path)\n        } else {\n            default_read_file(path)\n        }\n    };\n    let profile_path = opts.host_profile_path.clone().unwrap_or_else(|| {\n        std::env::var(\"CURSOR_DELEGATE_HOST_PROFILE\")\n            .unwrap_or_else(|_| default_host_profile_path())\n    });\n\n    let file_raw = read_json(&read_fn, &opts.models_path)?;\n    let profile_raw = read_json(&read_fn, &profile_path)?;\n\n    let file_raw =\n        file_raw.ok_or_else(|| format!(\"invalid or missing models file: {}\", opts.models_path))?;\n    if !is_record(&file_raw) || !file_raw.get(\"default\").and_then(|d| d.as_str()).is_some() {\n        return Err(format!(\"invalid or missing models file: {}\", opts.models_path).into());\n    }\n    let file_models = decode_models(\n        file_raw.get(\"models\").unwrap_or(&Value::Null),\n        \"models.json.models\",\n    )?;\n    let profile = decode_host_profile(profile_raw.as_ref())?;\n\n    let mut models = file_models;\n    if let Some(pm) = &profile.models {\n        for (k, v) in pm {\n            models.insert(k.clone(), v.clone());\n        }\n    }\n    let default_model = profile\n        .default\n        .clone()\n        .unwrap_or_else(|| file_raw[\"default\"].as_str().unwrap().to_string());\n    if !models.contains_key(&default_model) {\n        return Err(\n            format!(\"default model \\\"{default_model}\\\" is not present in the models map\").into(),\n        );\n    }\n    Ok(Config {\n        price_map: to_price_map(&models),\n        default: default_model,\n        models,\n        profile,\n    })\n}\n\npub struct CliDeps {\n    pub config: Config,\n}\n\npub fn build_deps() -> Result<CliDeps, Box<dyn std::error::Error + Send + Sync>> {\n    let bundled = BUNDLED_MODELS_JSON.to_string();\n    let config = load_config(LoadConfigOpts {\n        models_path: \"<bundled>/models.json\".into(),\n        host_profile_path: None,\n        read_file: Some(Box::new(move |path: &str| {\n            if path == \"<bundled>/models.json\" {\n                Ok(bundled.clone())\n            } else {\n                std::fs::read_to_string(path).map_err(|e| IoErr {\n                    code: if e.kind() == std::io::ErrorKind::NotFound {\n                        Some(\"ENOENT\".into())\n                    } else {\n                        None\n                    },\n                    message: e.to_string(),\n                })\n            }\n        })),\n    })?;\n    Ok(CliDeps { config })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use std::collections::HashMap;\n    use std::sync::Arc;\n\n    const MODELS_DEFAULT: &str = r#\"{\n  \"default\": \"composer-2.5\",\n  \"models\": {\n    \"composer-2.5\": {\n      \"label\": \"Composer 2.5\",\n      \"backend\": \"cursor\",\n      \"price\": { \"input\": 0.5, \"output\": 2.5, \"cacheRead\": 0.2, \"cacheWrite\": 0 }\n    },\n    \"grok-4.7-high\": {\n      \"label\": \"Grok 4.7 High\",\n      \"backend\": \"cursor\",\n      \"price\": { \"input\": 2, \"output\": 6, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n    }\n  }\n}\"#;\n\n    fn reader(files: HashMap<String, String>) -> ReadFileFn {\n        let files = Arc::new(files);\n        Box::new(move |path: &str| {\n            files.get(path).cloned().ok_or_else(|| IoErr {\n                code: Some(\"ENOENT\".into()),\n                message: \"ENOENT\".into(),\n            })\n        })\n    }\n\n    #[test]\n    fn loads_models_and_derives_price_map() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/does-not-exist.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"composer-2.5\");\n        assert_eq!(cfg.models[\"composer-2.5\"].backend, \"cursor\");\n        assert_eq!(cfg.price_map[\"composer-2.5\"].input, 0.5);\n        assert_eq!(cfg.profile, HostProfile::default());\n    }\n\n    #[test]\n    fn merges_host_profile() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/profile.json\".into(),\n            serde_json::json!({\n                \"default\": \"grok-4.7-high\",\n                \"models\": {\n                    \"openai-codex/gpt-6-luna\": {\n                        \"label\": \"GPT-6 Luna\",\n                        \"backend\": \"pi\",\n                        \"price\": { \"input\": 5, \"output\": 30, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n                    }\n                },\n                \"idleMs\": 1000\n            })\n            .to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"grok-4.7-high\");\n        assert!(cfg.models.contains_key(\"composer-2.5\"));\n        assert!(cfg.models.contains_key(\"openai-codex/gpt-6-luna\"));\n        assert_eq!(cfg.models[\"openai-codex/gpt-6-luna\"].backend, \"pi\");\n        assert_eq!(cfg.price_map[\"openai-codex/gpt-6-luna\"].output, 30.0);\n        assert_eq!(cfg.profile.idle_ms, Some(Some(1000.0)));\n    }\n\n    #[test]\n    fn missing_host_profile_is_empty() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/does-not-exist.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.profile, HostProfile::default());\n        assert_eq!(cfg.default, \"composer-2.5\");\n        assert!(cfg.price_map.contains_key(\"composer-2.5\"));\n    }\n\n    #[test]\n    fn throws_when_default_absent() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/profile.json\".into(),\n            serde_json::json!({\"default\":\"not-a-real-model\"}).to_string(),\n        );\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"default\"));\n    }\n\n    #[test]\n    fn rejects_non_finite_price() {\n        let bad = serde_json::json!({\n            \"default\":\"m\",\n            \"models\":{\"m\":{\"label\":\"M\",\"backend\":\"cursor\",\"price\":{\"input\":null,\"output\":1,\"cacheRead\":0,\"cacheWrite\":0}}}\n        })\n        .to_string();\n        // NaN is not valid JSON; use a missing-like invalid (string) which fails the number check.\n        let bad = bad.replace(\"null\", \"\\\"nan\\\"\");\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), bad);\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/x.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"price.input\"));\n    }\n\n    #[test]\n    fn rejects_missing_price_field() {\n        let bad = serde_json::json!({\n            \"default\":\"m\",\n            \"models\":{\"m\":{\"label\":\"M\",\"backend\":\"cursor\",\"price\":{\"input\":1,\"output\":1,\"cacheRead\":0}}}\n        })\n        .to_string();\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), bad);\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/x.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"price.cacheWrite\"));\n    }\n\n    #[test]\n    fn rejects_bad_deadline() {\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/p.json\".into(),\n            serde_json::json!({\"deadlineMs\":\"soon\"}).to_string(),\n        );\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/p.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"deadlineMs\"));\n    }\n\n    #[test]\n    fn rejects_bad_required_deny() {\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/p.json\".into(),\n            serde_json::json!({\"requiredDeny\":[1,2]}).to_string(),\n        );\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/p.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"requiredDeny\"));\n    }\n\n    #[test]\n    fn accepts_null_idle() {\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/p.json\".into(),\n            serde_json::json!({\"idleMs\":null,\"toolIdleMs\":null,\"deadlineMs\":1000}).to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/p.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.profile.idle_ms, Some(None));\n        assert_eq!(cfg.profile.tool_idle_ms, Some(None));\n    }\n}\n","afterFullFileContent":"use crate::types::{Config, HostProfile, ModelEntry, Price, PriceMap};\nuse serde_json::Value;\nuse std::collections::HashMap;\n\npub const BUNDLED_MODELS_JSON: &str = include_str!(\"../config/models.json\");\n\npub type ReadFileFn = Box<dyn Fn(&str) -> Result<String, IoErr> + Send + Sync>;\n\n#[derive(Debug)]\npub struct IoErr {\n    pub code: Option<String>,\n    pub message: String,\n}\n\nimpl std::fmt::Display for IoErr {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(&self.message)\n    }\n}\nimpl std::error::Error for IoErr {}\n\nfn default_read_file(path: &str) -> Result<String, IoErr> {\n    match std::fs::read_to_string(path) {\n        Ok(s) => Ok(s),\n        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Err(IoErr {\n            code: Some(\"ENOENT\".into()),\n            message: e.to_string(),\n        }),\n        Err(e) => Err(IoErr {\n            code: None,\n            message: e.to_string(),\n        }),\n    }\n}\n\nfn read_json(\n    read_file: &dyn Fn(&str) -> Result<String, IoErr>,\n    path: &str,\n) -> Result<Option<Value>, Box<dyn std::error::Error + Send + Sync>> {\n    match read_file(path) {\n        Ok(s) => Ok(Some(serde_json::from_str(&s)?)),\n        Err(e) if e.code.as_deref() == Some(\"ENOENT\") => Ok(None),\n        Err(e) => Err(Box::new(e)),\n    }\n}\n\nfn is_record(v: &Value) -> bool {\n    v.is_object()\n}\n\nfn str_field(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<String, String> {\n    obj.get(field)\n        .and_then(|v| v.as_str())\n        .map(|s| s.to_string())\n        .ok_or_else(|| format!(\"invalid config: {where_}.{field} must be a string\"))\n}\n\nfn opt_str(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<String>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => v\n            .as_str()\n            .map(|s| Some(s.to_string()))\n            .ok_or_else(|| format!(\"invalid config: {where_}.{field} must be a string\")),\n    }\n}\n\nfn opt_str_array(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<Vec<String>>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => {\n            let arr = v.as_array().ok_or_else(|| {\n                format!(\"invalid config: {where_}.{field} must be an array of strings\")\n            })?;\n            if arr.iter().any(|x| !x.is_string()) {\n                return Err(format!(\n                    \"invalid config: {where_}.{field} must be an array of strings\"\n                ));\n            }\n            Ok(Some(\n                arr.iter()\n                    .filter_map(|x| x.as_str().map(|s| s.to_string()))\n                    .collect(),\n            ))\n        }\n    }\n}\n\nfn opt_finite(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<f64>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => {\n            let n = v\n                .as_f64()\n                .filter(|n| n.is_finite() && *n > 0.0)\n                .ok_or_else(|| {\n                    format!(\"invalid config: {where_}.{field} must be a positive finite number\")\n                })?;\n            Ok(Some(n))\n        }\n    }\n}\n\nfn opt_finite_or_null(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<Option<f64>>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) if v.is_null() => Ok(Some(None)),\n        Some(_) => Ok(Some(opt_finite(obj, field, where_)?)),\n    }\n}\n\nfn decode_price(raw: &Value, where_: &str) -> Result<Price, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_}.price must be an object\"))?;\n    let mut out = Price {\n        input: 0.0,\n        output: 0.0,\n        cache_read: 0.0,\n        cache_write: 0.0,\n    };\n    for (k, slot) in [\n        (\"input\", &mut out.input),\n        (\"output\", &mut out.output),\n        (\"cacheRead\", &mut out.cache_read),\n        (\"cacheWrite\", &mut out.cache_write),\n    ] {\n        let v = obj.get(k).and_then(|x| x.as_f64());\n        match v {\n            Some(n) if n.is_finite() && n >= 0.0 => *slot = n,\n            _ => {\n                return Err(format!(\n                    \"invalid config: {where_}.price.{k} must be a non-negative finite number\"\n                ));\n            }\n        }\n    }\n    Ok(out)\n}\n\nfn decode_model_entry(raw: &Value, id: &str, where_: &str) -> Result<ModelEntry, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_}[\\\"{id}\\\"] must be an object\"))?;\n    let loc = format!(\"{where_}[\\\"{id}\\\"]\");\n    Ok(ModelEntry {\n        label: str_field(obj, \"label\", &loc)?,\n        backend: str_field(obj, \"backend\", &loc)?,\n        price: decode_price(obj.get(\"price\").unwrap_or(&Value::Null), &loc)?,\n    })\n}\n\nfn decode_models(raw: &Value, where_: &str) -> Result<HashMap<String, ModelEntry>, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_} must be an object\"))?;\n    let mut out = HashMap::new();\n    for (id, entry) in obj {\n        out.insert(id.clone(), decode_model_entry(entry, id, where_)?);\n    }\n    Ok(out)\n}\n\nfn decode_host_profile(raw: Option<&Value>) -> Result<HostProfile, String> {\n    let Some(raw) = raw else {\n        return Ok(HostProfile::default());\n    };\n    if raw.is_null() {\n        return Ok(HostProfile::default());\n    }\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| \"invalid config: host profile must be an object\".to_string())?;\n    let mut profile = HostProfile::default();\n    if let Some(d) = opt_str(obj, \"default\", \"host-profile\")? {\n        profile.default = Some(d);\n    }\n    if let Some(models) = obj.get(\"models\") {\n        profile.models = Some(decode_models(models, \"host-profile.models\")?);\n    }\n    if let Some(g) = opt_str(obj, \"gate\", \"host-profile\")? {\n        profile.gate = Some(g);\n    }\n    if let Some(i) = opt_finite_or_null(obj, \"idleMs\", \"host-profile\")? {\n        profile.idle_ms = Some(i);\n    }\n    if let Some(i) = opt_finite_or_null(obj, \"toolIdleMs\", \"host-profile\")? {\n        profile.tool_idle_ms = Some(i);\n    }\n    Ok(profile)\n}\n\npub fn default_host_profile_path() -> String {\n    crate::util::homedir()\n        .join(\".config/cursor-delegate/host-profile.json\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub fn default_cli_config_path() -> String {\n    crate::util::homedir()\n        .join(\".cursor/cli-config.json\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub struct LoadConfigOpts {\n    pub models_path: String,\n    pub host_profile_path: Option<String>,\n    pub read_file: Option<ReadFileFn>,\n}\n\nfn to_price_map(models: &HashMap<String, ModelEntry>) -> PriceMap {\n    models.iter().map(|(id, e)| (id.clone(), e.price)).collect()\n}\n\npub fn load_config(\n    opts: LoadConfigOpts,\n) -> Result<Config, Box<dyn std::error::Error + Send + Sync>> {\n    let read_owned = opts.read_file;\n    let read_fn = |path: &str| -> Result<String, IoErr> {\n        if let Some(rf) = &read_owned {\n            rf(path)\n        } else {\n            default_read_file(path)\n        }\n    };\n    let profile_path = opts.host_profile_path.clone().unwrap_or_else(|| {\n        std::env::var(\"CURSOR_DELEGATE_HOST_PROFILE\")\n            .unwrap_or_else(|_| default_host_profile_path())\n    });\n\n    let file_raw = read_json(&read_fn, &opts.models_path)?;\n    let profile_raw = read_json(&read_fn, &profile_path)?;\n\n    let file_raw =\n        file_raw.ok_or_else(|| format!(\"invalid or missing models file: {}\", opts.models_path))?;\n    if !is_record(&file_raw) || !file_raw.get(\"default\").and_then(|d| d.as_str()).is_some() {\n        return Err(format!(\"invalid or missing models file: {}\", opts.models_path).into());\n    }\n    let file_models = decode_models(\n        file_raw.get(\"models\").unwrap_or(&Value::Null),\n        \"models.json.models\",\n    )?;\n    let profile = decode_host_profile(profile_raw.as_ref())?;\n\n    let mut models = file_models;\n    if let Some(pm) = &profile.models {\n        for (k, v) in pm {\n            models.insert(k.clone(), v.clone());\n        }\n    }\n    let default_model = profile\n        .default\n        .clone()\n        .unwrap_or_else(|| file_raw[\"default\"].as_str().unwrap().to_string());\n    if !models.contains_key(&default_model) {\n        return Err(\n            format!(\"default model \\\"{default_model}\\\" is not present in the models map\").into(),\n        );\n    }\n    Ok(Config {\n        price_map: to_price_map(&models),\n        default: default_model,\n        models,\n        profile,\n    })\n}\n\npub struct CliDeps {\n    pub config: Config,\n}\n\npub fn build_deps() -> Result<CliDeps, Box<dyn std::error::Error + Send + Sync>> {\n    let bundled = BUNDLED_MODELS_JSON.to_string();\n    let config = load_config(LoadConfigOpts {\n        models_path: \"<bundled>/models.json\".into(),\n        host_profile_path: None,\n        read_file: Some(Box::new(move |path: &str| {\n            if path == \"<bundled>/models.json\" {\n                Ok(bundled.clone())\n            } else {\n                std::fs::read_to_string(path).map_err(|e| IoErr {\n                    code: if e.kind() == std::io::ErrorKind::NotFound {\n                        Some(\"ENOENT\".into())\n                    } else {\n                        None\n                    },\n                    message: e.to_string(),\n                })\n            }\n        })),\n    })?;\n    Ok(CliDeps { config })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use std::collections::HashMap;\n    use std::sync::Arc;\n\n    const MODELS_DEFAULT: &str = r#\"{\n  \"default\": \"composer-2.5\",\n  \"models\": {\n    \"composer-2.5\": {\n      \"label\": \"Composer 2.5\",\n      \"backend\": \"cursor\",\n      \"price\": { \"input\": 0.5, \"output\": 2.5, \"cacheRead\": 0.2, \"cacheWrite\": 0 }\n    },\n    \"grok-4.7-high\": {\n      \"label\": \"Grok 4.7 High\",\n      \"backend\": \"cursor\",\n      \"price\": { \"input\": 2, \"output\": 6, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n    }\n  }\n}\"#;\n\n    fn reader(files: HashMap<String, String>) -> ReadFileFn {\n        let files = Arc::new(files);\n        Box::new(move |path: &str| {\n            files.get(path).cloned().ok_or_else(|| IoErr {\n                code: Some(\"ENOENT\".into()),\n                message: \"ENOENT\".into(),\n            })\n        })\n    }\n\n    #[test]\n    fn loads_models_and_derives_price_map() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/does-not-exist.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"composer-2.5\");\n        assert_eq!(cfg.models[\"composer-2.5\"].backend, \"cursor\");\n        assert_eq!(cfg.price_map[\"composer-2.5\"].input, 0.5);\n        assert_eq!(cfg.profile, HostProfile::default());\n    }\n\n    #[test]\n    fn merges_host_profile() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/profile.json\".into(),\n            serde_json::json!({\n                \"default\": \"grok-4.7-high\",\n                \"models\": {\n                    \"openai-codex/gpt-6-luna\": {\n                        \"label\": \"GPT-6 Luna\",\n                        \"backend\": \"pi\",\n                        \"price\": { \"input\": 5, \"output\": 30, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n                    }\n                },\n                \"idleMs\": 1000\n            })\n            .to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"grok-4.7-high\");\n        assert!(cfg.models.contains_key(\"composer-2.5\"));\n        assert!(cfg.models.contains_key(\"openai-codex/gpt-6-luna\"));\n        assert_eq!(cfg.models[\"openai-codex/gpt-6-luna\"].backend, \"pi\");\n        assert_eq!(cfg.price_map[\"openai-codex/gpt-6-luna\"].output, 30.0);\n        assert_eq!(cfg.profile.idle_ms, Some(Some(1000.0)));\n    }\n\n    #[test]\n    fn missing_host_profile_is_empty() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/does-not-exist.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.profile, HostProfile::default());\n        assert_eq!(cfg.default, \"composer-2.5\");\n        assert!(cfg.price_map.contains_key(\"composer-2.5\"));\n    }\n\n    #[test]\n    fn throws_when_default_absent() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/profile.json\".into(),\n            serde_json::json!({\"default\":\"not-a-real-model\"}).to_string(),\n        );\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"default\"));\n    }\n\n    #[test]\n    fn rejects_non_finite_price() {\n        let bad = serde_json::json!({\n            \"default\":\"m\",\n            \"models\":{\"m\":{\"label\":\"M\",\"backend\":\"cursor\",\"price\":{\"input\":null,\"output\":1,\"cacheRead\":0,\"cacheWrite\":0}}}\n        })\n        .to_string();\n        // NaN is not valid JSON; use a missing-like invalid (string) which fails the number check.\n        let bad = bad.replace(\"null\", \"\\\"nan\\\"\");\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), bad);\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/x.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"price.input\"));\n    }\n\n    #[test]\n    fn rejects_missing_price_field() {\n        let bad = serde_json::json!({\n            \"default\":\"m\",\n            \"models\":{\"m\":{\"label\":\"M\",\"backend\":\"cursor\",\"price\":{\"input\":1,\"output\":1,\"cacheRead\":0}}}\n        })\n        .to_string();\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), bad);\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/x.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"price.cacheWrite\"));\n    }\n\n    #[test]\n    fn accepts_null_idle() {\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/p.json\".into(),\n            serde_json::json!({\"idleMs\":null,\"toolIdleMs\":null,\"deadlineMs\":1000}).to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/p.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.profile.idle_ms, Some(None));\n        assert_eq!(cfg.profile.tool_idle_ms, Some(None));\n    }\n}\n","message":"The file /Users/user/work/delegate-13-contract/src/config.rs has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"tool_972e47b8-3ffc-41eb-af0a-ba7a8e04511","startedAtMs":"1790852590404","completedAtMs":"1790852592743"},"model_call_id":"23978e36-7eb7-44ac-8d86-987b657a4703-23-t8u7","session_id":"e2d994f1-ef61-48a1-b218-cde928b7cc82","timestamp_ms":1790852592682}
{"type":"tool_call","subtype":"started","call_id":"tool_91c8a9ba-41fe-4e17-9578-af6d8e4ca96","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-13-contract/src/config.rs","streamContent":"            serde_json::json!({\"idleMs\":null,\"toolIdleMs\":null}).to_string(),"}},"hookAdditionalContexts":[],"toolCallId":"tool_91c8a9ba-41fe-4e17-9578-af6d8e4ca96","startedAtMs":"1790852592076"},"model_call_id":"23978e36-7eb7-44ac-8d86-987b657a4703-23-t8u7","session_id":"e2d994f1-ef61-48a1-b218-cde928b7cc82","timestamp_ms":1790852592682}
{"type":"tool_call","subtype":"completed","call_id":"tool_91c8a9ba-41fe-4e17-9578-af6d8e4ca96","tool_call":{"editToolCall":{"args":{"path":"/Users/user/work/delegate-13-contract/src/config.rs","streamContent":"            serde_json::json!({\"idleMs\":null,\"toolIdleMs\":null}).to_string(),"},"result":{"success":{"path":"/Users/user/work/delegate-13-contract/src/config.rs","linesAdded":1,"linesRemoved":1,"diffString":"--- a//Users/user/work/delegate-13-contract/src/config.rs\n+++ b//Users/user/work/delegate-13-contract/src/config.rs\n@@ -471,7 +471,7 @@\n         files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n         files.insert(\n             \"/p.json\".into(),\n-            serde_json::json!({\"idleMs\":null,\"toolIdleMs\":null,\"deadlineMs\":1000}).to_string(),\n+            serde_json::json!({\"idleMs\":null,\"toolIdleMs\":null}).to_string(),\n         );\n         let cfg = load_config(LoadConfigOpts {\n             models_path: \"/m.json\".into(),","beforeFullFileContent":"use crate::types::{Config, HostProfile, ModelEntry, Price, PriceMap};\nuse serde_json::Value;\nuse std::collections::HashMap;\n\npub const BUNDLED_MODELS_JSON: &str = include_str!(\"../config/models.json\");\n\npub type ReadFileFn = Box<dyn Fn(&str) -> Result<String, IoErr> + Send + Sync>;\n\n#[derive(Debug)]\npub struct IoErr {\n    pub code: Option<String>,\n    pub message: String,\n}\n\nimpl std::fmt::Display for IoErr {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(&self.message)\n    }\n}\nimpl std::error::Error for IoErr {}\n\nfn default_read_file(path: &str) -> Result<String, IoErr> {\n    match std::fs::read_to_string(path) {\n        Ok(s) => Ok(s),\n        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Err(IoErr {\n            code: Some(\"ENOENT\".into()),\n            message: e.to_string(),\n        }),\n        Err(e) => Err(IoErr {\n            code: None,\n            message: e.to_string(),\n        }),\n    }\n}\n\nfn read_json(\n    read_file: &dyn Fn(&str) -> Result<String, IoErr>,\n    path: &str,\n) -> Result<Option<Value>, Box<dyn std::error::Error + Send + Sync>> {\n    match read_file(path) {\n        Ok(s) => Ok(Some(serde_json::from_str(&s)?)),\n        Err(e) if e.code.as_deref() == Some(\"ENOENT\") => Ok(None),\n        Err(e) => Err(Box::new(e)),\n    }\n}\n\nfn is_record(v: &Value) -> bool {\n    v.is_object()\n}\n\nfn str_field(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<String, String> {\n    obj.get(field)\n        .and_then(|v| v.as_str())\n        .map(|s| s.to_string())\n        .ok_or_else(|| format!(\"invalid config: {where_}.{field} must be a string\"))\n}\n\nfn opt_str(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<String>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => v\n            .as_str()\n            .map(|s| Some(s.to_string()))\n            .ok_or_else(|| format!(\"invalid config: {where_}.{field} must be a string\")),\n    }\n}\n\nfn opt_str_array(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<Vec<String>>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => {\n            let arr = v.as_array().ok_or_else(|| {\n                format!(\"invalid config: {where_}.{field} must be an array of strings\")\n            })?;\n            if arr.iter().any(|x| !x.is_string()) {\n                return Err(format!(\n                    \"invalid config: {where_}.{field} must be an array of strings\"\n                ));\n            }\n            Ok(Some(\n                arr.iter()\n                    .filter_map(|x| x.as_str().map(|s| s.to_string()))\n                    .collect(),\n            ))\n        }\n    }\n}\n\nfn opt_finite(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<f64>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => {\n            let n = v\n                .as_f64()\n                .filter(|n| n.is_finite() && *n > 0.0)\n                .ok_or_else(|| {\n                    format!(\"invalid config: {where_}.{field} must be a positive finite number\")\n                })?;\n            Ok(Some(n))\n        }\n    }\n}\n\nfn opt_finite_or_null(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<Option<f64>>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) if v.is_null() => Ok(Some(None)),\n        Some(_) => Ok(Some(opt_finite(obj, field, where_)?)),\n    }\n}\n\nfn decode_price(raw: &Value, where_: &str) -> Result<Price, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_}.price must be an object\"))?;\n    let mut out = Price {\n        input: 0.0,\n        output: 0.0,\n        cache_read: 0.0,\n        cache_write: 0.0,\n    };\n    for (k, slot) in [\n        (\"input\", &mut out.input),\n        (\"output\", &mut out.output),\n        (\"cacheRead\", &mut out.cache_read),\n        (\"cacheWrite\", &mut out.cache_write),\n    ] {\n        let v = obj.get(k).and_then(|x| x.as_f64());\n        match v {\n            Some(n) if n.is_finite() && n >= 0.0 => *slot = n,\n            _ => {\n                return Err(format!(\n                    \"invalid config: {where_}.price.{k} must be a non-negative finite number\"\n                ));\n            }\n        }\n    }\n    Ok(out)\n}\n\nfn decode_model_entry(raw: &Value, id: &str, where_: &str) -> Result<ModelEntry, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_}[\\\"{id}\\\"] must be an object\"))?;\n    let loc = format!(\"{where_}[\\\"{id}\\\"]\");\n    Ok(ModelEntry {\n        label: str_field(obj, \"label\", &loc)?,\n        backend: str_field(obj, \"backend\", &loc)?,\n        price: decode_price(obj.get(\"price\").unwrap_or(&Value::Null), &loc)?,\n    })\n}\n\nfn decode_models(raw: &Value, where_: &str) -> Result<HashMap<String, ModelEntry>, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_} must be an object\"))?;\n    let mut out = HashMap::new();\n    for (id, entry) in obj {\n        out.insert(id.clone(), decode_model_entry(entry, id, where_)?);\n    }\n    Ok(out)\n}\n\nfn decode_host_profile(raw: Option<&Value>) -> Result<HostProfile, String> {\n    let Some(raw) = raw else {\n        return Ok(HostProfile::default());\n    };\n    if raw.is_null() {\n        return Ok(HostProfile::default());\n    }\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| \"invalid config: host profile must be an object\".to_string())?;\n    let mut profile = HostProfile::default();\n    if let Some(d) = opt_str(obj, \"default\", \"host-profile\")? {\n        profile.default = Some(d);\n    }\n    if let Some(models) = obj.get(\"models\") {\n        profile.models = Some(decode_models(models, \"host-profile.models\")?);\n    }\n    if let Some(g) = opt_str(obj, \"gate\", \"host-profile\")? {\n        profile.gate = Some(g);\n    }\n    if let Some(i) = opt_finite_or_null(obj, \"idleMs\", \"host-profile\")? {\n        profile.idle_ms = Some(i);\n    }\n    if let Some(i) = opt_finite_or_null(obj, \"toolIdleMs\", \"host-profile\")? {\n        profile.tool_idle_ms = Some(i);\n    }\n    Ok(profile)\n}\n\npub fn default_host_profile_path() -> String {\n    crate::util::homedir()\n        .join(\".config/cursor-delegate/host-profile.json\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub fn default_cli_config_path() -> String {\n    crate::util::homedir()\n        .join(\".cursor/cli-config.json\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub struct LoadConfigOpts {\n    pub models_path: String,\n    pub host_profile_path: Option<String>,\n    pub read_file: Option<ReadFileFn>,\n}\n\nfn to_price_map(models: &HashMap<String, ModelEntry>) -> PriceMap {\n    models.iter().map(|(id, e)| (id.clone(), e.price)).collect()\n}\n\npub fn load_config(\n    opts: LoadConfigOpts,\n) -> Result<Config, Box<dyn std::error::Error + Send + Sync>> {\n    let read_owned = opts.read_file;\n    let read_fn = |path: &str| -> Result<String, IoErr> {\n        if let Some(rf) = &read_owned {\n            rf(path)\n        } else {\n            default_read_file(path)\n        }\n    };\n    let profile_path = opts.host_profile_path.clone().unwrap_or_else(|| {\n        std::env::var(\"CURSOR_DELEGATE_HOST_PROFILE\")\n            .unwrap_or_else(|_| default_host_profile_path())\n    });\n\n    let file_raw = read_json(&read_fn, &opts.models_path)?;\n    let profile_raw = read_json(&read_fn, &profile_path)?;\n\n    let file_raw =\n        file_raw.ok_or_else(|| format!(\"invalid or missing models file: {}\", opts.models_path))?;\n    if !is_record(&file_raw) || !file_raw.get(\"default\").and_then(|d| d.as_str()).is_some() {\n        return Err(format!(\"invalid or missing models file: {}\", opts.models_path).into());\n    }\n    let file_models = decode_models(\n        file_raw.get(\"models\").unwrap_or(&Value::Null),\n        \"models.json.models\",\n    )?;\n    let profile = decode_host_profile(profile_raw.as_ref())?;\n\n    let mut models = file_models;\n    if let Some(pm) = &profile.models {\n        for (k, v) in pm {\n            models.insert(k.clone(), v.clone());\n        }\n    }\n    let default_model = profile\n        .default\n        .clone()\n        .unwrap_or_else(|| file_raw[\"default\"].as_str().unwrap().to_string());\n    if !models.contains_key(&default_model) {\n        return Err(\n            format!(\"default model \\\"{default_model}\\\" is not present in the models map\").into(),\n        );\n    }\n    Ok(Config {\n        price_map: to_price_map(&models),\n        default: default_model,\n        models,\n        profile,\n    })\n}\n\npub struct CliDeps {\n    pub config: Config,\n}\n\npub fn build_deps() -> Result<CliDeps, Box<dyn std::error::Error + Send + Sync>> {\n    let bundled = BUNDLED_MODELS_JSON.to_string();\n    let config = load_config(LoadConfigOpts {\n        models_path: \"<bundled>/models.json\".into(),\n        host_profile_path: None,\n        read_file: Some(Box::new(move |path: &str| {\n            if path == \"<bundled>/models.json\" {\n                Ok(bundled.clone())\n            } else {\n                std::fs::read_to_string(path).map_err(|e| IoErr {\n                    code: if e.kind() == std::io::ErrorKind::NotFound {\n                        Some(\"ENOENT\".into())\n                    } else {\n                        None\n                    },\n                    message: e.to_string(),\n                })\n            }\n        })),\n    })?;\n    Ok(CliDeps { config })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use std::collections::HashMap;\n    use std::sync::Arc;\n\n    const MODELS_DEFAULT: &str = r#\"{\n  \"default\": \"composer-2.5\",\n  \"models\": {\n    \"composer-2.5\": {\n      \"label\": \"Composer 2.5\",\n      \"backend\": \"cursor\",\n      \"price\": { \"input\": 0.5, \"output\": 2.5, \"cacheRead\": 0.2, \"cacheWrite\": 0 }\n    },\n    \"grok-4.7-high\": {\n      \"label\": \"Grok 4.7 High\",\n      \"backend\": \"cursor\",\n      \"price\": { \"input\": 2, \"output\": 6, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n    }\n  }\n}\"#;\n\n    fn reader(files: HashMap<String, String>) -> ReadFileFn {\n        let files = Arc::new(files);\n        Box::new(move |path: &str| {\n            files.get(path).cloned().ok_or_else(|| IoErr {\n                code: Some(\"ENOENT\".into()),\n                message: \"ENOENT\".into(),\n            })\n        })\n    }\n\n    #[test]\n    fn loads_models_and_derives_price_map() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/does-not-exist.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"composer-2.5\");\n        assert_eq!(cfg.models[\"composer-2.5\"].backend, \"cursor\");\n        assert_eq!(cfg.price_map[\"composer-2.5\"].input, 0.5);\n        assert_eq!(cfg.profile, HostProfile::default());\n    }\n\n    #[test]\n    fn merges_host_profile() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/profile.json\".into(),\n            serde_json::json!({\n                \"default\": \"grok-4.7-high\",\n                \"models\": {\n                    \"openai-codex/gpt-6-luna\": {\n                        \"label\": \"GPT-6 Luna\",\n                        \"backend\": \"pi\",\n                        \"price\": { \"input\": 5, \"output\": 30, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n                    }\n                },\n                \"idleMs\": 1000\n            })\n            .to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"grok-4.7-high\");\n        assert!(cfg.models.contains_key(\"composer-2.5\"));\n        assert!(cfg.models.contains_key(\"openai-codex/gpt-6-luna\"));\n        assert_eq!(cfg.models[\"openai-codex/gpt-6-luna\"].backend, \"pi\");\n        assert_eq!(cfg.price_map[\"openai-codex/gpt-6-luna\"].output, 30.0);\n        assert_eq!(cfg.profile.idle_ms, Some(Some(1000.0)));\n    }\n\n    #[test]\n    fn missing_host_profile_is_empty() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/does-not-exist.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.profile, HostProfile::default());\n        assert_eq!(cfg.default, \"composer-2.5\");\n        assert!(cfg.price_map.contains_key(\"composer-2.5\"));\n    }\n\n    #[test]\n    fn throws_when_default_absent() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/profile.json\".into(),\n            serde_json::json!({\"default\":\"not-a-real-model\"}).to_string(),\n        );\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"default\"));\n    }\n\n    #[test]\n    fn rejects_non_finite_price() {\n        let bad = serde_json::json!({\n            \"default\":\"m\",\n            \"models\":{\"m\":{\"label\":\"M\",\"backend\":\"cursor\",\"price\":{\"input\":null,\"output\":1,\"cacheRead\":0,\"cacheWrite\":0}}}\n        })\n        .to_string();\n        // NaN is not valid JSON; use a missing-like invalid (string) which fails the number check.\n        let bad = bad.replace(\"null\", \"\\\"nan\\\"\");\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), bad);\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/x.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"price.input\"));\n    }\n\n    #[test]\n    fn rejects_missing_price_field() {\n        let bad = serde_json::json!({\n            \"default\":\"m\",\n            \"models\":{\"m\":{\"label\":\"M\",\"backend\":\"cursor\",\"price\":{\"input\":1,\"output\":1,\"cacheRead\":0}}}\n        })\n        .to_string();\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), bad);\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/x.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"price.cacheWrite\"));\n    }\n\n    #[test]\n    fn accepts_null_idle() {\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/p.json\".into(),\n            serde_json::json!({\"idleMs\":null,\"toolIdleMs\":null,\"deadlineMs\":1000}).to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/p.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.profile.idle_ms, Some(None));\n        assert_eq!(cfg.profile.tool_idle_ms, Some(None));\n    }\n}\n","afterFullFileContent":"use crate::types::{Config, HostProfile, ModelEntry, Price, PriceMap};\nuse serde_json::Value;\nuse std::collections::HashMap;\n\npub const BUNDLED_MODELS_JSON: &str = include_str!(\"../config/models.json\");\n\npub type ReadFileFn = Box<dyn Fn(&str) -> Result<String, IoErr> + Send + Sync>;\n\n#[derive(Debug)]\npub struct IoErr {\n    pub code: Option<String>,\n    pub message: String,\n}\n\nimpl std::fmt::Display for IoErr {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(&self.message)\n    }\n}\nimpl std::error::Error for IoErr {}\n\nfn default_read_file(path: &str) -> Result<String, IoErr> {\n    match std::fs::read_to_string(path) {\n        Ok(s) => Ok(s),\n        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Err(IoErr {\n            code: Some(\"ENOENT\".into()),\n            message: e.to_string(),\n        }),\n        Err(e) => Err(IoErr {\n            code: None,\n            message: e.to_string(),\n        }),\n    }\n}\n\nfn read_json(\n    read_file: &dyn Fn(&str) -> Result<String, IoErr>,\n    path: &str,\n) -> Result<Option<Value>, Box<dyn std::error::Error + Send + Sync>> {\n    match read_file(path) {\n        Ok(s) => Ok(Some(serde_json::from_str(&s)?)),\n        Err(e) if e.code.as_deref() == Some(\"ENOENT\") => Ok(None),\n        Err(e) => Err(Box::new(e)),\n    }\n}\n\nfn is_record(v: &Value) -> bool {\n    v.is_object()\n}\n\nfn str_field(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<String, String> {\n    obj.get(field)\n        .and_then(|v| v.as_str())\n        .map(|s| s.to_string())\n        .ok_or_else(|| format!(\"invalid config: {where_}.{field} must be a string\"))\n}\n\nfn opt_str(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<String>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => v\n            .as_str()\n            .map(|s| Some(s.to_string()))\n            .ok_or_else(|| format!(\"invalid config: {where_}.{field} must be a string\")),\n    }\n}\n\nfn opt_str_array(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<Vec<String>>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => {\n            let arr = v.as_array().ok_or_else(|| {\n                format!(\"invalid config: {where_}.{field} must be an array of strings\")\n            })?;\n            if arr.iter().any(|x| !x.is_string()) {\n                return Err(format!(\n                    \"invalid config: {where_}.{field} must be an array of strings\"\n                ));\n            }\n            Ok(Some(\n                arr.iter()\n                    .filter_map(|x| x.as_str().map(|s| s.to_string()))\n                    .collect(),\n            ))\n        }\n    }\n}\n\nfn opt_finite(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<f64>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) => {\n            let n = v\n                .as_f64()\n                .filter(|n| n.is_finite() && *n > 0.0)\n                .ok_or_else(|| {\n                    format!(\"invalid config: {where_}.{field} must be a positive finite number\")\n                })?;\n            Ok(Some(n))\n        }\n    }\n}\n\nfn opt_finite_or_null(\n    obj: &serde_json::Map<String, Value>,\n    field: &str,\n    where_: &str,\n) -> Result<Option<Option<f64>>, String> {\n    match obj.get(field) {\n        None => Ok(None),\n        Some(v) if v.is_null() => Ok(Some(None)),\n        Some(_) => Ok(Some(opt_finite(obj, field, where_)?)),\n    }\n}\n\nfn decode_price(raw: &Value, where_: &str) -> Result<Price, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_}.price must be an object\"))?;\n    let mut out = Price {\n        input: 0.0,\n        output: 0.0,\n        cache_read: 0.0,\n        cache_write: 0.0,\n    };\n    for (k, slot) in [\n        (\"input\", &mut out.input),\n        (\"output\", &mut out.output),\n        (\"cacheRead\", &mut out.cache_read),\n        (\"cacheWrite\", &mut out.cache_write),\n    ] {\n        let v = obj.get(k).and_then(|x| x.as_f64());\n        match v {\n            Some(n) if n.is_finite() && n >= 0.0 => *slot = n,\n            _ => {\n                return Err(format!(\n                    \"invalid config: {where_}.price.{k} must be a non-negative finite number\"\n                ));\n            }\n        }\n    }\n    Ok(out)\n}\n\nfn decode_model_entry(raw: &Value, id: &str, where_: &str) -> Result<ModelEntry, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_}[\\\"{id}\\\"] must be an object\"))?;\n    let loc = format!(\"{where_}[\\\"{id}\\\"]\");\n    Ok(ModelEntry {\n        label: str_field(obj, \"label\", &loc)?,\n        backend: str_field(obj, \"backend\", &loc)?,\n        price: decode_price(obj.get(\"price\").unwrap_or(&Value::Null), &loc)?,\n    })\n}\n\nfn decode_models(raw: &Value, where_: &str) -> Result<HashMap<String, ModelEntry>, String> {\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| format!(\"invalid config: {where_} must be an object\"))?;\n    let mut out = HashMap::new();\n    for (id, entry) in obj {\n        out.insert(id.clone(), decode_model_entry(entry, id, where_)?);\n    }\n    Ok(out)\n}\n\nfn decode_host_profile(raw: Option<&Value>) -> Result<HostProfile, String> {\n    let Some(raw) = raw else {\n        return Ok(HostProfile::default());\n    };\n    if raw.is_null() {\n        return Ok(HostProfile::default());\n    }\n    let obj = raw\n        .as_object()\n        .ok_or_else(|| \"invalid config: host profile must be an object\".to_string())?;\n    let mut profile = HostProfile::default();\n    if let Some(d) = opt_str(obj, \"default\", \"host-profile\")? {\n        profile.default = Some(d);\n    }\n    if let Some(models) = obj.get(\"models\") {\n        profile.models = Some(decode_models(models, \"host-profile.models\")?);\n    }\n    if let Some(g) = opt_str(obj, \"gate\", \"host-profile\")? {\n        profile.gate = Some(g);\n    }\n    if let Some(i) = opt_finite_or_null(obj, \"idleMs\", \"host-profile\")? {\n        profile.idle_ms = Some(i);\n    }\n    if let Some(i) = opt_finite_or_null(obj, \"toolIdleMs\", \"host-profile\")? {\n        profile.tool_idle_ms = Some(i);\n    }\n    Ok(profile)\n}\n\npub fn default_host_profile_path() -> String {\n    crate::util::homedir()\n        .join(\".config/cursor-delegate/host-profile.json\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub fn default_cli_config_path() -> String {\n    crate::util::homedir()\n        .join(\".cursor/cli-config.json\")\n        .to_string_lossy()\n        .into_owned()\n}\n\npub struct LoadConfigOpts {\n    pub models_path: String,\n    pub host_profile_path: Option<String>,\n    pub read_file: Option<ReadFileFn>,\n}\n\nfn to_price_map(models: &HashMap<String, ModelEntry>) -> PriceMap {\n    models.iter().map(|(id, e)| (id.clone(), e.price)).collect()\n}\n\npub fn load_config(\n    opts: LoadConfigOpts,\n) -> Result<Config, Box<dyn std::error::Error + Send + Sync>> {\n    let read_owned = opts.read_file;\n    let read_fn = |path: &str| -> Result<String, IoErr> {\n        if let Some(rf) = &read_owned {\n            rf(path)\n        } else {\n            default_read_file(path)\n        }\n    };\n    let profile_path = opts.host_profile_path.clone().unwrap_or_else(|| {\n        std::env::var(\"CURSOR_DELEGATE_HOST_PROFILE\")\n            .unwrap_or_else(|_| default_host_profile_path())\n    });\n\n    let file_raw = read_json(&read_fn, &opts.models_path)?;\n    let profile_raw = read_json(&read_fn, &profile_path)?;\n\n    let file_raw =\n        file_raw.ok_or_else(|| format!(\"invalid or missing models file: {}\", opts.models_path))?;\n    if !is_record(&file_raw) || !file_raw.get(\"default\").and_then(|d| d.as_str()).is_some() {\n        return Err(format!(\"invalid or missing models file: {}\", opts.models_path).into());\n    }\n    let file_models = decode_models(\n        file_raw.get(\"models\").unwrap_or(&Value::Null),\n        \"models.json.models\",\n    )?;\n    let profile = decode_host_profile(profile_raw.as_ref())?;\n\n    let mut models = file_models;\n    if let Some(pm) = &profile.models {\n        for (k, v) in pm {\n            models.insert(k.clone(), v.clone());\n        }\n    }\n    let default_model = profile\n        .default\n        .clone()\n        .unwrap_or_else(|| file_raw[\"default\"].as_str().unwrap().to_string());\n    if !models.contains_key(&default_model) {\n        return Err(\n            format!(\"default model \\\"{default_model}\\\" is not present in the models map\").into(),\n        );\n    }\n    Ok(Config {\n        price_map: to_price_map(&models),\n        default: default_model,\n        models,\n        profile,\n    })\n}\n\npub struct CliDeps {\n    pub config: Config,\n}\n\npub fn build_deps() -> Result<CliDeps, Box<dyn std::error::Error + Send + Sync>> {\n    let bundled = BUNDLED_MODELS_JSON.to_string();\n    let config = load_config(LoadConfigOpts {\n        models_path: \"<bundled>/models.json\".into(),\n        host_profile_path: None,\n        read_file: Some(Box::new(move |path: &str| {\n            if path == \"<bundled>/models.json\" {\n                Ok(bundled.clone())\n            } else {\n                std::fs::read_to_string(path).map_err(|e| IoErr {\n                    code: if e.kind() == std::io::ErrorKind::NotFound {\n                        Some(\"ENOENT\".into())\n                    } else {\n                        None\n                    },\n                    message: e.to_string(),\n                })\n            }\n        })),\n    })?;\n    Ok(CliDeps { config })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use std::collections::HashMap;\n    use std::sync::Arc;\n\n    const MODELS_DEFAULT: &str = r#\"{\n  \"default\": \"composer-2.5\",\n  \"models\": {\n    \"composer-2.5\": {\n      \"label\": \"Composer 2.5\",\n      \"backend\": \"cursor\",\n      \"price\": { \"input\": 0.5, \"output\": 2.5, \"cacheRead\": 0.2, \"cacheWrite\": 0 }\n    },\n    \"grok-4.7-high\": {\n      \"label\": \"Grok 4.7 High\",\n      \"backend\": \"cursor\",\n      \"price\": { \"input\": 2, \"output\": 6, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n    }\n  }\n}\"#;\n\n    fn reader(files: HashMap<String, String>) -> ReadFileFn {\n        let files = Arc::new(files);\n        Box::new(move |path: &str| {\n            files.get(path).cloned().ok_or_else(|| IoErr {\n                code: Some(\"ENOENT\".into()),\n                message: \"ENOENT\".into(),\n            })\n        })\n    }\n\n    #[test]\n    fn loads_models_and_derives_price_map() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/does-not-exist.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"composer-2.5\");\n        assert_eq!(cfg.models[\"composer-2.5\"].backend, \"cursor\");\n        assert_eq!(cfg.price_map[\"composer-2.5\"].input, 0.5);\n        assert_eq!(cfg.profile, HostProfile::default());\n    }\n\n    #[test]\n    fn merges_host_profile() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/profile.json\".into(),\n            serde_json::json!({\n                \"default\": \"grok-4.7-high\",\n                \"models\": {\n                    \"openai-codex/gpt-6-luna\": {\n                        \"label\": \"GPT-6 Luna\",\n                        \"backend\": \"pi\",\n                        \"price\": { \"input\": 5, \"output\": 30, \"cacheRead\": 0.5, \"cacheWrite\": 0 }\n                    }\n                },\n                \"idleMs\": 1000\n            })\n            .to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.default, \"grok-4.7-high\");\n        assert!(cfg.models.contains_key(\"composer-2.5\"));\n        assert!(cfg.models.contains_key(\"openai-codex/gpt-6-luna\"));\n        assert_eq!(cfg.models[\"openai-codex/gpt-6-luna\"].backend, \"pi\");\n        assert_eq!(cfg.price_map[\"openai-codex/gpt-6-luna\"].output, 30.0);\n        assert_eq!(cfg.profile.idle_ms, Some(Some(1000.0)));\n    }\n\n    #[test]\n    fn missing_host_profile_is_empty() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/does-not-exist.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.profile, HostProfile::default());\n        assert_eq!(cfg.default, \"composer-2.5\");\n        assert!(cfg.price_map.contains_key(\"composer-2.5\"));\n    }\n\n    #[test]\n    fn throws_when_default_absent() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/profile.json\".into(),\n            serde_json::json!({\"default\":\"not-a-real-model\"}).to_string(),\n        );\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n            host_profile_path: Some(\"/profile.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"default\"));\n    }\n\n    #[test]\n    fn rejects_non_finite_price() {\n        let bad = serde_json::json!({\n            \"default\":\"m\",\n            \"models\":{\"m\":{\"label\":\"M\",\"backend\":\"cursor\",\"price\":{\"input\":null,\"output\":1,\"cacheRead\":0,\"cacheWrite\":0}}}\n        })\n        .to_string();\n        // NaN is not valid JSON; use a missing-like invalid (string) which fails the number check.\n        let bad = bad.replace(\"null\", \"\\\"nan\\\"\");\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), bad);\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/x.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"price.input\"));\n    }\n\n    #[test]\n    fn rejects_missing_price_field() {\n        let bad = serde_json::json!({\n            \"default\":\"m\",\n            \"models\":{\"m\":{\"label\":\"M\",\"backend\":\"cursor\",\"price\":{\"input\":1,\"output\":1,\"cacheRead\":0}}}\n        })\n        .to_string();\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), bad);\n        let e = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/x.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap_err();\n        assert!(e.to_string().contains(\"price.cacheWrite\"));\n    }\n\n    #[test]\n    fn accepts_null_idle() {\n        let mut files = HashMap::new();\n        files.insert(\"/m.json\".into(), MODELS_DEFAULT.into());\n        files.insert(\n            \"/p.json\".into(),\n            serde_json::json!({\"idleMs\":null,\"toolIdleMs\":null}).to_string(),\n        );\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/m.json\".into(),\n            host_profile_path: Some(\"/p.json\".into()),\n            read_file: Some(reader(files)),\n        })\n        .unwrap();\n        assert_eq!(cfg.profile.idle_ms, Some(None));\n        assert_eq!(cfg.profile.tool_idle_ms, Some(None));\n    }\n}\n","message":"The file /Users/user/work/delegate-13-contract/src/config.rs has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"tool_91c8a9ba-41fe-4e17-9578-af6d8e4ca96","startedAtMs":"1790852592076","completedAtMs":"1790852593454"},"model_call_id":"23978e36-7eb7-44ac-8d86-987b657a4703-23-t8u7","session_id":"e2d994f1-ef61-48a1-b218-cde928b7cc82","timestamp_ms":1790852593461}
