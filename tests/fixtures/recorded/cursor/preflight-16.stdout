{"type":"tool_call","subtype":"started","call_id":"tool_fcc7246f-eb65-4f2a-accc-2ace42a3e38","tool_call":{"shellToolCall":{"args":{"command":"cd /Users/user/work/delegate-fixtures && git show origin/main:src/cli.rs 2>/dev/null | head -200; git show origin/main:tests/cli_e2e.rs 2>/dev/null | head -150","workingDirectory":"","timeout":30000,"toolCallId":"tool_fcc7246f-eb65-4f2a-accc-2ace42a3e38","simpleCommands":["cd","git","head","git","head"],"hasInputRedirect":false,"hasOutputRedirect":true,"parsingResult":{"parsingFailed":false,"executableCommands":[{"name":"cd","args":[{"type":"word","value":"/Users/user/work/delegate-fixtures"}],"fullText":"cd /Users/user/work/delegate-fixtures"},{"name":"git","args":[{"type":"word","value":"show"},{"type":"word","value":"origin/main:src/cli.rs"}],"fullText":"git show origin/main:src/cli.rs"},{"name":"head","args":[{"type":"number","value":"-200"}],"fullText":"head -200"},{"name":"git","args":[{"type":"word","value":"show"},{"type":"word","value":"origin/main:tests/cli_e2e.rs"}],"fullText":"git show origin/main:tests/cli_e2e.rs"},{"name":"head","args":[{"type":"number","value":"-150"}],"fullText":"head -150"}],"hasRedirects":true,"hasCommandSubstitution":false,"allRedirectsAreDevNull":true,"redirects":[{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"},{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"}]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Show origin/main cli.rs and cli_e2e.rs heads","closeStdin":true,"conversationId":"24a298ed-5281-4d0f-b4ee-9f5363059aa8","adminCommandDenylist":[],"requestId":"386feff0-e8c0-4a47-a111-127accad2785"},"description":"Show origin/main cli.rs and cli_e2e.rs heads"},"hookAdditionalContexts":[],"toolCallId":"tool_fcc7246f-eb65-4f2a-accc-2ace42a3e38","startedAtMs":"1790845568687"},"model_call_id":"386feff0-