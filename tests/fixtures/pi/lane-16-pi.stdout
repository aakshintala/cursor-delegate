,\\n    pub verify_commands: Option<Vec<String>>,\\n    pub gate: String,\\n    pub allow_partial_commit: bool,\\n}\\n\\n#[derive(Debug, Clone)]\\npub struct JobSpec {\\n    pub bin: String,\\n    pub argv: Vec<String>,\\n    pub cwd: String,\\n    pub model: String,\\n    pub backend: String,\\n    pub is_write: bool,\\n    pub path: Option<String>,\\n    pub head_before: Option<String>,\\n    pub gate: String,\",\"isEmpty\":false,\"exceededLimit\":false,\"totalLines\":540,\"fileSize\":15435,\"path\":\"/Users/user/work/delegate-7-tracer/src/types.rs\",\"readRange\":{\"startLine\":330,\"endLine\":369},\"relatedCursorRulePaths\":[],\"relatedCursorRules\":[]}}},\"hookAdditionalContexts\":[],\"toolCallId\":\"tool_d885c820-0dab-4556-b303-efe4de85a48\",\"startedAtMs\":\"1790842927781\",\"completedAtMs\":\"1790842928147\"},\"model_call_id\":\"1980f2fa-bcff-4397-b8a1-23601c4723d6-5-py8f\",\"session_id\":\"36627d89-4873-4238-8376-e9782bc73a39\",\"timestamp_ms\":1790842928064}\n===\nsrc/types.rs\nsrc/backends/cursor/doctor.rs\nsrc/backends/cursor/doctor_tests.rs\nsrc/doctor.rs\n"}],"isError":false,"timestamp":1790855774740}]}
