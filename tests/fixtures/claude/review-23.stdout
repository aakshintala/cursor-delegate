supervise(args: &[String]) -> i32 {\n180\t     {\n181\t         rd.heartbeat_ms = ms;\n182\t     }\n183\t+    if let Some(ms) = std::env::var(\"DELEGATE_IDLE_MS\")\n184\t+        .ok()\n185\t+        .and_then(|v| v.parse().ok())\n186\t+    {\n187\t+        rd.idle_ms = Some(ms);\n188\t+    }\n189\t     rd.status_writer = Arc::new(CliRecordWriter {\n190\t         job_id: id.clone(),\n191\t         model: model.clone(),\n192\t         cwd: cwd.clone(),\n193\t         capability: cap_label,\n194\t+        gate: gate.clone(),\n195\t+        tool_idle_ms,\n196\t     });\n197\t     let registry = JobRegistry::new(rd);\n198\t     let Some(job) = registry\n199\t@@ -284,6 +372,9 @@ fn watch(args: &[String]) -> Result<i32, Usage> {\n200\t     }\n201\t     let start = Instant::now();\n202\t     loop {\n203\t+        for id in &ids {\n204\t+            settle_dead_supervisor(id);\n205\t+        }\n206\t         // A read can land on no file only if the record was deleted under us; treat as running.\n207\t         let recs: Vec<Option<serde_json::Value>> = ids\n208\t             .iter()\n209\t@@ -302,3 +393,41 @@ fn watch(args: &[String]) -> Result<i32, Usage> {\n210\t         std::thread::sleep(Duration::from_millis(50));\n211\t     }\n212\t }\n213\t+\n214\t+/// `kill(pid, 0)` fails with `ESRCH` only when the process is gone. `EPERM` means it exists.\n215\t+fn process_missing(pid: i32) -> bool {\n216\t+    let rc = unsafe { libc::kill(pid, 0) };\n217\t+    rc != 0 && std::io::Error::last_os_error().raw_os_error() == Some(libc::ESRCH)\n218\t+}\n219\t+\n220\t+/// A RUNNING record whose supervisor has died is terminal: rewrite it once and let the\n221\t+/// caller print the ERROR record. Re-read after the liveness check so a supervisor that\n222\t+/// finished and exited in between is not overwritten.\n223\t+fn settle_dead_supervisor(id: &str) {\n224\t+    let Some(v) = read_record(id).and_then(|s| serde_json::from_str::<serde_json::Value>(&s).ok())\n225\t+    else {\n226\t+        return;\n227\t+    };\n228\t+    if v[\"status\"] != \"RUNNING\" {\n229\t+        return;\n230\t+    }\n231\t+    let Some(pid) = v[\"supervisorPid\"].as_i64() else {\n232\t+        return;\n233\t+    };\n234\t+    if pid <= 0 || pid > i32::MAX as i64 || !process_missing(pid as i32) {\n235\t+        return;\n236\t+    }\n237\t+    let Some(v) = read_record(id).and_then(|s| serde_json::from_str::<serde_json::Value>(&s).ok())\n238\t+    else {\n239\t+        return;\n240\t+    };\n241\t+    if v[\"status\"] != \"RUNNING\" {\n242\t+        return;\n243\t+    }\n244\t+    if let Err(e) = write_supervisor_died(id, &v) {\n245\t+        eprintln!(\n246\t+            \"cannot write status record {}: {e}\",\n247\t+            cli_record_path(id).display()\n248\t+        );\n249\t+    }\n250\t+}\n251\tdiff --git a/src/finalize.rs b/src/finalize.rs\n252\tindex 319c6b1..bccad03 100644\n253\t--- a/src/finalize.rs\n254\t+++ b/src/finalize.rs\n255\t@@ -61,7 +61,7 @@ fn run_gate_ctx(ctx: &FinalizeCtx, cwd: &str) -> GateResult {\n256\t             &ctx.gate,\n257\t             cwd,\n258\t             crate::gate::GateOpts {\n259\t-                timeout_ms: None,\n260\t+                timeout_ms: ctx.gate_timeout_ms,\n261\t                 signal: ctx.signal.as_ref(),\n262\t             },\n263\t         )\n264\t@@ -146,6 +146,7 @@ pub fn default_finalize_ctx(cwd: &str, model: &str, backend: &str) -> FinalizeCt\n265\t         head_before: None,\n266\t         is_write: false,\n267\t         gate: String::new(),\n268\t+        gate_timeout_ms: None,\n269\t         allow_partial_commit: false,\n270\t         model: model.into(),\n271\t         backend: backend.into(),\n272\tdiff --git a/src/job_registry.rs b/src/job_registry.rs\n273\tindex 2dd69a7..da730c6 100644\n274\t--- a/src/job_registry.rs\n275\t+++ b/src/job_registry.rs\n276\t@@ -412,6 +412,10 @@ impl JobRegistry {\n277\t             head_before: spec.head_before.clone(),\n278\t             is_write: spec.is_write,\n279\t             gate: spec.gate.clone(),\n280\t+            gate_timeout_ms: spec\n281\t+                .tool_idle_ms\n282\t+                .unwrap_or(self.deps.tool_idle_ms)\n283\t+                .map(|ms| ms.max(0.0) as u64),\n284\t             allow_partial_commit: spec.allow_partial_commit,\n285\t             model: spec.model.clone(),\n286\t             backend: spec.backend.clone(),\n287\tdiff --git a/src/lib.rs b/src/lib.rs\n288\tindex baa04d7..158c3f7 100644\n289\t--- a/src/lib.rs\n290\t+++ b/src/lib.rs\n291\t@@ -14,6 +14,7 @@ pub mod git;\n292\t pub mod index;\n293\t pub mod isolation;\n294\t pub mod job_registry;\n295\t+pub mod lock;\n296\t pub mod models;\n297\t pub mod output;\n298\t pub mod pricing;\n299\tdiff --git a/src/lock.rs b/src/lock.rs\n300\tnew file mode 100644\n301\tindex 0000000..6d435a5\n302\t--- /dev/null\n303\t+++ b/src/lock.rs\n304\t@@ -0,0 +1,113 @@\n305\t+//! One exclusive flock per canonical working directory, held by a read-write job's supervisor.\n306\t+//! The kernel drops it when that process exits, so a crash needs no cleanup.\n307\t+\n308\t+use std::fs::OpenOptions;\n309\t+use std::hash::{Hash, Hasher};\n310\t+use std::io::{Read, Seek, Write};\n311\t+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};\n312\t+use std::os::unix::fs::OpenOptionsExt;\n313\t+use std::path::PathBuf;\n314\t+\n315\t+pub struct WriteLock {\n316\t+    file: std::fs::File,\n317\t+}\n318\t+\n319\t+impl WriteLock {\n320\t+    pub fn fd(&self) -> i32 {\n321\t+        self.file.as_raw_fd()\n322\t+    }\n323\t+}\n324\t+\n325\t+pub enum AcquireError {\n326\t+    Busy { holder: String },\n327\t+    Io(std::io::Error),\n328\t+}\n329\t+\n330\t+/// Canonical path, falling back to the given string when the directory cannot be resolved.\n331\t+fn cwd_key(cwd: &str) -> String {\n332\t+    std::fs::canonicalize(cwd)\n333\t+        .map(|p| p.to_string_lossy().into_owned())\n334\t+        .unwrap_or_else(|_| cwd.to_string())\n335\t+}\n336\t+\n337\t+fn lock_path(cwd: &str) -> PathBuf {\n338\t+    let mut hasher = std::hash::DefaultHasher::new();\n339\t+    cwd_key(cwd).hash(&mut hasher);\n340\t+    std::env::temp_dir()\n341\t+        .join(\"delegate-locks\")\n342\t+        .join(format!(\"{:016x}.lock\", hasher.finish()))\n343\t+}\n344\t+\n345\t+fn would_block(err: &std::io::Error) -> bool {\n346\t+    err.kind() == std::io::ErrorKind::WouldBlock\n347\t+        || matches!(\n348\t+            err.raw_os_error(),\n349\t+            Some(code) if code == libc::EWOULDBLOCK || code == libc::EAGAIN\n350\t+        )\n351\t+}\n352\t+\n353\t+/// `flock(LOCK_EX|LOCK_NB)`. On success the file contains `job_id` and `FD_CLOEXEC` is clear\n354\t+/// so the supervisor can inherit this fd. On `EWOULDBLOCK` the error carries the holder id.\n355\t+pub fn try_acquire(cwd: &str, job_id: &str) -> Result<WriteLock, AcquireError> {\n356\t+    let path = lock_path(cwd);\n357\t+    if let Some(dir) = path.parent() {\n358\t+        std::fs::create_dir_all(dir).map_err(AcquireError::Io)?;\n359\t+    }\n360\t+    let mut file = OpenOptions::new()\n361\t+        .read(true)\n362\t+        .write(true)\n363\t+        .create(true)\n364\t+        .truncate(false)\n365\t+        .mode(0o600)\n366\t+        .open(&path)\n367\t+        .map_err(AcquireError::Io)?;\n368\t+    let fd = file.as_raw_fd();\n369\t+    // Safety: `fd` is the open lock file. LOCK_NB returns immediately when another process holds it.\n370\t+    let rc = unsafe { libc::flock(fd, libc::LOCK_EX | libc::LOCK_NB) };\n371\t+    if rc != 0 {\n372\t+        let err = std::io::Error::last_os_error();\n373\t+        if would_block(&err) {\n374\t+            let mut holder = String::new();\n375\t+            let _ = file.take(256).read_to_string(&mut holder);\n376\t+            return Err(AcquireError::Busy {\n377\t+                holder: holder.trim().to_string(),\n378\t+            });\n379\t+        }\n380\t+        return Err(AcquireError::Io(err));\n381\t+    }\n382\t+    file.set_len(0).map_err(AcquireError::Io)?;\n383\t+    file.seek(std::io::SeekFrom::Start(0))\n384\t+        .map_err(AcquireError::Io)?;\n385\t+    file.write_all(job_id.as_bytes())\n386\t+        .map_err(AcquireError::Io)?;\n387\t+    clear_cloexec(fd).map_err(AcquireError::Io)?;\n388\t+    Ok(WriteLock { file })\n389\t+}\n390\t+\n391\t+fn clear_cloexec(fd: i32) -> std::io::Result<()> {\n392\t+    // Safety: `fd` is open. FD_CLOEXEC is per descriptor, so clearing it only affects this one.\n393\t+    let flags = unsafe { libc::fcntl(fd, libc::F_GETFD) };\n394\t+    if flags < 0 {\n395\t+        return Err(std::io::Error::last_os_error());\n396\t+    }\n397\t+    let rc = unsafe { libc::fcntl(fd, libc::F_SETFD, flags & !libc::FD_CLOEXEC) };\n398\t+    if rc < 0 {\n399\t+        return Err(std::io::Error::last_os_error());\n400\t+    }\n401\t+    Ok(())\n402\t+}\n403\t+\n404\t+/// Take ownership of a lock fd inherited across `exec`, and set `FD_CLOEXEC` so the agent\n405\t+/// and the gate do not keep the lock after this process dies.\n406\t+///\n407\t+/// # Safety\n408\t+///\n409\t+/// `fd` must be an open file descriptor inherited from the parent `run` process. It is\n410\t+/// not closed or owned by anything else in this process.\n411\t+pub unsafe fn adopt(fd: i32) -> OwnedFd {\n412\t+    let flags = unsafe { libc::fcntl(fd, libc::F_GETFD) };\n413\t+    if flags >= 0 {\n414\t+        unsafe { libc::fcntl(fd, libc::F_SETFD, flags | libc::FD_CLOEXEC) };\n415\t+    }\n416\t+    unsafe { OwnedFd::from_raw_fd(fd) }\n417\t+}\n418\tdiff --git a/src/status_record.rs b/src/status_record.rs\n419\tindex 6ab136a..77ab725 100644\n420\t--- a/src/status_record.rs\n421\t+++ b/src/status_record.rs\n422\t@@ -1,4 +1,4 @@\n423\t-use crate::types::PollResult;\n424\t+use crate::types::{JobStatus, PollResult, RunOutput, RunStatus};\n425\t use crate::util::{json_compact, random_uuid};\n426\t use std::fs;\n427\t use std::path::{Path, PathBuf};\n428\t@@ -57,6 +57,9 @@ pub struct CliResume {\n429\t     pub cwd: String,\n430\t     pub capability: &'static str,\n431\t     pub session_id: Option<String>,\n432\t+    pub gate: String,\n433\t+    #[serde(serialize_with = \"crate::util::js_num_opt\")]\n434\t+    pub tool_idle_ms: Option<f64>,\n435\t }\n436\t \n437\t /// `PollResult` plus what a watcher needs to find and resume the job.\n438\t@@ -71,12 +74,14 @@ pub struct CliRecord {\n439\t \n440\t /// Writes the CLI record for the one job this supervisor runs. A failed write exits the\n441\t /// supervisor: the file is the only truth, so a job that cannot report is not worth running.\n442\t-/// ponytail: the cursor-agent child is orphaned on that exit; supervisor death handling is #9.\n443\t+/// ponytail: the cursor-agent child is orphaned on that exit; `watch` reports the dead supervisor.\n444\t pub struct CliRecordWriter {\n445\t     pub job_id: String,\n446\t     pub model: String,\n447\t     pub cwd: String,\n448\t     pub capability: &'static str,\n449\t+    pub gate: String,\n450\t+    pub tool_idle_ms: Option<f64>,\n451\t }\n452\t \n453\t impl StatusRecordWriter for CliRecordWriter {\n454\t@@ -96,6 +101,8 @@ impl StatusRecordWriter for CliRecordWriter {\n455\t                 cwd: self.cwd.clone(),\n456\t                 capability: self.capability,\n457\t                 session_id,\n458\t+                gate: self.gate.clone(),\n459\t+                tool_idle_ms: self.tool_idle_ms,\n460\t             },\n461\t         };\n462\t         let path = cli_record_path(&self.job_id);\n463\t@@ -106,3 +113,49 @@ impl StatusRecordWriter for CliRecordWriter {\n464\t         }\n465\t     }\n466\t }\n467\t+\n468\t+/// A RUNNING record whose supervisor is gone. Keeps resume so a later command can still\n469\t+/// see what the job was; the result text is the whole reason.\n470\t+pub fn write_supervisor_died(job_id: &str, prior: &serde_json::Value) -> std::io::Result<()> {\n471\t+    let resume_in = &prior[\"resume\"];\n472\t+    let capability = if resume_in[\"capability\"] == \"read-write\" {\n473\t+        \"read-write\"\n474\t+    } else {\n475\t+        \"read-only\"\n476\t+    };\n477\t+    let session_id = resume_in[\"sessionId\"].as_str().map(str::to_string);\n478\t+    let model = resume_in[\"model\"].as_str().unwrap_or(\"\").to_string();\n479\t+    let rec = CliRecord {\n480\t+        poll: PollResult::Terminal {\n481\t+            status: JobStatus::Error,\n482\t+            result: RunOutput {\n483\t+                status: RunStatus::Error,\n484\t+                text: \"supervisor died\".into(),\n485\t+                session_id: session_id.clone(),\n486\t+                backend: \"cursor\".into(),\n487\t+                model: model.clone(),\n488\t+                usage: None,\n489\t+                cost_usd: None,\n490\t+                cost_estimated: false,\n491\t+                duration_ms: None,\n492\t+                job_id: Some(job_id.to_string()),\n493\t+                downgraded: None,\n494\t+                stderr_tail: None,\n495\t+                gate_result: None,\n496\t+                change_set: None,\n497\t+                concerns: None,\n498\t+            },\n499\t+            superseded_by: None,\n500\t+        },\n501\t+        supervisor_pid: prior[\"supervisorPid\"].as_u64().unwrap_or(0) as u32,\n502\t+        resume: CliResume {\n503\t+            model,\n504\t+            cwd: resume_in[\"cwd\"].as_str().unwrap_or(\"\").to_string(),\n505\t+            capability,\n506\t+            session_id,\n507\t+            gate: resume_in[\"gate\"].as_str().unwrap_or(\"\").to_string(),\n508\t+            tool_idle_ms: resume_in[\"toolIdleMs\"].as_f64(),\n509\t+        },\n510\t+    };\n511\t+    write_atomic(&cli_record_path(job_id), &json_compact(&rec))\n512\t+}\n513\tdiff --git a/src/types.rs b/src/types.rs\n514\tindex d938352..27db459 100644\n515\t--- a/src/types.rs\n516\t+++ b/src/types.rs\n517\t@@ -523,6 +523,8 @@ pub struct FinalizeCtx {\n518\t     pub head_before: Option<String>,\n519\t     pub is_write: bool,\n520\t     pub gate: String,\n521\t+    /// Kill the gate after this many milliseconds. `None` keeps the gate's own default.\n522\t+    pub gate_timeout_ms: Option<u64>,\n523\t     pub allow_partial_commit: bool,\n524\t     pub model: String,\n525\t     pub backend: String,\n526\tdiff --git a/tests/cli_e2e.rs b/tests/cli_e2e.rs\n527\tindex 78c2c85..23f64a2 100644\n528\t--- a/tests/cli_e2e.rs\n529\t+++ b/tests/cli_e2e.rs\n530\t@@ -9,9 +9,34 @@ use std::time::{Duration, Instant};\n531\t \n532\t const FAKE_AGENT: &str = r#\"#!/bin/sh\n533\t printf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\n534\t+rel=\"$(dirname \"$0\")/go\"\n535\t+# Silent jobs emit nothing, so the model-idle window is what kills them.\n536\t+case \"$*\" in\n537\t+  *SILENT*)\n538\t+    i=0\n539\t+    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n540\t+    exit 0\n541\t+    ;;\n542\t+esac\n543\t printf '%s\\n' '{\"type\":\"tool_call\",\"subtype\":\"started\",\"tool_call\":{\"shellToolCall\":{\"args\":{\"command\":\"ls\"}}}}'\n544\t case \"$*\" in\n545\t-  *SLOW*) i=0; while [ ! -e \"$(dirname \"$0\")/go\" ] && [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done ;;\n546\t+  *SLOW*)\n547\t+    i=0\n548\t+    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n549\t+    ;;\n550\t+esac\n551\t+case \"$*\" in\n552\t+  *COMMIT*)\n553\t+    printf 'x\\n' >> calc.py\n554\t+    git add calc.py && git commit -q -m \"Fix add\"\n555\t+    ;;\n556\t+esac\n557\t+case \"$*\" in\n558\t+  *DIRTY*)\n559\t+    printf 'x\\n' >> calc.py\n560\t+    git add calc.py && git commit -q -m \"Fix add\"\n561\t+    printf 'leftover\\n' >> extra.py\n562\t+    ;;\n563\t esac\n564\t case \"$*\" in\n565\t   *ASKME*) printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"Which db?\\nSTATUS: NEEDS_CONTEXT\",\"session_id\":\"s-2\"}' ;;\n566\t@@ -45,12 +70,20 @@ impl Env {\n567\t     }\n568\t \n569\t     fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n570\t-        let mut child = Command::new(env!(\"CARGO_BIN_EXE_delegate\"))\n571\t-            .args(args)\n572\t+        self.delegate_env(args, stdin, &[])\n573\t+    }\n574\t+\n575\t+    fn delegate_env(&self, args: &[&str], stdin: Option<&str>, env: &[(&str, &str)]) -> Output {\n576\t+        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n577\t+        cmd.args(args)\n578\t             .current_dir(&self.dir)\n579\t             .env(\"TMPDIR\", &self.dir)\n580\t             .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n581\t-            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\")\n582\t+            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n583\t+        for (k, v) in env {\n584\t+            cmd.env(k, v);\n585\t+        }\n586\t+        let mut child = cmd\n587\t             .stdin(Stdio::piped())\n588\t             .stdout(Stdio::piped())\n589\t             .stderr(Stdio::piped())\n590\t@@ -247,3 +280,318 @@ fn bad_run_input_exits_2() {\n591\t     assert_eq!(out.status.code(), Some(2));\n592\t     assert!(!Path::new(&e.dir.join(\"delegate-jobs\")).exists());\n593\t }\n594\t+\n595\t+fn stdout_id(out: &Output) -> String {\n596\t+    String::from_utf8(out.stdout.clone())\n597\t+        .unwrap()\n598\t+        .trim()\n599\t+        .to_string()\n600\t+}\n601\t+\n602\t+fn assert_ok(out: &Output) -> String {\n603\t+    assert!(\n604\t+        out.status.success(),\n605\t+        \"exit {:?}\\nstderr: {}\\nstdout: {}\",\n606\t+        out.status.code(),\n607\t+        String::from_utf8_lossy(&out.stderr),\n608\t+        String::from_utf8_lossy(&out.stdout)\n609\t+    );\n610\t+    stdout_id(out)\n611\t+}\n612\t+\n613\t+fn run_write(e: &Env, prompt: &str) -> Output {\n614\t+    e.delegate(\n615\t+        &[\n616\t+            \"run\",\n617\t+            \"--model\",\n618\t+            \"composer-2.5\",\n619\t+            \"--capability\",\n620\t+            \"read-write\",\n621\t+        ],\n622\t+        Some(prompt),\n623\t+    )\n624\t+}\n625\t+\n626\t+fn init_repo(dir: &Path) {\n627\t+    std::fs::create_dir_all(dir).unwrap();\n628\t+    let hooks = dir.with_file_name(\"githooks\");\n629\t+    std::fs::create_dir_all(&hooks).unwrap();\n630\t+    let g = |args: &[&str]| {\n631\t+        let out = Command::new(\"git\")\n632\t+            .arg(\"-C\")\n633\t+            .arg(dir)\n634\t+            .args(args)\n635\t+            .output()\n636\t+            .unwrap();\n637\t+        assert!(\n638\t+            out.status.success(),\n639\t+            \"git {args:?}: {}\",\n640\t+            String::from_utf8_lossy(&out.stderr)\n641\t+        );\n642\t+    };\n643\t+    g(&[\"init\", \"-q\"]);\n644\t+    g(&[\"config\", \"user.email\", \"t@t.com\"]);\n645\t+    g(&[\"config\", \"user.name\", \"t\"]);\n646\t+    g(&[\"config\", \"commit.gpgsign\", \"false\"]);\n647\t+    g(&[\"config\", \"core.hooksPath\", hooks.to_str().unwrap()]);\n648\t+    std::fs::write(dir.join(\"calc.py\"), \"def add(a, b):\\n    return a - b\\n\").unwrap();\n649\t+    g(&[\"add\", \"calc.py\"]);\n650\t+    g(&[\"commit\", \"-q\", \"-m\", \"init\"]);\n651\t+}\n652\t+\n653\t+fn git_head(dir: &Path) -> String {\n654\t+    let out = Command::new(\"git\")\n655\t+        .arg(\"-C\")\n656\t+        .arg(dir)\n657\t+        .args([\"rev-parse\", \"HEAD\"])\n658\t+        .output()\n659\t+        .unwrap();\n660\t+    assert!(out.status.success());\n661\t+    String::from_utf8(out.stdout).unwrap().trim().to_string()\n662\t+}\n663\t+\n664\t+#[test]\n665\t+fn gate_pass_keeps_done() {\n666\t+    let e = Env::new(\"gate-ok\");\n667\t+    let out = e.delegate(\n668\t+        &[\"run\", \"--model\", \"composer-2.5\", \"--gate\", \"true\"],\n669\t+        Some(\"ship it\"),\n670\t+    );\n671\t+    let id = assert_ok(&out);\n672\t+    let done = e.wait_terminal(&id);\n673\t+    assert_eq!(done[\"status\"], \"DONE\");\n674\t+    assert_eq!(done[\"result\"][\"gateResult\"][\"passed\"], true);\n675\t+    assert_eq!(done[\"result\"][\"gateResult\"][\"exitCode\"], 0);\n676\t+    assert_eq!(done[\"result\"][\"gateResult\"][\"command\"], \"true\");\n677\t+    assert_eq!(done[\"resume\"][\"gate\"], \"true\");\n678\t+    assert!(done[\"resume\"][\"toolIdleMs\"].is_null());\n679\t+}\n680\t+\n681\t+#[test]\n682\t+fn gate_fail_downgrades_and_records_output() {\n683\t+    let e = Env::new(\"gate-bad\");\n684\t+    let out = e.delegate(\n685\t+        &[\n686\t+            \"run\",\n687\t+            \"--model\",\n688\t+            \"composer-2.5\",\n689\t+            \"--gate\",\n690\t+            \"echo AssertionError; exit 1\",\n691\t+            \"--tool-idle-ms\",\n692\t+            \"2500\",\n693\t+        ],\n694\t+        Some(\"ship it\"),\n695\t+    );\n696\t+    let id = assert_ok(&out);\n697\t+    let done = e.wait_terminal(&id);\n698\t+    assert_eq!(done[\"status\"], \"DONE_WITH_CONCERNS\");\n699\t+    assert_eq!(done[\"result\"][\"gateResult\"][\"passed\"], false);\n700\t+    assert_eq!(done[\"result\"][\"gateResult\"][\"exitCode\"], 1);\n701\t+    assert_eq!(\n702\t+        done[\"result\"][\"gateResult\"][\"command\"],\n703\t+        \"echo AssertionError; exit 1\"\n704\t+    );\n705\t+    assert!(\n706\t+        done[\"result\"][\"gateResult\"][\"outputTail\"]\n707\t+            .as_str()\n708\t+            .unwrap()\n709\t+            .contains(\"AssertionError\"),\n710\t+        \"{done}\"\n711\t+    );\n712\t+    assert_eq!(done[\"resume\"][\"gate\"], \"echo AssertionError; exit 1\");\n713\t+    assert_eq!(done[\"resume\"][\"toolIdleMs\"], serde_json::json!(2500));\n714\t+}\n715\t+\n716\t+#[test]\n717\t+fn gate_killed_after_tool_idle_window() {\n718\t+    let e = Env::new(\"gate-timeout\");\n719\t+    let out = e.delegate(\n720\t+        &[\n721\t+            \"run\",\n722\t+            \"--model\",\n723\t+            \"composer-2.5\",\n724\t+            \"--tool-idle-ms\",\n725\t+            \"400\",\n726\t+            \"--gate\",\n727\t+            \"sleep 30\",\n728\t+        ],\n729\t+        Some(\"ship it\"),\n730\t+    );\n731\t+    let id = assert_ok(&out);\n732\t+    let done = e.wait_terminal(&id);\n733\t+    assert_eq!(done[\"status\"], \"DONE_WITH_CONCERNS\");\n734\t+    assert_eq!(done[\"result\"][\"gateResult\"][\"passed\"], false);\n735\t+    assert!(\n736\t+        done[\"result\"][\"gateResult\"][\"error\"]\n737\t+            .as_str()\n738\t+            .unwrap_or(\"\")\n739\t+            .contains(\"timeout\"),\n740\t+        \"{done}\"\n741\t+    );\n742\t+}\n743\t+\n744\t+#[test]\n745\t+fn change_set_lists_the_commit() {\n746\t+    let e = Env::new(\"cset\");\n747\t+    let repo = e.dir.join(\"repo\");\n748\t+    init_repo(&repo);\n749\t+    let before = git_head(&repo);\n750\t+    let out = e.delegate(\n751\t+        &[\n752\t+            \"run\",\n753\t+            \"--model\",\n754\t+            \"composer-2.5\",\n755\t+            \"--capability\",\n756\t+            \"read-write\",\n757\t+            \"--cwd\",\n758\t+            repo.to_str().unwrap(),\n759\t+        ],\n760\t+        Some(\"COMMIT the fix\"),\n761\t+    );\n762\t+    let id = assert_ok(&out);\n763\t+    let done = e.wait_terminal(&id);\n764\t+    let head = git_head(&repo);\n765\t+    assert_ne!(head, before);\n766\t+    assert_eq!(done[\"status\"], \"DONE\");\n767\t+    let commits = done[\"result\"][\"changeSet\"][\"newCommits\"]\n768\t+        .as_array()\n769\t+        .unwrap();\n770\t+    assert!(\n771\t+        commits.iter().any(|c| c.as_str() == Some(head.as_str())),\n772\t+        \"{commits:?} head {head}\"\n773\t+    );\n774\t+    let files = done[\"result\"][\"changeSet\"][\"filesChanged\"]\n775\t+        .as_array()\n776\t+        .unwrap();\n777\t+    assert!(files.iter().any(|f| f.as_str() == Some(\"calc.py\")));\n778\t+    assert_eq!(done[\"result\"][\"changeSet\"][\"dirtyAfter\"], false);\n779\t+    assert!(done[\"result\"][\"concerns\"].is_null());\n780\t+}\n781\t+\n782\t+#[test]\n783\t+fn dirty_tree_after_commit_is_a_concern() {\n784\t+    let e = Env::new(\"dirty\");\n785\t+    let repo = e.dir.join(\"repo\");\n786\t+    init_repo(&repo);\n787\t+    let out = e.delegate(\n788\t+        &[\n789\t+            \"run\",\n790\t+            \"--model\",\n791\t+            \"composer-2.5\",\n792\t+            \"--capability\",\n793\t+            \"read-write\",\n794\t+            \"--cwd\",\n795\t+            repo.to_str().unwrap(),\n796\t+        ],\n797\t+        Some(\"DIRTY the tree\"),\n798\t+    );\n799\t+    let id = assert_ok(&out);\n800\t+    let done = e.wait_terminal(&id);\n801\t+    assert_eq!(done[\"status\"], \"DONE_WITH_CONCERNS\");\n802\t+    assert_eq!(done[\"result\"][\"changeSet\"][\"dirtyAfter\"], true);\n803\t+    let files = done[\"result\"][\"changeSet\"][\"uncommittedFiles\"]\n804\t+        .as_array()\n805\t+        .unwrap();\n806\t+    assert!(\n807\t+        files.iter().any(|f| f.as_str() == Some(\"extra.py\")),\n808\t+        \"{files:?}\"\n809\t+    );\n810\t+    let concerns = done[\"result\"][\"concerns\"].as_array().unwrap();\n811\t+    assert!(\n812\t+        concerns\n813\t+            .iter()\n814\t+            .any(|c| c.as_str().unwrap().contains(\"still dirty\")),\n815\t+        \"{concerns:?}\"\n816\t+    );\n817\t+}\n818\t+\n819\t+#[test]\n820\t+fn silent_agent_stalls_and_record_says_why() {\n821\t+    let e = Env::new(\"stall\");\n822\t+    let out = e.delegate_env(\n823\t+        &[\"run\", \"--model\", \"composer-2.5\"],\n824\t+        Some(\"SILENT\"),\n825\t+        &[(\"DELEGATE_IDLE_MS\", \"200\")],\n826\t+    );\n827\t+    let id = assert_ok(&out);\n828\t+    let done = e.wait_terminal(&id);\n829\t+    assert_eq!(done[\"status\"], \"STALLED\");\n830\t+    let text = done[\"result\"][\"text\"].as_str().unwrap();\n831\t+    assert!(text.contains(\"Idle watchdog killed this job\"), \"{text}\");\n832\t+}\n833\t+\n834\t+#[test]\n835\t+fn write_lock_busy_until_finish_and_read_only_is_not_busy() {\n836\t+    let e = Env::new(\"busy\");\n837\t+    let first = run_write(&e, \"SLOW write\");\n838\t+    let id = assert_ok(&first);\n839\t+    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap();\n840\t+    let busy = run_write(&e, \"second write\");\n841\t+    assert_eq!(busy.status.code(), Some(3));\n842\t+    assert_eq!(\n843\t+        String::from_utf8(busy.stderr).unwrap(),\n844\t+        format!(\"BUSY {id}\\n\")\n845\t+    );\n846\t+    assert!(busy.stdout.is_empty());\n847\t+\n848\t+    let ro = e.delegate(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"read only\"));\n849\t+    let ro_id = assert_ok(&ro);\n850\t+    e.wait_terminal(&ro_id);\n851\t+\n852\t+    e.release();\n853\t+    e.wait_terminal(&id);\n854\t+    until(\"supervisor exit\", || !alive(pid));\n855\t+\n856\t+    let again = run_write(&e, \"after finish\");\n857\t+    let id2 = assert_ok(&again);\n858\t+    e.wait_terminal(&id2);\n859\t+}\n860\t+\n861\t+#[test]\n862\t+fn write_lock_released_after_supervisor_killed() {\n863\t+    let e = Env::new(\"lockkill\");\n864\t+    let first = run_write(&e, \"SLOW write\");\n865\t+    let id = assert_ok(&first);\n866\t+    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap();\n867\t+    let busy = run_write(&e, \"while held\");\n868\t+    assert_eq!(busy.status.code(), Some(3));\n869\t+    assert_eq!(\n870\t+        String::from_utf8(busy.stderr).unwrap(),\n871\t+        format!(\"BUSY {id}\\n\")\n872\t+    );\n873\t+    unsafe { libc::kill(pid as i32, libc::SIGKILL) };\n874\t+    let started = Instant::now();\n875\t+    let id2 = loop {\n876\t+        let again = run_write(&e, \"after kill\");\n877\t+        if again.status.success() {\n878\t+            break stdout_id(&again);\n879\t+        }\n880\t+        assert_eq!(\n881\t+            again.status.code(),\n882\t+            Some(3),\n883\t+            \"stderr {}\",\n884\t+            String::from_utf8_lossy(&again.stderr)\n885\t+        );\n886\t+        assert!(\n887\t+            started.elapsed() < Duration::from_secs(10),\n888\t+            \"lock not released after supervisor died\"\n889\t+        );\n890\t+        std::thread::sleep(Duration::from_millis(20));\n891\t+    };\n892\t+    e.release();\n893\t+    e.wait_terminal(&id2);\n894\t+}\n895\t+\n896\t+#[test]\n897\t+fn watch_reports_dead_supervisor() {\n898\t+    let e = Env::new(\"dead-sup\");\n899\t+    let id = e.run(\"SLOW\");\n900\t+    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap();\n901\t+    unsafe { libc::kill(pid as i32, libc::SIGKILL) };\n902\t+    let done = e.wait_terminal(&id);\n903\t+    assert_eq!(done[\"status\"], \"ERROR\");\n904\t+    assert_eq!(done[\"result\"][\"text\"], \"supervisor died\");\n905\t+    assert_eq!(e.record(&id)[\"status\"], \"ERROR\");\n906\t+    assert_eq!(e.record(&id)[\"result\"][\"text\"], \"supervisor died\");\n907\t+    e.release();\n908\t+}\n909\t"}]},"parent_tool_use_id":null,"session_id":"04a0345a-7eae-4364-9c93-6be8627e4fed","uuid":"7077aba2-a16c-4146-bb24-7f1b86b041a1","timestamp":"2026-10-01T09:27:14.556Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/pr23.diff","content":"diff --git a/src/cli.rs b/src/cli.rs\nindex 14391c1..96972b7 100644\n--- a/src/cli.rs\n+++ b/src/cli.rs\n@@ -6,10 +6,11 @@ use crate::capability::map_capability;\n use crate::git::capture_head;\n use crate::index::build_deps;\n use crate::job_registry::{JobRegistry, RegistryDeps, WaitOpts};\n+use crate::lock::{self, AcquireError};\n use crate::models::resolve_model;\n use crate::prompt::status_block;\n use crate::runner::build_argv;\n-use crate::status_record::{CliRecordWriter, cli_record_path};\n+use crate::status_record::{CliRecordWriter, cli_record_path, write_supervisor_died};\n use crate::types::{Capability, JobSpec, ResumeContext};\n use crate::util::{random_uuid, resolve_path};\n use std::io::{Read, Write};\n@@ -19,7 +20,7 @@ use std::process::{Command, Stdio};\n use std::sync::Arc;\n use std::time::{Duration, Instant};\n \n-const USAGE: &str = \"usage: delegate run --model M [--capability read-only|read-write] [--cwd D] [--prompt-file F]\\n       delegate watch <jobId>... [--timeout S]\";\n+const USAGE: &str = \"usage: delegate run --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F]\\n       delegate watch <jobId>... [--timeout S]\";\n \n /// Bad input: reason on stderr, exit 2.\n struct Usage(String);\n@@ -80,12 +81,30 @@ fn capability(name: &str) -> Result<(Capability, &'static str), Usage> {\n }\n \n fn run(args: &[String]) -> Result<i32, Usage> {\n-    let (kv, _) = parse(args, &[\"--model\", \"--capability\", \"--cwd\", \"--prompt-file\"])?;\n+    let (kv, _) = parse(\n+        args,\n+        &[\n+            \"--model\",\n+            \"--capability\",\n+            \"--cwd\",\n+            \"--gate\",\n+            \"--tool-idle-ms\",\n+            \"--prompt-file\",\n+        ],\n+    )?;\n     let Some(model) = flag(&kv, \"--model\") else {\n         return usage(\"--model is required\");\n     };\n     let cap_name = flag(&kv, \"--capability\").unwrap_or(\"read-only\");\n     capability(cap_name)?;\n+    let gate = flag(&kv, \"--gate\").unwrap_or(\"\").to_string();\n+    let tool_idle_ms = match flag(&kv, \"--tool-idle-ms\") {\n+        None => None,\n+        Some(s) => match s.parse::<f64>() {\n+            Ok(n) if n.is_finite() && n >= 0.0 => Some(n),\n+            _ => return usage(format!(\"invalid --tool-idle-ms {s}\")),\n+        },\n+    };\n     let deps = match build_deps() {\n         Ok(d) => d,\n         Err(e) => {\n@@ -122,6 +141,23 @@ fn run(args: &[String]) -> Result<i32, Usage> {\n     }\n \n     let id = random_uuid();\n+    // Read-only jobs take no lock. A read-write job locks before the supervisor exists, so a\n+    // second writer in this cwd is refused even if the first supervisor has not started.\n+    let held = if cap_name == \"read-write\" {\n+        match lock::try_acquire(&cwd, &id) {\n+            Ok(lock) => Some(lock),\n+            Err(AcquireError::Busy { holder }) => {\n+                eprintln!(\"BUSY {holder}\");\n+                return Ok(3);\n+            }\n+            Err(AcquireError::Io(e)) => {\n+                eprintln!(\"cannot lock {cwd}: {e}\");\n+                return Ok(1);\n+            }\n+        }\n+    } else {\n+        None\n+    };\n     let record = cli_record_path(&id);\n     let dir = record.parent().expect(\"record has a parent\");\n     std::fs::create_dir_all(dir).map_err(|e| Usage(format!(\"{}: {e}\", dir.display())))?;\n@@ -137,10 +173,31 @@ fn run(args: &[String]) -> Result<i32, Usage> {\n         return usage(format!(\"{}: {e}\", prompt_file.display()));\n     }\n \n+    let mut supervise_args = vec![\n+        \"__supervise\".to_string(),\n+        id.clone(),\n+        model.to_string(),\n+        cap_name.to_string(),\n+        cwd.clone(),\n+    ];\n+    if !gate.is_empty() {\n+        supervise_args.push(\"--gate\".into());\n+        supervise_args.push(gate);\n+    }\n+    if let Some(ms) = tool_idle_ms {\n+        supervise_args.push(\"--tool-idle-ms\".into());\n+        // Shortest round-trip so the supervisor parses the same number back.\n+        supervise_args.push(ms.to_string());\n+    }\n+    if let Some(lock) = &held {\n+        supervise_args.push(\"--lock-fd\".into());\n+        supervise_args.push(lock.fd().to_string());\n+    }\n     // Own session and process group, stdio closed: the supervisor outlives this process.\n+    // `held` stays open across the spawn so the inherited fd remains locked.\n     let mut child = unsafe {\n         Command::new(std::env::current_exe().map_err(|e| Usage(e.to_string()))?)\n-            .args([\"__supervise\", &id, model, cap_name, &cwd])\n+            .args(&supervise_args)\n             .stdin(Stdio::null())\n             .stdout(Stdio::null())\n             .stderr(Stdio::null())\n@@ -170,13 +227,36 @@ fn run(args: &[String]) -> Result<i32, Usage> {\n \n /// The detached half of `run`: drives one job, keeping its record fresh until it ends.\n fn supervise(args: &[String]) -> i32 {\n-    let [id, model, cap_name, cwd] = args else {\n-        return 2;\n-    };\n     let fail = |m: String| {\n         eprintln!(\"{m}\");\n         1\n     };\n+    let (kv, pos) = match parse(args, &[\"--gate\", \"--tool-idle-ms\", \"--lock-fd\"]) {\n+        Ok(v) => v,\n+        Err(Usage(m)) => return fail(m),\n+    };\n+    let [id, model, cap_name, cwd] = pos.as_slice() else {\n+        return 2;\n+    };\n+    // Hold the inherited lock until this process ends. CLOEXEC stops the agent and the gate\n+    // from keeping it after we die.\n+    let _lock = match flag(&kv, \"--lock-fd\") {\n+        None => None,\n+        Some(s) => {\n+            let Ok(fd) = s.parse::<i32>() else {\n+                return 2;\n+            };\n+            Some(unsafe { lock::adopt(fd) })\n+        }\n+    };\n+    let gate = flag(&kv, \"--gate\").unwrap_or(\"\").to_string();\n+    let tool_idle_ms = match flag(&kv, \"--tool-idle-ms\") {\n+        None => None,\n+        Some(s) => match s.parse::<f64>() {\n+            Ok(n) => Some(n),\n+            Err(_) => return 2,\n+        },\n+    };\n     let (cap, cap_label) = match capability(cap_name) {\n         Ok(c) => c,\n         Err(Usage(m)) => return fail(m),\n@@ -204,11 +284,11 @@ fn supervise(args: &[String]) -> i32 {\n         is_write: capres.is_write,\n         path: Some(resolve_path(cwd)),\n         head_before: capture_head(cwd, None),\n-        gate: String::new(),\n+        gate: gate.clone(),\n         allow_partial_commit: false,\n         wait_ms: None,\n         idle_ms: None,\n-        tool_idle_ms: None,\n+        tool_idle_ms: tool_idle_ms.map(Some),\n         background: Some(true),\n         price_map: config.price_map.clone(),\n         downgraded: false,\n@@ -220,7 +300,7 @@ fn supervise(args: &[String]) -> i32 {\n             allow_unsandboxed: true,\n             isolation: crate::types::Isolation::None,\n             verify_commands: None,\n-            gate: String::new(),\n+            gate: gate.clone(),\n             allow_partial_commit: false,\n         },\n     };\n@@ -241,11 +321,19 @@ fn supervise(args: &[String]) -> i32 {\n     {\n         rd.heartbeat_ms = ms;\n     }\n+    if let Some(ms) = std::env::var(\"DELEGATE_IDLE_MS\")\n+        .ok()\n+        .and_then(|v| v.parse().ok())\n+    {\n+        rd.idle_ms = Some(ms);\n+    }\n     rd.status_writer = Arc::new(CliRecordWriter {\n         job_id: id.clone(),\n         model: model.clone(),\n         cwd: cwd.clone(),\n         capability: cap_label,\n+        gate: gate.clone(),\n+        tool_idle_ms,\n     });\n     let registry = JobRegistry::new(rd);\n     let Some(job) = registry\n@@ -284,6 +372,9 @@ fn watch(args: &[String]) -> Result<i32, Usage> {\n     }\n     let start = Instant::now();\n     loop {\n+        for id in &ids {\n+            settle_dead_supervisor(id);\n+        }\n         // A read can land on no file only if the record was deleted under us; treat as running.\n         let recs: Vec<Option<serde_json::Value>> = ids\n             .iter()\n@@ -302,3 +393,41 @@ fn watch(args: &[String]) -> Result<i32, Usage> {\n         std::thread::sleep(Duration::from_millis(50));\n     }\n }\n+\n+/// `kill(pid, 0)` fails with `ESRCH` only when the process is gone. `EPERM` means it exists.\n+fn process_missing(pid: i32) -> bool {\n+    let rc = unsafe { libc::kill(pid, 0) };\n+    rc != 0 && std::io::Error::last_os_error().raw_os_error() == Some(libc::ESRCH)\n+}\n+\n+/// A RUNNING record whose supervisor has died is terminal: rewrite it once and let the\n+/// caller print the ERROR record. Re-read after the liveness check so a supervisor that\n+/// finished and exited in between is not overwritten.\n+fn settle_dead_supervisor(id: &str) {\n+    let Some(v) = read_record(id).and_then(|s| serde_json::from_str::<serde_json::Value>(&s).ok())\n+    else {\n+        return;\n+    };\n+    if v[\"status\"] != \"RUNNING\" {\n+        return;\n+    }\n+    let Some(pid) = v[\"supervisorPid\"].as_i64() else {\n+        return;\n+    };\n+    if pid <= 0 || pid > i32::MAX as i64 || !process_missing(pid as i32) {\n+        return;\n+    }\n+    let Some(v) = read_record(id).and_then(|s| serde_json::from_str::<serde_json::Value>(&s).ok())\n+    else {\n+        return;\n+    };\n+    if v[\"status\"] != \"RUNNING\" {\n+        return;\n+    }\n+    if let Err(e) = write_supervisor_died(id, &v) {\n+        eprintln!(\n+            \"cannot write status record {}: {e}\",\n+            cli_record_path(id).display()\n+        );\n+    }\n+}\ndiff --git a/src/finalize.rs b/src/finalize.rs\nindex 319c6b1..bccad03 100644\n--- a/src/finalize.rs\n+++ b/src/finalize.rs\n@@ -61,7 +61,7 @@ fn run_gate_ctx(ctx: &FinalizeCtx, cwd: &str) -> GateResult {\n             &ctx.gate,\n             cwd,\n             crate::gate::GateOpts {\n-                timeout_ms: None,\n+                timeout_ms: ctx.gate_timeout_ms,\n                 signal: ctx.signal.as_ref(),\n             },\n         )\n@@ -146,6 +146,7 @@ pub fn default_finalize_ctx(cwd: &str, model: &str, backend: &str) -> FinalizeCt\n         head_before: None,\n         is_write: false,\n         gate: String::new(),\n+        gate_timeout_ms: None,\n         allow_partial_commit: false,\n         model: model.into(),\n         backend: backend.into(),\ndiff --git a/src/job_registry.rs b/src/job_registry.rs\nindex 2dd69a7..da730c6 100644\n--- a/src/job_registry.rs\n+++ b/src/job_registry.rs\n@@ -412,6 +412,10 @@ impl JobRegistry {\n             head_before: spec.head_before.clone(),\n             is_write: spec.is_write,\n             gate: spec.gate.clone(),\n+            gate_timeout_ms: spec\n+                .tool_idle_ms\n+                .unwrap_or(self.deps.tool_idle_ms)\n+                .map(|ms| ms.max(0.0) as u64),\n             allow_partial_commit: spec.allow_partial_commit,\n             model: spec.model.clone(),\n             backend: spec.backend.clone(),\ndiff --git a/src/lib.rs b/src/lib.rs\nindex baa04d7..158c3f7 100644\n--- a/src/lib.rs\n+++ b/src/lib.rs\n@@ -14,6 +14,7 @@ pub mod git;\n pub mod index;\n pub mod isolation;\n pub mod job_registry;\n+pub mod lock;\n pub mod models;\n pub mod output;\n pub mod pricing;\ndiff --git a/src/lock.rs b/src/lock.rs\nnew file mode 100644\nindex 0000000..6d435a5\n--- /dev/null\n+++ b/src/lock.rs\n@@ -0,0 +1,113 @@\n+//! One exclusive flock per canonical working directory, held by a read-write job's supervisor.\n+//! The kernel drops it when that process exits, so a crash needs no cleanup.\n+\n+use std::fs::OpenOptions;\n+use std::hash::{Hash, Hasher};\n+use std::io::{Read, Seek, Write};\n+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};\n+use std::os::unix::fs::OpenOptionsExt;\n+use std::path::PathBuf;\n+\n+pub struct WriteLock {\n+    file: std::fs::File,\n+}\n+\n+impl WriteLock {\n+    pub fn fd(&self) -> i32 {\n+        self.file.as_raw_fd()\n+    }\n+}\n+\n+pub enum AcquireError {\n+    Busy { holder: String },\n+    Io(std::io::Error),\n+}\n+\n+/// Canonical path, falling back to the given string when the directory cannot be resolved.\n+fn cwd_key(cwd: &str) -> String {\n+    std::fs::canonicalize(cwd)\n+        .map(|p| p.to_string_lossy().into_owned())\n+        .unwrap_or_else(|_| cwd.to_string())\n+}\n+\n+fn lock_path(cwd: &str) -> PathBuf {\n+    let mut hasher = std::hash::DefaultHasher::new();\n+    cwd_key(cwd).hash(&mut hasher);\n+    std::env::temp_dir()\n+        .join(\"delegate-locks\")\n+        .join(format!(\"{:016x}.lock\", hasher.finish()))\n+}\n+\n+fn would_block(err: &std::io::Error) -> bool {\n+    err.kind() == std::io::ErrorKind::WouldBlock\n+        || matches!(\n+            err.raw_os_error(),\n+            Some(code) if code == libc::EWOULDBLOCK || code == libc::EAGAIN\n+        )\n+}\n+\n+/// `flock(LOCK_EX|LOCK_NB)`. On success the file contains `job_id` and `FD_CLOEXEC` is clear\n+/// so the supervisor can inherit this fd. On `EWOULDBLOCK` the error carries the holder id.\n+pub fn try_acquire(cwd: &str, job_id: &str) -> Result<WriteLock, AcquireError> {\n+    let path = lock_path(cwd);\n+    if let Some(dir) = path.parent() {\n+        std::fs::create_dir_all(dir).map_err(AcquireError::Io)?;\n+    }\n+    let mut file = OpenOptions::new()\n+        .read(true)\n+        .write(true)\n+        .create(true)\n+        .truncate(false)\n+        .mode(0o600)\n+        .open(&path)\n+        .map_err(AcquireError::Io)?;\n+    let fd = file.as_raw_fd();\n+    // Safety: `fd` is the open lock file. LOCK_NB returns immediately when another process holds it.\n+    let rc = unsafe { libc::flock(fd, libc::LOCK_EX | libc::LOCK_NB) };\n+    if rc != 0 {\n+        let err = std::io::Error::last_os_error();\n+        if would_block(&err) {\n+            let mut holder = String::new();\n+            let _ = file.take(256).read_to_string(&mut holder);\n+            return Err(AcquireError::Busy {\n+                holder: holder.trim().to_string(),\n+            });\n+        }\n+        return Err(AcquireError::Io(err));\n+    }\n+    file.set_len(0).map_err(AcquireError::Io)?;\n+    file.seek(std::io::SeekFrom::Start(0))\n+        .map_err(AcquireError::Io)?;\n+    file.write_all(job_id.as_bytes())\n+        .map_err(AcquireError::Io)?;\n+    clear_cloexec(fd).map_err(AcquireError::Io)?;\n+    Ok(WriteLock { file })\n+}\n+\n+fn clear_cloexec(fd: i32) -> std::io::Result<()> {\n+    // Safety: `fd` is open. FD_CLOEXEC is per descriptor, so clearing it only affects this one.\n+    let flags = unsafe { libc::fcntl(fd, libc::F_GETFD) };\n+    if flags < 0 {\n+        return Err(std::io::Error::last_os_error());\n+    }\n+    let rc = unsafe { libc::fcntl(fd, libc::F_SETFD, flags & !libc::FD_CLOEXEC) };\n+    if rc < 0 {\n+        return Err(std::io::Error::last_os_error());\n+    }\n+    Ok(())\n+}\n+\n+/// Take ownership of a lock fd inherited across `exec`, and set `FD_CLOEXEC` so the agent\n+/// and the gate do not keep the lock after this process dies.\n+///\n+/// # Safety\n+///\n+/// `fd` must be an open file descriptor inherited from the parent `run` process. It is\n+/// not closed or owned by anything else in this process.\n+pub unsafe fn adopt(fd: i32) -> OwnedFd {\n+    let flags = unsafe { libc::fcntl(fd, libc::F_GETFD) };\n+    if flags >= 0 {\n+        unsafe { libc::fcntl(fd, libc::F_SETFD, flags | libc::FD_CLOEXEC) };\n+    }\n+    unsafe { OwnedFd::from_raw_fd(fd) }\n+}\ndiff --git a/src/status_record.rs b/src/status_record.rs\nindex 6ab136a..77ab725 100644\n--- a/src/status_record.rs\n+++ b/src/status_record.rs\n@@ -1,4 +1,4 @@\n-use crate::types::PollResult;\n+use crate::types::{JobStatus, PollResult, RunOutput, RunStatus};\n use crate::util::{json_compact, random_uuid};\n use std::fs;\n use std::path::{Path, PathBuf};\n@@ -57,6 +57,9 @@ pub struct CliResume {\n     pub cwd: String,\n     pub capability: &'static str,\n     pub session_id: Option<String>,\n+    pub gate: String,\n+    #[serde(serialize_with = \"crate::util::js_num_opt\")]\n+    pub tool_idle_ms: Option<f64>,\n }\n \n /// `PollResult` plus what a watcher needs to find and resume the job.\n@@ -71,12 +74,14 @@ pub struct CliRecord {\n \n /// Writes the CLI record for the one job this supervisor runs. A failed write exits the\n /// supervisor: the file is the only truth, so a job that cannot report is not worth running.\n-/// ponytail: the cursor-agent child is orphaned on that exit; supervisor death handling is #9.\n+/// ponytail: the cursor-agent child is orphaned on that exit; `watch` reports the dead supervisor.\n pub struct CliRecordWriter {\n     pub job_id: String,\n     pub model: String,\n     pub cwd: String,\n     pub capability: &'static str,\n+    pub gate: String,\n+    pub tool_idle_ms: Option<f64>,\n }\n \n impl StatusRecordWriter for CliRecordWriter {\n@@ -96,6 +101,8 @@ impl StatusRecordWriter for CliRecordWriter {\n                 cwd: self.cwd.clone(),\n                 capability: self.capability,\n                 session_id,\n+                gate: self.gate.clone(),\n+                tool_idle_ms: self.tool_idle_ms,\n             },\n         };\n         let path = cli_record_path(&self.job_id);\n@@ -106,3 +113,49 @@ impl StatusRecordWriter for CliRecordWriter {\n         }\n     }\n }\n+\n+/// A RUNNING record whose supervisor is gone. Keeps resume so a later command can still\n+/// see what the job was; the result text is the whole reason.\n+pub fn write_supervisor_died(job_id: &str, prior: &serde_json::Value) -> std::io::Result<()> {\n+    let resume_in = &prior[\"resume\"];\n+    let capability = if resume_in[\"capability\"] == \"read-write\" {\n+        \"read-write\"\n+    } else {\n+        \"read-only\"\n+    };\n+    let session_id = resume_in[\"sessionId\"].as_str().map(str::to_string);\n+    let model = resume_in[\"model\"].as_str().unwrap_or(\"\").to_string();\n+    let rec = CliRecord {\n+        poll: PollResult::Terminal {\n+            status: JobStatus::Error,\n+            result: RunOutput {\n+                status: RunStatus::Error,\n+                text: \"supervisor died\".into(),\n+                session_id: session_id.clone(),\n+                backend: \"cursor\".into(),\n+                model: model.clone(),\n+                usage: None,\n+                cost_usd: None,\n+                cost_estimated: false,\n+                duration_ms: None,\n+                job_id: Some(job_id.to_string()),\n+                downgraded: None,\n+                stderr_tail: None,\n+                gate_result: None,\n+                change_set: None,\n+                concerns: None,\n+            },\n+            superseded_by: None,\n+        },\n+        supervisor_pid: prior[\"supervisorPid\"].as_u64().unwrap_or(0) as u32,\n+        resume: CliResume {\n+            model,\n+            cwd: resume_in[\"cwd\"].as_str().unwrap_or(\"\").to_string(),\n+            capability,\n+            session_id,\n+            gate: resume_in[\"gate\"].as_str().unwrap_or(\"\").to_string(),\n+            tool_idle_ms: resume_in[\"toolIdleMs\"].as_f64(),\n+        },\n+    };\n+    write_atomic(&cli_record_path(job_id), &json_compact(&rec))\n+}\ndiff --git a/src/types.rs b/src/types.rs\nindex d938352..27db459 100644\n--- a/src/types.rs\n+++ b/src/types.rs\n@@ -523,6 +523,8 @@ pub struct FinalizeCtx {\n     pub head_before: Option<String>,\n     pub is_write: bool,\n     pub gate: String,\n+    /// Kill the gate after this many milliseconds. `None` keeps the gate's own default.\n+    pub gate_timeout_ms: Option<u64>,\n     pub allow_partial_commit: bool,\n     pub model: String,\n     pub backend: String,\ndiff --git a/tests/cli_e2e.rs b/tests/cli_e2e.rs\nindex 78c2c85..23f64a2 100644\n--- a/tests/cli_e2e.rs\n+++ b/tests/cli_e2e.rs\n@@ -9,9 +9,34 @@ use std::time::{Duration, Instant};\n \n const FAKE_AGENT: &str = r#\"#!/bin/sh\n printf '%s\\n' \"$@\" > \"$(dirname \"$0\")/argv.txt\"\n+rel=\"$(dirname \"$0\")/go\"\n+# Silent jobs emit nothing, so the model-idle window is what kills them.\n+case \"$*\" in\n+  *SILENT*)\n+    i=0\n+    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n+    exit 0\n+    ;;\n+esac\n printf '%s\\n' '{\"type\":\"tool_call\",\"subtype\":\"started\",\"tool_call\":{\"shellToolCall\":{\"args\":{\"command\":\"ls\"}}}}'\n case \"$*\" in\n-  *SLOW*) i=0; while [ ! -e \"$(dirname \"$0\")/go\" ] && [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done ;;\n+  *SLOW*)\n+    i=0\n+    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n+    ;;\n+esac\n+case \"$*\" in\n+  *COMMIT*)\n+    printf 'x\\n' >> calc.py\n+    git add calc.py && git commit -q -m \"Fix add\"\n+    ;;\n+esac\n+case \"$*\" in\n+  *DIRTY*)\n+    printf 'x\\n' >> calc.py\n+    git add calc.py && git commit -q -m \"Fix add\"\n+    printf 'leftover\\n' >> extra.py\n+    ;;\n esac\n case \"$*\" in\n   *ASKME*) printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"Which db?\\nSTATUS: NEEDS_CONTEXT\",\"session_id\":\"s-2\"}' ;;\n@@ -45,12 +70,20 @@ impl Env {\n     }\n \n     fn delegate(&self, args: &[&str], stdin: Option<&str>) -> Output {\n-        let mut child = Command::new(env!(\"CARGO_BIN_EXE_delegate\"))\n-            .args(args)\n+        self.delegate_env(args, stdin, &[])\n+    }\n+\n+    fn delegate_env(&self, args: &[&str], stdin: Option<&str>, env: &[(&str, &str)]) -> Output {\n+        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_delegate\"));\n+        cmd.args(args)\n             .current_dir(&self.dir)\n             .env(\"TMPDIR\", &self.dir)\n             .env(\"CURSOR_AGENT_BIN\", self.dir.join(\"agent.sh\"))\n-            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\")\n+            .env(\"DELEGATE_HEARTBEAT_MS\", \"100\");\n+        for (k, v) in env {\n+            cmd.env(k, v);\n+        }\n+        let mut child = cmd\n             .stdin(Stdio::piped())\n             .stdout(Stdio::piped())\n             .stderr(Stdio::piped())\n@@ -247,3 +280,318 @@ fn bad_run_input_exits_2() {\n     assert_eq!(out.status.code(), Some(2));\n     assert!(!Path::new(&e.dir.join(\"delegate-jobs\")).exists());\n }\n+\n+fn stdout_id(out: &Output) -> String {\n+    String::from_utf8(out.stdout.clone())\n+        .unwrap()\n+        .trim()\n+        .to_string()\n+}\n+\n+fn assert_ok(out: &Output) -> String {\n+    assert!(\n+        out.status.success(),\n+        \"exit {:?}\\nstderr: {}\\nstdout: {}\",\n+        out.status.code(),\n+        String::from_utf8_lossy(&out.stderr),\n+        String::from_utf8_lossy(&out.stdout)\n+    );\n+    stdout_id(out)\n+}\n+\n+fn run_write(e: &Env, prompt: &str) -> Output {\n+    e.delegate(\n+        &[\n+            \"run\",\n+            \"--model\",\n+            \"composer-2.5\",\n+            \"--capability\",\n+            \"read-write\",\n+        ],\n+        Some(prompt),\n+    )\n+}\n+\n+fn init_repo(dir: &Path) {\n+    std::fs::create_dir_all(dir).unwrap();\n+    let hooks = dir.with_file_name(\"githooks\");\n+    std::fs::create_dir_all(&hooks).unwrap();\n+    let g = |args: &[&str]| {\n+        let out = Command::new(\"git\")\n+            .arg(\"-C\")\n+            .arg(dir)\n+            .args(args)\n+            .output()\n+            .unwrap();\n+        assert!(\n+            out.status.success(),\n+            \"git {args:?}: {}\",\n+            String::from_utf8_lossy(&out.stderr)\n+        );\n+    };\n+    g(&[\"init\", \"-q\"]);\n+    g(&[\"config\", \"user.email\", \"t@t.com\"]);\n+    g(&[\"config\", \"user.name\", \"t\"]);\n+    g(&[\"config\", \"commit.gpgsign\", \"false\"]);\n+    g(&[\"config\", \"core.hooksPath\", hooks.to_str().unwrap()]);\n+    std::fs::write(dir.join(\"calc.py\"), \"def add(a, b):\\n    return a - b\\n\").unwrap();\n+    g(&[\"add\", \"calc.py\"]);\n+    g(&[\"commit\", \"-q\", \"-m\", \"init\"]);\n+}\n+\n+fn git_head(dir: &Path) -> String {\n+    let out = Command::new(\"git\")\n+        .arg(\"-C\")\n+        .arg(dir)\n+        .args([\"rev-parse\", \"HEAD\"])\n+        .output()\n+        .unwrap();\n+    assert!(out.status.success());\n+    String::from_utf8(out.stdout).unwrap().trim().to_string()\n+}\n+\n+#[test]\n+fn gate_pass_keeps_done() {\n+    let e = Env::new(\"gate-ok\");\n+    let out = e.delegate(\n+        &[\"run\", \"--model\", \"composer-2.5\", \"--gate\", \"true\"],\n+        Some(\"ship it\"),\n+    );\n+    let id = assert_ok(&out);\n+    let done = e.wait_terminal(&id);\n+    assert_eq!(done[\"status\"], \"DONE\");\n+    assert_eq!(done[\"result\"][\"gateResult\"][\"passed\"], true);\n+    assert_eq!(done[\"result\"][\"gateResult\"][\"exitCode\"], 0);\n+    assert_eq!(done[\"result\"][\"gateResult\"][\"command\"], \"true\");\n+    assert_eq!(done[\"resume\"][\"gate\"], \"true\");\n+    assert!(done[\"resume\"][\"toolIdleMs\"].is_null());\n+}\n+\n+#[test]\n+fn gate_fail_downgrades_and_records_output() {\n+    let e = Env::new(\"gate-bad\");\n+    let out = e.delegate(\n+        &[\n+            \"run\",\n+            \"--model\",\n+            \"composer-2.5\",\n+            \"--gate\",\n+            \"echo AssertionError; exit 1\",\n+            \"--tool-idle-ms\",\n+            \"2500\",\n+        ],\n+        Some(\"ship it\"),\n+    );\n+    let id = assert_ok(&out);\n+    let done = e.wait_terminal(&id);\n+    assert_eq!(done[\"status\"], \"DONE_WITH_CONCERNS\");\n+    assert_eq!(done[\"result\"][\"gateResult\"][\"passed\"], false);\n+    assert_eq!(done[\"result\"][\"gateResult\"][\"exitCode\"], 1);\n+    assert_eq!(\n+        done[\"result\"][\"gateResult\"][\"command\"],\n+        \"echo AssertionError; exit 1\"\n+    );\n+    assert!(\n+        done[\"result\"][\"gateResult\"][\"outputTail\"]\n+            .as_str()\n+            .unwrap()\n+            .contains(\"AssertionError\"),\n+        \"{done}\"\n+    );\n+    assert_eq!(done[\"resume\"][\"gate\"], \"echo AssertionError; exit 1\");\n+    assert_eq!(done[\"resume\"][\"toolIdleMs\"], serde_json::json!(2500));\n+}\n+\n+#[test]\n+fn gate_killed_after_tool_idle_window() {\n+    let e = Env::new(\"gate-timeout\");\n+    let out = e.delegate(\n+        &[\n+            \"run\",\n+            \"--model\",\n+            \"composer-2.5\",\n+            \"--tool-idle-ms\",\n+            \"400\",\n+            \"--gate\",\n+            \"sleep 30\",\n+        ],\n+        Some(\"ship it\"),\n+    );\n+    let id = assert_ok(&out);\n+    let done = e.wait_terminal(&id);\n+    assert_eq!(done[\"status\"], \"DONE_WITH_CONCERNS\");\n+    assert_eq!(done[\"result\"][\"gateResult\"][\"passed\"], false);\n+    assert!(\n+        done[\"result\"][\"gateResult\"][\"error\"]\n+            .as_str()\n+            .unwrap_or(\"\")\n+            .contains(\"timeout\"),\n+        \"{done}\"\n+    );\n+}\n+\n+#[test]\n+fn change_set_lists_the_commit() {\n+    let e = Env::new(\"cset\");\n+    let repo = e.dir.join(\"repo\");\n+    init_repo(&repo);\n+    let before = git_head(&repo);\n+    let out = e.delegate(\n+        &[\n+            \"run\",\n+            \"--model\",\n+            \"composer-2.5\",\n+            \"--capability\",\n+            \"read-write\",\n+            \"--cwd\",\n+            repo.to_str().unwrap(),\n+        ],\n+        Some(\"COMMIT the fix\"),\n+    );\n+    let id = assert_ok(&out);\n+    let done = e.wait_terminal(&id);\n+    let head = git_head(&repo);\n+    assert_ne!(head, before);\n+    assert_eq!(done[\"status\"], \"DONE\");\n+    let commits = done[\"result\"][\"changeSet\"][\"newCommits\"]\n+        .as_array()\n+        .unwrap();\n+    assert!(\n+        commits.iter().any(|c| c.as_str() == Some(head.as_str())),\n+        \"{commits:?} head {head}\"\n+    );\n+    let files = done[\"result\"][\"changeSet\"][\"filesChanged\"]\n+        .as_array()\n+        .unwrap();\n+    assert!(files.iter().any(|f| f.as_str() == Some(\"calc.py\")));\n+    assert_eq!(done[\"result\"][\"changeSet\"][\"dirtyAfter\"], false);\n+    assert!(done[\"result\"][\"concerns\"].is_null());\n+}\n+\n+#[test]\n+fn dirty_tree_after_commit_is_a_concern() {\n+    let e = Env::new(\"dirty\");\n+    let repo = e.dir.join(\"repo\");\n+    init_repo(&repo);\n+    let out = e.delegate(\n+        &[\n+            \"run\",\n+            \"--model\",\n+            \"composer-2.5\",\n+            \"--capability\",\n+            \"read-write\",\n+            \"--cwd\",\n+            repo.to_str().unwrap(),\n+        ],\n+        Some(\"DIRTY the tree\"),\n+    );\n+    let id = assert_ok(&out);\n+    let done = e.wait_terminal(&id);\n+    assert_eq!(done[\"status\"], \"DONE_WITH_CONCERNS\");\n+    assert_eq!(done[\"result\"][\"changeSet\"][\"dirtyAfter\"], true);\n+    let files = done[\"result\"][\"changeSet\"][\"uncommittedFiles\"]\n+        .as_array()\n+        .unwrap();\n+    assert!(\n+        files.iter().any(|f| f.as_str() == Some(\"extra.py\")),\n+        \"{files:?}\"\n+    );\n+    let concerns = done[\"result\"][\"concerns\"].as_array().unwrap();\n+    assert!(\n+        concerns\n+            .iter()\n+            .any(|c| c.as_str().unwrap().contains(\"still dirty\")),\n+        \"{concerns:?}\"\n+    );\n+}\n+\n+#[test]\n+fn silent_agent_stalls_and_record_says_why() {\n+    let e = Env::new(\"stall\");\n+    let out = e.delegate_env(\n+        &[\"run\", \"--model\", \"composer-2.5\"],\n+        Some(\"SILENT\"),\n+        &[(\"DELEGATE_IDLE_MS\", \"200\")],\n+    );\n+    let id = assert_ok(&out);\n+    let done = e.wait_terminal(&id);\n+    assert_eq!(done[\"status\"], \"STALLED\");\n+    let text = done[\"result\"][\"text\"].as_str().unwrap();\n+    assert!(text.contains(\"Idle watchdog killed this job\"), \"{text}\");\n+}\n+\n+#[test]\n+fn write_lock_busy_until_finish_and_read_only_is_not_busy() {\n+    let e = Env::new(\"busy\");\n+    let first = run_write(&e, \"SLOW write\");\n+    let id = assert_ok(&first);\n+    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap();\n+    let busy = run_write(&e, \"second write\");\n+    assert_eq!(busy.status.code(), Some(3));\n+    assert_eq!(\n+        String::from_utf8(busy.stderr).unwrap(),\n+        format!(\"BUSY {id}\\n\")\n+    );\n+    assert!(busy.stdout.is_empty());\n+\n+    let ro = e.delegate(&[\"run\", \"--model\", \"composer-2.5\"], Some(\"read only\"));\n+    let ro_id = assert_ok(&ro);\n+    e.wait_terminal(&ro_id);\n+\n+    e.release();\n+    e.wait_terminal(&id);\n+    until(\"supervisor exit\", || !alive(pid));\n+\n+    let again = run_write(&e, \"after finish\");\n+    let id2 = assert_ok(&again);\n+    e.wait_terminal(&id2);\n+}\n+\n+#[test]\n+fn write_lock_released_after_supervisor_killed() {\n+    let e = Env::new(\"lockkill\");\n+    let first = run_write(&e, \"SLOW write\");\n+    let id = assert_ok(&first);\n+    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap();\n+    let busy = run_write(&e, \"while held\");\n+    assert_eq!(busy.status.code(), Some(3));\n+    assert_eq!(\n+        String::from_utf8(busy.stderr).unwrap(),\n+        format!(\"BUSY {id}\\n\")\n+    );\n+    unsafe { libc::kill(pid as i32, libc::SIGKILL) };\n+    let started = Instant::now();\n+    let id2 = loop {\n+        let again = run_write(&e, \"after kill\");\n+        if again.status.success() {\n+            break stdout_id(&again);\n+        }\n+        assert_eq!(\n+            again.status.code(),\n+            Some(3),\n+            \"stderr {}\",\n+            String::from_utf8_lossy(&again.stderr)\n+        );\n+        assert!(\n+            started.elapsed() < Duration::from_secs(10),\n+            \"lock not released after supervisor died\"\n+        );\n+        std::thread::sleep(Duration::from_millis(20));\n+    };\n+    e.release();\n+    e.wait_terminal(&id2);\n+}\n+\n+#[test]\n+fn watch_reports_dead_supervisor() {\n+    let e = Env::new(\"dead-sup\");\n+    let id = e.run(\"SLOW\");\n+    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap();\n+    unsafe { libc::kill(pid as i32, libc::SIGKILL) };\n+    let done = e.wait_terminal(&id);\n+    assert_eq!(done[\"status\"], \"ERROR\");\n+    assert_eq!(done[\"result\"][\"text\"], \"supervisor died\");\n+    assert_eq!(e.record(&id)[\"status\"], \"ERROR\");\n+    assert_eq!(e.record(&id)[\"result\"][\"text\"], \"supervisor died\");\n+    e.release();\n+}\n","numLines":909,"startLine":1,"totalLines":909}}}
