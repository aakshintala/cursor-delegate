s\"}],\"hasRedirects\":false,\"hasCommandSubstitution\":false,\"redirects\":[]},\"fileOutputThresholdBytes\":\"40000\",\"isBackground\":false,\"skipApproval\":false,\"timeoutBehavior\":\"TIMEOUT_BEHAVIOR_BACKGROUND\",\"hardTimeout\":86400000,\"descri [... omitted end of long line]","contentTruncated":false,"isContextLine":false},{"lineNumber":26,"content":"{\"type\":\"tool_call\",\"subtype\":\"completed\",\"call_id\":\"tool_7d346946-35a9-41ee-a6ad-7b17832d25c\",\"tool_call\":{\"shellToolCall\":{\"args\":{\"command\":\"cd /Users/user/work/delegate-fixtures && for n in 7 9 10 11; do echo \\\"=== ISSUE $n ===\\\"; gh issue view $n --comments; done\",\"workingDirectory\":\"\",\"timeout\":30000,\"toolCallId\":\"tool_7d346946-35a9-41ee-a6ad-7b17832d25c\",\"simpleCommands\":[\"cd\",\"echo\",\"gh\"],\"hasInputRedirect\":false,\"hasOutputRedirect\":false,\"parsingResult\":{\"parsingFailed\":false,\"executableCommands\":[{\"name\":\"cd\",\"args\":[{\"type\":\"word\",\"value\":\"/Users/user/work/delegate-fixtures\"}],\"fullText\":\"cd /Users/user/work/delegate-fixtures\"},{\"name\":\"echo\",\"args\":[{\"type\":\"string\",\"value\":\"\\\"=== ISSUE $n ===\\\"\"}],\"fullText\":\"echo \\\"=== ISSUE $n ===\\\"\"},{\"name\":\"gh\",\"args\":[{\"type\":\"word\",\"value\":\"issue\"},{\"type\":\"word\",\"value\":\"view\"},{\"type\":\"simple_expansion\",\"value\":\"$n\"},{\"type\":\"word\",\"value\":\"--comments\"}],\"fullText\":\"gh issue view $n --comments\"}],\"hasRedirects\":false,\"hasCommandSu [... omitted end of long line]","contentTruncated":false,"isContextLine":false}]},{"file":"./tests/fixtures/cursor/preflight-9.stdout","matches":[{"lineNumber":40,"content":"{\"type\":\"tool_call\",\"subtype\":\"completed\",\"call_id\":\"tool_2a62a29c-785c-46f5-8578-c6e93fa186b\",\"tool_call\":{\"shellToolCall\":{\"args\":{\"command\":\"cd /Users/user/work/delegate-fixtures && gh issue view 9 && gh issue view 4 && gh issue view 4 --comments && gh issue view 7 --comments\",\"workingDirectory\"