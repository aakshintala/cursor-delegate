{"type":"tool_execution_update","toolCallId":"call_01a0f74eb98576d78e073768db1f5f29|fc_01a0f74eb98576d78e073768db1f5f29","toolName":"bash","args":{"command":"grep -n \"from_name\\|capability\\|Capability\\|read-only\\|read_only\\|Ask\\b\" src/cli.rs | head -40; echo ====; grep -n \"from_name\" src/models.rs src/cli_info.rs src/*.rs | head; echo ====; sed -n '1,80p' src/models.rs"},"partialResult":{"content":[{"type":"text","text":"14:use crate::types::{Capability, Config, JobSpec, ResumeContext};\n24:const USAGE: &str = \"usage: delegate run --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F]\n25:       delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\n90:fn capability(name: &str) -> Result<(Capability, &'static str), Usage> {\n92:        \"read-only\" => Ok((Capability::Ask, \"read-only\")),\n93:        \"read-write\" => Ok((Capability::WriteUnsandboxed, \"read-write\")),\n95:            \"unknown capability {o}: use read-only or read-write\"\n220:            \"--capability\",\n230:    let cap_name = flag(&kv, \"--capability\").unwrap_or(\"read-only\");\n231:    capability(cap_name)?;\n299:        &[\"--model\", \"--capability\", \"--gate\", \"--prompt-file\"],\n321:    let stored_cap = old[\"resume\"][\"capability\"]\n323:        .unwrap_or(\"read-only\")\n361:    let cap_name = flag(&kv, \"--capability\").unwrap_or(&stored_cap).to_string();\n362:    capability(&cap_name)?;\n585:    let (cap, cap_label) = match capability(cap_name) {\n605:    let Some(backend) = Backend::from_name(&resolved.backend) else {\n629:            capability: cap,\n660:        capability: cap_label,\n====\nsrc/models.rs:28:    if Backend::from_name(&entry.backend).is_none() {\nsrc/cli_info.rs:102:    if let Some(backend) = Backend::from_name(\"cursor\") {\nsrc/cli_info.rs:111:        if Backend::from_name(&entry.backend).is_none() {\nsrc/cli_info.rs:102:    if let Some(backend) = Backend::from