 already publishes: the author name and\n    email appear in its commits and `.claude-plugin/*.json`.\n    \n    Fixtures that captured the owner's global instructions were deleted\n    rather than redacted: the #14 preflight, the #14 lane and the PR #28\n    review.\n    \n    Part of #4.\n    \n    Co-authored with Claude Code.\n    \n    ---------\n    \n    Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>\n\ndiff --git a/src/backends/cursor/mod.rs b/src/backends/cursor/mod.rs\nindex 4533737..9fc6eec 100644\n--- a/src/backends/cursor/mod.rs\n+++ b/src/backends/cursor/mod.rs\n@@ -409,7 +409,6 @@ mod tests {\n             assert_eq!(res.clean_exit, clean, \"{stem}\");\n             assert_eq!(res.stderr, stderr, \"{stem}\");\n             assert_eq!(res.cost_usd, None, \"{stem}\");\n-            assert!(!res.text.contains(\"CANCELLED\"), \"{stem}\");\n             if !clean && stdout.is_empty() {\n                 assert_eq!(res.is_error, Some(true), \"{stem}\");\n                 assert_eq!(res.text, stderr, \"{stem}\");\ndiff --git a/tests/budgets.rs b/tests/budgets.rs\nindex b402c4b..619b251 100644\n--- a/tests/budgets.rs\n+++ b/tests/budgets.rs\n@@ -209,7 +209,13 @@ fn supervisor_rss_kb(pid: i32) -> u64 {\n         .expect(\"rss parse\")\n }\n \n+/// Budgets are ~3x macOS medians; GitHub's Linux runners need 4x more headroom (#31).\n fn assert_wall_ms(cmd: &str, ms: u128, budget: u128) {\n+    let budget = if std::env::var_os(\"CI\").is_some() {\n+        budget * 4\n+    } else {\n+        budget\n+    };\n     assert!(ms <= budget, \"{cmd} took {ms}ms, budget {budget}ms\");\n }\n \n","stderr":"","executionTime":951,"interleavedOutput":"commit b99b5183f29f99aeaef8291314a3a181328f84b5\nAuthor: Amogh Akshintala <amoghakshintala@gmail.com>\nDate:   Thu Oct 1 04:56:48 2026 -0700\n\n    test: round-1 fixtures, plus CI budget headroom (#31) (#30)\n    \n    Adds the raw headless streams recorded while landing #7–#15:\n    implementation lanes, repairs, code reviews, over-engineering reviews\n    and doc preflights, across cursor, pi and claude. All were recorded with\n    `scripts/record.sh`, so all are redacted.\n    \n    This PR adds only files under `tests/fixtures/**`. The fixtures contain\n    no data beyond what the repo already publishes: the author name and\n    email appear in its commits and `.claude-plugin/*.json`.\n    \n    Fixtures that captured the owner's global instructions were deleted\n    rather than redacted: the #14 preflight, the #14 lane and the PR #28\n    review.\n    \n    Part of #4.\n    \n    Co-authored with Claude Code.\n    \n    ---------\n    \n    Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>\n\ndiff --git a/src/backends/cursor/mod.rs b/src/backends/cursor/mod.rs\nindex 4533737..9fc6eec 100644\n--- a/src/backends/cursor/mod.rs\n+++ b/src/backends/cursor/mod.rs\n@@ -409,7 +409,6 @@ mod tests {\n             assert_eq!(res.clean_exit, clean, \"{stem}\");\n             assert_eq!(res.stderr, stderr, \"{stem}\");\n             assert_eq!(res.cost_usd, None, \"{stem}\");\n-            assert!(!res.text.contains(\"CANCELLED\"), \"{stem}\");\n             if !clean && stdout.is_empty() {\n                 assert_eq!(res.is_error, Some(true), \"{stem}\");\n                 assert_eq!(res.text, stderr, \"{stem}\");\ndiff --git a/tests/budgets.rs b/tests/budgets.rs\nindex b402c4b..619b251 100644\n--- a/tests/budgets.rs\n+++ b/tests/budgets.rs\n@@ -209,7 +209,13 @@ fn supervisor_rss_kb(pid: i32) -> u64 {\n         .expect(\"rss parse\")\n }\n \n+/// Budgets are ~3x macOS medians; GitHub's Linux runners need 4x more headroom (#31).\n fn assert_wall_ms(cmd: &str, ms: u128, budget: u128) {\n+    let budget = if std::env::var_os(\"CI\").is_some() {\n+        budget * 4\n+    } else {\n+        budget\n+    };\n     assert!(ms <= budget, \"{cmd} took {ms}ms, budget {budget}ms\");\n }\n \n","localExecutionTimeMs":434},"isBackground":false},"description":"Show non-fixture hunks on origin/main"},"hookAdditionalContexts":[],"toolCallId":"call-210d7399-f246-4a61-a279-3a6a137bfbe0-174\nfc_2b8e46ef-cc03-923e-8562-2a8720268459_0","startedAtMs":"1790857058903","completedAtMs":"1790857060127"},"model_call_id":"a6d3412c-3430-4550-9d20-13547e35e0bc-69-c9n0","session_id":"a6874d86-60bb-4e84-8f2b-a3973591ec9a","timestamp_ms":1790857060141}
