:false,"isContextLine":false},{"lineNumber":71,"content":"{\"type\":\"thinking\",\"subtype\":\"delta\",\"text\":\" for record.sh.\",\"session_id\":\"04dee1e2-96f1-4825-9926-d7d625c11b45\",\"timestamp_ms\":1790843235865}","contentTruncated":false,"isContextLine":false}]},{"file":"./tests/fixtures/claude/review-18.stdout","matches":[{"lineNumber":15,"content":"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HGCobLa7Nx9QjMUKTdjMFz\",\"type\":\"tool_result\",\"content\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, [... omitted end of long line]","contentTruncated":false,"isContextLine":false},{"lineNumber":16,"content":"{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5-5\",\"id\":\"msg_011CfbCYdc48mVkXaDEsBPPp\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01FKZWbvxr8HjdhvcCbZixe8\",\"name\":\"Bash\",\"input\":{\"command\":\"cat -n scripts/record.sh scripts/redact.jq; gh issue view 4 --comments | sed -n '/^--$/,$p' | tail -120; gh pr diff 18 --name-only | tail -8; ls tests/fixtures/pi\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":7740,\"cache_read_input_tokens\":28108,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":7740},\"output_tokens\":20,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"75962907-5eab-4e06-bb8e-7524e710c52b\",\"timestamp\":\"2026-10-01T08:27:02.741Z\",\"reques [... omitted end of long line]","contentTruncated":false,"isContextLine":false},{"lineNumber":18,"content":"{\"type\":\"system\",\"subtype\":\"task_started\",\"task_id\":\"bmsibbwv0\",\"tool_use_id\":\"toolu_01FKZWbvxr8HjdhvcCbZixe8\",\"description\":\"cat -n scripts/record.sh scripts/redact.jq; gh issue view 4 --comments | sed -n '/^--$/,$p' | tail -120; gh pr diff 18 --name-only | tail -8; ls tests/fixtures/pi\",\"is_backgrounded\":false,\"task_type\":\"local_bash\",\"uuid\":\"7e90be3a-ae32-4de2-8485-f99112bd939a\",\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\"}","contentTruncated":false,"isContextLine":false},{"lineNumber":19,"content":"{\"type\":\"system\",\"subtype\":\"task_notification\",\"task_id\":\"bmsibbwv0\",\"tool_use_id\":\"toolu_01FKZWbvxr8HjdhvcCbZixe8\",\"status\":\"completed\",\"output_file\":\"\",\"summary\":\"cat -n scripts/record.sh scripts/redact.jq; gh issue view 4 --comments | sed -n '/^--$/,$p' | tail -120; gh pr diff 18 --name-only | tail -8; ls tests/fixtures/pi\",\"uuid\":\"19d05a96-ab41-4e85-861e-fa660c56fd89\",\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\"}","contentTruncated":false,"isContextLine":false},{"lineNumber":20,"content":"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01FKZWbvxr8HjdhvcCbZixe8\",\"type\":\"tool_result\",\"content\":\"     1\\t#!/usr/bin/env bash\\n     2\\t# Run one prompt through a backend's raw headless CLI and save stdout/stderr as a parser fixture.\\n     3\\t#\\n     4\\t#   scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt\\n     5\\t#\\n     6\\t# BACKEND: cursor | pi | claude. CAPABILITY: read-only | read-write (pi rejects read-only).\\n     7\\t# SESSION resumes that backend session; pi and claude get a fresh id when it is omitted.\\n     8\\t# CANCEL_AFTER=N sends the CLI SIGTERM after N seconds.\\n     9\\t# Writes tests/fixtures/BACKEND/NAME.{stdout,stderr,argv}; prints the session id (if chosen) and exit code.\\n    10\\tset -uo pipefail\\n    11\\t\\n    12\\t[ $# -ge 4 ] || { sed -n 2,9p \\\"$0\\\"; exit 2; }\\n    13\\tbackend=$1 model=$2 cap=$3 name=$4 cwd=${5:-$PWD} session=${6:-}\\n    14\\there=\\\"$(cd \\\"$(dirname \\\"$0\\\")\\\" && pwd)\\\"\\n    15\\tout=\\\"$here/../t [... omitted end of long line]","contentTruncated":false,"isContextLine":false}]},{"file":"./tests/fixtures/cursor/preflight-7.stdout","matches":[{"lineNumber":43,"content":"{\"type\":\"tool_call\",\"subtype\":\"completed\",\"call_id\":\"tool_eb875959-7d27-439a-8b4e-682d339e1b6\",\"tool_call\":{\"shellToolCall\":{\"args\":{\"command\":\"cd /Users/user/work/delegate-7-tracer && gh issue view 4 --comments\",\"workingDirectory\":\"\",\"timeout\":30000,\"toolCallId\":\"tool_eb875959-7d27-439a-8b4e-682d339e1b6\",\"simpleCommands\":[\"cd\",\"gh\"],\"hasInputRedirect\":false,\"hasOutputRedirect\":false,\"parsingResult\":{\"parsingFailed\":false,\"executableCommands\":[{\"name\":\"cd\",\"args\":[{\"type\":\"word\",\"value\":\"/Users/user/work/delegate-7-tracer\"}],\"fullText\":\"cd /Users/user/work/delegate-7-tracer\"},{\"name\":\"gh\",\"args\":[{\"type\":\"word\",\"value\":\"issue\"},{\"type\":\"word\",\"value\":\"view\"},{\"type\":\"number\",\"value\":\"4\"},{\"type\":\"word\",\"value\":\"--comments\"}],\"fullText\":\"gh issue view 4 --comments\"}],\"hasRedirects\":false,\"hasCommandSubstitution\":false,\"redirects\":[]},\"fileOutputThresholdBytes\":\"40000\",\"isBackground\":false,\"skipApproval\":false,\"timeoutBehavior\":\"TIMEOUT_BEHAVIOR_BACKGROUND\",\"hardTimeout\":86400000,\"descri [... omitted end of long line]","contentTruncated":false,"isContextLine":false}]},{"file":"./tests/fixtures/claude/review-19.stdout","matches":[{"lineNumber":16,"content":"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01CtvwRn678gy36PGvnifeBK\",\"type\":\"tool_result\",\"content\":\"title:\\tci: Linux workflow (fmt, clippy, tests) (#8)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t19\\nurl:\\thttps://github.com/user/delegate/pull/19\\nadditions:\\t23\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #8\\n\\nOne `ci` job on `ubuntu-latest` for pull requests and pushes to `main`: `cargo fmt --check`, `cargo clippy --all-targets -- -D warnings`, `cargo test`. Ignored live tests stay excluded. Every action is pinned by SHA, the token is read-only, and `pull_request_target` is not used.\\n\\nImplemented by composer-2.5 via `scripts/record.sh` (fixture lands with #18).\\n\\nCo-authored with Claude Code.\\ndiff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\\nnew file mode 100644\\nindex 0000000..ede11d5\\n--- /dev/null\\n+++ b/.github/workflows/ci.yml\\n@@ -0,0 +1,23 @ [... omitted end of long line]","contentTruncated":false,"isContextLine":false}]},{"file":"./scripts/record.sh","matches":[{"lineNumber":4,"content":"#   scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt","contentTruncated":false,"isContextLine":false}]}],"totalLines":18,"totalMatchedLines":18,"clientTruncated":false,"ripgrepTruncated":false,"headLimitApplied":20}}}}}},"hookAdditionalContexts":[],"toolCallId":"tool_71333a62-cd62-4d47-9660-63e0780fc41","startedAtMs":"1790843235946","completedAtMs":"1790843236339"},"model_call_id":"19994692-c4a5-4e36-9b