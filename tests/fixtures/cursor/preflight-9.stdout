{"type":"tool_call","subtype":"completed","call_id":"tool_66040b69-ff5b-44dd-a056-f15b8154304","tool_call":{"readToolCall":{"args":{"path":"/Users/user/work/delegate-fixtures/src/capability.rs"},"result":{"success":{"content":"use crate::types::Capability;\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct CapabilityResult {\n    pub flags: Vec<String>,\n    pub is_write: bool,\n    pub forced: bool,\n    pub downgraded: bool,\n}\n\npub fn map_capability(capability: Capability, allow_unsandboxed: bool) -> CapabilityResult {\n    match capability {\n        Capability::Ask => CapabilityResult {\n            flags: vec![\"--mode\".into(), \"ask\".into(), \"--force\".into()],\n            is_write: false,\n            forced: true,\n            downgraded: false,\n        },\n        Capability::Plan => CapabilityResult {\n            flags: vec![\"--mode\".into(), \"plan\".into(), \"--force\".into()],\n            is_write: false,\n            forced: true,\n            downgraded: false,\n        },\n        Capability::Write => CapabilityResult {\n            flags: vec![\"--sandbox\".into(), \"enabled\".into(), \"--force\".into()],\n            is_write: true,\n            forced: true,\n            downgraded: false,\n        },\n        Capability::WriteUnsandboxed => {\n            if allow_unsandboxed {\n                CapabilityResult {\n                    flags: vec![\"--sandbox\".into(), \"disabled\".into(), \"--force\".into()],\n                    is_write: true,\n                    forced: true,\n                    downgraded: false,\n                }\n            } else {\n                CapabilityResult {\n                    flags: vec![\"--sandbox\".into(), \"enabled\".into(), \"--force\".into()],\n                    is_write: true,\n                    forced: true,\n                    downgraded: true,\n                }\n            }\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn ask_carries_force() {\n        let r = map_capability(Capability::Ask, false);\n        assert_eq!(r.flags, [\"--mode\", \"ask\", \"--force\"]);\n        assert!(!r.is_write);\n        assert!(r.forced);\n        assert!(!r.downgraded);\n    }\n\n    #[test]\n    fn plan_carries_force() {\n        let r = map_capability(Capability::Plan, false);\n        assert_eq!(r.flags, [\"--mode\", \"plan\", \"--force\"]);\n        assert!(!r.is_write);\n        assert!(r.forced);\n        assert!(!r.downgraded);\n    }\n\n    #[test]\n    fn write_is_sandboxed_and_forced() {\n        let r = map_capability(Capability::Write, false);\n        assert_eq!(r.flags, [\"--sandbox\", \"enabled\", \"--force\"]);\n        assert!(r.is_write);\n        assert!(r.forced);\n        assert!(!r.downgraded);\n    }\n\n    #[test]\n    fn write_unsandboxed_with_allow() {\n        let r = map_capability(Capability::WriteUnsandboxed, true);\n        assert_eq!(r.flags, [\"--sandbox\", \"disabled\", \"--force\"]);\n        assert!(r.is_write);\n        assert!(r.forced);\n        assert!(!r.downgraded);\n    }\n\n    #[test]\n    fn write_unsandboxed_without_signal_downgrades() {\n        let r = map_capability(Capability::WriteUnsandboxed, false);\n        assert_eq!(r.flags, [\"--sandbox\", \"enabled\", \"--force\"]);\n        assert!(r.is_write);\n        assert!(r.forced);\n        assert!(r.downgraded);\n    }\n\n    #[test]\n    fn default_capability_is_ask() {\n        let r = map_capability(Capability::Ask, false);\n        assert_eq!(r.flags, [\"--mode\", \"ask\", \"--force\"]);\n        assert!(r.forced);\n    }\n}\n","isEmpty":false,"exceededLimit":false,"totalLines":107,"fileSize":3213,"path":"/Users/user/work/delegate-fixtures/src/capability.rs","readRange":{"startLine":1,"endLine":107},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"tool_66040b69-ff5b-44dd-a056-f15b8154304","startedAtMs":"1790844179742","completedAtMs":"1790844180220"},"model_call_id":"a09b1b3c-34aa-45b4-baad-9b84151ab3b9-0-t3cc","session_id":"a4b49908-1fff-436c-8b85-7053cc35540a","timestamp_ms":1790844180145}
