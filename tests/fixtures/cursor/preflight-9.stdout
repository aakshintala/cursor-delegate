Y jobId (waits for the lock holder).\".into(),","contentTruncated":false,"isContextLine":false},{"lineNumber":191,"content":"            description: \"Block until the FIRST listed job is terminal (or timeout). Returns {jobs, firstDone?}. Pairs with background:true for parallel dispatch.\".into(),","contentTruncated":false,"isContextLine":false},{"lineNumber":196,"content":"            description: \"Block until ALL listed (known) jobs are terminal (or timeout). Returns {jobs, allDone}. Empty input -> {jobs:{}, allDone:true}.\".into(),","contentTruncated":false,"isContextLine":false}]},{"file":"./src/status_record.rs","matches":[{"lineNumber":12,"content":"        .join(\"cursor-delegate-jobs\")","contentTruncated":false,"isContextLine":false}]},{"file":"./src/runner/tests.rs","matches":[{"lineNumber":74,"content":"        *fake.auto.lock().unwrap() = Some(done_ok());","contentTruncated":false,"isContextLine":false},{"lineNumber":274,"content":"    *reg.fake.auto.lock().unwrap() = Some(result_of(","contentTruncated":false,"isContextLine":false},{"lineNumber":342,"content":"            .lock()","contentTruncated":false,"isContextLine":false},{"lineNumber":363,"content":"        *calls.lock().unwrap(),","contentTruncated":false,"isContextLine":false},{"lineNumber":378,"content":"            .lock()","contentTruncated":false,"isContextLine":false},{"lineNumber":397,"content":"    assert_eq!(*calls.lock().unwrap(), vec![(\"/srv\".into(), None)]);","contentTruncated":false,"isContextLine":false},{"lineNumber":503,"content":"    *reg.fake.auto.lock().unwrap() = Some(result_of(","contentTruncated":false,"isContextLine":false},{"lineNumber":524,"content":"    *reg.fake.auto.lock().unwrap() = None;","contentTruncated":false,"isContextLine":false}]},{"file":"./src/runner.rs","matches":[{"lineNumber":152,"content":"        idle_ms: input.idle_ms,","contentTruncated":false,"isContextLine":false},{"lineNumber":153,"content":"        tool_idle_ms: input.tool_idle_ms,","contentTru