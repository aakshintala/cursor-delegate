_PI_FIXTURE\"\n","oldText":"cat \"$DELEGATE_TEST_PI_FIXTURE\"\n"},{"newText":"case \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\n# Replay the fixture as this session, like the real pi echoes the id back.\nsid=\"\"\nprev=\"\"\nfor a in \"$@\"; do\n  if [ \"$prev\" = \"--session-id\" ]; then sid=\"$a\"; fi\n  prev=\"$a\"\ndone\nsed \"s/afcd8926-430b-4d9a-a552-d7c6d1b900ba/$sid/g\" \"$DELEGATE_TEST_PI_FIXTURE\"\n\"#;","oldText":"case \"$*\" in\n  *SLOW*)\n    i=0\n    while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n    ;;\nesac\ncat \"$DELEGATE_TEST_PI_FIXTURE\"\n\"#;"}],"path":"tests/pi_e2e.rs"}}],"api":"openai-responses","provider":"opencode-go","model":"muse-spark-1.3-contributor","usage":{"input":755,"output":1655,"cacheRead":145905,"cacheWrite":0,"reasoning":1023,"totalTokens":148315,"cost":{"input":0.0000755,"output":0.000331,"cacheRead":0.00029181000000000004,"cacheWrite":0,"total":0.0006983100000000001}},"stopReason":"toolUse","timestamp":1790856226469,"responseId":"resp_6abe4c23f275649e53554f2d","rawStopReason":"completed","thinkingLevel":"high"},"toolResults":[{"role":"toolResult","toolCallId":"call_01a0f759975077c5a0129997e9dfde91|fc_01a0f759975077c5a0129997e9dfde91","toolName":"edit","content":[{"type":"text","text":"edits[2] and edits[1] overlap in tests/pi_e2e.rs. Merge them into one edit or target disjoint regions."}],"details":{},"isError":true,"timestamp":1790856241789}]}
