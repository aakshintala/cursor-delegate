rom\\\", \\\"supersededBy\\\"] {\\n        if let Some(v) = prior.get(key) {\\n            obj.insert(key.into(), v.clone());\\n        }\\n    }\\n    write_atomic(\\n        &cli_record_path(job_id),\\n        &json_compact(&serde_json::Value::Object(obj)),\\n    )\\n}\",\"oldText\":\"    write_atomic(&cli_record_path(job_id), &json_compact(&rec))\\n}\"}]"}}
