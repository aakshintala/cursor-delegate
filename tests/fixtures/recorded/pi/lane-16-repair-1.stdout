figured_ids {\n        let r = run_command(\n            &path,\n            &[\"auth\".into(), \"check\".into(), \"--model\".into(), id.clone()],\n        );\n        if !r.ok {\n            let err = command_err(&r, &format!(\"auth check --model {id}\"));\n            model_failures.push(format!(\"model {id} auth check failed: {err}\"));\n            report\n                .warnings\n                .push(format!(\"pi: model {id} auth check failed: {err}\"));\n        }\n    }\n    report.sections.push(DoctorBackendSection {\n        backend: \"pi\".into(),\n        found: true,\n        path: Some(path),\n        version: ver,\n        version_error: ver_err,\n        model_failures,\n    });\n}\n\npub(crate) fn lines(report: &DoctorReport) -> (String, bool) {\n    // No section means no pi models in the table: nothing to say.\n    let Some(sec) = report.sections.iter().find(|s| s.backend == \"pi\") else {\n        return (String::new(), false);\n    };\n    let mut text = String::new();\n    let mut failed = false;\n    if !sec.found {\n        text += &status_line(\"fail\", \"pi: pi not found\");\n        return (text, true);\n    }\n    let path = sec.path.as_deref().unwrap_or(\"?\");\n    match sec.version.as_deref() {\n        Some(v) => {\n            text += &status_line(\"ok\", &format!(\"pi: pi {v} ({path})\"));\n        }\n        None => {\n            let e = sec.version_error.as_deref().unwrap_or(\"unknown error\");\n            text += &status_line(\"fail\", &format!(\"pi: pi --version failed: {e}\"));\n            failed = true;\n        }\n    }\n    for m in &sec.model_failures {\n        text += &status_line(\"warn\", &format!(\"pi: {m}\"));\n    }\n    (text, failed)\n}\n\nfn command_err(r: &AgentCommandResult, what: &str) -> String {\n    r.error.clone().unwrap_or_else(|| {\n        let t = r.stderr.trim();\n        if t.is_empty() {\n            format!(\"pi {what} failed\")\n        } else {\n            t.to_string()\n        }\n    })\n}\n\n"}],"isError":false,"timestamp":1790856746778},{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"rs_6abe4e2b115411a6508b4b5c:rs_01a0f7615b2b753c960db0f6e17d278d\",\"type\":\"reasoning\",\"status\":\"completed\",\"encrypted_content\":\"Q-PaDgH1cjkW8rhyjyA6fliV5fCY6vgUChJftfTAzCXtEolewrMxB7Mo3OCtmlulb0-KyJFQD4PGkKW8P4dNWxuBg7RoePHjEZVuMcKRu2e-TxKBml1cQa88z9RW7-dHvfxOlgMXit7ZfSR8zlUZTBQNTVnhyrCEz8xsG9XRfTzsQ1D0qfDl5ee9RDhQkaIEZCYB6SdnAMpVczDYMCr1uVtAdQRW49X3uPBx_khFAicj2Pc2e85h-GqsasDcSXhCy2KKMPSdNUtC1yJXYgNlAcBTdMzJAZpd32TxTfyFCFwy9AxAC-9DpVXvXJYnlOfTDzfMafXk6CWk4eyX_BdXM4X4wmo9Gq5L7PZdvm93-v7xaMmJGrm1qvn25nLIJSC_9ZloHblYzVfmneQ4wmXeR-2jAnE8cGLfok7f75UK6GDazIUSnRphUGUrlh6ZR5lvKosZcecCYvqaRtAPySrYc64RPO_A0DHbJz0xzDKuu7F1y9y8F5z-r6cdCE2STBfRu61XsxGd3q6AYYRe-NZK_RU5T-xkg3tO0FaEEDUVG0Xfl4ruf0bNWR17eC60VyR22Q4kfDmlOKYm5YuWiuB3huJR2MxXJRsDi8uFh3xQtsE6ah5a5z0NbGFvpL_rbijuXzrE2KweEnkj2TqHGDNAxO7CWMdj2Dq6PADs8XJmOyD556lav5Kul9n_j4MyIm9x89TDiXaBgXMqaYCIROpFpDEq_7spIcmd0kxRQU5aIUn7F2jUBD8GpuY6bK0XrPkspwQmbU8YBaDVbK7l_6eR7oWxb1pYUxU49ispLnbrrZVkPsYEiaJZXSn340GUUxBXUUms-dlvVXDF4qjGUBx7l7OXZ8XcTktlabb2eOQsL5165GTPdmJ39W6wc7KjxUg26LJrdy9mH5fYWnQV_r_VoBb38fVK2Hb3TRg7W-f8bLLn0tFxA69dCI0nfbSVzR_CJ2DyKhjJdmxTsyGW2rtggKzt7yYFQtjgKSQsbh9Dz_GL79PR1DYhkThSOLTO5C6XKhu5yZtxufTxWz2LY-SflPccB0ZvRQpGk_lGgn1Vk4Ao87pfJp8IYVB2_bPEE-dU_rz2td5ZG-hvcRZHNiaQq0j9WuApGkzCA_dmi0PGNm6fQiygHECodWf7gkDXGpjYmkMD_2NKg6Tpr51BANvKxcnCkeqOvWVV9fhW3GrkNQDKVcr2KinYqjXS-zUimuA-bl5zVLaNusdDX_Clu3w2735POKfjksZv9B93y6IMKtpELETBmsw3o970WPr4pgS8ul3BEZbOZx0lUkG4-x4Jl07g6QEJRwqELEiMpKccGsx95JM8rNwaDayJPTKsIrvaJMztLqh-WsUhQYqSLHlQ4OZXl98q_Pit1_adotC9i4oEX0HmWaCDNT5CLdrXfoycrDsZx_OZh33oVKV9fQ\",\"summary\":[]}"},{"type":"toolCall","id":"call_01a0f761609476b682d9d51136cf17ec|fc_01a0f761609476b682d9d51136cf17ec","name":"bash","arguments":{"command":"sed -n '125,260p' src/backends/pi/doctor.rs"}}],"api":"openai-responses","provider":"opencode-go","model":"muse-spark-1.3-contributor","usage":{"input":791,"output":181,"cacheRead":180977,"cacheWrite":0,"reasoning":115,"totalTokens":181949,"cost":{"input":0.00007910000000000001,"output":0.000036200000000000006,"cacheRead":0.000361954,"cacheWrite":0,"total":0.000477254}},"stopReason":"toolUse","timestamp":1790856746780,"responseId":"resp_6abe4e2b115411a6508b4b5c","rawStopReason":"completed","thinkingLevel":"high"},{"role":"toolResult","toolCallId":"call_01a0f761609476b682d9d51136cf17ec|fc_01a0f761609476b682d9d51136cf17ec","toolName":"bash","content":[{"type":"text","text":"        },\n        None,\n    )\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::types::{Config, HostProfile, ModelEntry, Price};\n    use std::collections::HashMap;\n\n    fn config_with_pi() -> Config {\n        let mut models: HashMap<String, ModelEntry> = HashMap::new();\n        models.insert(\n            \"openai-codex/gpt-6-luna\".into(),\n            ModelEntry {\n                label: \"GPT-6 Luna\".into(),\n                backend: \"pi\".into(),\n                price: Price {\n                    input: 1.0,\n                    output: 2.0,\n                    cache_read: 0.0,\n                    cache_write: 0.0,\n                },\n            },\n        );\n        Config {\n            default: \"openai-codex/gpt-6-luna\".into(),\n            price_map: models.iter().map(|(k, v)| (k.clone(), v.price)).collect(),\n            models,\n            profile: HostProfile::default(),\n        }\n    }\n\n    fn ok_result(stdout: &str) -> AgentCommandResult {\n        AgentCommandResult {\n            ok: true,\n            stdout: stdout.into(),\n            stderr: String::new(),\n            error: None,\n        }\n    }\n\n    fn err_result() -> AgentCommandResult {\n        AgentCommandResult {\n            ok: false,\n            stdout: String::new(),\n            stderr: String::new(),\n            error: Some(\"exit 1\".into()),\n        }\n    }\n\n    fn empty_report() -> DoctorReport {\n        DoctorReport {\n            ok: false,\n            plugin: crate::types::DoctorPluginInfo {\n                version: \"1.0.0\".into(),\n            },\n            agent: crate::types::DoctorAgentInfo {\n                found: false,\n                path: None,\n                version: None,\n                error: None,\n            },\n            account: crate::types::DoctorAccountInfo {\n                logged_in: false,\n                email: None,\n                subscription: None,\n                current_model: None,\n                error: None,\n            },\n            model_menu: crate::types::DoctorModelMenuInfo {\n                configured_ids: vec![],\n                account_ids: None,\n                missing_from_account: vec![],\n                prices_checkable: false,\n                note: String::new(),\n                error: None,\n            },\n            sections: vec![],\n            warnings: vec![],\n            failures: vec![],\n        }\n    }\n\n    #[test]\n    fn fill_ok_and_auth_failure_is_a_warning() {\n        let config = config_with_pi();\n        let mut report = empty_report();\n        let opts = RunDoctorOpts {\n            config: &config,\n            resolve_bin: Some(&|_| \"/bin/pi\".into()),\n            bin_exists: Some(&|_| true),\n            run_command: Some(&|_: &str, args: &[String]| {\n                if args == [\"--version\"] {\n                    ok_result(\"0.99.2\\n\")\n                } else {\n                    assert_eq!(\n                        args,\n                        &[\"auth\", \"check\", \"--model\", \"openai-codex/gpt-6-luna\"]\n                    );\n                    err_result()\n                }\n            }),\n            read_package_version: None,\n        };\n        fill(&mut report, &opts);\n        assert!(report.failures.is_empty());\n        assert_eq!(report.warnings.len(), 1);\n        let (text, failed) = lines(&report);\n        assert!(!failed);\n        assert!(text.contains(\"ok    pi: pi 0.99.2 (/bin/pi)\"), \"{text}\");\n        assert!(\n            text.contains(\"warn  pi: model openai-codex/gpt-6-luna auth check failed: exit 1\"),\n            \"{text}\"\n        );\n    }\n\n    #[test]\n    fn fill_missing_binary_is_a_failure() {\n        let config = config_with_pi();\n        let mut report = empty_report();\n        let opts = RunDoctorOpts {\n            config: &config,\n            resolve_bin: Some(&|_| \"/nowhere/pi\".into()),\n            bin_exists: Some(&|_| false),\n            run_command: None,\n            read_package_version: None,\n        };\n        fill(&mut report, &opts);\n        assert_eq!(report.failures.len(), 1);\n        let (text, failed) = lines(&report);\n        assert!(failed);\n        assert!(text.contains(\"fail  pi: pi not found\"), \"{text}\");\n    }\n\n"}],"isError":false,"timestamp":1790856749755},{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"rs_6abe4e2fe01dcb8e31cf4d2c:rs_01a0f7616799713992a90f17183b4112\",\"type\":\"reasoning\",\"status\":\"completed\",\"encrypted_content\":\"Q-PaDgG37I18nCwhbNqU_NlHuN-KYhI-podcm6Qf1NDdDggLgmICvEst6MKB5-ITGSbKv_BLe4R0rPosooejsfq6F8hzeLe3fmouUHXO363kohanUVsiDK7UeBZNbEWh3p7rozqPWsAFhC3HomYFumpgSoHyX-bqd0MKMB3L6KYl6Gj3Ic-DjcYsGI5fNMTE9TmdUq64mw3OgjKFvCSRVLRmgWJDcEkeNG5TTfvwbIAxmQhFzGYXs-MOvsOEe0RVefGHYooZD3ZdmVNPjYmCQjYCswG6e8iKOzMcgAZF7DfmmzLymHeSqY4uMmiPnlPmgs146dTXKn1B_xOF8aC9WiBPn21G5039fMzrRvY1mzIlxG6CLVL92IkJ75CcPddnpA28i4Gm4_udbb51E1xQVa4Lejxxzf3t7mJRirmF76dw95jsU2NMovJIvChSZvmhJ7QCnLALYJErXmKburIQC0-BVeDYDnOYKyCBLaYFoIH2UNdFMSSdvA_odTKUgXU90CiSt1uP6lV6MK_ZSu5mCh1qNveRWuyseVSm9A2b04PbtKwcrQr__RGmIe4EpzAO_wgYoQ8D4TY_XKFww4H8y9pnAhxW-JGXZcsh5eCrwpU72fHqZMZottuHHnK3GutG3YDq28p7fM9t9TU-2--2pKjM_HQUoreMVZqpqgI55TIZYpR6d0d02XlYYnzO2SfbDeN9v3hvWjv9_JwCPLpgm2Zpu0IXtCk9OvZes0OQwmu5st3YjB-vPV5JSdjT8nTPEducT6KST_aXyG-4V_8Lp-MAUtb5QXCDOOsyeF5YSlMGhiTVZMH4VT9SmCeOP07