\"supervisorPid\"].as_i64().unwrap();\n    unsafe { libc::kill(pid as i32, libc::SIGKILL) };\n    let done = e.wait_terminal(&id);\n    assert_eq!(done[\"status\"], \"ERROR\");\n    assert_eq!(done[\"result\"][\"text\"], \"supervisor died\");\n    assert_eq!(e.record(&id)[\"status\"], \"ERROR\");\n    assert_eq!(e.record(&id)[\"result\"][\"text\"], \"supervisor died\");\n    e.release();\n}\n\nimpl Env {\n    fn resume(&self, id: &str, extra: &[&str], prompt: Option<&str>) -> Output {\n        let mut args: Vec<&str> = vec![\"resume\", id];\n        args.extend(extra);\n        self.delegate(&args, prompt)\n    }\n\n    fn resume_ok(&self, id: &str, extra: &[&str], prompt: &str) -> String {\n        let out = self.resume(id, extra, Some(prompt));\n        assert!(\n            out.status.success(),\n            \"exit {:?}\\nstderr: {}\\nstdout: {}\",\n            out.status.code(),\n            String::from_utf8_lossy(&out.stderr),\n            String::from_utf8_lossy(&out.stdout)\n        );\n        String::from_utf8(out.stdout).unwrap().trim().to_string()\n    }\n}\n\n#[test]\nfn resume_continues_session_and_links_chain() {\n    let e = Env::new(\"resume\");\n    let a = e.run(\"first brief\");\n    let first = e.wait_terminal(&a);\n    assert_eq!(first[\"status\"], \"DONE\");\n    assert_eq!(first[\"resume\"][\"sessionId\"], \"s-1\");\n    let pid = first[\"supervisorPid\"].as_i64().unwrap();\n    // The original supervisor is gone: everything resume needs is in the record.\n    until(\"supervisor exit\", || !alive(pid));\n\n    let b = e.resume_ok(&a, &[], \"follow up\");\n    assert_eq!(b.len(), 36);\n    let done = e.wait_terminal(&b);\n    assert_eq!(done[\"status\"], \"DONE\");\n    assert_eq!(done[\"result\"][\"jobId\"], b.as_str());\n    assert_eq!(done[\"resume\"][\"sessionId\"], \"s-1\");\n    // No heartbeat/progress on a terminal record.\n    assert!(done.get(\"lastHeartbeatAt\").is_none(), \"{done}\");\n    assert!(done.get(\"progress\").is_none(), \"{done}\");\n    // The fake agent saw the resume flag with the original model, cwd and capability.\n    let argv = e.argv();\n    assert!(\n        argv.windows(2).any(|w| w == [\"--resume\", \"s-1\"]),\n        \"{argv:?}\"\n    );\n    assert!(argv.contains(&\"composer-2.5\".to_string()), \"{argv:?}\");\n    assert!(\n        argv.windows(2).any(|w| w == [\"--mode\", \"ask\"]),\n        \"{argv:?}\"\n    );\n    assert_eq!(done[\"resume\"][\"cwd\"], first[\"resume\"][\"cwd\"]);\n    assert_eq!(done[\"resume\"][\"capability\"], \"read-only\");\n    // Chain links: B points back, A points forward, nothing else on A changed.\n    assert_eq!(done[\"resumedFrom\"], a.as_str());\n    let again = e.record(&a);\n    assert_eq!(again[\"supersededBy\"], b.as_str());\n    assert_eq!(again[\"result\"], first[\"result\"]);\n    assert_eq!(again[\"resume\"], first[\"resume\"]);\n}\n\n#[test]\nfn resume_overrides_replace_stored_values() {\n    let e = Env::new(\"resume-ov\");\n    let a = e.run(\"first\");\n    e.wait_terminal(&a);\n\n    let b = e.resume_ok(&a, &[\"--model\", \"grok-4.7-high\"], \"again\");\n    let done = e.wait_terminal(&b);\n    assert_eq!(done[\"resume\"][\"model\"], \"grok-4.7-high\");\n    assert!(\n        e.argv().contains(&\"grok-4.7-high\".to_string()),\n        \"{:?}\",\n        e.argv()\n    );\n\n    let c = e.resume_ok(&a, &[\"--capability\", \"read-write\"], \"as writer\");\n    let done = e.wait_terminal(&c);\n    assert_eq!(done[\"resume\"][\"capability\"], \"read-write\");\n    assert!(\n        e.argv().windows(2).any(|w| w == [\"--sandbox\", \"disabled\"]),\n        \"{:?}\",\n        e.argv()\n    );\n\n    std::fs::write(e.dir.join(\"follow.txt\"), \"gated follow-up\").unwrap();\n    let out = e.resume(&a, &[\"--gate\", \"true\", \"--prompt-file\", \"follow.txt\"], None);\n    let d = e.ok_output(&out);\n    let done = e.wait_terminal(&d);\n    assert_eq!(done[\"resume\"][\"gate\"], \"true\");\n    assert_eq!(done[\"result\"][\"gateResult\"][\"command\"], \"true\");\n    assert_eq!(done[\"result\"][\"gateResult\"][\"passed\"], true);\n}\n\n#[test]\nfn resume_cross_backend_and_unknown_models_exit_2() {\n    let e = Env::new(\"resume-xb\");\n    let a = e.run(\"first\");\n    e.wait_terminal(&a);\n    for m in [\"openai-codex/gpt-6-luna\", \"claude-sonnet-5-5\"] {\n        let out = e.resume(&a, &[\"--model\", m], Some(\"again\"));\n        assert_eq!(out.status.code(), Some(2), \"{m}\");\n        let err = String::from_utf8_lossy(&out.stderr);\n        assert!(err.contains(\"backend\"), \"{err}\");\n        assert!(out.stdout.is_empty());\n    }\n    let out = e.resume(&a, &[\"--model\", \"nope-9\"], Some(\"again\"));\n    assert_eq!(out.status.code(), Some(2));\n    let err = String::from_utf8_lossy(&out.stderr);\n    assert!(err.contains(\"nope-9\") && err.contains(\"composer-2.5\"), \"{err}\");\n}\n\n#[test]\nfn resume_running_job_exits_2() {\n    let e = Env::new(\"resume-run\");\n    let slow = e.run(\"SLOW\");\n    assert_eq!(e.record(&slow)[\"status\"], \"RUNNING\");\n    let out = e.resume(&slow, &[], Some(\"follow\"));\n    assert_eq!(out.status.code(), Some(2));\n    assert!(\n        String::from_utf8_lossy(&out.stderr).contains(\"RUNNING\"),\n        \"{}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    e.release();\n    e.wait_terminal(&slow);\n}\n\n#[test]\nfn resume_read_write_into_locked_cwd_is_busy() {\n    let e = Env::new(\"resume-busy\");\n    let a = e.ok_output(&e.run_write(\"quick\"));\n    e.wait_terminal(&a);\n    let blocker = e.ok_output(&e.run_write(\"SLOW write\"));\n    assert_eq!(e.record(&blocker)[\"status\"], \"RUNNING\");\n    // A was read-write, so resuming it needs the same lock a second run would take.\n    let busy = e.resume(&a, &[], Some(\"more\"));\n    assert_eq!(busy.status.code(), Some(3));\n    assert_eq!(\n        String::from_utf8(busy.stderr).unwrap(),\n        format!(\"BUSY {blocker}\\n\")\n    );\n    assert!(busy.stdout.is_empty());\n    // Once free, the resumed job takes the lock fresh through the shared run path.\n    e.release();\n    e.wait_terminal(&blocker);\n    let b = e.resume_ok(&a, &[], \"more\");\n    e.wait_terminal(&b);\n}\n\n#[test]\nfn resume_unknown_no_session_and_empty_prompt_exit_2() {\n    let e = Env::new(\"resume-err\");\n    let out = e.resume(\"nope\", &[], Some(\"hi\"));\n    assert_eq!(out.status.code(), Some(2));\n    assert!(\n        String::from_utf8_lossy(&out.stderr).contains(\"unknown job nope\"),\n        \"{}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n\n    let a = e.run(\"first\");\n    e.wait_terminal(&a);\n    let out = e.resume(&a, &[], Some(\"  \\n\"));\n    assert_eq!(out.status.code(), Some(2));\n    assert!(\n        String::from_utf8_lossy(&out.stderr).contains(\"prompt is empty\"),\n        \"{}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n\n    // A record with no session id (supervisor died before any result) is not resumable.\n    let slow = e.run(\"SLOW\");\n    let pid = e.record(&slow)[\"supervisorPid\"].as_i64().unwrap();\n    unsafe { libc::kill(pid as i32, libc::SIGKILL) };\n    let dead = e.wait_terminal(&slow);\n    assert_eq!(dead[\"status\"], \"ERROR\");\n    let out = e.resume(&slow, &[], Some(\"follow\"));\n    assert_eq!(out.status.code(), Some(2));\n    assert!(\n        String::from_utf8_lossy(&out.stderr).contains(\"session\"),\n        \"{}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    e.release();\n}\n\n/// A fake that stays RUNNING behind a grandchild: `sleep` inherits the agent's process\n/// group, so killing only the agent would leave it behind.\nconst CANCEL_AGENT: &str = r#\"#!/bin/sh\nDUR=300\nsleep $DUR &\necho $! > \"$(dirname \"$0\")/grandchild.pid\"\necho $$ > \"$(dirname \"$0\")/agent.pid\"\nrel=\"$(dirname \"$0\")/go\"\ni=0\nwhile [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\nprintf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n\"#;\n\nfn read_pid(dir: &std::path::Path, name: &str) -> i32 {\n    std::fs::read_to_string(dir.join(name))\n        .unwrap()\n        .trim()\n        .parse()\n        .unwrap()\n}\n\nfn gone(pid: i32) -> bool {\n    unsafe { libc::kill(pid, 0) } != 0\n}\n\n#[test]\nfn cancel_kills_agent_and_grandchild() {\n    let e = Env::new(\"cancel\");\n    std::fs::write(e.dir.join(\"agent.sh\"), CANCEL_AGENT).unwrap();\n    let id = e.run(\"CANCELME\");\n    until(\"agent spawn\", || {\n        e.dir.join(\"agent.pid\").exists() && e.dir.join(\"grandchild.pid\").exists()\n    });\n    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n    let agent = read_pid(&e.dir, \"agent.pid\");\n    let grand = read_pid(&e.dir, \"grandchild.pid\");\n    assert!(!gone(agent) && !gone(grand), \"agent {agent} grand {grand}\");\n\n    let out = e.delegate(&[\"cancel\", &id], None);\n    assert_eq!(out.status.code(), Some(0), \"{}\", String::from_utf8_lossy(&out.stderr));\n    let final_rec: Value = serde_json::from_slice(&out.stdout).unwrap();\n    assert_eq!(final_rec[\"status\"], \"CANCELLED\");\n    assert_eq!(final_rec[\"result\"][\"status\"], \"CANCELLED\");\n    assert_eq!(final_rec[\"result\"][\"jobId\"], id.as_str());\n    until(\"agent death\", || gone(agent) && gone(grand));\n    assert_eq!(e.record(&id)[\"status\"], \"CANCELLED\");\n}\n\n#[test]\nfn cancel_on_terminal_job_prints_record_and_exits_0() {\n    let e = Env::new(\"cancel-noop\");\n    let id = e.run(\"quick\");\n    let done = e.wait_terminal(&id);\n    let out = e.delegate(&[\"cancel\", &id], None);\n    assert_eq!(out.status.code(), Some(0));\n    let printed: Value = serde_json::from_slice(&out.stdout).unwrap();\n    assert_eq!(printed, done);\n}\n\n#[test]\nfn cancel_unknown_job_exits_2() {\n    let e = Env::new(\"cancel-unknown\");\n    let out = e.delegate(&[\"cancel\", \"nope\"], None);\n    assert_eq!(out.status.code(), Some(2));\n    assert!(\n        String::from_utf8_lossy(&out.stderr).contains(\"unknown job nope\"),\n        \"{}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n}","oldText":"#[test]\nfn watch_reports_dead_supervisor() {\n    let e = Env::new(\"dead-sup\");\n    let id = e.run(\"SLOW\");\n    let pid = e.record(&id)[\"supervisorPid\"].as_i64().unwrap();\n    unsafe { libc::kill(pid as i32, libc::SIGKILL) };\n    let done = e.wait_terminal(&id);\n    assert_eq!(done[\"status\"], \"ERROR\");\n    assert_eq!(done[\"result\"][\"text\"], \"supervisor died\");\n    assert_eq!(e.record(&id)[\"status\"], \"ERROR\");\n    assert_eq!(e.record(&id)[\"result\"][\"text\"], \"supervisor died\");\n    e.release();\n}"}],"path":"/Users/user/work/delegate-10-resume-cancel/tests/cli_e2e.rs"}}],"api":"openai-responses","provider":"opencode-go","model":"muse-spark-1.3-contributor","usage":{"input":116269,"output":3653,"cacheRead":113,"cacheWrite":0,"reasoning":49,"totalTokens":120035,"cost":{"input":0.0116269,"output":0.0007306000000000001,"cacheRead":2.26E-7,"cacheWrite":0,"total":0.012357726000000001}},"stopReason":"toolUse","timestamp":1790850549209,"responseId":"resp_6abe35f849dd7f87b39b4782","rawStopReason":"completed","thinkingLevel":"high"},"toolResults":[{"role":"toolResult","toolCallId":"call_01a0f702d6717765b5b00cb9c6ce5992|fc_01a0f702d6717765b5b00cb9c6ce5992","toolName":"edit","content":[{"type":"text","text":"Successfully replaced 1 block(s) in /Users/user/work/delegate-10-resume-cancel/tests/cli_e2e.rs."}],"details":{"diff":"     ...\n 612     assert_eq!(e.record(&id)[\"status\"], \"ERROR\");\n 613     assert_eq!(e.record(&id)[\"result\"][\"text\"], \"supervisor died\");\n 614     e.release();\n 615 }\n+616 \n+617 impl Env {\n+618     fn resume(&self, id: &str, extra: &[&str], prompt: Option<&str>) -> Output {\n+619         let mut args: Vec<&str> = vec![\"resume\", id];\n+620         args.extend(extra);\n+621         self.delegate(&args, prompt)\n+622     }\n+623 \n+624     fn resume_ok(&self, id: &str, extra: &[&str], prompt: &str) -> String {\n+625         let out = self.resume(id, extra, Some(prompt));\n+626         assert!(\n+627             out.status.success(),\n+628             \"exit {:?}\\nstderr: {}\\nstdout: {}\",\n+629             out.status.code(),\n+630             String::from_utf8_lossy(&out.stderr),\n+631             String::from_utf8_lossy(&out.stdout)\n+632         );\n+633         String::from_utf8(out.stdout).unwrap().trim().to_string()\n+634     }\n+635 }\n+636 \n+637 #[test]\n+638 fn resume_continues_session_and_links_chain() {\n+639     let e = Env::new(\"resume\");\n+640     let a = e.run(\"first brief\");\n+641     let first = e.wait_terminal(&a);\n+642     assert_eq!(first[\"status\"], \"DONE\");\n+643     assert_eq!(first[\"resume\"][\"sessionId\"], \"s-1\");\n+644     let pid = first[\"supervisorPid\"].as_i64().unwrap();\n+645     // The original supervisor is gone: everything resume needs is in the record.\n+646     until(\"supervisor exit\", || !alive(pid));\n+647 \n+648     let b = e.resume_ok(&a, &[], \"follow up\");\n+649     assert_eq!(b.len(), 36);\n+650     let done = e.wait_terminal(&b);\n+651     assert_eq!(done[\"status\"], \"DONE\");\n+652     assert_eq!(done[\"result\"][\"jobId\"], b.as_str());\n+653     assert_eq!(done[\"resume\"][\"sessionId\"], \"s-1\");\n+654     // No heartbeat/progress on a terminal record.\n+655     assert!(done.get(\"lastHeartbeatAt\").is_none(), \"{done}\");\n+656     assert!(done.get(\"progress\").is_none(), \"{done}\");\n+657     // The fake agent saw the resume flag with the original model, cwd and capability.\n+658     let argv = e.argv();\n+659     assert!(\n+660         argv.windows(2).any(|w| w == [\"--resume\", \"s-1\"]),\n+661         \"{argv:?}\"\n+662     );\n+663     assert!(argv.contains(&\"composer-2.5\".to_string()), \"{argv:?}\");\n+664     assert!(\n+665         argv.windows(2).any(|w| w == [\"--mode\", \"ask\"]),\n+666         \"{argv:?}\"\n+667     );\n+668     assert_eq!(done[\"resume\"][\"cwd\"], first[\"resume\"][\"cwd\"]);\n+669     assert_eq!(done[\"resume\"][\"capability\"], \"read-only\");\n+670     // Chain links: B points back, A points forward, nothing else on A changed.\n+671     assert_eq!(done[\"resumedFrom\"], a.as_str());\n+672     let again = e.record(&a);\n+673     assert_eq!(again[\"supersededBy\"], b.as_str());\n+674     assert_eq!(again[\"result\"], first[\"result\"]);\n+675     assert_eq!(again[\"resume\"], first[\"resume\"]);\n+676 }\n+677 \n+678 #[test]\n+679 fn resume_overrides_replace_stored_values() {\n+680     let e = Env::new(\"resume-ov\");\n+681     let a = e.run(\"first\");\n+682     e.wait_terminal(&a);\n+683 \n+684     let b = e.resume_ok(&a, &[\"--model\", \"grok-4.7-high\"], \"again\");\n+685     let done = e.wait_terminal(&b);\n+686     assert_eq!(done[\"resume\"][\"model\"], \"grok-4.7-high\");\n+687     assert!(\n+688         e.argv().contains(&\"grok-4.7-high\".to_string()),\n+689         \"{:?}\",\n+690         e.argv()\n+691     );\n+692 \n+693     let c = e.resume_ok(&a, &[\"--capability\", \"read-write\"], \"as writer\");\n+694     let done = e.wait_terminal(&c);\n+695     assert_eq!(done[\"resume\"][\"capability\"], \"read-write\");\n+696     assert!(\n+697         e.argv().windows(2).any(|w| w == [\"--sandbox\", \"disabled\"]),\n+698         \"{:?}\",\n+699         e.argv()\n+700     );\n+701 \n+702     std::fs::write(e.dir.join(\"follow.txt\"), \"gated follow-up\").unwrap();\n+703     let out = e.resume(&a, &[\"--gate\", \"true\", \"--prompt-file\", \"follow.txt\"], None);\n+704     let d = e.ok_output(&out);\n+705     let done = e.wait_terminal(&d);\n+706     assert_eq!(done[\"resume\"][\"gate\"], \"true\");\n+707     assert_eq!(done[\"result\"][\"gateResult\"][\"command\"], \"true\");\n+708     assert_eq!(done[\"result\"][\"gateResult\"][\"passed\"], true);\n+709 }\n+710 \n+711 #[test]\n+712 fn resume_cross_backend_and_unknown_models_exit_2() {\n+713     let e = Env::new(\"resume-xb\");\n+714     let a = e.run(\"first\");\n+715     e.wait_terminal(&a);\n+716     for m in [\"openai-codex/gpt-6-luna\", \"claude-sonnet-5-5\"] {\n+717         let out = e.resume(&a, &[\"--model\", m], Some(\"again\"));\n+718         assert_eq!(out.status.code(), Some(2), \"{m}\");\n+719         let err = String::from_utf8_lossy(&out.stderr);\n+720         assert!(err.contains(\"backend\"), \"{err}\");\n+721         assert!(out.stdout.is_empty());\n+722     }\n+723     let out = e.resume(&a, &[\"--model\", \"nope-9\"], Some(\"again\"));\n+724     assert_eq!(out.status.code(), Some(2));\n+725     let err = String::from_utf8_lossy(&out.stderr);\n+726     assert!(err.contains(\"nope-9\") && err.contains(\"composer-2.5\"), \"{err}\");\n+727 }\n+728 \n+729 #[test]\n+730 fn resume_running_job_exits_2() {\n+731     let e = Env::new(\"resume-run\");\n+732     let slow = e.run(\"SLOW\");\n+733     assert_eq!(e.record(&slow)[\"status\"], \"RUNNING\");\n+734     let out = e.resume(&slow, &[], Some(\"follow\"));\n+735     assert_eq!(out.status.code(), Some(2));\n+736     assert!(\n+737         String::from_utf8_lossy(&out.stderr).contains(\"RUNNING\"),\n+738         \"{}\",\n+739         String::from_utf8_lossy(&out.stderr)\n+740     );\n+741     e.release();\n+742     e.wait_terminal(&slow);\n+743 }\n+744 \n+745 #[test]\n+746 fn resume_read_write_into_locked_cwd_is_busy() {\n+747     let e = Env::new(\"resume-busy\");\n+748     let a = e.ok_output(&e.run_write(\"quick\"));\n+749     e.wait_terminal(&a);\n+750     let blocker = e.ok_output(&e.run_write(\"SLOW write\"));\n+751     assert_eq!(e.record(&blocker)[\"status\"], \"RUNNING\");\n+752     // A was read-write, so resuming it needs the same lock a second run would take.\n+753     let busy = e.resume(&a, &[], Some(\"more\"));\n+754     assert_eq!(busy.status.code(), Some(3));\n+755     assert_eq!(\n+756         String::from_utf8(busy.stderr).unwrap(),\n+757         format!(\"BUSY {blocker}\\n\")\n+758     );\n+759     assert!(busy.stdout.is_empty());\n+760     // Once free, the resumed job takes the lock fresh through the shared run path.\n+761     e.release();\n+762     e.wait_terminal(&blocker);\n+763     let b = e.resume_ok(&a, &[], \"more\");\n+764     e.wait_terminal(&b);\n+765 }\n+766 \n+767 #[test]\n+768 fn resume_unknown_no_session_and_empty_prompt_exit_2() {\n+769     let e = Env::new(\"resume-err\");\n+770     let out = e.resume(\"nope\", &[], Some(\"hi\"));\n+771     assert_eq!(out.status.code(), Some(2));\n+772     assert!(\n+773         String::from_utf8_lossy(&out.stderr).contains(\"unknown job nope\"),\n+774         \"{}\",\n+775         String::from_utf8_lossy(&out.stderr)\n+776     );\n+777 \n+778     let a = e.run(\"first\");\n+779     e.wait_terminal(&a);\n+780     let out = e.resume(&a, &[], Some(\"  \\n\"));\n+781     assert_eq!(out.status.code(), Some(2));\n+782     assert!(\n+783         String::from_utf8_lossy(&out.stderr).contains(\"prompt is empty\"),\n+784         \"{}\",\n+785         String::from_utf8_lossy(&out.stderr)\n+786     );\n+787 \n+788     // A record with no session id (supervisor died before any result) is not resumable.\n+789     let slow = e.run(\"SLOW\");\n+790     let pid = e.record(&slow)[\"supervisorPid\"].as_i64().unwrap();\n+791     unsafe { libc::kill(pid as i32, libc::SIGKILL) };\n+792     let dead = e.wait_terminal(&slow);\n+793     assert_eq!(dead[\"status\"], \"ERROR\");\n+794     let out = e.resume(&slow, &[], Some(\"follow\"));\n+795     assert_eq!(out.status.code(), Some(2));\n+796     assert!(\n+797         String::from_utf8_lossy(&out.stderr).contains(\"session\"),\n+798         \"{}\",\n+799         String::from_utf8_lossy(&out.stderr)\n+800     );\n+801     e.release();\n+802 }\n+803 \n+804 /// A fake that stays RUNNING behind a grandchild: `sleep` inherits the agent's process\n+805 /// group, so killing only the agent would leave it behind.\n+806 const CANCEL_AGENT: &str = r#\"#!/bin/sh\n+807 DUR=300\n+808 sleep $DUR &\n+809 echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n+810 echo $$ > \"$(dirname \"$0\")/agent.pid\"\n+811 rel=\"$(dirname \"$0\")/go\"\n+812 i=0\n+813 while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n+814 printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n+815 \"#;\n+816 \n+817 fn read_pid(dir: &std::path::Path, name: &str) -> i32 {\n+818     std::fs::read_to_string(dir.join(name))\n+819         .unwrap()\n+820         .trim()\n+821         .parse()\n+822         .unwrap()\n+823 }\n+824 \n+825 fn gone(pid: i32) -> bool {\n+826     unsafe { libc::kill(pid, 0) } != 0\n+827 }\n+828 \n+829 #[test]\n+830 fn cancel_kills_agent_and_grandchild() {\n+831     let e = Env::new(\"cancel\");\n+832     std::fs::write(e.dir.join(\"agent.sh\"), CANCEL_AGENT).unwrap();\n+833     let id = e.run(\"CANCELME\");\n+834     until(\"agent spawn\", || {\n+835         e.dir.join(\"agent.pid\").exists() && e.dir.join(\"grandchild.pid\").exists()\n+836     });\n+837     assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n+838     let agent = read_pid(&e.dir, \"agent.pid\");\n+839     let grand = read_pid(&e.dir, \"grandchild.pid\");\n+840     assert!(!gone(agent) && !gone(grand), \"agent {agent} grand {grand}\");\n+841 \n+842     let out = e.delegate(&[\"cancel\", &id], None);\n+843     assert_eq!(out.status.code(), Some(0), \"{}\", String::from_utf8_lossy(&out.stderr));\n+844     let final_rec: Value = serde_json::from_slice(&out.stdout).unwrap();\n+845     assert_eq!(final_rec[\"status\"], \"CANCELLED\");\n+846     assert_eq!(final_rec[\"result\"][\"status\"], \"CANCELLED\");\n+847     assert_eq!(final_rec[\"result\"][\"jobId\"], id.as_str());\n+848     until(\"agent death\", || gone(agent) && gone(grand));\n+849     assert_eq!(e.record(&id)[\"status\"], \"CANCELLED\");\n+850 }\n+851 \n+852 #[test]\n+853 fn cancel_on_terminal_job_prints_record_and_exits_0() {\n+854     let e = Env::new(\"cancel-noop\");\n+855     let id = e.run(\"quick\");\n+856     let done = e.wait_terminal(&id);\n+857     let out = e.delegate(&[\"cancel\", &id], None);\n+858     assert_eq!(out.status.code(), Some(0));\n+859     let printed: Value = serde_json::from_slice(&out.stdout).unwrap();\n+860     assert_eq!(printed, done);\n+861 }\n+862 \n+863 #[test]\n+864 fn cancel_unknown_job_exits_2() {\n+865     let e = Env::new(\"cancel-unknown\");\n+866     let out = e.delegate(&[\"cancel\", \"nope\"], None);\n+867     assert_eq!(out.status.code(), Some(2));\n+868     assert!(\n+869         String::from_utf8_lossy(&out.stderr).contains(\"unknown job nope\"),\n+870         \"{}\",\n+871         String::from_utf8_lossy(&out.stderr)\n+872     );\n+873 }","patch":"--- /Users/user/work/delegate-10-resume-cancel/tests/cli_e2e.rs\n+++ /Users/user/work/delegate-10-resume-cancel/tests/cli_e2e.rs\n@@ -612,4 +612,262 @@\n     assert_eq!(e.record(&id)[\"status\"], \"ERROR\");\n     assert_eq!(e.record(&id)[\"result\"][\"text\"], \"supervisor died\");\n     e.release();\n }\n+\n+impl Env {\n+    fn resume(&self, id: &str, extra: &[&str], prompt: Option<&str>) -> Output {\n+        let mut args: Vec<&str> = vec![\"resume\", id];\n+        args.extend(extra);\n+        self.delegate(&args, prompt)\n+    }\n+\n+    fn resume_ok(&self, id: &str, extra: &[&str], prompt: &str) -> String {\n+        let out = self.resume(id, extra, Some(prompt));\n+        assert!(\n+            out.status.success(),\n+            \"exit {:?}\\nstderr: {}\\nstdout: {}\",\n+            out.status.code(),\n+            String::from_utf8_lossy(&out.stderr),\n+            String::from_utf8_lossy(&out.stdout)\n+        );\n+        String::from_utf8(out.stdout).unwrap().trim().to_string()\n+    }\n+}\n+\n+#[test]\n+fn resume_continues_session_and_links_chain() {\n+    let e = Env::new(\"resume\");\n+    let a = e.run(\"first brief\");\n+    let first = e.wait_terminal(&a);\n+    assert_eq!(first[\"status\"], \"DONE\");\n+    assert_eq!(first[\"resume\"][\"sessionId\"], \"s-1\");\n+    let pid = first[\"supervisorPid\"].as_i64().unwrap();\n+    // The original supervisor is gone: everything resume needs is in the record.\n+    until(\"supervisor exit\", || !alive(pid));\n+\n+    let b = e.resume_ok(&a, &[], \"follow up\");\n+    assert_eq!(b.len(), 36);\n+    let done = e.wait_terminal(&b);\n+    assert_eq!(done[\"status\"], \"DONE\");\n+    assert_eq!(done[\"result\"][\"jobId\"], b.as_str());\n+    assert_eq!(done[\"resume\"][\"sessionId\"], \"s-1\");\n+    // No heartbeat/progress on a terminal record.\n+    assert!(done.get(\"lastHeartbeatAt\").is_none(), \"{done}\");\n+    assert!(done.get(\"progress\").is_none(), \"{done}\");\n+    // The fake agent saw the resume flag with the original model, cwd and capability.\n+    let argv = e.argv();\n+    assert!(\n+        argv.windows(2).any(|w| w == [\"--resume\", \"s-1\"]),\n+        \"{argv:?}\"\n+    );\n+    assert!(argv.contains(&\"composer-2.5\".to_string()), \"{argv:?}\");\n+    assert!(\n+        argv.windows(2).any(|w| w == [\"--mode\", \"ask\"]),\n+        \"{argv:?}\"\n+    );\n+    assert_eq!(done[\"resume\"][\"cwd\"], first[\"resume\"][\"cwd\"]);\n+    assert_eq!(done[\"resume\"][\"capability\"], \"read-only\");\n+    // Chain links: B points back, A points forward, nothing else on A changed.\n+    assert_eq!(done[\"resumedFrom\"], a.as_str());\n+    let again = e.record(&a);\n+    assert_eq!(again[\"supersededBy\"], b.as_str());\n+    assert_eq!(again[\"result\"], first[\"result\"]);\n+    assert_eq!(again[\"resume\"], first[\"resume\"]);\n+}\n+\n+#[test]\n+fn resume_overrides_replace_stored_values() {\n+    let e = Env::new(\"resume-ov\");\n+    let a = e.run(\"first\");\n+    e.wait_terminal(&a);\n+\n+    let b = e.resume_ok(&a, &[\"--model\", \"grok-4.7-high\"], \"again\");\n+    let done = e.wait_terminal(&b);\n+    assert_eq!(done[\"resume\"][\"model\"], \"grok-4.7-high\");\n+    assert!(\n+        e.argv().contains(&\"grok-4.7-high\".to_string()),\n+        \"{:?}\",\n+        e.argv()\n+    );\n+\n+    let c = e.resume_ok(&a, &[\"--capability\", \"read-write\"], \"as writer\");\n+    let done = e.wait_terminal(&c);\n+    assert_eq!(done[\"resume\"][\"capability\"], \"read-write\");\n+    assert!(\n+        e.argv().windows(2).any(|w| w == [\"--sandbox\", \"disabled\"]),\n+        \"{:?}\",\n+        e.argv()\n+    );\n+\n+    std::fs::write(e.dir.join(\"follow.txt\"), \"gated follow-up\").unwrap();\n+    let out = e.resume(&a, &[\"--gate\", \"true\", \"--prompt-file\", \"follow.txt\"], None);\n+    let d = e.ok_output(&out);\n+    let done = e.wait_terminal(&d);\n+    assert_eq!(done[\"resume\"][\"gate\"], \"true\");\n+    assert_eq!(done[\"result\"][\"gateResult\"][\"command\"], \"true\");\n+    assert_eq!(done[\"result\"][\"gateResult\"][\"passed\"], true);\n+}\n+\n+#[test]\n+fn resume_cross_backend_and_unknown_models_exit_2() {\n+    let e = Env::new(\"resume-xb\");\n+    let a = e.run(\"first\");\n+    e.wait_terminal(&a);\n+    for m in [\"openai-codex/gpt-6-luna\", \"claude-sonnet-5-5\"] {\n+        let out = e.resume(&a, &[\"--model\", m], Some(\"again\"));\n+        assert_eq!(out.status.code(), Some(2), \"{m}\");\n+        let err = String::from_utf8_lossy(&out.stderr);\n+        assert!(err.contains(\"backend\"), \"{err}\");\n+        assert!(out.stdout.is_empty());\n+    }\n+    let out = e.resume(&a, &[\"--model\", \"nope-9\"], Some(\"again\"));\n+    assert_eq!(out.status.code(), Some(2));\n+    let err = String::from_utf8_lossy(&out.stderr);\n+    assert!(err.contains(\"nope-9\") && err.contains(\"composer-2.5\"), \"{err}\");\n+}\n+\n+#[test]\n+fn resume_running_job_exits_2() {\n+    let e = Env::new(\"resume-run\");\n+    let slow = e.run(\"SLOW\");\n+    assert_eq!(e.record(&slow)[\"status\"], \"RUNNING\");\n+    let out = e.resume(&slow, &[], Some(\"follow\"));\n+    assert_eq!(out.status.code(), Some(2));\n+    assert!(\n+        String::from_utf8_lossy(&out.stderr).contains(\"RUNNING\"),\n+        \"{}\",\n+        String::from_utf8_lossy(&out.stderr)\n+    );\n+    e.release();\n+    e.wait_terminal(&slow);\n+}\n+\n+#[test]\n+fn resume_read_write_into_locked_cwd_is_busy() {\n+    let e = Env::new(\"resume-busy\");\n+    let a = e.ok_output(&e.run_write(\"quick\"));\n+    e.wait_terminal(&a);\n+    let blocker = e.ok_output(&e.run_write(\"SLOW write\"));\n+    assert_eq!(e.record(&blocker)[\"status\"], \"RUNNING\");\n+    // A was read-write, so resuming it needs the same lock a second run would take.\n+    let busy = e.resume(&a, &[], Some(\"more\"));\n+    assert_eq!(busy.status.code(), Some(3));\n+    assert_eq!(\n+        String::from_utf8(busy.stderr).unwrap(),\n+        format!(\"BUSY {blocker}\\n\")\n+    );\n+    assert!(busy.stdout.is_empty());\n+    // Once free, the resumed job takes the lock fresh through the shared run path.\n+    e.release();\n+    e.wait_terminal(&blocker);\n+    let b = e.resume_ok(&a, &[], \"more\");\n+    e.wait_terminal(&b);\n+}\n+\n+#[test]\n+fn resume_unknown_no_session_and_empty_prompt_exit_2() {\n+    let e = Env::new(\"resume-err\");\n+    let out = e.resume(\"nope\", &[], Some(\"hi\"));\n+    assert_eq!(out.status.code(), Some(2));\n+    assert!(\n+        String::from_utf8_lossy(&out.stderr).contains(\"unknown job nope\"),\n+        \"{}\",\n+        String::from_utf8_lossy(&out.stderr)\n+    );\n+\n+    let a = e.run(\"first\");\n+    e.wait_terminal(&a);\n+    let out = e.resume(&a, &[], Some(\"  \\n\"));\n+    assert_eq!(out.status.code(), Some(2));\n+    assert!(\n+        String::from_utf8_lossy(&out.stderr).contains(\"prompt is empty\"),\n+        \"{}\",\n+        String::from_utf8_lossy(&out.stderr)\n+    );\n+\n+    // A record with no session id (supervisor died before any result) is not resumable.\n+    let slow = e.run(\"SLOW\");\n+    let pid = e.record(&slow)[\"supervisorPid\"].as_i64().unwrap();\n+    unsafe { libc::kill(pid as i32, libc::SIGKILL) };\n+    let dead = e.wait_terminal(&slow);\n+    assert_eq!(dead[\"status\"], \"ERROR\");\n+    let out = e.resume(&slow, &[], Some(\"follow\"));\n+    assert_eq!(out.status.code(), Some(2));\n+    assert!(\n+        String::from_utf8_lossy(&out.stderr).contains(\"session\"),\n+        \"{}\",\n+        String::from_utf8_lossy(&out.stderr)\n+    );\n+    e.release();\n+}\n+\n+/// A fake that stays RUNNING behind a grandchild: `sleep` inherits the agent's process\n+/// group, so killing only the agent would leave it behind.\n+const CANCEL_AGENT: &str = r#\"#!/bin/sh\n+DUR=300\n+sleep $DUR &\n+echo $! > \"$(dirname \"$0\")/grandchild.pid\"\n+echo $$ > \"$(dirname \"$0\")/agent.pid\"\n+rel=\"$(dirname \"$0\")/go\"\n+i=0\n+while [ ! -e \"$rel\" ] && [ \"$i\" -lt 400 ]; do sleep 0.05; i=$((i+1)); done\n+printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"late\\nSTATUS: DONE\",\"session_id\":\"s-9\"}'\n+\"#;\n+\n+fn read_pid(dir: &std::path::Path, name: &str) -> i32 {\n+    std::fs::read_to_string(dir.join(name))\n+        .unwrap()\n+        .trim()\n+        .parse()\n+        .unwrap()\n+}\n+\n+fn gone(pid: i32) -> bool {\n+    unsafe { libc::kill(pid, 0) } != 0\n+}\n+\n+#[test]\n+fn cancel_kills_agent_and_grandchild() {\n+    let e = Env::new(\"cancel\");\n+    std::fs::write(e.dir.join(\"agent.sh\"), CANCEL_AGENT).unwrap();\n+    let id = e.run(\"CANCELME\");\n+    until(\"agent spawn\", || {\n+        e.dir.join(\"agent.pid\").exists() && e.dir.join(\"grandchild.pid\").exists()\n+    });\n+    assert_eq!(e.record(&id)[\"status\"], \"RUNNING\");\n+    let agent = read_pid(&e.dir, \"agent.pid\");\n+    let grand = read_pid(&e.dir, \"grandchild.pid\");\n+    assert!(!gone(agent) && !gone(grand), \"agent {agent} grand {grand}\");\n+\n+    let out = e.delegate(&[\"cancel\", &id], None);\n+    assert_eq!(out.status.code(), Some(0), \"{}\", String::from_utf8_lossy(&out.stderr));\n+    let final_rec: Value = serde_json::from_slice(&out.stdout).unwrap();\n+    assert_eq!(final_rec[\"status\"], \"CANCELLED\");\n+    assert_eq!(final_rec[\"result\"][\"status\"], \"CANCELLED\");\n+    assert_eq!(final_rec[\"result\"][\"jobId\"], id.as_str());\n+    until(\"agent death\", || gone(agent) && gone(grand));\n+    assert_eq!(e.record(&id)[\"status\"], \"CANCELLED\");\n+}\n+\n+#[test]\n+fn cancel_on_terminal_job_prints_record_and_exits_0() {\n+    let e = Env::new(\"cancel-noop\");\n+    let id = e.run(\"quick\");\n+    let done = e.wait_terminal(&id);\n+    let out = e.delegate(&[\"cancel\", &id], None);\n+    assert_eq!(out.status.code(), Some(0));\n+    let printed: Value = serde_json::from_slice(&out.stdout).unwrap();\n+    assert_eq!(printed, done);\n+}\n+\n+#[test]\n+fn cancel_unknown_job_exits_2() {\n+    let e = Env::new(\"cancel-unknown\");\n+    let out = e.delegate(&[\"cancel\", \"nope\"], None);\n+    assert_eq!(out.status.code(), Some(2));\n+    assert!(\n+        String::from_utf8_lossy(&out.stderr).contains(\"unknown job nope\"),\n+        \"{}\",\n+        String::from_utf8_lossy(&out.stderr)\n+    );\n+}\n","firstChangedLine":616},"isError":false,"timestamp":1790850578957}]}
