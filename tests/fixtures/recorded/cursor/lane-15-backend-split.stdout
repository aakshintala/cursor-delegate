s/claude/review-19.stdout","./tests/fixtures/claude/review-19.argv","./tests/fixtures/claude/review-18.stdout","./tests/fixtures/claude/review-18.argv","./tests/fixtures/claude/resume-answer.stdout","./tests/fixtures/claude/resume-answer.argv","./tests/fixtures/claude/plan-review.stdout","./tests/fixtures/claude/plan-review.argv","./tests/fixtures/claude/plan-plain-answer.stdout","./tests/fixtures/claude/plan-plain-answer.argv","./tests/fixtures/claude/plan-edit-request.stdout","./tests/fixtures/claude/plan-edit-request.argv","./tests/fixtures/claude/needs-context.stdout","./tests/fixtures/claude/needs-context.argv","./tests/fixtures/claude/error-bad-model.stdout","./tests/fixtures/claude/error-bad-model.stderr","./tests/fixtures/claude/error-bad-model.argv","./tests/fixtures/claude/cancelled.stdout","./tests/fixtures/claude/cancelled.argv","./tests/fixtures/claude/auto-refusal.stdout","./tests/fixtures/claude/auto-refusal.argv","./tests/fixtures/claude/auto-refusal-exfil.stdout","./tests/fixtures/claude/auto-refusal-exfil.argv","./tests/fixtures/claude/auto-fix.stdout","./tests/fixtures/claude/auto-fix.argv","./tests/cli_info_e2e.rs","./tests/cli_e2e.rs","./tests/budgets.rs"],"totalFiles":68,"clientTruncated":false,"ripgrepTruncated":false}}},"hookAdditionalContexts":[],"toolCallId":"call-e0a90d10-1a96-484d-963a-74b21ab920e5-8\nfc_97f3b6e6-2f4e-9997-821b-dd2fb4dfafb0_1","startedAtMs":"1790853438284","completedAtMs":"1790853438638"},"model_call_id":"a39a3dae-67ec-4300-bf85-501258a620a7-2-w67n","session_id":"1d546125-183e-46a3-aaab-e9734f91ce3e","timestamp_ms":1790853438546}
