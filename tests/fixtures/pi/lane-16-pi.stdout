{"type":"message_update","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"assistantMessageEvent":{"type":"toolcall_delta","contentIndex":2,"delta":"{\"command\":\"python3 - <<'EOF'\\nimport json\\nfor stem in [\\\"plain-answer\\\",\\\"tool-calls-fix\\\",\\\"resume-answer\\\",\\\"error-bad-model\\\",\\\"needs-context\\\"]:\\n    with open(f\\\"tests/fixtures/pi/{stem}.stdout\\\") as f: lines=[l.rstrip(\\\"\\\\n\\\") for l in f]\\n    ae=[json.loads(l) for l in lines if json.loads(l).get(\\\"type\\\")==\\\"agent_end\\\"]\\n    print(\\\"=\\\"*15, stem, \\\"agent_end:\\\", len(ae))\\n    if ae:\\n        msgs=ae[-1].get(\\\"messages\\\",[])\\n        lasts=[m for m in msgs if m.get(\\\"role\\\")==\\\"assistant\\\"]\\n        if lasts:\\n            m=lasts[-1]\\n            print(\\\" stopReason:\\\", m.get(\\\"stopReason\\\"))\\n            print(\\\" errorMessage:\\\", repr(m.get(\\\"errorMessage\\\")))\\n            texts=[p.get(\\\"text\\\",\\\"\\\") for p in (m.get(\\\"content\\\") or []) if p.get(\\\"type\\\")==\\\"text\\\"]\\n            print(\\\" text:\\\", repr(\\\"\\\".join(texts)))\\n    inp=out=cr=cw=0; cost=0.0; n=0\\n    for l in lines:\\n        o=json.loads(l)\\n        if o.get(\\\"type\\\")==\\\"message_end\\\" and (o.get(\\\"message\\\") or {}).get(\\\"role\\\")==\\\"assistant\\\":\\n            n+=1; u=(o.get(\\\"message\\\") or {}).get(\\\"usage\\\") or {}\\n            inp+=u.get(\\\"input\\\",0); out+=u.get(\\\"output\\\",0); cr+=u.get(\\\"cacheRead\\\",0); cw+=u.get(\\\"cacheWrite\\\",0)\\n            cost+=(u.get(\\\"cost\\\") or {}).get(\\\"total\\\",0)\\n    print(f\\\" n={n} in={inp} out={out} cr={cr} cw={cw} cost={cost!r}\\\")\\n    sid=[json.loads(l).get(\\\"id\\\") for l in lines if json.loads(l).get(\\\"type\\\")==\\\"session\\\"]\\n    print(\\\" session:\\\", sid)\\nEOF\"}"}}
{"type":"message_update","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":2,"toolCall":{"type":"toolCall","id":"call_01a0f753961d76e0a899c0e76a1bb188|fc_01a0f753961d76e0a899c0e76a1bb188","name":"bash","arguments":{"command":"python3 - <<'EOF'\nimport json\nfor stem in [\"plain-answer\",\"tool-calls-fix\",\"resume-answer\",\"error-bad-model\",\"needs-context\"]:\n    with open(f\"tests/fixtures/pi/{stem}.stdout\") as f: lines=[l.rstrip(\"\\n\") for l in f]\n    ae=[json.loads(l) for l in lines if json.loads(l).get(\"type\")==\"agent_end\"]\n    print(\"=\"*15, stem, \"agent_end:\", len(ae))\n    if ae:\n        msgs=ae[-1].get(\"messages\",[])\n        lasts=[m for m in msgs if m.get(\"role\")==\"assistant\"]\n        if lasts:\n            m=lasts[-1]\n            print(\" stopReason:\", m.get(\"stopReason\"))\n            print(\" errorMessage:\", repr(m.get(\"errorMessage\")))\n            texts=[p.get(\"text\",\"\") for p in (m.get(\"content\") or []) if p.get(\"type\")==\"text\"]\n            print(\" text:\", repr(\"\".join(texts)))\n    inp=out=cr=cw=0; cost=0.0; n=0\n    for l in lines:\n        o=json.loads(l)\n        if o.get(\"type\")==\"message_end\" and (o.get(\"message\") or {}).get(\"role\")==\"assistant\":\n            n+=1; u=(o.get(\"message\") or {}).get(\"usage\") or {}\n            inp+=u.get(\"input\",0); out+=u.get(\"output\",0); cr+=u.get(\"cacheRead\",0); cw+=u.get(\"cacheWrite\",0)\n            cost+=(u.get(\"cost\") or {}).get(\"total\",0)\n    print(f\" n={n} in={inp} out={out} cr={cr} cw={cw} cost={cost!r}\")\n    sid=[json.loads(l).get(\"id\") for l in lines if json.loads(l).get(\"type\")==\"session\"]\n    print(\" session:\", sid)\nEOF"}}}}
