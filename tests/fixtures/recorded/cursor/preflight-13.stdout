)\n            .unwrap();\n        let mut child = Command::new(env!(\"CARGO_BIN_EXE_cursor-delegate-mcp\"))\n            .current_dir(dir)\n            .env(\"CURSOR_AGENT_BIN\", &agent)\n            .stdin(Stdio::piped())\n            .stdout(Stdio::piped())\n            .spawn()\n            .unwrap();\n        let stdin = child.stdin.take().unwrap();\n        let stdout = BufReader::new(child.stdout.take().unwrap());\n        let mut s = Server {\n            child,\n            stdin,\n","localExecutionTimeMs":184},"isBackground":false},"description":"e2e tests scope on origin/main"},"hookAdditionalContexts":[],"toolCallId":"tool_c8c33dfb-41bb-4a4c-97e0-5193088e0ce","startedAtMs":"1790845491869","completedAtMs":"1790845492393"},"model_call_id":"e585ae89-c308-48e6-a816-313689ff8cab-7-djhz","session_id":"7bb334b3-f226-467c-b3bf-a467f772d57f","timestamp_ms":1790845492380}
